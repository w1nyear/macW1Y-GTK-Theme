[Desktop Entry]
Type=Application
Name=Wine Windows Program Loader
Comment=Run Windows applications seamlessly on macOS Modpack
Exec=/usr/local/bin/mac-wine-runner %F
Icon=wine
Terminal=false
StartupNotify=true
NoDisplay=false
MimeType=application/x-ms-dos-executable;application/x-msdownload;application/x-msi;application/x-bat;application/vnd.microsoft.portable-executable;application/x-msdos-program;application/x-wine-extension-msp;application/x-ms-shortcut;application/x-executable;
Categories=System;Emulator;
