[Desktop Entry]
Type=Application
Name=CapCut
Comment=CapCut Video Editor
Exec=/usr/local/bin/mac-wine-runner "C:\\users\\Public\\CapCut\\Apps\\CapCut.exe" %U
Icon=capcut
Terminal=false
Categories=AudioVideo;Video;AudioVideoEditing;Utility;
X-Mac-Wine-App=true
X-Mac-Real-Path=~/.wine/drive_c/users/Public/CapCut/Apps/CapCut.exe
PrefersNonDefaultGPU=true
X-KDE-RunOnDiscreteGpu=true
StartupNotify=true
StartupWMClass=capcut.exe
