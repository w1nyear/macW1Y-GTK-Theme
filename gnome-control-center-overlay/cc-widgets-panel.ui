                                </child>
                                <child type="suffix">
                                  <object class="GtkButton" id="btn_picker_add_system">
                                    <property name="label">Додати</property>
                                    <property name="icon-name">list-add-symbolic</property>
                                    <property name="valign">center</property>
                                    <property name="tooltip-text">Додати системний монітор на стільницю</property>
                                    <style>
                                      <class name="suggested-action"/>
                                      <class name="mac-action-accent-btn"/>
                                      <class name="pill"/>
                                    </style>
                                    <signal name="clicked" handler="on_dw_add_system"/>
                                  </object>
                                </child>
                              </object>
                            </child>

                          </object>
                        </child>

                        <!-- 3.4 Інформація -->
                        <child>
                          <object class="AdwPreferencesGroup">
                            <property name="title">Інформація та веб</property>
                            <property name="description">Прогноз погоди та статистика GitHub</property>

                            <child>
                              <object class="AdwActionRow" id="picker_row_weather">
                                <property name="title">Погода</property>
                                <property name="subtitle">Поточна температура, стан неба та метеопрогноз</property>
                                <property name="activatable">true</property>
                                <signal name="activated" handler="on_dw_add_weather"/>
                                <child type="prefix">
                                  <object class="GtkImage">
                                    <property name="icon-name">weather-few-clouds-symbolic</property>
                                    <property name="pixel-size">24</property>
                                  </object>
                                </child>
                                <child type="suffix">
                                  <object class="GtkButton" id="btn_picker_add_weather">
                                    <property name="label">Додати</property>
                                    <property name="icon-name">list-add-symbolic</property>
                                    <property name="valign">center</property>
                                    <property name="tooltip-text">Додати погоду на стільницю</property>
                                    <style>
                                      <class name="suggested-action"/>
                                      <class name="mac-action-accent-btn"/>
                                      <class name="pill"/>
                                    </style>
                                    <signal name="clicked" handler="on_dw_add_weather"/>
                                  </object>
                                </child>
                              </object>
                            </child>

                            <child>
                              <object class="AdwActionRow" id="picker_row_github">
                                <property name="title">GitHub</property>
                                <property name="subtitle">Матриця контрибуцій та статистика репозиторіїв</property>
                                <property name="activatable">true</property>
                                <signal name="activated" handler="on_dw_add_github"/>
                                <child type="prefix">
                                  <object class="GtkImage">
                                    <property name="icon-name">network-server-symbolic</property>
                                    <property name="pixel-size">24</property>
                                  </object>
                                </child>
                                <child type="suffix">
                                  <object class="GtkButton" id="btn_picker_add_github">
                                    <property name="label">Додати</property>
                                    <property name="icon-name">list-add-symbolic</property>
                                    <property name="valign">center</property>
                                    <property name="tooltip-text">Додати віджет GitHub на стільницю</property>
                                    <style>
                                      <class name="suggested-action"/>
                                      <class name="mac-action-accent-btn"/>
                                      <class name="pill"/>
                                    </style>
                                    <signal name="clicked" handler="on_dw_add_github"/>
                                  </object>
                                </child>
                              </object>
                            </child>

                          </object>
                        </child>

                        <!-- 3.5 Мультимедіа та декор -->
                        <child>
                          <object class="AdwPreferencesGroup">
                            <property name="title">Мультимедіа та декор</property>
                            <property name="description">Керування музикою, фотогалерея та релакс-віджети</property>

                            <child>
                              <object class="AdwActionRow" id="picker_row_music">
                                <property name="title">Музичний плеєр</property>
                                <property name="subtitle">Керування відтворенням треків, назва та обкладинка</property>
                                <property name="activatable">true</property>
                                <signal name="activated" handler="on_dw_add_music"/>
                                <child type="prefix">
                                  <object class="GtkImage">
                                    <property name="icon-name">multimedia-player-symbolic</property>
                                    <property name="pixel-size">24</property>
                                  </object>
                                </child>
                                <child type="suffix">
                                  <object class="GtkButton" id="btn_picker_add_music">
                                    <property name="label">Додати</property>
                                    <property name="icon-name">list-add-symbolic</property>
                                    <property name="valign">center</property>
                                    <property name="tooltip-text">Додати музичний плеєр на стільницю</property>
                                    <style>
                                      <class name="suggested-action"/>
                                      <class name="mac-action-accent-btn"/>
                                      <class name="pill"/>
                                    </style>
                                    <signal name="clicked" handler="on_dw_add_music"/>
                                  </object>
                                </child>
                              </object>
                            </child>

                            <child>
                              <object class="AdwActionRow" id="picker_row_photos">
                                <property name="title">Фотогалерея</property>
                                <property name="subtitle">Слайдшоу улюблених світлин на стільниці</property>
                                <property name="activatable">true</property>
                                <signal name="activated" handler="on_dw_add_photos"/>
                                <child type="prefix">
                                  <object class="GtkImage">
                                    <property name="icon-name">image-x-generic-symbolic</property>
                                    <property name="pixel-size">24</property>
                                  </object>
                                </child>
                                <child type="suffix">
                                  <object class="GtkButton" id="btn_picker_add_photos">
                                    <property name="label">Додати</property>
                                    <property name="icon-name">list-add-symbolic</property>
                                    <property name="valign">center</property>
                                    <property name="tooltip-text">Додати фотогалерею на стільницю</property>
                                    <style>
                                      <class name="suggested-action"/>
                                      <class name="mac-action-accent-btn"/>
                                      <class name="pill"/>
                                    </style>
                                    <signal name="clicked" handler="on_dw_add_photos"/>
                                  </object>
                                </child>
                              </object>
                            </child>

                            <child>
                              <object class="AdwActionRow" id="picker_row_lava">
                                <property name="title">Лава-лампа</property>
                                <property name="subtitle">Декоративний фізичний віджет з анімованими краплями</property>
                                <property name="activatable">true</property>
                                <signal name="activated" handler="on_dw_add_lava"/>
                                <child type="prefix">
                                  <object class="GtkImage">
                                    <property name="icon-name">color-select-symbolic</property>
                                    <property name="pixel-size">24</property>
                                  </object>
                                </child>
                                <child type="suffix">
                                  <object class="GtkButton" id="btn_picker_add_lava">
                                    <property name="label">Додати</property>
                                    <property name="icon-name">list-add-symbolic</property>
                                    <property name="valign">center</property>
                                    <property name="tooltip-text">Додати лава-лампу на стільницю</property>
                                    <style>
                                      <class name="suggested-action"/>
                                      <class name="mac-action-accent-btn"/>
                                      <class name="pill"/>
                                    </style>
                                    <signal name="clicked" handler="on_dw_add_lava"/>
                                  </object>
                                </child>
                              </object>
                            </child>

                          </object>
                        </child>

                      </object>
                    </property>
                  </object>
                </property>
              </object>
            </property>
          </object>
        </child>
      </object>
    </property>
  </object>
</interface>
