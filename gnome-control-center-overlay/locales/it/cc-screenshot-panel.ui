<?xml version='1.0' encoding='utf-8'?>
<interface>
  <requires lib="gtk" version="4.0" />
  <object class="AdwNavigationPage" id="screenshot_page">
    <property name="title">Schermata</property>
    <property name="tag">screenshot</property>
    <property name="child">
      <object class="AdwToolbarView">
        <property name="extend-content-to-top-edge">False</property>
        <property name="extend-content-to-bottom-edge">True</property>
        <property name="top-bar-style">flat</property>
        <child type="top">
          <object class="AdwHeaderBar">
            <style>
              <class name="flat" />
            </style>
          </object>
        </child>
        <property name="content">
          <object class="AdwPreferencesPage">

            
            <child>
              <object class="AdwPreferencesGroup">
                <property name="title">Schermate (Foto)</property>
                <property name="description">Parametri di salvataggio e formato per le schermate fisse</property>

                <child>
                  <object class="AdwComboRow" id="screenshot_format_row">
                    <property name="title">Formato file immagine</property>
                    <property name="subtitle">Formato di salvataggio delle schermate</property>
                    <property name="model">
                      <object class="GtkStringList">
                        <items>
                          <item>PNG (Senza perdita / Testo nitido)</item>
                          <item>JPEG (Formato foto compresso)</item>
                          <item>WebP (Formato compatto moderno)</item>
                        </items>
                      </object>
                    </property>
                    <signal name="realize" handler="init_screenshot_format" />
                    <signal name="notify::selected" handler="on_screenshot_format_changed" />
                  </object>
                </child>

                <child>
                  <object class="AdwActionRow" id="screenshot_quality_row">
                    <property name="title">Qualità di compressione</property>
                    <property name="subtitle">Livello di qualità per formati JPEG e WebP (70% - 100%)</property>
                    <child type="suffix">
                      <object class="GtkScale" id="screenshot_quality_scale">
                        <property name="orientation">0</property>
                        <property name="draw-value">true</property>
                        <property name="digits">0</property>
                        <property name="round-digits">0</property>
                        <property name="width-request">200</property>
                        <property name="adjustment">
                          <object class="GtkAdjustment">
                            <property name="lower">70</property>
                            <property name="upper">100</property>
                            <property name="step-increment">1</property>
                            <property name="page-increment">5</property>
                            <property name="value">95</property>
                          </object>
                        </property>
                        <signal name="realize" handler="init_screenshot_quality" />
                        <signal name="value-changed" handler="on_screenshot_quality_changed" />
                      </object>
                    </child>
                  </object>
                </child>

                <child>
                  <object class="AdwSwitchRow" id="screenshot_cursor_row">
                    <property name="title">Mostra cursore nella schermata</property>
                    <property name="subtitle">Includi il puntatore del mouse nella schermata finale</property>
                    <property name="active">true</property>
                    <signal name="realize" handler="init_screenshot_cursor" />
                    <signal name="notify::active" handler="on_screenshot_cursor_changed" />
                  </object>
                </child>

                <child>
                  <object class="AdwSwitchRow" id="screenshot_sound_row">
                    <property name="title">Suono dell'otturatore</property>
                    <property name="subtitle">Riproduci il suono dell'otturatore macOS allo scatto</property>
                    <property name="active">true</property>
                    <signal name="realize" handler="init_screenshot_sound" />
                    <signal name="notify::active" handler="on_screenshot_sound_changed" />
                  </object>
                </child>

                <child>
                  <object class="AdwComboRow" id="screenshot_delay_row">
                    <property name="title">Ritardo prima dello scatto</property>
                    <property name="subtitle">Timer conto alla rovescia per preparare la finestra</property>
                    <property name="model">
                      <object class="GtkStringList">
                        <items>
                          <item>Senza ritardo (immediatamente)</item>
                          <item>3 secondi</item>
                          <item>5 secondi</item>
                          <item>10 secondi</item>
                        </items>
                      </object>
                    </property>
                    <signal name="realize" handler="init_screenshot_delay" />
                    <signal name="notify::selected" handler="on_screenshot_delay_changed" />
                  </object>
                </child>
              </object>
            </child>

            
            <child>
              <object class="AdwPreferencesGroup">
                <property name="title">Registrazione schermo (Video)</property>
                <property name="description">Impostazioni di codec video, formato e frequenza dei fotogrammi</property>

                <child>
                  <object class="AdwComboRow" id="screencast_container_row">
                    <property name="title">Formato contenitore video</property>
                    <property name="subtitle">Tipo di file per salvare la registrazione dello schermo</property>
                    <property name="model">
                      <object class="GtkStringList">
                        <items>
                          <item>MP4 (.mp4 — massima compatibilità macOS/iOS/Windows)</item>
                          <item>WebM (.webm — formato web aperto e ottimizzato)</item>
                          <item>MKV (.mkv — contenitore senza restrizioni)</item>
                        </items>
                      </object>
                    </property>
                    <signal name="realize" handler="init_screencast_container" />
                    <signal name="notify::selected" handler="on_screencast_container_changed" />
                  </object>
                </child>

                <child>
                  <object class="AdwComboRow" id="screencast_codec_row">
                    <property name="title">Codec video</property>
                    <property name="subtitle">Algoritmo di codifica del flusso video</property>
                    <property name="model">
                      <object class="GtkStringList">
                        <items>
                          <item>H.264 / AVC (Veloce e universalmente compatibile)</item>
                          <item>VP9 (Alta qualità in WebM)</item>
                          <item>AV1 (Compressione ad alta efficienza di nuova generazione)</item>
                        </items>
                      </object>
                    </property>
                    <signal name="realize" handler="init_screencast_codec" />
                    <signal name="notify::selected" handler="on_screencast_codec_changed" />
                  </object>
                </child>

                <child>
                  <object class="AdwComboRow" id="screencast_fps_row">
                    <property name="title">Frequenza dei fotogrammi (FPS)</property>
                    <property name="subtitle">Fluidità della registrazione video</property>
                    <property name="model">
                      <object class="GtkStringList">
                        <items>
                          <item>60 FPS (Stile macOS fluido)</item>
                          <item>30 FPS (Bilanciamento dimensioni standard)</item>
                        </items>
                      </object>
                    </property>
                    <signal name="realize" handler="init_screencast_fps" />
                    <signal name="notify::selected" handler="on_screencast_fps_changed" />
                  </object>
                </child>

                <child>
                  <object class="AdwSwitchRow" id="screencast_cursor_row">
                    <property name="title">Mostra cursore nel video</property>
                    <property name="subtitle">Registra i movimenti del puntatore durante la registrazione</property>
                    <property name="active">true</property>
                    <signal name="realize" handler="init_screencast_cursor" />
                    <signal name="notify::active" handler="on_screencast_cursor_changed" />
                  </object>
                </child>

                <child>
                  <object class="AdwSwitchRow" id="screencast_audio_row">
                    <property name="title">Registra audio</property>
                    <property name="subtitle">Cattura l'audio di sistema e del microfono</property>
                    <property name="active">false</property>
                    <signal name="realize" handler="init_screencast_audio" />
                    <signal name="notify::active" handler="on_screencast_audio_changed" />
                  </object>
                </child>
              </object>
            </child>

            
            <child>
              <object class="AdwPreferencesGroup">
                <property name="title">Elaborazione e miglioramento della qualità</property>
                <property name="description">Ridimensionamento automatico e ottimizzazione dopo l'acquisizione</property>

                <child>
                  <object class="AdwSwitchRow" id="processing_enabled_row">
                    <property name="title">Post-elaborazione automatica</property>
                    <property name="subtitle">Elabora le foto o i video acquisiti alla risoluzione di destinazione (1080p / 2K / 4K)</property>
                    <property name="active">true</property>
                    <signal name="realize" handler="init_processing_enabled" />
                    <signal name="notify::active" handler="on_processing_enabled_changed" />
                  </object>
                </child>

                <child>
                  <object class="AdwComboRow" id="processing_resolution_row">
                    <property name="title">Risoluzione di elaborazione target</property>
                    <property name="subtitle">Risoluzione di destinazione a cui ridimensionare lo scatto o video</property>
                    <property name="model">
                      <object class="GtkStringList">
                        <items>
                          <item>Originale (1:1 Nativa invariata)</item>
                          <item>1080p Full HD (1920×1080)</item>
                          <item>2K Quad HD (2560×1440 — ottimale per Retina/HiDPI)</item>
                          <item>4K Ultra HD (3840×2160 — massima qualità)</item>
                        </items>
                      </object>
                    </property>
                    <signal name="realize" handler="init_processing_resolution" />
                    <signal name="notify::selected" handler="on_processing_resolution_changed" />
                  </object>
                </child>

                <child>
                  <object class="AdwComboRow" id="processing_scope_row">
                    <property name="title">Applica elaborazione a</property>
                    <property name="subtitle">Quali file multimediali devono essere migliorati automaticamente</property>
                    <property name="model">
                      <object class="GtkStringList">
                        <items>
                          <item>Schermate e video (Foto + Video)</item>
                          <item>Solo schermate (Foto)</item>
                          <item>Solo registrazioni dello schermo (Video)</item>
                        </items>
                      </object>
                    </property>
                    <signal name="realize" handler="init_processing_scope" />
                    <signal name="notify::selected" handler="on_processing_scope_changed" />
                  </object>
                </child>

                <child>
                  <object class="AdwComboRow" id="processing_algorithm_row">
                    <property name="title">Algoritmo di miglioramento della nitidezza</property>
                    <property name="subtitle">Metodo di calcolo dei pixel durante il ridimensionamento</property>
                    <property name="model">
                      <object class="GtkStringList">
                        <items>
                          <item>Lanczos3 (Alta nitidezza, preserva i dettagli di testo e UI)</item>
                          <item>Spline bicubica (Smussatura cinematografica morbida)</item>
                          <item>Maschera di contrasto + Miglioramento dei contorni</item>
                        </items>
                      </object>
                    </property>
                    <signal name="realize" handler="init_processing_algorithm" />
                    <signal name="notify::selected" handler="on_processing_algorithm_changed" />
                  </object>
                </child>

                <child>
                  <object class="AdwSwitchRow" id="processing_keep_original_row">
                    <property name="title">Conserva copia originale</property>
                    <property name="subtitle">Mantieni una copia di backup nella cartella Originals</property>
                    <property name="active">false</property>
                    <signal name="realize" handler="init_processing_keep_original" />
                    <signal name="notify::active" handler="on_processing_keep_original_changed" />
                  </object>
                </child>
              </object>
            </child>

            
            <child>
              <object class="AdwPreferencesGroup">
                <property name="title">Percorso di salvataggio dei file</property>
                <property name="description">Percorsi delle cartelle di salvataggio di schermate e registrazioni</property>

                <child>
                  <object class="AdwActionRow" id="open_screenshots_folder_row">
                    <property name="title">Cartella schermate</property>
                    <property name="subtitle">~/Immagini/Schermate</property>
                    <child type="suffix">
                      <object class="GtkButton" id="btn_open_screenshots_folder">
                        <property name="label">Apri nel Finder</property>
                        <property name="valign">center</property>
                        <property name="icon-name">folder-open-symbolic</property>
                        <signal name="clicked" handler="on_open_screenshots_folder_clicked" />
                      </object>
                    </child>
                  </object>
                </child>

                <child>
                  <object class="AdwActionRow" id="open_screencasts_folder_row">
                    <property name="title">Cartella registrazioni schermo</property>
                    <property name="subtitle">~/Video/Registrazioni schermo</property>
                    <child type="suffix">
                      <object class="GtkButton" id="btn_open_screencasts_folder">
                        <property name="label">Apri nel Finder</property>
                        <property name="valign">center</property>
                        <property name="icon-name">folder-open-symbolic</property>
                        <signal name="clicked" handler="on_open_screencasts_folder_clicked" />
                      </object>
                    </child>
                  </object>
                </child>

                <child>
                  <object class="AdwActionRow">
                    <property name="title">Ripristina valori predefiniti</property>
                    <property name="subtitle">Ripristina tutte le impostazioni delle schermate ai valori predefiniti di macOS</property>
                    <child type="suffix">
                      <object class="GtkButton" id="btn_reset_screenshot_defaults">
                        <property name="label">Ripristina…</property>
                        <property name="valign">center</property>
                        <style>
                          <class name="destructive-action" />
                        </style>
                        <signal name="clicked" handler="on_reset_screenshot_defaults_clicked" />
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </child>

          </object>
        </property>
      </object>
    </property>
  </object>
</interface>