                        <child type="suffix">
                          <object class="GtkScale" id="widget_blur_scale">
                            <property name="orientation">0</property>
                            <property name="draw-value">true</property>
                            <property name="digits">0</property>
                            <property name="round-digits">0</property>
                            <property name="width-request">200</property>
                            <property name="adjustment">
                              <object class="GtkAdjustment">
                                <property name="lower">0</property>
                                <property name="upper">50</property>
                                <property name="step-increment">1</property>
                                <property name="page-increment">5</property>
                                <property name="value">1</property>
                              </object>
                            </property>
                            <signal name="realize" handler="init_widget_blur" />
                            <signal name="value-changed" handler="on_widget_blur_changed" />
                          </object>
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="AdwActionRow" id="widget_tint_row">
                        <property name="title">Oscuramento dello sfondo</property>
                        <child type="suffix">
                          <object class="GtkScale" id="widget_tint_scale">
                            <property name="orientation">0</property>
                            <property name="draw-value">true</property>
                            <property name="digits">0</property>
                            <property name="round-digits">0</property>
                            <property name="width-request">200</property>
                            <property name="adjustment">
                              <object class="GtkAdjustment">
                                <property name="lower">0</property>
                                <property name="upper">100</property>
                                <property name="step-increment">1</property>
                                <property name="page-increment">5</property>
                                <property name="value">20</property>
                              </object>
                            </property>
                            <signal name="realize" handler="init_widget_tint" />
                            <signal name="value-changed" handler="on_widget_tint_changed" />
                          </object>
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="AdwActionRow" id="widget_shadow_row">
                        <property name="title">Ombra</property>
                        <child type="suffix">
                          <object class="GtkScale" id="widget_shadow_scale">
                            <property name="orientation">0</property>
                            <property name="draw-value">true</property>
                            <property name="digits">0</property>
                            <property name="round-digits">0</property>
                            <property name="width-request">200</property>
                            <property name="adjustment">
                              <object class="GtkAdjustment">
                                <property name="lower">0</property>
                                <property name="upper">100</property>
                                <property name="step-increment">1</property>
                                <property name="page-increment">5</property>
                                <property name="value">30</property>
                              </object>
                            </property>
                            <signal name="realize" handler="init_widget_shadow" />
                            <signal name="value-changed" handler="on_widget_shadow_changed" />
                          </object>
                        </child>
                      </object>
                    </child>
                  </object>
                </child>

                
                <child>
                  <object class="AdwPreferencesGroup">
                    <property name="title">Bootloader</property>
                    <property name="description">Impostazioni di avvio macW1Y Plymouth e registrazione del kernel</property>
                    <child>
                      <object class="AdwSwitchRow" id="boot_verbose_switch">
                        <property name="title">Modalità dettagliata (Verbose)</property>
                        <property name="subtitle">Testo del registro di avvio del terminale dietro il logo macW1Y</property>
                        <signal name="realize" handler="init_boot_verbose" />
                        <signal name="notify::active" handler="on_boot_verbose_changed" />
                      </object>
                    </child>
                    <child>
                      <object class="AdwSwitchRow" id="boot_grub_switch">
                        <property name="title">Menu GRUB</property>
                        <property name="subtitle">Menu grafico di selezione del sistema in stile macW1Y all'avvio</property>
                        <signal name="realize" handler="init_boot_grub" />
                        <signal name="notify::active" handler="on_boot_grub_changed" />
                      </object>
                    </child>
                  </object>
                </child>

                
                <child>
                  <object class="AdwPreferencesGroup">
                    <property name="title">Integrità e diagnostica</property>
                    <property name="description">Controllo dello standard SSOT, protezione delle estensioni GNOME e ripristino automatico</property>
                    <child>
                      <object class="AdwActionRow" id="diag_status_row">
                        <property name="title">Stato del tema macW1Y</property>
                        <property name="subtitle">Tutti i componenti sono conformi allo standard SSOT (OK)</property>
                        <child type="prefix">
                          <object class="GtkImage">
                            <property name="icon-name">emblem-ok-symbolic</property>
                          </object>
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="AdwActionRow">
                        <property name="title">Azioni di manutenzione</property>
                        <property name="subtitle">Verifica lo stato corrente o ripristina lo stile originale</property>
                        <child type="suffix">
                          <object class="GtkButton" id="btn_run_diagnostics">
                            <property name="label">Esegui diagnostica</property>
                            <property name="valign">center</property>
                            <signal name="clicked" handler="on_run_diagnostics_clicked" />
                          </object>
                        </child>
                        <child type="suffix">
                          <object class="GtkButton" id="btn_restore_theme">
                            <property name="label">Ripristina tema</property>
                            <property name="valign">center</property>
                            <style>
                              <class name="suggested-action" />
                            </style>
                            <signal name="clicked" handler="on_restore_theme_clicked" />
                          </object>
                        </child>
                      </object>
                    </child>
                  </object>
                </child>

              </object>
            </property>
          </object>
        </property>
      </object>
</interface>