<?xml version='1.0' encoding='utf-8'?>
<interface>
  <requires lib="gtk" version="4.0" />

  
  <object class="AdwNavigationPage" id="widgets_page">
    <property name="title">Widgets</property>
    <property name="tag">widgets</property>
    <property name="child">
      <object class="AdwNavigationView" id="widgets_nav_view">
        <signal name="popped" handler="on_widgets_nav_view_popped" />
        
        <child>
          <object class="AdwNavigationPage" id="widgets_main_page">
            <property name="title">Widgets</property>
            <property name="tag">widgets_main</property>
            <property name="child">
              <object class="AdwToolbarView">
        <property name="extend-content-to-top-edge">False</property>
        <property name="extend-content-to-bottom-edge">True</property>
        <property name="top-bar-style">flat</property>
        <child type="top">
          <object class="AdwHeaderBar">
            <style>
              <class name="flat" />
            </style>
          </object>
        </child>
        <property name="content">
          <object class="AdwPreferencesPage">

            
            <child>
              <object class="AdwPreferencesGroup">
                <property name="title">Desktop &amp; Placement</property>
                <property name="description">Manage desktop widgets and behavior</property>

                <child>
                  <object class="AdwSwitchRow" id="dw_edit_mode_row">
                    <property name="title">Edit Mode</property>
                    <property name="subtitle">Allow dragging, resizing, and removing widgets on desktop</property>
                    <property name="active">false</property>
                    <signal name="realize" handler="init_dw_edit_mode" />
                    <signal name="notify::active" handler="on_dw_edit_mode_changed" />
                  </object>
                </child>

                <child>
                  <object class="AdwActionRow" id="dw_add_widgets_row">
                    <property name="title">Add widgets to desktop</property>
                    <property name="subtitle">Open widget picker menu (Clock, Weather, Battery, Photos, etc.)</property>
                    <property name="activatable">true</property>
                    <signal name="activated" handler="on_dw_add_widgets_clicked" />
                    <child type="suffix">
                      <object class="GtkButton" id="dw_btn_add_widgets">
                        <property name="valign">center</property>
                        <property name="icon-name">list-add-symbolic</property>
                        <style>
                          <class name="suggested-action" />
                          <class name="circular" />
                          <class name="mac-action-accent-btn" />
                        </style>
                        <signal name="clicked" handler="on_dw_add_widgets_clicked" />
                      </object>
                    </child>
                  </object>
                </child>

                <child>
                  <object class="AdwActionRow" id="dw_arrange_row">
                    <property name="title">Arrange by Grid</property>
                    <property name="subtitle">Automatically align all placed widgets into a common grid</property>
                    <property name="activatable">true</property>
                    <signal name="activated" handler="on_dw_arrange_clicked" />
                    <child type="suffix">
                      <object class="GtkButton" id="dw_btn_arrange">
                        <property name="valign">center</property>
                        <property name="icon-name">view-grid-symbolic</property>
                        <style>
                          <class name="suggested-action" />
                          <class name="circular" />
                          <class name="mac-action-accent-btn" />
                        </style>
                        <signal name="clicked" handler="on_dw_arrange_clicked" />
                      </object>
                    </child>
                  </object>
                </child>

                <child>
                  <object class="AdwActionRow" id="dw_gap_row">
                    <property name="title">Widget Spacing</property>
                    <property name="subtitle">Distance in pixels between widgets and screen edges</property>
                    <child type="suffix">
                      <object class="GtkScale" id="dw_gap_scale">
                        <property name="orientation">0</property>
                        <property name="draw-value">true</property>
                        <property name="digits">0</property>
                        <property name="round-digits">0</property>
                        <property name="width-request">200</property>
                        <property name="adjustment">
                          <object class="GtkAdjustment">
                            <property name="lower">0</property>
                            <property name="upper">50</property>
                            <property name="step-increment">1</property>
                            <property name="page-increment">5</property>
                            <property name="value">15</property>
                          </object>
                        </property>
                        <signal name="realize" handler="init_dw_gap" />
                        <signal name="value-changed" handler="on_dw_gap_changed" />
                      </object>
                    </child>
                  </object>
                </child>

                <child>
                  <object class="AdwSwitchRow" id="dw_panel_icon_row">
                    <property name="title">Top Bar Icon</property>
                    <property name="subtitle">Show quick widget toggle icon in top bar</property>
                    <property name="active">true</property>
                    <signal name="realize" handler="init_dw_panel_icon" />
                    <signal name="notify::active" handler="on_dw_panel_icon_changed" />
                  </object>
                </child>

              </object>
            </child>

            
            <child>
              <object class="AdwPreferencesGroup">
                <property name="title">Styling &amp; Design</property>
                <property name="description">Appearance, corner radius, and opacity of widget cards</property>

                <child>
                  <object class="AdwActionRow" id="dw_border_radius_row">
                    <property name="title">Corner Radius</property>
                    <property name="subtitle">Corner radius of widget cards (px)</property>
                    <child type="suffix">
                      <object class="GtkScale" id="dw_border_radius_scale">
                        <property name="orientation">0</property>
                        <property name="draw-value">true</property>
                        <property name="digits">0</property>
                        <property name="round-digits">0</property>
                        <property name="width-request">200</property>
                        <property name="adjustment">
                          <object class="GtkAdjustment">
                            <property name="lower">0</property>
                            <property name="upper">40</property>
                            <property name="step-increment">1</property>
                            <property name="page-increment">5</property>
                            <property name="value">35</property>
                          </object>
                        </property>
                        <signal name="realize" handler="init_dw_border_radius" />
                        <signal name="value-changed" handler="on_dw_border_radius_changed" />
                      </object>
                    </child>
                  </object>
                </child>

                <child>
                  <object class="AdwActionRow" id="dw_opacity_row">
                    <property name="title">Widget Opacity</property>
                    <property name="subtitle">Widget background opacity level (%)</property>
                    <child type="suffix">
                      <object class="GtkScale" id="dw_opacity_scale">
                        <property name="orientation">0</property>
                        <property name="draw-value">true</property>
                        <property name="digits">0</property>
                        <property name="round-digits">0</property>
                        <property name="width-request">200</property>
                        <property name="adjustment">
                          <object class="GtkAdjustment">
                            <property name="lower">10</property>
                            <property name="upper">100</property>
                            <property name="step-increment">1</property>
                            <property name="page-increment">5</property>
                            <property name="value">85</property>
                          </object>
                        </property>
                        <signal name="realize" handler="init_dw_opacity" />
                        <signal name="value-changed" handler="on_dw_opacity_changed" />
                      </object>
                    </child>
                  </object>
                </child>

                <child>
                  <object class="AdwSwitchRow" id="dw_use_custom_accent_row">
                    <property name="title">Custom accent color</property>
                    <property name="subtitle">Use selected color instead of macW1Y system accent</property>
                    <property name="active">false</property>
                    <signal name="realize" handler="init_dw_use_custom_accent" />
                    <signal name="notify::active" handler="on_dw_use_custom_accent_changed" />
                  </object>
                </child>

              </object>
            </child>

            
            <child>
              <object class="AdwPreferencesGroup">
                <property name="title">Component Behavior</property>
                <property name="description">Parameters for individual information modules</property>

                <child>
                  <object class="AdwSwitchRow" id="dw_clock_seconds_row">
                    <property name="title">Show seconds in clock</property>
                    <property name="subtitle">Seconds indicator for digital and analog clocks</property>
                    <property name="active">false</property>
                    <signal name="realize" handler="init_dw_clock_seconds" />
                    <signal name="notify::active" handler="on_dw_clock_seconds_changed" />
                  </object>
                </child>

                <child>
                  <object class="AdwSwitchRow" id="dw_battery_percent_row">
                    <property name="title">Show battery percentage</property>
                    <property name="subtitle">Charge number value under battery ring</property>
                    <property name="active">true</property>
                    <signal name="realize" handler="init_dw_battery_percent" />
                    <signal name="notify::active" handler="on_dw_battery_percent_changed" />
                  </object>
                </child>

                <child>
                  <object class="AdwSwitchRow" id="dw_music_browsers_row">
                    <property name="title">Music: ignore browsers</property>
                    <property name="subtitle">Do not display Chrome or Firefox audio tabs in player widget</property>
                    <property name="active">true</property>
                    <signal name="realize" handler="init_dw_music_browsers" />
                    <signal name="notify::active" handler="on_dw_music_browsers_changed" />
                  </object>
                </child>

              </object>
            </child>

            
            <child>
              <object class="AdwPreferencesGroup">
                <property name="title">Advanced Configuration</property>
                <property name="description">In-depth configuration for all 19 widget types</property>

                <child>
                  <object class="AdwActionRow" id="dw_advanced_row">
                    <property name="title">Full Widget Configurator</property>
                    <property name="subtitle">Open advanced configuration for all widget types</property>
                    <property name="activatable">true</property>
                    <signal name="activated" handler="on_dw_advanced_clicked" />
                    <child type="suffix">
                      <object class="GtkButton" id="dw_btn_advanced">
                        <property name="valign">center</property>
                        <property name="icon-name">go-next-symbolic</property>
                        <style>
                          <class name="suggested-action" />
                          <class name="circular" />
                          <class name="mac-action-accent-btn" />
                        </style>
                        <signal name="clicked" handler="on_dw_advanced_clicked" />
                      </object>
                    </child>
                  </object>
                </child>

              </object>
            </child>

          </object>
        </property>
      </object>
    </property>
  </object>
</child>

        
        <child>
          <object class="AdwNavigationPage" id="widgets_configurator_page">
    <property name="title">Widget Configurator</property>
    <property name="tag">widgets_configurator</property>
    <property name="child">
      <object class="AdwToolbarView">
        <property name="extend-content-to-top-edge">False</property>
        <property name="extend-content-to-bottom-edge">True</property>
        <property name="top-bar-style">flat</property>
        <child type="top">
          <object class="AdwHeaderBar">
            <style>
              <class name="flat" />
            </style>
          </object>
        </child>
        <property name="content">
          <object class="AdwPreferencesPage">

            
            <child>
              <object class="AdwPreferencesGroup">
                <property name="title">Clocks (Analog, Digital, Binary)</property>
                <property name="description">Time format display and second hands</property>

                <child>
                  <object class="AdwSwitchRow" id="cfg_digitalclock_show_seconds">
                    <property name="title">Digital: show seconds</property>
                    <property name="subtitle">Display seconds in digital clock</property>
                  </object>
                </child>

                <child>
                  <object class="AdwSwitchRow" id="cfg_digitalclock_smooth_seconds">
                    <property name="title">Digital: smooth sweep</property>
                    <property name="subtitle">Smooth second indicator animation</property>
                  </object>
                </child>

                <child>
                  <object class="AdwSwitchRow" id="cfg_clock_smooth_seconds">
                    <property name="title">Analog: smooth second hand</property>
                    <property name="subtitle">Continuous smooth sweep hand without discrete ticks</property>
                  </object>
                </child>

                <child>
                  <object class="AdwSwitchRow" id="cfg_digitalclock_show_ampm">
                    <property name="title">Show AM / PM</property>
                    <property name="subtitle">Display period of day in 12-hour format (AM/PM)</property>
                  </object>
                </child>

                <child>
                  <object class="AdwSwitchRow" id="cfg_binaryclock_use_accent">
                    <property name="title">Binary: system accent color</property>
                    <property name="subtitle">Highlight active bits with macW1Y theme color</property>
                  </object>
                </child>
              </object>
            </child>

            
            <child>
              <object class="AdwPreferencesGroup">
                <property name="title">Calendar &amp; Events</property>
                <property name="description">Schedule and date display options</property>

                <child>
                  <object class="AdwSpinRow" id="cfg_calendar_lookahead_row">
                    <property name="title">Event horizon (days)</property>
                    <property name="subtitle">Number of days to search for upcoming events</property>
                    <property name="adjustment">
                      <object class="GtkAdjustment" id="cfg_calendar_lookahead_adj">
                        <property name="lower">1</property>
                        <property name="upper">30</property>
                        <property name="step-increment">1</property>
                        <property name="page-increment">5</property>
                        <property name="value">14</property>
                      </object>
                    </property>
                  </object>
                </child>

                <child>
                  <object class="AdwSwitchRow" id="cfg_calendar_use_accent">
                    <property name="title">Use accent color</property>
                    <property name="subtitle">Highlight today with system accent</property>
                  </object>
                </child>

                <child>
                  <object class="AdwSwitchRow" id="cfg_calendar_show_page_dots">
                    <property name="title">Calendar page dots</property>
                    <property name="subtitle">Display month scroll indicators</property>
                  </object>
                </child>
              </object>
            </child>

            
            <child>
              <object class="AdwPreferencesGroup">
                <property name="title">Weather</property>
                <property name="description">Weather forecast and current conditions</property>

                <child>
                  <object class="AdwSwitchRow" id="cfg_weather_use_accent">
                    <property name="title">Use accent color</property>
                    <property name="subtitle">Highlight weather icons with theme accent color</property>
                  </object>
                </child>

                <child>
                  <object class="AdwSwitchRow" id="cfg_weather_show_page_dots">
                    <property name="title">Forecast switch page dots</property>
                    <property name="subtitle">Show weather page dots indicator</property>
                  </object>
                </child>
              </object>
            </child>

            
            <child>
              <object class="AdwPreferencesGroup">
                <property name="title">Battery &amp; Power</property>
                <property name="description">Number of devices and charge indicator style</property>

                <child>
                  <object class="AdwSpinRow" id="cfg_battery_slot_count_row">
                    <property name="title">Number of device slots</property>
                    <property name="subtitle">Display batteries for mouse, keyboard, and headphones</property>
                    <property name="adjustment">
                      <object class="GtkAdjustment" id="cfg_battery_slot_count_adj">
                        <property name="lower">1</property>
                        <property name="upper">4</property>
                        <property name="step-increment">1</property>
                        <property name="page-increment">1</property>
                        <property name="value">2</property>
                      </object>
                    </property>
                  </object>
                </child>

                <child>
                  <object class="AdwSwitchRow" id="cfg_battery_show_percent">
                    <property name="title">Show Charge Percentage</property>
                    <property name="subtitle">Percentage number value under ring</property>
                  </object>
                </child>

                <child>
                  <object class="AdwSwitchRow" id="cfg_battery_use_accent">
                    <property name="title">Use accent color</property>
                    <property name="subtitle">Tint charge ring in accent color</property>
                  </object>
                </child>
              </object>
            </child>

            
            <child>
              <object class="AdwPreferencesGroup">
                <property name="title">Music Player</property>
                <property name="description">Control audio playback and media</property>

                <child>
                  <object class="AdwSwitchRow" id="cfg_music_ignore_browsers">
                    <property name="title">Ignore browser audio</property>
                    <property name="subtitle">Do not intercept YouTube or Spotify Web tabs</property>
                  </object>
                </child>

                <child>
                  <object class="AdwEntryRow" id="cfg_music_custom_app_entry">
                    <property name="title">Custom music application</property>
                    <property name="text">spotify</property>
                  </object>
                </child>
              </object>
            </child>

            
            <child>
              <object class="AdwPreferencesGroup">
                <property name="title">System Monitor</property>
                <property name="description">CPU, memory, network, and disk utilization</property>

                <child>
                  <object class="AdwSwitchRow" id="cfg_system_page_indicator_accent">
                    <property name="title">Indicator accent color</property>
                    <property name="subtitle">Apply system color to selected page</property>
                  </object>
                </child>

                <child>
                  <object class="AdwSwitchRow" id="cfg_system_show_page_dashes">
                    <property name="title">Dotted page indicators</property>
                    <property name="subtitle">Dash style instead of dots</property>
                  </object>
                </child>
              </object>
            </child>

            
            <child>
              <object class="AdwPreferencesGroup">
                <property name="title">Photos</property>
                <property name="description">Desktop Photo Frame</property>

                <child>
                  <object class="AdwEntryRow" id="cfg_custom_photo_entry">
                    <property name="title">Path to photo or folder</property>
                    <property name="text" />
                  </object>
                </child>
              </object>
            </child>

            
            <child>
              <object class="AdwPreferencesGroup">
                <property name="title">Pomodoro Timer</property>
                <property name="description">Productivity &amp; Focus intervals</property>

                <child>
                  <object class="AdwSpinRow" id="cfg_pomodoro_work_row">
                    <property name="title">Focus time (minutes)</property>
                    <property name="subtitle">Work interval duration</property>
                    <property name="adjustment">
                      <object class="GtkAdjustment" id="cfg_pomodoro_work_adj">
                        <property name="lower">1</property>
                        <property name="upper">60</property>
                        <property name="step-increment">1</property>
                        <property name="page-increment">5</property>
                        <property name="value">25</property>
                      </object>
                    </property>
                  </object>
                </child>

                <child>
                  <object class="AdwSpinRow" id="cfg_pomodoro_short_break_row">
                    <property name="title">Short break (minutes)</property>
                    <property name="subtitle">Rest duration between sessions</property>
                    <property name="adjustment">
                      <object class="GtkAdjustment" id="cfg_pomodoro_short_break_adj">
                        <property name="lower">1</property>
                        <property name="upper">30</property>
                        <property name="step-increment">1</property>
                        <property name="page-increment">5</property>
                        <property name="value">5</property>
                      </object>
                    </property>
                  </object>
                </child>

                <child>
                  <object class="AdwSpinRow" id="cfg_pomodoro_long_break_row">
                    <property name="title">Long break (minutes)</property>
                    <property name="subtitle">Long break duration</property>
                    <property name="adjustment">
                      <object class="GtkAdjustment" id="cfg_pomodoro_long_break_adj">
                        <property name="lower">1</property>
                        <property name="upper">60</property>
                        <property name="step-increment">1</property>
                        <property name="page-increment">5</property>
                        <property name="value">15</property>
                      </object>
                    </property>
                  </object>
                </child>

                <child>
                  <object class="AdwSpinRow" id="cfg_pomodoro_sessions_row">
                    <property name="title">Sessions until long break</property>
                    <property name="subtitle">Number of work intervals before long break</property>
                    <property name="adjustment">
                      <object class="GtkAdjustment" id="cfg_pomodoro_sessions_adj">
                        <property name="lower">1</property>
                        <property name="upper">10</property>
                        <property name="step-increment">1</property>
                        <property name="page-increment">1</property>
                        <property name="value">4</property>
                      </object>
                    </property>
                  </object>
                </child>
              </object>
            </child>

            
            <child>
              <object class="AdwPreferencesGroup">
                <property name="title">Notes</property>
                <property name="description">Fonts for quick sticky notes on desktop</property>

                <child>
                  <object class="AdwSpinRow" id="cfg_notes_title_size_row">
                    <property name="title">Title font size (px)</property>
                    <property name="adjustment">
                      <object class="GtkAdjustment" id="cfg_notes_title_size_adj">
                        <property name="lower">10</property>
                        <property name="upper">36</property>
                        <property name="step-increment">1</property>
                        <property name="page-increment">2</property>
                        <property name="value">16</property>
                      </object>
                    </property>
                  </object>
                </child>

                <child>
                  <object class="AdwSpinRow" id="cfg_notes_content_size_row">
                    <property name="title">Note body text font size (px)</property>
                    <property name="adjustment">
                      <object class="GtkAdjustment" id="cfg_notes_content_size_adj">
                        <property name="lower">10</property>
                        <property name="upper">28</property>
                        <property name="step-increment">1</property>
                        <property name="page-increment">2</property>
                        <property name="value">13</property>
                      </object>
                    </property>
                  </object>
                </child>
              </object>
            </child>

            
            <child>
              <object class="AdwPreferencesGroup">
                <property name="title">GitHub Widget</property>
                <property name="description">Contributions activity chart and profile</property>

                <child>
                  <object class="AdwEntryRow" id="cfg_github_username_entry">
                    <property name="title">GitHub Username</property>
                    <property name="text" />
                  </object>
                </child>

                <child>
                  <object class="AdwSwitchRow" id="cfg_github_use_green">
                    <property name="title">Signature GitHub green theme</property>
                    <property name="subtitle">Use authentic green colors for commits matrix</property>
                  </object>
                </child>
              </object>
            </child>

            
            <child>
              <object class="AdwPreferencesGroup">
                <property name="title">Folder Launcher</property>
                <property name="description">Quick access to directories</property>

                <child>
                  <object class="AdwEntryRow" id="cfg_folder_file_manager_entry">
                    <property name="title">File Manager</property>
                    <property name="text">nautilus</property>
                  </object>
                </child>

                <child>
                  <object class="AdwSwitchRow" id="cfg_folder_show_names">
                    <property name="title">Show folder labels</property>
                    <property name="subtitle">Display text labels below icons</property>
                  </object>
                </child>
              </object>
            </child>

            
            <child>
              <object class="AdwPreferencesGroup">
                <property name="title">Screen Time</property>
                <property name="description">Activity monitoring and application usage</property>

                <child>
                  <object class="AdwSpinRow" id="cfg_screentime_retention_row">
                    <property name="title">Keep history (days)</property>
                    <property name="subtitle">Number of days to retain activity history</property>
                    <property name="adjustment">
                      <object class="GtkAdjustment" id="cfg_screentime_retention_adj">
                        <property name="lower">1</property>
                        <property name="upper">30</property>
                        <property name="step-increment">1</property>
                        <property name="page-increment">5</property>
                        <property name="value">7</property>
                      </object>
                    </property>
                  </object>
                </child>

                <child>
                  <object class="AdwSwitchRow" id="cfg_screentime_show_nav_buttons">
                    <property name="title">Day navigation buttons</property>
                    <property name="subtitle">Previous days navigation arrows</property>
                  </object>
                </child>
              </object>
            </child>

            
            <child>
              <object class="AdwPreferencesGroup">
                <property name="title">Lava Lamp</property>
                <property name="description">Decorative physics widget</property>

                <child>
                  <object class="AdwSwitchRow" id="cfg_lava_use_accent">
                    <property name="title">Use accent color</property>
                    <property name="subtitle">Tint lava droplets in system accent color</property>
                  </object>
                </child>
              </object>
            </child>

          </object>
        </property>
      </object>
    </property>
  </object>
</child>

        
        <child>
          <object class="AdwNavigationPage" id="widgets_picker_page">
            <property name="title">Add Widgets</property>
            <property name="tag">widgets_picker</property>
            <signal name="shown" handler="on_widgets_picker_shown" />
            <signal name="hidden" handler="on_widgets_picker_hidden" />
            <property name="child">
              <object class="AdwToolbarView">
                <property name="extend-content-to-top-edge">False</property>
                <property name="extend-content-to-bottom-edge">True</property>
                <property name="top-bar-style">flat</property>
                <child type="top">
                  <object class="AdwHeaderBar">
                    <style>
                      <class name="flat" />
                    </style>
                  </object>
                </child>
                <property name="content">
                  <object class="AdwToastOverlay" id="widgets_picker_toast_overlay">
                    <property name="child">
                      <object class="AdwPreferencesPage">

                        
                        <child>
                          <object class="AdwPreferencesGroup">
                            <property name="title">Clocks &amp; Time</property>
                            <property name="description">Analog, digital, and binary clocks, timers, and stopwatches</property>

                            <child>
