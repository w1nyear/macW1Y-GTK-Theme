                                    <property name="tooltip-text">Ajouter la galerie de photos au bureau</property>
                                    <style>
                                      <class name="suggested-action" />
                                      <class name="mac-action-accent-btn" />
                                      <class name="pill" />
                                    </style>
                                    <signal name="clicked" handler="on_dw_add_photos" />
                                  </object>
                                </child>
                              </object>
                            </child>

                            <child>
                              <object class="AdwActionRow" id="picker_row_lava">
                                <property name="title">Lampe à lave</property>
                                <property name="subtitle">Widget physique décoratif avec gouttes animées</property>
                                <property name="activatable">true</property>
                                <signal name="activated" handler="on_dw_add_lava" />
                                <child type="prefix">
                                  <object class="GtkImage">
                                    <property name="icon-name">color-select-symbolic</property>
                                    <property name="pixel-size">24</property>
                                  </object>
                                </child>
                                <child type="suffix">
                                  <object class="GtkButton" id="btn_picker_add_lava">
                                    <property name="label">Ajouter</property>
                                    <property name="icon-name">list-add-symbolic</property>
                                    <property name="valign">center</property>
                                    <property name="tooltip-text">Ajouter une lampe à lave au bureau</property>
                                    <style>
                                      <class name="suggested-action" />
                                      <class name="mac-action-accent-btn" />
                                      <class name="pill" />
                                    </style>
                                    <signal name="clicked" handler="on_dw_add_lava" />
                                  </object>
                                </child>
                              </object>
                            </child>

                          </object>
                        </child>

                      </object>
                    </property>
                  </object>
                </property>
              </object>
            </property>
          </object>
        </child>
      </object>
    </property>
  </object>
</interface>