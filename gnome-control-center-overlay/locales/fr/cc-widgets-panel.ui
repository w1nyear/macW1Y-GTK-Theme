<?xml version='1.0' encoding='utf-8'?>
<interface>
  <requires lib="gtk" version="4.0" />

  
  <object class="AdwNavigationPage" id="widgets_page">
    <property name="title">Widgets</property>
    <property name="tag">widgets</property>
    <property name="child">
      <object class="AdwNavigationView" id="widgets_nav_view">
        <signal name="popped" handler="on_widgets_nav_view_popped" />
        
        <child>
          <object class="AdwNavigationPage" id="widgets_main_page">
            <property name="title">Widgets</property>
            <property name="tag">widgets_main</property>
            <property name="child">
              <object class="AdwToolbarView">
        <property name="extend-content-to-top-edge">False</property>
        <property name="extend-content-to-bottom-edge">True</property>
        <property name="top-bar-style">flat</property>
        <child type="top">
          <object class="AdwHeaderBar">
            <style>
              <class name="flat" />
            </style>
          </object>
        </child>
        <property name="content">
          <object class="AdwPreferencesPage">

            
            <child>
              <object class="AdwPreferencesGroup">
                <property name="title">Bureau et disposition</property>
                <property name="description">Gérer les widgets du bureau et leur comportement</property>

                <child>
                  <object class="AdwSwitchRow" id="dw_edit_mode_row">
                    <property name="title">Mode édition</property>
                    <property name="subtitle">Autoriser le glissement, le redimensionnement et la suppression des widgets</property>
                    <property name="active">false</property>
                    <signal name="realize" handler="init_dw_edit_mode" />
                    <signal name="notify::active" handler="on_dw_edit_mode_changed" />
                  </object>
                </child>

                <child>
                  <object class="AdwActionRow" id="dw_add_widgets_row">
                    <property name="title">Ajouter des widgets au bureau</property>
                    <property name="subtitle">Ouvrir le sélecteur de widgets (Horloge, Météo, Batterie, Photos, etc.)</property>
                    <property name="activatable">true</property>
                    <signal name="activated" handler="on_dw_add_widgets_clicked" />
                    <child type="suffix">
                      <object class="GtkButton" id="dw_btn_add_widgets">
                        <property name="valign">center</property>
                        <property name="icon-name">list-add-symbolic</property>
                        <style>
                          <class name="suggested-action" />
                          <class name="circular" />
                          <class name="mac-action-accent-btn" />
                        </style>
                        <signal name="clicked" handler="on_dw_add_widgets_clicked" />
                      </object>
                    </child>
                  </object>
                </child>

                <child>
                  <object class="AdwActionRow" id="dw_arrange_row">
                    <property name="title">Aligner sur la grille</property>
                    <property name="subtitle">Aligner automatiquement tous les widgets sur une grille commune</property>
                    <property name="activatable">true</property>
                    <signal name="activated" handler="on_dw_arrange_clicked" />
                    <child type="suffix">
                      <object class="GtkButton" id="dw_btn_arrange">
                        <property name="valign">center</property>
                        <property name="icon-name">view-grid-symbolic</property>
                        <style>
                          <class name="suggested-action" />
                          <class name="circular" />
                          <class name="mac-action-accent-btn" />
                        </style>
                        <signal name="clicked" handler="on_dw_arrange_clicked" />
                      </object>
                    </child>
                  </object>
                </child>

                <child>
                  <object class="AdwActionRow" id="dw_gap_row">
                    <property name="title">Espacement des widgets</property>
                    <property name="subtitle">Distance en pixels entre les widgets et les bords de l'écran</property>
                    <child type="suffix">
                      <object class="GtkScale" id="dw_gap_scale">
                        <property name="orientation">0</property>
                        <property name="draw-value">true</property>
                        <property name="digits">0</property>
                        <property name="round-digits">0</property>
                        <property name="width-request">200</property>
                        <property name="adjustment">
                          <object class="GtkAdjustment">
                            <property name="lower">0</property>
                            <property name="upper">50</property>
                            <property name="step-increment">1</property>
                            <property name="page-increment">5</property>
                            <property name="value">15</property>
                          </object>
                        </property>
                        <signal name="realize" handler="init_dw_gap" />
                        <signal name="value-changed" handler="on_dw_gap_changed" />
                      </object>
                    </child>
                  </object>
                </child>

                <child>
                  <object class="AdwSwitchRow" id="dw_panel_icon_row">
                    <property name="title">Icône de la barre supérieure</property>
                    <property name="subtitle">Afficher l'icône de bascule rapide des widgets dans la barre supérieure</property>
                    <property name="active">true</property>
                    <signal name="realize" handler="init_dw_panel_icon" />
                    <signal name="notify::active" handler="on_dw_panel_icon_changed" />
                  </object>
                </child>

              </object>
            </child>

            
            <child>
              <object class="AdwPreferencesGroup">
                <property name="title">Style et apparence</property>
                <property name="description">Apparence, arrondi des angles et opacité des cartes de widgets</property>

                <child>
                  <object class="AdwActionRow" id="dw_border_radius_row">
                    <property name="title">Rayon des coins</property>
                    <property name="subtitle">Rayon d'arrondi des cartes de widgets (px)</property>
                    <child type="suffix">
                      <object class="GtkScale" id="dw_border_radius_scale">
                        <property name="orientation">0</property>
                        <property name="draw-value">true</property>
                        <property name="digits">0</property>
                        <property name="round-digits">0</property>
                        <property name="width-request">200</property>
                        <property name="adjustment">
                          <object class="GtkAdjustment">
                            <property name="lower">0</property>
                            <property name="upper">40</property>
                            <property name="step-increment">1</property>
                            <property name="page-increment">5</property>
                            <property name="value">35</property>
                          </object>
                        </property>
                        <signal name="realize" handler="init_dw_border_radius" />
                        <signal name="value-changed" handler="on_dw_border_radius_changed" />
                      </object>
                    </child>
                  </object>
                </child>

                <child>
                  <object class="AdwActionRow" id="dw_opacity_row">
                    <property name="title">Transparence des widgets</property>
                    <property name="subtitle">Niveau d'opacité du fond des widgets (%)</property>
                    <child type="suffix">
                      <object class="GtkScale" id="dw_opacity_scale">
                        <property name="orientation">0</property>
                        <property name="draw-value">true</property>
                        <property name="digits">0</property>
                        <property name="round-digits">0</property>
                        <property name="width-request">200</property>
                        <property name="adjustment">
                          <object class="GtkAdjustment">
                            <property name="lower">10</property>
                            <property name="upper">100</property>
                            <property name="step-increment">1</property>
                            <property name="page-increment">5</property>
                            <property name="value">85</property>
                          </object>
                        </property>
                        <signal name="realize" handler="init_dw_opacity" />
                        <signal name="value-changed" handler="on_dw_opacity_changed" />
                      </object>
                    </child>
                  </object>
                </child>

                <child>
                  <object class="AdwSwitchRow" id="dw_use_custom_accent_row">
                    <property name="title">Couleur d'accent personnalisée</property>
                    <property name="subtitle">Utiliser la couleur sélectionnée plutôt que l'accent système</property>
                    <property name="active">false</property>
                    <signal name="realize" handler="init_dw_use_custom_accent" />
                    <signal name="notify::active" handler="on_dw_use_custom_accent_changed" />
                  </object>
                </child>

              </object>
            </child>

            
            <child>
              <object class="AdwPreferencesGroup">
                <property name="title">Comportement des composants</property>
                <property name="description">Paramètres des modules d'information individuels</property>

                <child>
                  <object class="AdwSwitchRow" id="dw_clock_seconds_row">
                    <property name="title">Afficher les secondes dans l'horloge</property>
                    <property name="subtitle">Indicateur des secondes pour les horloges numériques et analogiques</property>
                    <property name="active">false</property>
                    <signal name="realize" handler="init_dw_clock_seconds" />
                    <signal name="notify::active" handler="on_dw_clock_seconds_changed" />
                  </object>
                </child>

                <child>
                  <object class="AdwSwitchRow" id="dw_battery_percent_row">
                    <property name="title">Afficher le pourcentage de la batterie</property>
                    <property name="subtitle">Valeur numérique de charge sous l'anneau de batterie</property>
                    <property name="active">true</property>
                    <signal name="realize" handler="init_dw_battery_percent" />
                    <signal name="notify::active" handler="on_dw_battery_percent_changed" />
                  </object>
                </child>

                <child>
                  <object class="AdwSwitchRow" id="dw_music_browsers_row">
                    <property name="title">Musique : ignorer les navigateurs</property>
                    <property name="subtitle">Ne pas afficher les onglets audio de Chrome ou Firefox dans le widget du lecteur</property>
                    <property name="active">true</property>
                    <signal name="realize" handler="init_dw_music_browsers" />
                    <signal name="notify::active" handler="on_dw_music_browsers_changed" />
                  </object>
                </child>

              </object>
            </child>

            
            <child>
              <object class="AdwPreferencesGroup">
                <property name="title">Configuration avancée</property>
                <property name="description">Configuration approfondie des 19 types de widgets</property>

                <child>
                  <object class="AdwActionRow" id="dw_advanced_row">
                    <property name="title">Configurateur complet des widgets</property>
                    <property name="subtitle">Ouvrir la configuration avancée de tous les types de widgets</property>
                    <property name="activatable">true</property>
                    <signal name="activated" handler="on_dw_advanced_clicked" />
                    <child type="suffix">
                      <object class="GtkButton" id="dw_btn_advanced">
                        <property name="valign">center</property>
                        <property name="icon-name">go-next-symbolic</property>
                        <style>
                          <class name="suggested-action" />
                          <class name="circular" />
                          <class name="mac-action-accent-btn" />
                        </style>
                        <signal name="clicked" handler="on_dw_advanced_clicked" />
                      </object>
                    </child>
                  </object>
                </child>

              </object>
            </child>

          </object>
        </property>
      </object>
    </property>
  </object>
</child>

        
        <child>
          <object class="AdwNavigationPage" id="widgets_configurator_page">
    <property name="title">Configurateur de widgets</property>
    <property name="tag">widgets_configurator</property>
    <property name="child">
      <object class="AdwToolbarView">
        <property name="extend-content-to-top-edge">False</property>
        <property name="extend-content-to-bottom-edge">True</property>
        <property name="top-bar-style">flat</property>
        <child type="top">
          <object class="AdwHeaderBar">
            <style>
              <class name="flat" />
            </style>
          </object>
        </child>
        <property name="content">
          <object class="AdwPreferencesPage">

            
            <child>
              <object class="AdwPreferencesGroup">
                <property name="title">Horloges (Analogique, Numérique, Binaire)</property>
                <property name="description">Format d'affichage de l'heure et trotteuses</property>

                <child>
                  <object class="AdwSwitchRow" id="cfg_digitalclock_show_seconds">
                    <property name="title">Numérique : afficher les secondes</property>
                    <property name="subtitle">Afficher les secondes dans l'horloge numérique</property>
                  </object>
                </child>

                <child>
                  <object class="AdwSwitchRow" id="cfg_digitalclock_smooth_seconds">
                    <property name="title">Numérique : balayage fluide</property>
                    <property name="subtitle">Animation fluide de l'indicateur des secondes</property>
                  </object>
                </child>

                <child>
                  <object class="AdwSwitchRow" id="cfg_clock_smooth_seconds">
                    <property name="title">Analogique : trotteuse fluide</property>
                    <property name="subtitle">Mouvement fluide continu de l'aiguille sans à-coups</property>
                  </object>
                </child>

                <child>
                  <object class="AdwSwitchRow" id="cfg_digitalclock_show_ampm">
                    <property name="title">Afficher AM / PM</property>
                    <property name="subtitle">Afficher la période du jour au format 12 heures (AM/PM)</property>
                  </object>
                </child>

                <child>
                  <object class="AdwSwitchRow" id="cfg_binaryclock_use_accent">
                    <property name="title">Binaire : couleur d'accentuation système</property>
                    <property name="subtitle">Mettre en valeur les bits actifs avec la couleur macW1Y</property>
                  </object>
                </child>
              </object>
            </child>

            
            <child>
              <object class="AdwPreferencesGroup">
                <property name="title">Calendrier et événements</property>
                <property name="description">Options d'affichage du calendrier et de la date</property>

                <child>
                  <object class="AdwSpinRow" id="cfg_calendar_lookahead_row">
                    <property name="title">Horizon des événements (jours)</property>
                    <property name="subtitle">Nombre de jours pour rechercher les événements à venir</property>
                    <property name="adjustment">
                      <object class="GtkAdjustment" id="cfg_calendar_lookahead_adj">
                        <property name="lower">1</property>
                        <property name="upper">30</property>
                        <property name="step-increment">1</property>
                        <property name="page-increment">5</property>
                        <property name="value">14</property>
                      </object>
                    </property>
                  </object>
                </child>

                <child>
                  <object class="AdwSwitchRow" id="cfg_calendar_use_accent">
                    <property name="title">Utiliser la couleur d'accentuation</property>
                    <property name="subtitle">Mettre en évidence le jour actuel avec l'accent système</property>
                  </object>
                </child>

                <child>
                  <object class="AdwSwitchRow" id="cfg_calendar_show_page_dots">
                    <property name="title">Points de pages du calendrier</property>
                    <property name="subtitle">Afficher les indicateurs de défilement des mois</property>
                  </object>
                </child>
              </object>
            </child>

            
            <child>
              <object class="AdwPreferencesGroup">
                <property name="title">Météo</property>
                <property name="description">Prévisions météo et conditions actuelles</property>

                <child>
                  <object class="AdwSwitchRow" id="cfg_weather_use_accent">
                    <property name="title">Utiliser la couleur d'accentuation</property>
                    <property name="subtitle">Colorer les icônes météo avec l'accent du thème</property>
                  </object>
                </child>

                <child>
                  <object class="AdwSwitchRow" id="cfg_weather_show_page_dots">
                    <property name="title">Points de changement de prévisions</property>
                    <property name="subtitle">Afficher l'indicateur de pages météo</property>
                  </object>
                </child>
              </object>
            </child>

            
            <child>
              <object class="AdwPreferencesGroup">
                <property name="title">Batterie et alimentation</property>
                <property name="description">Nombre d'appareils et style d'indicateur de charge</property>

                <child>
                  <object class="AdwSpinRow" id="cfg_battery_slot_count_row">
                    <property name="title">Nombre d'emplacements d'appareils</property>
                    <property name="subtitle">Afficher le niveau de batterie de la souris, du clavier et du casque</property>
                    <property name="adjustment">
                      <object class="GtkAdjustment" id="cfg_battery_slot_count_adj">
                        <property name="lower">1</property>
                        <property name="upper">4</property>
                        <property name="step-increment">1</property>
                        <property name="page-increment">1</property>
                        <property name="value">2</property>
                      </object>
                    </property>
                  </object>
                </child>

                <child>
                  <object class="AdwSwitchRow" id="cfg_battery_show_percent">
                    <property name="title">Afficher le pourcentage de charge</property>
                    <property name="subtitle">Valeur numérique en pourcentage sous l'anneau</property>
                  </object>
                </child>

                <child>
                  <object class="AdwSwitchRow" id="cfg_battery_use_accent">
                    <property name="title">Utiliser la couleur d'accentuation</property>
                    <property name="subtitle">Colorer l'anneau de charge avec la couleur d'accent</property>
                  </object>
                </child>
              </object>
            </child>

            
            <child>
              <object class="AdwPreferencesGroup">
                <property name="title">Lecteur de musique</property>
                <property name="description">Contrôler la lecture audio et les médias</property>

                <child>
                  <object class="AdwSwitchRow" id="cfg_music_ignore_browsers">
                    <property name="title">Ignorer l'audio des navigateurs</property>
                    <property name="subtitle">Ne pas intercepter les onglets YouTube ou Spotify Web</property>
                  </object>
                </child>

                <child>
                  <object class="AdwEntryRow" id="cfg_music_custom_app_entry">
                    <property name="title">Application musicale personnalisée</property>
                    <property name="text">spotify</property>
                  </object>
                </child>
              </object>
            </child>

            
            <child>
              <object class="AdwPreferencesGroup">
                <property name="title">Moniteur système</property>
                <property name="description">Utilisation du processeur, de la mémoire, du réseau et des disques</property>

                <child>
                  <object class="AdwSwitchRow" id="cfg_system_page_indicator_accent">
                    <property name="title">Couleur d'accentuation de l'indicateur</property>
                    <property name="subtitle">Appliquer la couleur système à la page sélectionnée</property>
                  </object>
                </child>

                <child>
                  <object class="AdwSwitchRow" id="cfg_system_show_page_dashes">
                    <property name="title">Indicateurs de page en pointillés</property>
                    <property name="subtitle">Style tirets au lieu de points</property>
                  </object>
                </child>
              </object>
            </child>

            
            <child>
              <object class="AdwPreferencesGroup">
                <property name="title">Photos</property>
                <property name="description">Cadre photo sur le bureau</property>

                <child>
                  <object class="AdwEntryRow" id="cfg_custom_photo_entry">
                    <property name="title">Chemin vers la photo ou le dossier</property>
                    <property name="text" />
                  </object>
                </child>
              </object>
            </child>

            
            <child>
              <object class="AdwPreferencesGroup">
                <property name="title">Minuteur Pomodoro</property>
                <property name="description">Intervalles de productivité et de concentration</property>

                <child>
                  <object class="AdwSpinRow" id="cfg_pomodoro_work_row">
                    <property name="title">Temps de concentration (minutes)</property>
                    <property name="subtitle">Durée de l'intervalle de travail</property>
                    <property name="adjustment">
                      <object class="GtkAdjustment" id="cfg_pomodoro_work_adj">
                        <property name="lower">1</property>
                        <property name="upper">60</property>
                        <property name="step-increment">1</property>
                        <property name="page-increment">5</property>
                        <property name="value">25</property>
                      </object>
                    </property>
                  </object>
                </child>

                <child>
                  <object class="AdwSpinRow" id="cfg_pomodoro_short_break_row">
                    <property name="title">Courte pause (minutes)</property>
                    <property name="subtitle">Durée de repos entre les sessions</property>
                    <property name="adjustment">
                      <object class="GtkAdjustment" id="cfg_pomodoro_short_break_adj">
                        <property name="lower">1</property>
                        <property name="upper">30</property>
                        <property name="step-increment">1</property>
                        <property name="page-increment">5</property>
                        <property name="value">5</property>
                      </object>
                    </property>
                  </object>
                </child>

                <child>
                  <object class="AdwSpinRow" id="cfg_pomodoro_long_break_row">
                    <property name="title">Longue pause (minutes)</property>
                    <property name="subtitle">Durée de la longue pause</property>
                    <property name="adjustment">
                      <object class="GtkAdjustment" id="cfg_pomodoro_long_break_adj">
                        <property name="lower">1</property>
                        <property name="upper">60</property>
                        <property name="step-increment">1</property>
                        <property name="page-increment">5</property>
                        <property name="value">15</property>
                      </object>
                    </property>
                  </object>
                </child>

                <child>
                  <object class="AdwSpinRow" id="cfg_pomodoro_sessions_row">
                    <property name="title">Sessions jusqu'à la longue pause</property>
                    <property name="subtitle">Nombre d'intervalles de travail avant une longue pause</property>
                    <property name="adjustment">
                      <object class="GtkAdjustment" id="cfg_pomodoro_sessions_adj">
                        <property name="lower">1</property>
                        <property name="upper">10</property>
                        <property name="step-increment">1</property>
                        <property name="page-increment">1</property>
                        <property name="value">4</property>
                      </object>
                    </property>
                  </object>
                </child>
              </object>
            </child>

            
            <child>
              <object class="AdwPreferencesGroup">
                <property name="title">Notes</property>
                <property name="description">Polices pour les notes adhésives du bureau</property>

                <child>
                  <object class="AdwSpinRow" id="cfg_notes_title_size_row">
                    <property name="title">Taille de la police du titre (px)</property>
                    <property name="adjustment">
                      <object class="GtkAdjustment" id="cfg_notes_title_size_adj">
                        <property name="lower">10</property>
                        <property name="upper">36</property>
                        <property name="step-increment">1</property>
                        <property name="page-increment">2</property>
                        <property name="value">16</property>
                      </object>
                    </property>
                  </object>
                </child>

                <child>
                  <object class="AdwSpinRow" id="cfg_notes_content_size_row">
                    <property name="title">Taille de la police du texte de la note (px)</property>
                    <property name="adjustment">
                      <object class="GtkAdjustment" id="cfg_notes_content_size_adj">
                        <property name="lower">10</property>
                        <property name="upper">28</property>
                        <property name="step-increment">1</property>
                        <property name="page-increment">2</property>
                        <property name="value">13</property>
                      </object>
                    </property>
                  </object>
                </child>
              </object>
            </child>

            
            <child>
              <object class="AdwPreferencesGroup">
                <property name="title">Widget GitHub</property>
                <property name="description">Graphique d'activité des contributions et profil</property>

                <child>
                  <object class="AdwEntryRow" id="cfg_github_username_entry">
                    <property name="title">Nom d'utilisateur GitHub</property>
                    <property name="text" />
                  </object>
                </child>

                <child>
                  <object class="AdwSwitchRow" id="cfg_github_use_green">
                    <property name="title">Style vert emblématique de GitHub</property>
                    <property name="subtitle">Utiliser les couleurs vertes authentiques pour la matrice des commits</property>
                  </object>
                </child>
              </object>
            </child>

            
            <child>
              <object class="AdwPreferencesGroup">
                <property name="title">Lanceur de dossiers</property>
                <property name="description">Accès rapide aux dossiers</property>

                <child>
                  <object class="AdwEntryRow" id="cfg_folder_file_manager_entry">
                    <property name="title">Gestionnaire de fichiers</property>
                    <property name="text">nautilus</property>
                  </object>
                </child>

                <child>
                  <object class="AdwSwitchRow" id="cfg_folder_show_names">
                    <property name="title">Afficher les étiquettes de dossiers</property>
                    <property name="subtitle">Afficher les étiquettes textuelles sous les icônes</property>
                  </object>
                </child>
              </object>
            </child>

            
            <child>
              <object class="AdwPreferencesGroup">
                <property name="title">Temps d'écran</property>
                <property name="description">Surveillance de l'activité et de l'utilisation des applications</property>

                <child>
                  <object class="AdwSpinRow" id="cfg_screentime_retention_row">
                    <property name="title">Conserver l'historique (jours)</property>
                    <property name="subtitle">Nombre de jours de conservation de l'historique d'activité</property>
                    <property name="adjustment">
                      <object class="GtkAdjustment" id="cfg_screentime_retention_adj">
                        <property name="lower">1</property>
                        <property name="upper">30</property>
                        <property name="step-increment">1</property>
                        <property name="page-increment">5</property>
                        <property name="value">7</property>
                      </object>
                    </property>
                  </object>
                </child>

                <child>
