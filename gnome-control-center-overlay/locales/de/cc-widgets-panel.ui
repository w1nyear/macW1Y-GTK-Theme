<?xml version='1.0' encoding='utf-8'?>
<interface>
  <requires lib="gtk" version="4.0" />

  
  <object class="AdwNavigationPage" id="widgets_page">
    <property name="title">Widgets</property>
    <property name="tag">widgets</property>
    <property name="child">
      <object class="AdwNavigationView" id="widgets_nav_view">
        <signal name="popped" handler="on_widgets_nav_view_popped" />
        
        <child>
          <object class="AdwNavigationPage" id="widgets_main_page">
            <property name="title">Widgets</property>
            <property name="tag">widgets_main</property>
            <property name="child">
              <object class="AdwToolbarView">
        <property name="extend-content-to-top-edge">False</property>
        <property name="extend-content-to-bottom-edge">True</property>
        <property name="top-bar-style">flat</property>
        <child type="top">
          <object class="AdwHeaderBar">
            <style>
              <class name="flat" />
            </style>
          </object>
        </child>
        <property name="content">
          <object class="AdwPreferencesPage">

            
            <child>
              <object class="AdwPreferencesGroup">
                <property name="title">Schreibtisch &amp; Platzierung</property>
                <property name="description">Desktop-Widgets und deren Verhalten verwalten</property>

                <child>
                  <object class="AdwSwitchRow" id="dw_edit_mode_row">
                    <property name="title">Bearbeitungsmodus</property>
                    <property name="subtitle">Verschieben, Ändern der Größe und Entfernen von Widgets erlauben</property>
                    <property name="active">false</property>
                    <signal name="realize" handler="init_dw_edit_mode" />
                    <signal name="notify::active" handler="on_dw_edit_mode_changed" />
                  </object>
                </child>

                <child>
                  <object class="AdwActionRow" id="dw_add_widgets_row">
                    <property name="title">Widgets zum Schreibtisch hinzufügen</property>
                    <property name="subtitle">Widget-Auswahlmenü öffnen (Uhr, Wetter, Batterie, Fotos usw.)</property>
                    <property name="activatable">true</property>
                    <signal name="activated" handler="on_dw_add_widgets_clicked" />
                    <child type="suffix">
                      <object class="GtkButton" id="dw_btn_add_widgets">
                        <property name="valign">center</property>
                        <property name="icon-name">list-add-symbolic</property>
                        <style>
                          <class name="suggested-action" />
                          <class name="circular" />
                          <class name="mac-action-accent-btn" />
                        </style>
                        <signal name="clicked" handler="on_dw_add_widgets_clicked" />
                      </object>
                    </child>
                  </object>
                </child>

                <child>
                  <object class="AdwActionRow" id="dw_arrange_row">
                    <property name="title">Am Raster ausrichten</property>
                    <property name="subtitle">Alle platzierten Widgets automatisch an einem Raster ausrichten</property>
                    <property name="activatable">true</property>
                    <signal name="activated" handler="on_dw_arrange_clicked" />
                    <child type="suffix">
                      <object class="GtkButton" id="dw_btn_arrange">
                        <property name="valign">center</property>
                        <property name="icon-name">view-grid-symbolic</property>
                        <style>
                          <class name="suggested-action" />
                          <class name="circular" />
                          <class name="mac-action-accent-btn" />
                        </style>
                        <signal name="clicked" handler="on_dw_arrange_clicked" />
                      </object>
                    </child>
                  </object>
                </child>

                <child>
                  <object class="AdwActionRow" id="dw_gap_row">
                    <property name="title">Widget-Abstand</property>
                    <property name="subtitle">Abstand in Pixeln zwischen Widgets und Bildschirmrändern</property>
                    <child type="suffix">
                      <object class="GtkScale" id="dw_gap_scale">
                        <property name="orientation">0</property>
                        <property name="draw-value">true</property>
                        <property name="digits">0</property>
                        <property name="round-digits">0</property>
                        <property name="width-request">200</property>
                        <property name="adjustment">
                          <object class="GtkAdjustment">
                            <property name="lower">0</property>
                            <property name="upper">50</property>
                            <property name="step-increment">1</property>
                            <property name="page-increment">5</property>
                            <property name="value">15</property>
                          </object>
                        </property>
                        <signal name="realize" handler="init_dw_gap" />
                        <signal name="value-changed" handler="on_dw_gap_changed" />
                      </object>
                    </child>
                  </object>
                </child>

                <child>
                  <object class="AdwSwitchRow" id="dw_panel_icon_row">
                    <property name="title">Symbol in der oberen Leiste</property>
                    <property name="subtitle">Schnellumschaltsymbol für Widgets in der oberen Leiste anzeigen</property>
                    <property name="active">true</property>
                    <signal name="realize" handler="init_dw_panel_icon" />
                    <signal name="notify::active" handler="on_dw_panel_icon_changed" />
                  </object>
                </child>

              </object>
            </child>

            
            <child>
              <object class="AdwPreferencesGroup">
                <property name="title">Design &amp; Gestaltung</property>
                <property name="description">Erscheinungsbild, Eckenabrundung und Transparenz der Widget-Karten</property>

                <child>
                  <object class="AdwActionRow" id="dw_border_radius_row">
                    <property name="title">Eckenradius</property>
                    <property name="subtitle">Eckenabrundungsradius der Widget-Karten (px)</property>
                    <child type="suffix">
                      <object class="GtkScale" id="dw_border_radius_scale">
                        <property name="orientation">0</property>
                        <property name="draw-value">true</property>
                        <property name="digits">0</property>
                        <property name="round-digits">0</property>
                        <property name="width-request">200</property>
                        <property name="adjustment">
                          <object class="GtkAdjustment">
                            <property name="lower">0</property>
                            <property name="upper">40</property>
                            <property name="step-increment">1</property>
                            <property name="page-increment">5</property>
                            <property name="value">35</property>
                          </object>
                        </property>
                        <signal name="realize" handler="init_dw_border_radius" />
                        <signal name="value-changed" handler="on_dw_border_radius_changed" />
                      </object>
                    </child>
                  </object>
                </child>

                <child>
                  <object class="AdwActionRow" id="dw_opacity_row">
                    <property name="title">Widget-Transparenz</property>
                    <property name="subtitle">Deckkraft des Widget-Hintergrunds (%)</property>
                    <child type="suffix">
                      <object class="GtkScale" id="dw_opacity_scale">
                        <property name="orientation">0</property>
                        <property name="draw-value">true</property>
                        <property name="digits">0</property>
                        <property name="round-digits">0</property>
                        <property name="width-request">200</property>
                        <property name="adjustment">
                          <object class="GtkAdjustment">
                            <property name="lower">10</property>
                            <property name="upper">100</property>
                            <property name="step-increment">1</property>
                            <property name="page-increment">5</property>
                            <property name="value">85</property>
                          </object>
                        </property>
                        <signal name="realize" handler="init_dw_opacity" />
                        <signal name="value-changed" handler="on_dw_opacity_changed" />
                      </object>
                    </child>
                  </object>
                </child>

                <child>
                  <object class="AdwSwitchRow" id="dw_use_custom_accent_row">
                    <property name="title">Eigene Akzentfarbe</property>
                    <property name="subtitle">Gewählte Farbe statt des macW1Y-Systemakzents verwenden</property>
                    <property name="active">false</property>
                    <signal name="realize" handler="init_dw_use_custom_accent" />
                    <signal name="notify::active" handler="on_dw_use_custom_accent_changed" />
                  </object>
                </child>

              </object>
            </child>

            
            <child>
              <object class="AdwPreferencesGroup">
                <property name="title">Komponentenverhalten</property>
                <property name="description">Parameter einzelner Informationsmodule</property>

                <child>
                  <object class="AdwSwitchRow" id="dw_clock_seconds_row">
                    <property name="title">Sekunden in der Uhr anzeigen</property>
                    <property name="subtitle">Sekundenanzeige für Digital- und Analoguhren</property>
                    <property name="active">false</property>
                    <signal name="realize" handler="init_dw_clock_seconds" />
                    <signal name="notify::active" handler="on_dw_clock_seconds_changed" />
                  </object>
                </child>

                <child>
                  <object class="AdwSwitchRow" id="dw_battery_percent_row">
                    <property name="title">Batterieladestand in Prozent anzeigen</property>
                    <property name="subtitle">Numerischer Ladewert unter dem Batteriering</property>
                    <property name="active">true</property>
                    <signal name="realize" handler="init_dw_battery_percent" />
                    <signal name="notify::active" handler="on_dw_battery_percent_changed" />
                  </object>
                </child>

                <child>
                  <object class="AdwSwitchRow" id="dw_music_browsers_row">
                    <property name="title">Musik: Browser ignorieren</property>
                    <property name="subtitle">Audio-Tabs aus Chrome oder Firefox nicht im Player-Widget anzeigen</property>
                    <property name="active">true</property>
                    <signal name="realize" handler="init_dw_music_browsers" />
                    <signal name="notify::active" handler="on_dw_music_browsers_changed" />
                  </object>
                </child>

              </object>
            </child>

            
            <child>
              <object class="AdwPreferencesGroup">
                <property name="title">Erweiterte Konfiguration</property>
                <property name="description">Detaillierte Konfiguration aller 19 Widget-Typen</property>

                <child>
                  <object class="AdwActionRow" id="dw_advanced_row">
                    <property name="title">Vollständiger Widget-Konfigurator</property>
                    <property name="subtitle">Erweiterte Einstellungen aller Widget-Typen öffnen</property>
                    <property name="activatable">true</property>
                    <signal name="activated" handler="on_dw_advanced_clicked" />
                    <child type="suffix">
                      <object class="GtkButton" id="dw_btn_advanced">
                        <property name="valign">center</property>
                        <property name="icon-name">go-next-symbolic</property>
                        <style>
                          <class name="suggested-action" />
                          <class name="circular" />
                          <class name="mac-action-accent-btn" />
                        </style>
                        <signal name="clicked" handler="on_dw_advanced_clicked" />
                      </object>
                    </child>
                  </object>
                </child>

              </object>
            </child>

          </object>
        </property>
      </object>
    </property>
  </object>
</child>

        
        <child>
          <object class="AdwNavigationPage" id="widgets_configurator_page">
    <property name="title">Widget-Konfigurator</property>
    <property name="tag">widgets_configurator</property>
    <property name="child">
      <object class="AdwToolbarView">
        <property name="extend-content-to-top-edge">False</property>
        <property name="extend-content-to-bottom-edge">True</property>
        <property name="top-bar-style">flat</property>
        <child type="top">
          <object class="AdwHeaderBar">
            <style>
              <class name="flat" />
            </style>
          </object>
        </child>
        <property name="content">
          <object class="AdwPreferencesPage">

            
            <child>
              <object class="AdwPreferencesGroup">
                <property name="title">Uhren (Analog, Digital, Binär)</property>
                <property name="description">Zeitanzeigeformat und Sekundenzeiger</property>

                <child>
                  <object class="AdwSwitchRow" id="cfg_digitalclock_show_seconds">
                    <property name="title">Digital: Sekunden anzeigen</property>
                    <property name="subtitle">Sekunden in der Digitaluhr anzeigen</property>
                  </object>
                </child>

                <child>
                  <object class="AdwSwitchRow" id="cfg_digitalclock_smooth_seconds">
                    <property name="title">Digital: fließender Übergang</property>
                    <property name="subtitle">Fließende Animation der Sekundenanzeige</property>
                  </object>
                </child>

                <child>
                  <object class="AdwSwitchRow" id="cfg_clock_smooth_seconds">
                    <property name="title">Analog: fließender Sekundenzeiger</property>
                    <property name="subtitle">Kontinuierlich fließender Zeigerlauf ohne Ticken</property>
                  </object>
                </child>

                <child>
                  <object class="AdwSwitchRow" id="cfg_digitalclock_show_ampm">
                    <property name="title">AM / PM anzeigen</property>
                    <property name="subtitle">Tageszeit im 12-Stunden-Format anzeigen (AM/PM)</property>
                  </object>
                </child>

                <child>
                  <object class="AdwSwitchRow" id="cfg_binaryclock_use_accent">
                    <property name="title">Binär: Systemakzentfarbe</property>
                    <property name="subtitle">Aktive Bits in der macW1Y-Designfarbe hervorheben</property>
                  </object>
                </child>
              </object>
            </child>

            
            <child>
              <object class="AdwPreferencesGroup">
                <property name="title">Kalender &amp; Ereignisse</property>
                <property name="description">Optionen für Zeitplan- und Datumsanzeige</property>

                <child>
                  <object class="AdwSpinRow" id="cfg_calendar_lookahead_row">
                    <property name="title">Ereignishorizont (Tage)</property>
                    <property name="subtitle">Anzahl der Tage zur Suche nach bevorstehenden Ereignissen</property>
                    <property name="adjustment">
                      <object class="GtkAdjustment" id="cfg_calendar_lookahead_adj">
                        <property name="lower">1</property>
                        <property name="upper">30</property>
                        <property name="step-increment">1</property>
                        <property name="page-increment">5</property>
                        <property name="value">14</property>
                      </object>
                    </property>
                  </object>
                </child>

                <child>
                  <object class="AdwSwitchRow" id="cfg_calendar_use_accent">
                    <property name="title">Akzentfarbe verwenden</property>
                    <property name="subtitle">Heutigen Tag mit Systemakzent hervorheben</property>
                  </object>
                </child>

                <child>
                  <object class="AdwSwitchRow" id="cfg_calendar_show_page_dots">
                    <property name="title">Kalenderseiten-Punkte</property>
                    <property name="subtitle">Monats-Scroll-Indikatoren anzeigen</property>
                  </object>
                </child>
              </object>
            </child>

            
            <child>
              <object class="AdwPreferencesGroup">
                <property name="title">Wetter</property>
                <property name="description">Wettervorhersage und aktuelle Bedingungen</property>

                <child>
                  <object class="AdwSwitchRow" id="cfg_weather_use_accent">
                    <property name="title">Akzentfarbe verwenden</property>
                    <property name="subtitle">Wettersymbole mit der Designakzentfarbe hervorheben</property>
                  </object>
                </child>

                <child>
                  <object class="AdwSwitchRow" id="cfg_weather_show_page_dots">
                    <property name="title">Umschaltpunkte für Vorhersagen</property>
                    <property name="subtitle">Wetterseiten-Punkteanzeige anzeigen</property>
                  </object>
                </child>
              </object>
            </child>

            
            <child>
              <object class="AdwPreferencesGroup">
                <property name="title">Batterie &amp; Energie</property>
                <property name="description">Anzahl der Geräte und Stil der Ladeanzeige</property>

                <child>
                  <object class="AdwSpinRow" id="cfg_battery_slot_count_row">
                    <property name="title">Anzahl der Geräteslots</property>
                    <property name="subtitle">Batteriestand für Maus, Tastatur und Kopfhörer anzeigen</property>
                    <property name="adjustment">
                      <object class="GtkAdjustment" id="cfg_battery_slot_count_adj">
                        <property name="lower">1</property>
                        <property name="upper">4</property>
                        <property name="step-increment">1</property>
                        <property name="page-increment">1</property>
                        <property name="value">2</property>
                      </object>
                    </property>
                  </object>
                </child>

                <child>
                  <object class="AdwSwitchRow" id="cfg_battery_show_percent">
                    <property name="title">Ladestand in Prozent anzeigen</property>
                    <property name="subtitle">Prozentwert unter dem Ring</property>
                  </object>
                </child>

                <child>
                  <object class="AdwSwitchRow" id="cfg_battery_use_accent">
                    <property name="title">Akzentfarbe verwenden</property>
                    <property name="subtitle">Ladering in der Akzentfarbe färben</property>
                  </object>
                </child>
              </object>
            </child>

            
            <child>
              <object class="AdwPreferencesGroup">
                <property name="title">Musikplayer</property>
                <property name="description">Audiowiedergabe und Medien steuern</property>

                <child>
                  <object class="AdwSwitchRow" id="cfg_music_ignore_browsers">
                    <property name="title">Browser-Audio ignorieren</property>
                    <property name="subtitle">YouTube- oder Spotify-Web-Tabs nicht abfangen</property>
                  </object>
                </child>

                <child>
                  <object class="AdwEntryRow" id="cfg_music_custom_app_entry">
                    <property name="title">Eigene Musik-App</property>
                    <property name="text">spotify</property>
                  </object>
                </child>
              </object>
            </child>

            
            <child>
              <object class="AdwPreferencesGroup">
                <property name="title">Systemmonitor</property>
                <property name="description">Auslastung von CPU, Arbeitsspeicher, Netzwerk und Datenträgern</property>

                <child>
                  <object class="AdwSwitchRow" id="cfg_system_page_indicator_accent">
                    <property name="title">Akzentfarbe der Anzeige</property>
                    <property name="subtitle">Systemfarbe auf die ausgewählte Seite anwenden</property>
                  </object>
                </child>

                <child>
                  <object class="AdwSwitchRow" id="cfg_system_show_page_dashes">
                    <property name="title">Gepunktete Seitenindikatoren</property>
                    <property name="subtitle">Strichstil statt Punkte</property>
                  </object>
                </child>
              </object>
            </child>

            
            <child>
              <object class="AdwPreferencesGroup">
                <property name="title">Fotos</property>
                <property name="description">Bilderrahmen auf dem Schreibtisch</property>

                <child>
                  <object class="AdwEntryRow" id="cfg_custom_photo_entry">
                    <property name="title">Pfad zum Foto oder Ordner</property>
                    <property name="text" />
                  </object>
                </child>
              </object>
            </child>

            
            <child>
              <object class="AdwPreferencesGroup">
                <property name="title">Pomodoro-Timer</property>
                <property name="description">Produktivitäts- und Fokusintervalle</property>

                <child>
                  <object class="AdwSpinRow" id="cfg_pomodoro_work_row">
                    <property name="title">Fokuszeit (Minuten)</property>
                    <property name="subtitle">Dauer des Arbeitsintervalls</property>
                    <property name="adjustment">
                      <object class="GtkAdjustment" id="cfg_pomodoro_work_adj">
                        <property name="lower">1</property>
                        <property name="upper">60</property>
                        <property name="step-increment">1</property>
                        <property name="page-increment">5</property>
                        <property name="value">25</property>
                      </object>
                    </property>
                  </object>
                </child>

                <child>
                  <object class="AdwSpinRow" id="cfg_pomodoro_short_break_row">
                    <property name="title">Kurze Pause (Minuten)</property>
                    <property name="subtitle">Erholungsdauer zwischen den Sitzungen</property>
                    <property name="adjustment">
                      <object class="GtkAdjustment" id="cfg_pomodoro_short_break_adj">
                        <property name="lower">1</property>
                        <property name="upper">30</property>
                        <property name="step-increment">1</property>
                        <property name="page-increment">5</property>
                        <property name="value">5</property>
                      </object>
                    </property>
                  </object>
                </child>

                <child>
                  <object class="AdwSpinRow" id="cfg_pomodoro_long_break_row">
                    <property name="title">Lange Pause (Minuten)</property>
                    <property name="subtitle">Dauer der langen Pause</property>
                    <property name="adjustment">
                      <object class="GtkAdjustment" id="cfg_pomodoro_long_break_adj">
                        <property name="lower">1</property>
                        <property name="upper">60</property>
                        <property name="step-increment">1</property>
                        <property name="page-increment">5</property>
                        <property name="value">15</property>
                      </object>
                    </property>
                  </object>
                </child>

                <child>
                  <object class="AdwSpinRow" id="cfg_pomodoro_sessions_row">
                    <property name="title">Sitzungen bis zur langen Pause</property>
                    <property name="subtitle">Anzahl der Arbeitsintervalle vor einer langen Pause</property>
                    <property name="adjustment">
                      <object class="GtkAdjustment" id="cfg_pomodoro_sessions_adj">
                        <property name="lower">1</property>
                        <property name="upper">10</property>
                        <property name="step-increment">1</property>
                        <property name="page-increment">1</property>
                        <property name="value">4</property>
                      </object>
                    </property>
                  </object>
                </child>
              </object>
            </child>

            
            <child>
              <object class="AdwPreferencesGroup">
                <property name="title">Notizen</property>
                <property name="description">Schriftarten für Notizen auf dem Schreibtisch</property>

                <child>
                  <object class="AdwSpinRow" id="cfg_notes_title_size_row">
                    <property name="title">Schriftgröße des Titels (px)</property>
                    <property name="adjustment">
                      <object class="GtkAdjustment" id="cfg_notes_title_size_adj">
                        <property name="lower">10</property>
                        <property name="upper">36</property>
                        <property name="step-increment">1</property>
                        <property name="page-increment">2</property>
                        <property name="value">16</property>
                      </object>
                    </property>
                  </object>
                </child>

                <child>
                  <object class="AdwSpinRow" id="cfg_notes_content_size_row">
                    <property name="title">Schriftgröße des Notizentextes (px)</property>
                    <property name="adjustment">
                      <object class="GtkAdjustment" id="cfg_notes_content_size_adj">
                        <property name="lower">10</property>
                        <property name="upper">28</property>
                        <property name="step-increment">1</property>
                        <property name="page-increment">2</property>
                        <property name="value">13</property>
                      </object>
                    </property>
                  </object>
                </child>
              </object>
            </child>

            
            <child>
              <object class="AdwPreferencesGroup">
                <property name="title">GitHub-Widget</property>
                <property name="description">Beitragsaktivitätsdiagramm und Profil</property>

                <child>
                  <object class="AdwEntryRow" id="cfg_github_username_entry">
                    <property name="title">GitHub-Benutzername</property>
                    <property name="text" />
                  </object>
                </child>

                <child>
                  <object class="AdwSwitchRow" id="cfg_github_use_green">
                    <property name="title">Charakteristisches GitHub-Grün-Design</property>
                    <property name="subtitle">Authentische grüne Farben für die Commit-Matrix verwenden</property>
                  </object>
                </child>
              </object>
            </child>

            
            <child>
              <object class="AdwPreferencesGroup">
                <property name="title">Ordner-Starter</property>
                <property name="description">Schnellzugriff auf Verzeichnisse</property>

                <child>
                  <object class="AdwEntryRow" id="cfg_folder_file_manager_entry">
                    <property name="title">Dateimanager</property>
                    <property name="text">nautilus</property>
                  </object>
                </child>

                <child>
                  <object class="AdwSwitchRow" id="cfg_folder_show_names">
                    <property name="title">Ordnerbeschriftungen anzeigen</property>
                    <property name="subtitle">Textbeschriftungen unter den Symbolen anzeigen</property>
                  </object>
                </child>
              </object>
            </child>

            
            <child>
              <object class="AdwPreferencesGroup">
                <property name="title">Bildschirmzeit</property>
                <property name="description">Aktivitätsüberwachung und App-Nutzung</property>

                <child>
                  <object class="AdwSpinRow" id="cfg_screentime_retention_row">
                    <property name="title">Verlauf aufbewahren (Tage)</property>
                    <property name="subtitle">Anzahl der Tage zur Speicherung des Aktivitätsverlaufs</property>
                    <property name="adjustment">
                      <object class="GtkAdjustment" id="cfg_screentime_retention_adj">
                        <property name="lower">1</property>
                        <property name="upper">30</property>
                        <property name="step-increment">1</property>
                        <property name="page-increment">5</property>
                        <property name="value">7</property>
                      </object>
                    </property>
                  </object>
                </child>

                <child>
