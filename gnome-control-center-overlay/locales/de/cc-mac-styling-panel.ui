                <child>
                  <object class="AdwPreferencesGroup">
                    <property name="title">Integrität &amp; Diagnose</property>
                    <property name="description">SSOT-Standardkontrolle, GNOME-Erweiterungsschutz und automatische Reparatur</property>
                    <child>
                      <object class="AdwActionRow" id="diag_status_row">
                        <property name="title">macW1Y Design-Status</property>
                        <property name="subtitle">Alle Komponenten entsprechen dem SSOT-Standard (OK)</property>
                        <child type="prefix">
                          <object class="GtkImage">
                            <property name="icon-name">emblem-ok-symbolic</property>
                          </object>
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="AdwActionRow">
                        <property name="title">Wartungsaktionen</property>
                        <property name="subtitle">Aktuellen Status überprüfen oder Design wiederherstellen</property>
                        <child type="suffix">
                          <object class="GtkButton" id="btn_run_diagnostics">
                            <property name="label">Diagnose ausführen</property>
                            <property name="valign">center</property>
                            <signal name="clicked" handler="on_run_diagnostics_clicked" />
                          </object>
                        </child>
                        <child type="suffix">
                          <object class="GtkButton" id="btn_restore_theme">
                            <property name="label">Design wiederherstellen</property>
                            <property name="valign">center</property>
                            <style>
                              <class name="suggested-action" />
                            </style>
                            <signal name="clicked" handler="on_restore_theme_clicked" />
                          </object>
                        </child>
                      </object>
                    </child>
                  </object>
                </child>

              </object>
            </property>
          </object>
        </property>
      </object>
</interface>