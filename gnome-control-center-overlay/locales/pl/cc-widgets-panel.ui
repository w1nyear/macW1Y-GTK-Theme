                                </child>
                                <child type="suffix">
                                  <object class="GtkButton" id="btn_picker_add_music">
                                    <property name="label">Dodaj</property>
                                    <property name="icon-name">list-add-symbolic</property>
                                    <property name="valign">center</property>
                                    <property name="tooltip-text">Dodaj odtwarzacz muzyki na biurko</property>
                                    <style>
                                      <class name="suggested-action" />
                                      <class name="mac-action-accent-btn" />
                                      <class name="pill" />
                                    </style>
                                    <signal name="clicked" handler="on_dw_add_music" />
                                  </object>
                                </child>
                              </object>
                            </child>

                            <child>
                              <object class="AdwActionRow" id="picker_row_photos">
                                <property name="title">Galeria zdjęć</property>
                                <property name="subtitle">Pokaz ulubionych zdjęć na biurku</property>
                                <property name="activatable">true</property>
                                <signal name="activated" handler="on_dw_add_photos" />
                                <child type="prefix">
                                  <object class="GtkImage">
                                    <property name="icon-name">image-x-generic-symbolic</property>
                                    <property name="pixel-size">24</property>
                                  </object>
                                </child>
                                <child type="suffix">
                                  <object class="GtkButton" id="btn_picker_add_photos">
                                    <property name="label">Dodaj</property>
                                    <property name="icon-name">list-add-symbolic</property>
                                    <property name="valign">center</property>
                                    <property name="tooltip-text">Dodaj galerię zdjęć na biurko</property>
                                    <style>
                                      <class name="suggested-action" />
                                      <class name="mac-action-accent-btn" />
                                      <class name="pill" />
                                    </style>
                                    <signal name="clicked" handler="on_dw_add_photos" />
                                  </object>
                                </child>
                              </object>
                            </child>

                            <child>
                              <object class="AdwActionRow" id="picker_row_lava">
                                <property name="title">Lampa lawowa</property>
                                <property name="subtitle">Dekoracyjny widżet fizyczny z animowanymi kroplami</property>
                                <property name="activatable">true</property>
                                <signal name="activated" handler="on_dw_add_lava" />
                                <child type="prefix">
                                  <object class="GtkImage">
                                    <property name="icon-name">color-select-symbolic</property>
                                    <property name="pixel-size">24</property>
                                  </object>
                                </child>
                                <child type="suffix">
                                  <object class="GtkButton" id="btn_picker_add_lava">
                                    <property name="label">Dodaj</property>
                                    <property name="icon-name">list-add-symbolic</property>
                                    <property name="valign">center</property>
                                    <property name="tooltip-text">Dodaj lampę lawową na biurko</property>
                                    <style>
                                      <class name="suggested-action" />
                                      <class name="mac-action-accent-btn" />
                                      <class name="pill" />
                                    </style>
                                    <signal name="clicked" handler="on_dw_add_lava" />
                                  </object>
                                </child>
                              </object>
                            </child>

                          </object>
                        </child>

                      </object>
                    </property>
                  </object>
                </property>
              </object>
            </property>
          </object>
        </child>
      </object>
    </property>
  </object>
</interface>