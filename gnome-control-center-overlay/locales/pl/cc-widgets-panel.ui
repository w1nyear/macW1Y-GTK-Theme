<?xml version='1.0' encoding='utf-8'?>
<interface>
  <requires lib="gtk" version="4.0" />

  
  <object class="AdwNavigationPage" id="widgets_page">
    <property name="title">Widżety</property>
    <property name="tag">widgets</property>
    <property name="child">
      <object class="AdwNavigationView" id="widgets_nav_view">
        <signal name="popped" handler="on_widgets_nav_view_popped" />
        
        <child>
          <object class="AdwNavigationPage" id="widgets_main_page">
            <property name="title">Widżety</property>
            <property name="tag">widgets_main</property>
            <property name="child">
              <object class="AdwToolbarView">
        <property name="extend-content-to-top-edge">False</property>
        <property name="extend-content-to-bottom-edge">True</property>
        <property name="top-bar-style">flat</property>
        <child type="top">
          <object class="AdwHeaderBar">
            <style>
              <class name="flat" />
            </style>
          </object>
        </child>
        <property name="content">
          <object class="AdwPreferencesPage">

            
            <child>
              <object class="AdwPreferencesGroup">
                <property name="title">Biurko i rozmieszczenie</property>
                <property name="description">Zarządzanie widżetami na biurku i ich zachowaniem</property>

                <child>
                  <object class="AdwSwitchRow" id="dw_edit_mode_row">
                    <property name="title">Tryb edycji</property>
                    <property name="subtitle">Zezwalaj na przeciąganie, zmianę rozmiaru i usuwanie widżetów na biurku</property>
                    <property name="active">false</property>
                    <signal name="realize" handler="init_dw_edit_mode" />
                    <signal name="notify::active" handler="on_dw_edit_mode_changed" />
                  </object>
                </child>

                <child>
                  <object class="AdwActionRow" id="dw_add_widgets_row">
                    <property name="title">Dodaj widżety na biurko</property>
                    <property name="subtitle">Otwórz menu wyboru widżetów (Zegar, Pogoda, Bateria, Zdjęcia itp.)</property>
                    <property name="activatable">true</property>
                    <signal name="activated" handler="on_dw_add_widgets_clicked" />
                    <child type="suffix">
                      <object class="GtkButton" id="dw_btn_add_widgets">
                        <property name="valign">center</property>
                        <property name="icon-name">list-add-symbolic</property>
                        <style>
                          <class name="suggested-action" />
                          <class name="circular" />
                          <class name="mac-action-accent-btn" />
                        </style>
                        <signal name="clicked" handler="on_dw_add_widgets_clicked" />
                      </object>
                    </child>
                  </object>
                </child>

                <child>
                  <object class="AdwActionRow" id="dw_arrange_row">
                    <property name="title">Wyrównaj do siatki</property>
                    <property name="subtitle">Automatycznie wyrównaj wszystkie widżety do wspólnej siatki</property>
                    <property name="activatable">true</property>
                    <signal name="activated" handler="on_dw_arrange_clicked" />
                    <child type="suffix">
                      <object class="GtkButton" id="dw_btn_arrange">
                        <property name="valign">center</property>
                        <property name="icon-name">view-grid-symbolic</property>
                        <style>
                          <class name="suggested-action" />
                          <class name="circular" />
                          <class name="mac-action-accent-btn" />
                        </style>
                        <signal name="clicked" handler="on_dw_arrange_clicked" />
                      </object>
                    </child>
                  </object>
                </child>

                <child>
                  <object class="AdwActionRow" id="dw_gap_row">
                    <property name="title">Odstęp między widżetami</property>
                    <property name="subtitle">Odległość w pikselach między widżetami a krawędzią ekranu</property>
                    <child type="suffix">
                      <object class="GtkScale" id="dw_gap_scale">
                        <property name="orientation">0</property>
                        <property name="draw-value">true</property>
                        <property name="digits">0</property>
                        <property name="round-digits">0</property>
                        <property name="width-request">200</property>
                        <property name="adjustment">
                          <object class="GtkAdjustment">
                            <property name="lower">0</property>
                            <property name="upper">50</property>
                            <property name="step-increment">1</property>
                            <property name="page-increment">5</property>
                            <property name="value">15</property>
                          </object>
                        </property>
                        <signal name="realize" handler="init_dw_gap" />
                        <signal name="value-changed" handler="on_dw_gap_changed" />
                      </object>
                    </child>
                  </object>
                </child>

                <child>
                  <object class="AdwSwitchRow" id="dw_panel_icon_row">
                    <property name="title">Ikona na górnym pasku</property>
                    <property name="subtitle">Pokaż ikonę szybkiego przełączania widżetów na górnym pasku</property>
                    <property name="active">true</property>
                    <signal name="realize" handler="init_dw_panel_icon" />
                    <signal name="notify::active" handler="on_dw_panel_icon_changed" />
                  </object>
                </child>

              </object>
            </child>

            
            <child>
              <object class="AdwPreferencesGroup">
                <property name="title">Stylizacja i wygląd</property>
                <property name="description">Wygląd, zaokrąglenie rogów i przezroczystość kart widżetów</property>

                <child>
                  <object class="AdwActionRow" id="dw_border_radius_row">
                    <property name="title">Promień zaokrąglenia rogów</property>
                    <property name="subtitle">Promień zaokrąglenia kart widżetów (px)</property>
                    <child type="suffix">
                      <object class="GtkScale" id="dw_border_radius_scale">
                        <property name="orientation">0</property>
                        <property name="draw-value">true</property>
                        <property name="digits">0</property>
                        <property name="round-digits">0</property>
                        <property name="width-request">200</property>
                        <property name="adjustment">
                          <object class="GtkAdjustment">
                            <property name="lower">0</property>
                            <property name="upper">40</property>
                            <property name="step-increment">1</property>
                            <property name="page-increment">5</property>
                            <property name="value">35</property>
                          </object>
                        </property>
                        <signal name="realize" handler="init_dw_border_radius" />
                        <signal name="value-changed" handler="on_dw_border_radius_changed" />
                      </object>
                    </child>
                  </object>
                </child>

                <child>
                  <object class="AdwActionRow" id="dw_opacity_row">
                    <property name="title">Przezroczystość widżetów</property>
                    <property name="subtitle">Poziom przezroczystości tła widżetów (%)</property>
                    <child type="suffix">
                      <object class="GtkScale" id="dw_opacity_scale">
                        <property name="orientation">0</property>
                        <property name="draw-value">true</property>
                        <property name="digits">0</property>
                        <property name="round-digits">0</property>
                        <property name="width-request">200</property>
                        <property name="adjustment">
                          <object class="GtkAdjustment">
                            <property name="lower">10</property>
                            <property name="upper">100</property>
                            <property name="step-increment">1</property>
                            <property name="page-increment">5</property>
                            <property name="value">85</property>
                          </object>
                        </property>
                        <signal name="realize" handler="init_dw_opacity" />
                        <signal name="value-changed" handler="on_dw_opacity_changed" />
                      </object>
                    </child>
                  </object>
                </child>

                <child>
                  <object class="AdwSwitchRow" id="dw_use_custom_accent_row">
                    <property name="title">Własny kolor akcentu</property>
                    <property name="subtitle">Użyj wybranego koloru zamiast systemowego akcentu macW1Y</property>
                    <property name="active">false</property>
                    <signal name="realize" handler="init_dw_use_custom_accent" />
                    <signal name="notify::active" handler="on_dw_use_custom_accent_changed" />
                  </object>
                </child>

              </object>
            </child>

            
            <child>
              <object class="AdwPreferencesGroup">
                <property name="title">Zachowanie składników</property>
                <property name="description">Parametry poszczególnych modułów informacyjnych</property>

                <child>
                  <object class="AdwSwitchRow" id="dw_clock_seconds_row">
                    <property name="title">Pokaż sekundy w zegarze</property>
                    <property name="subtitle">Wskaźnik sekund dla zegarów cyfrowych i analogowych</property>
                    <property name="active">false</property>
                    <signal name="realize" handler="init_dw_clock_seconds" />
                    <signal name="notify::active" handler="on_dw_clock_seconds_changed" />
                  </object>
                </child>

                <child>
                  <object class="AdwSwitchRow" id="dw_battery_percent_row">
                    <property name="title">Pokaż procent naładowania baterii</property>
                    <property name="subtitle">Liczbowa wartość naładowania pod pierścieniem baterii</property>
                    <property name="active">true</property>
                    <signal name="realize" handler="init_dw_battery_percent" />
                    <signal name="notify::active" handler="on_dw_battery_percent_changed" />
                  </object>
                </child>

                <child>
                  <object class="AdwSwitchRow" id="dw_music_browsers_row">
                    <property name="title">Muzyka: ignoruj przeglądarki</property>
                    <property name="subtitle">Nie pokazuj kart audio z Chrome lub Firefox w widżecie odtwarzacza</property>
                    <property name="active">true</property>
                    <signal name="realize" handler="init_dw_music_browsers" />
                    <signal name="notify::active" handler="on_dw_music_browsers_changed" />
                  </object>
                </child>

              </object>
            </child>

            
            <child>
              <object class="AdwPreferencesGroup">
                <property name="title">Zaawansowana konfiguracja</property>
                <property name="description">Szczegółowa konfiguracja wszystkich 19 typów widżetów</property>

                <child>
                  <object class="AdwActionRow" id="dw_advanced_row">
                    <property name="title">Pełny konfigurator widżetów</property>
                    <property name="subtitle">Otwórz zaawansowane ustawienia wszystkich typów widżetów</property>
                    <property name="activatable">true</property>
                    <signal name="activated" handler="on_dw_advanced_clicked" />
                    <child type="suffix">
                      <object class="GtkButton" id="dw_btn_advanced">
                        <property name="valign">center</property>
                        <property name="icon-name">go-next-symbolic</property>
                        <style>
                          <class name="suggested-action" />
                          <class name="circular" />
                          <class name="mac-action-accent-btn" />
                        </style>
                        <signal name="clicked" handler="on_dw_advanced_clicked" />
                      </object>
                    </child>
                  </object>
                </child>

              </object>
            </child>

          </object>
        </property>
      </object>
    </property>
  </object>
</child>

        
        <child>
          <object class="AdwNavigationPage" id="widgets_configurator_page">
    <property name="title">Konfigurator widżetów</property>
    <property name="tag">widgets_configurator</property>
    <property name="child">
      <object class="AdwToolbarView">
        <property name="extend-content-to-top-edge">False</property>
        <property name="extend-content-to-bottom-edge">True</property>
        <property name="top-bar-style">flat</property>
        <child type="top">
          <object class="AdwHeaderBar">
            <style>
              <class name="flat" />
            </style>
          </object>
        </child>
        <property name="content">
          <object class="AdwPreferencesPage">

            
            <child>
              <object class="AdwPreferencesGroup">
                <property name="title">Zegary (Analogowy, Cyfrowy, Binarny)</property>
                <property name="description">Format wyświetlania czasu i wskazówki sekund</property>

                <child>
                  <object class="AdwSwitchRow" id="cfg_digitalclock_show_seconds">
                    <property name="title">Cyfrowy: pokazuj sekundy</property>
                    <property name="subtitle">Pokaż sekundy w zegarze cyfrowym</property>
                  </object>
                </child>

                <child>
                  <object class="AdwSwitchRow" id="cfg_digitalclock_smooth_seconds">
                    <property name="title">Cyfrowy: płynny ruch</property>
                    <property name="subtitle">Płynna animacja wskaźnika sekund</property>
                  </object>
                </child>

                <child>
                  <object class="AdwSwitchRow" id="cfg_clock_smooth_seconds">
                    <property name="title">Analogowy: płynna wskazówka sekundowa</property>
                    <property name="subtitle">Płynny ruch wskazówki bez skoków</property>
                  </object>
                </child>

                <child>
                  <object class="AdwSwitchRow" id="cfg_digitalclock_show_ampm">
                    <property name="title">Pokaż AM / PM</property>
                    <property name="subtitle">Pokazuj porę dnia w formacie 12-godzinnym (AM/PM)</property>
                  </object>
                </child>

                <child>
                  <object class="AdwSwitchRow" id="cfg_binaryclock_use_accent">
                    <property name="title">Binarny: systemowy kolor akcentu</property>
                    <property name="subtitle">Podświetlaj aktywne bity kolorem motywu macW1Y</property>
                  </object>
                </child>
              </object>
            </child>

            
            <child>
              <object class="AdwPreferencesGroup">
                <property name="title">Kalendarz i wydarzenia</property>
                <property name="description">Opcje wyświetlania harmonogramu i daty</property>

                <child>
                  <object class="AdwSpinRow" id="cfg_calendar_lookahead_row">
                    <property name="title">Zakres wydarzeń (dni)</property>
                    <property name="subtitle">Liczba dni wyszukiwania nadchodzących wydarzeń</property>
                    <property name="adjustment">
                      <object class="GtkAdjustment" id="cfg_calendar_lookahead_adj">
                        <property name="lower">1</property>
                        <property name="upper">30</property>
                        <property name="step-increment">1</property>
                        <property name="page-increment">5</property>
                        <property name="value">14</property>
                      </object>
                    </property>
                  </object>
                </child>

                <child>
                  <object class="AdwSwitchRow" id="cfg_calendar_use_accent">
                    <property name="title">Użyj koloru akcentu</property>
                    <property name="subtitle">Wyróżnij dzisiejszy dzień akcentem systemowym</property>
                  </object>
                </child>

                <child>
                  <object class="AdwSwitchRow" id="cfg_calendar_show_page_dots">
                    <property name="title">Kropki stron kalendarza</property>
                    <property name="subtitle">Pokaż wskaźniki przewijania miesięcy</property>
                  </object>
                </child>
              </object>
            </child>

            
            <child>
              <object class="AdwPreferencesGroup">
                <property name="title">Pogoda</property>
                <property name="description">Prognoza pogody i bieżące warunki</property>

                <child>
                  <object class="AdwSwitchRow" id="cfg_weather_use_accent">
                    <property name="title">Użyj koloru akcentu</property>
                    <property name="subtitle">Podświetlaj ikony pogody kolorem akcentu motywu</property>
                  </object>
                </child>

                <child>
                  <object class="AdwSwitchRow" id="cfg_weather_show_page_dots">
                    <property name="title">Kropki przełączania prognozy</property>
                    <property name="subtitle">Pokaż kropki stron pogody</property>
                  </object>
                </child>
              </object>
            </child>

            
            <child>
              <object class="AdwPreferencesGroup">
                <property name="title">Bateria i zasilanie</property>
                <property name="description">Liczba urządzeń i styl wskaźnika naładowania</property>

                <child>
                  <object class="AdwSpinRow" id="cfg_battery_slot_count_row">
                    <property name="title">Liczba slotów urządzeń</property>
                    <property name="subtitle">Pokazuj poziom baterii myszy, klawiatury i słuchawek</property>
                    <property name="adjustment">
                      <object class="GtkAdjustment" id="cfg_battery_slot_count_adj">
                        <property name="lower">1</property>
                        <property name="upper">4</property>
                        <property name="step-increment">1</property>
                        <property name="page-increment">1</property>
                        <property name="value">2</property>
                      </object>
                    </property>
                  </object>
                </child>

                <child>
                  <object class="AdwSwitchRow" id="cfg_battery_show_percent">
                    <property name="title">Pokaż procent naładowania</property>
                    <property name="subtitle">Liczbowa wartość procentowa pod pierścieniem</property>
                  </object>
                </child>

                <child>
                  <object class="AdwSwitchRow" id="cfg_battery_use_accent">
                    <property name="title">Użyj koloru akcentu</property>
                    <property name="subtitle">Zabarwiaj pierścień naładowania na kolor akcentu</property>
                  </object>
                </child>
              </object>
            </child>

            
            <child>
              <object class="AdwPreferencesGroup">
                <property name="title">Odtwarzacz muzyki</property>
                <property name="description">Sterowanie odtwarzaniem dźwięku i multimediów</property>

                <child>
                  <object class="AdwSwitchRow" id="cfg_music_ignore_browsers">
                    <property name="title">Ignoruj dźwięk z przeglądarek</property>
                    <property name="subtitle">Nie przechwytuj kart YouTube ani Spotify Web</property>
                  </object>
                </child>

                <child>
                  <object class="AdwEntryRow" id="cfg_music_custom_app_entry">
                    <property name="title">Własna aplikacja muzyczna</property>
                    <property name="text">spotify</property>
                  </object>
                </child>
              </object>
            </child>

            
            <child>
              <object class="AdwPreferencesGroup">
                <property name="title">Monitor systemu</property>
                <property name="description">Obciążenie procesora, pamięci, sieci i dysków</property>

                <child>
                  <object class="AdwSwitchRow" id="cfg_system_page_indicator_accent">
                    <property name="title">Akcent kolorystyczny wskaźnika</property>
                    <property name="subtitle">Zastosuj kolor systemowy do wybranej strony</property>
                  </object>
                </child>

                <child>
                  <object class="AdwSwitchRow" id="cfg_system_show_page_dashes">
                    <property name="title">Kropkowe wskaźniki stron</property>
                    <property name="subtitle">Styl kresek zamiast kropek</property>
                  </object>
                </child>
              </object>
            </child>

            
            <child>
              <object class="AdwPreferencesGroup">
                <property name="title">Zdjęcia</property>
                <property name="description">Ramka na zdjęcia na biurku</property>

                <child>
                  <object class="AdwEntryRow" id="cfg_custom_photo_entry">
                    <property name="title">Ścieżka do zdjęcia lub folderu</property>
                    <property name="text" />
                  </object>
                </child>
              </object>
            </child>

            
            <child>
              <object class="AdwPreferencesGroup">
                <property name="title">Minutnik Pomodoro</property>
                <property name="description">Przedziały produktywności i skupienia</property>

                <child>
                  <object class="AdwSpinRow" id="cfg_pomodoro_work_row">
                    <property name="title">Czas skupienia (minuty)</property>
                    <property name="subtitle">Czas trwania interwału pracy</property>
                    <property name="adjustment">
                      <object class="GtkAdjustment" id="cfg_pomodoro_work_adj">
                        <property name="lower">1</property>
                        <property name="upper">60</property>
                        <property name="step-increment">1</property>
                        <property name="page-increment">5</property>
                        <property name="value">25</property>
                      </object>
                    </property>
                  </object>
                </child>

                <child>
                  <object class="AdwSpinRow" id="cfg_pomodoro_short_break_row">
                    <property name="title">Krótka przerwa (minuty)</property>
                    <property name="subtitle">Czas trwania odpoczynku między sesjami</property>
                    <property name="adjustment">
                      <object class="GtkAdjustment" id="cfg_pomodoro_short_break_adj">
                        <property name="lower">1</property>
                        <property name="upper">30</property>
                        <property name="step-increment">1</property>
                        <property name="page-increment">5</property>
                        <property name="value">5</property>
                      </object>
                    </property>
                  </object>
                </child>

                <child>
                  <object class="AdwSpinRow" id="cfg_pomodoro_long_break_row">
                    <property name="title">Długa przerwa (minuty)</property>
                    <property name="subtitle">Czas trwania długiej przerwy</property>
                    <property name="adjustment">
                      <object class="GtkAdjustment" id="cfg_pomodoro_long_break_adj">
                        <property name="lower">1</property>
                        <property name="upper">60</property>
                        <property name="step-increment">1</property>
                        <property name="page-increment">5</property>
                        <property name="value">15</property>
                      </object>
                    </property>
                  </object>
                </child>

                <child>
                  <object class="AdwSpinRow" id="cfg_pomodoro_sessions_row">
                    <property name="title">Liczba sesji do długiej przerwy</property>
                    <property name="subtitle">Liczba interwałów pracy przed długą przerwą</property>
                    <property name="adjustment">
                      <object class="GtkAdjustment" id="cfg_pomodoro_sessions_adj">
                        <property name="lower">1</property>
                        <property name="upper">10</property>
                        <property name="step-increment">1</property>
                        <property name="page-increment">1</property>
                        <property name="value">4</property>
                      </object>
                    </property>
                  </object>
                </child>
              </object>
            </child>

            
            <child>
              <object class="AdwPreferencesGroup">
                <property name="title">Notatki</property>
                <property name="description">Czcionki dla szybkich karteczek na biurku</property>

                <child>
                  <object class="AdwSpinRow" id="cfg_notes_title_size_row">
                    <property name="title">Rozmiar czcionki tytułu (px)</property>
                    <property name="adjustment">
                      <object class="GtkAdjustment" id="cfg_notes_title_size_adj">
                        <property name="lower">10</property>
                        <property name="upper">36</property>
                        <property name="step-increment">1</property>
                        <property name="page-increment">2</property>
                        <property name="value">16</property>
                      </object>
                    </property>
                  </object>
                </child>

                <child>
                  <object class="AdwSpinRow" id="cfg_notes_content_size_row">
                    <property name="title">Rozmiar czcionki treści notatki (px)</property>
                    <property name="adjustment">
                      <object class="GtkAdjustment" id="cfg_notes_content_size_adj">
                        <property name="lower">10</property>
                        <property name="upper">28</property>
                        <property name="step-increment">1</property>
                        <property name="page-increment">2</property>
                        <property name="value">13</property>
                      </object>
                    </property>
                  </object>
                </child>
              </object>
            </child>

            
            <child>
              <object class="AdwPreferencesGroup">
                <property name="title">Widżet GitHub</property>
                <property name="description">Wykres aktywności commitów i profil</property>

                <child>
                  <object class="AdwEntryRow" id="cfg_github_username_entry">
                    <property name="title">Nazwa użytkownika GitHub</property>
                    <property name="text" />
                  </object>
                </child>

                <child>
                  <object class="AdwSwitchRow" id="cfg_github_use_green">
                    <property name="title">Charakterystyczny zielony styl GitHub</property>
                    <property name="subtitle">Użyj autentycznych zielonych kolorów dla siatki commitów</property>
                  </object>
                </child>
              </object>
            </child>

            
            <child>
              <object class="AdwPreferencesGroup">
                <property name="title">Otwieranie folderów</property>
                <property name="description">Szybki dostęp do katalogów</property>

                <child>
                  <object class="AdwEntryRow" id="cfg_folder_file_manager_entry">
                    <property name="title">Menedżer plików</property>
                    <property name="text">nautilus</property>
                  </object>
                </child>

                <child>
                  <object class="AdwSwitchRow" id="cfg_folder_show_names">
                    <property name="title">Pokaż etykiety folderów</property>
