                                <property name="lower">0</property>
                                <property name="upper">100</property>
                                <property name="step-increment">1</property>
                                <property name="page-increment">5</property>
                                <property name="value">36</property>
                              </object>
                            </property>
                            <signal name="realize" handler="init_blur_tint"/>
                            <signal name="value-changed" handler="on_blur_tint_changed"/>
                          </object>
                        </child>
                      </object>
                    </child>
                  </object>
                </child>

                <!-- 4. Контекст меню -->
                <child>
                  <object class="AdwPreferencesGroup" id="context_menu_group">
                    <property name="title">Контекст меню</property>
                    <property name="description">Глобальні параметри затемнення та розмиття контекстних меню</property>
                    <child>
                      <object class="GtkBox" id="context_menu_preview_container">
                        <property name="orientation">1</property>
                        <property name="margin-start">15</property>
                        <property name="margin-end">15</property>
                        <property name="margin-top">4</property>
                        <property name="margin-bottom">12</property>
                        <child>
                          <object class="GtkDrawingArea" id="context_menu_preview_area">
                            <property name="height-request">180</property>
                            <property name="hexpand">true</property>
                            <signal name="realize" handler="init_context_menu_preview"/>
                          </object>
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="AdwActionRow" id="menu_tint_row">
                        <property name="title">Затемнення</property>
                        <child type="suffix">
                          <object class="GtkScale" id="menu_tint_scale">
                            <property name="orientation">0</property>
                            <property name="draw-value">true</property>
                            <property name="digits">0</property>
                            <property name="round-digits">0</property>
                            <property name="width-request">200</property>
                            <property name="adjustment">
                              <object class="GtkAdjustment">
                                <property name="lower">0</property>
                                <property name="upper">100</property>
                                <property name="step-increment">1</property>
                                <property name="page-increment">5</property>
                                <property name="value">35</property>
                              </object>
                            </property>
                            <signal name="realize" handler="init_menu_tint"/>
                            <signal name="value-changed" handler="on_menu_tint_changed"/>
                          </object>
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="AdwActionRow" id="menu_blur_row">
                        <property name="title">Розмиття</property>
                        <child type="suffix">
                          <object class="GtkScale" id="menu_blur_scale">
                            <property name="orientation">0</property>
                            <property name="draw-value">true</property>
                            <property name="digits">0</property>
                            <property name="round-digits">0</property>
                            <property name="width-request">200</property>
                            <property name="adjustment">
                              <object class="GtkAdjustment">
                                <property name="lower">0</property>
                                <property name="upper">100</property>
                                <property name="step-increment">1</property>
                                <property name="page-increment">5</property>
                                <property name="value">30</property>
                              </object>
                            </property>
                            <signal name="realize" handler="init_menu_blur"/>
                            <signal name="value-changed" handler="on_menu_blur_changed"/>
                          </object>
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="AdwExpanderRow" id="menu_shadow_expander">
                        <property name="title">Тінь</property>
                        <property name="subtitle">Розмиття та сила тіні під контекстними вікнами</property>
                        <property name="expanded">true</property>
                        <child>
                          <object class="AdwActionRow" id="menu_shadow_blur_row">
                            <property name="title">Розмиття тіні</property>
                            <child type="suffix">
                              <object class="GtkScale" id="menu_shadow_blur_scale">
                                <property name="orientation">0</property>
                                <property name="draw-value">true</property>
                                <property name="digits">0</property>
                                <property name="round-digits">0</property>
                                <property name="width-request">200</property>
                                <property name="adjustment">
                                  <object class="GtkAdjustment">
                                    <property name="lower">0</property>
                                    <property name="upper">100</property>
                                    <property name="step-increment">1</property>
                                    <property name="page-increment">5</property>
                                    <property name="value">30</property>
                                  </object>
                                </property>
                                <signal name="realize" handler="init_menu_shadow_blur"/>
                                <signal name="value-changed" handler="on_menu_shadow_blur_changed"/>
                              </object>
                            </child>
                          </object>
                        </child>
                        <child>
                          <object class="AdwActionRow" id="menu_shadow_strength_row">
                            <property name="title">Сила тіні</property>
                            <child type="suffix">
                              <object class="GtkScale" id="menu_shadow_strength_scale">
                                <property name="orientation">0</property>
                                <property name="draw-value">true</property>
                                <property name="digits">0</property>
                                <property name="round-digits">0</property>
                                <property name="width-request">200</property>
                                <property name="adjustment">
                                  <object class="GtkAdjustment">
                                    <property name="lower">0</property>
                                    <property name="upper">100</property>
                                    <property name="step-increment">1</property>
                                    <property name="page-increment">5</property>
                                    <property name="value">55</property>
                                  </object>
                                </property>
                                <signal name="realize" handler="init_menu_shadow_strength"/>
                                <signal name="value-changed" handler="on_menu_shadow_strength_changed"/>
                              </object>
                            </child>
                          </object>
                        </child>
                      </object>
                    </child>
                  </object>
                </child>

                <!-- 5. Віджети -->
                <child>
                  <object class="AdwPreferencesGroup" id="widgets_group">
                    <property name="title">Віджети</property>
                    <property name="description">Параметри заокруглення, тіні, розмиття та затемнення фону віджетів стільниці</property>
                    <child>
                      <object class="GtkBox" id="widgets_preview_container">
                        <property name="orientation">1</property>
                        <property name="margin-start">15</property>
                        <property name="margin-end">15</property>
                        <property name="margin-top">4</property>
                        <property name="margin-bottom">12</property>
                        <child>
                          <object class="GtkDrawingArea" id="widgets_preview_area">
                            <property name="height-request">170</property>
                            <property name="hexpand">true</property>
                            <signal name="realize" handler="init_widgets_preview"/>
                          </object>
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="AdwActionRow" id="widget_blur_row">
                        <property name="title">Розмиття</property>
                        <child type="suffix">
                          <object class="GtkScale" id="widget_blur_scale">
                            <property name="orientation">0</property>
                            <property name="draw-value">true</property>
                            <property name="digits">0</property>
                            <property name="round-digits">0</property>
                            <property name="width-request">200</property>
                            <property name="adjustment">
                              <object class="GtkAdjustment">
                                <property name="lower">0</property>
                                <property name="upper">50</property>
                                <property name="step-increment">1</property>
                                <property name="page-increment">5</property>
                                <property name="value">1</property>
                              </object>
                            </property>
                            <signal name="realize" handler="init_widget_blur"/>
                            <signal name="value-changed" handler="on_widget_blur_changed"/>
                          </object>
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="AdwActionRow" id="widget_tint_row">
                        <property name="title">Затемнення фону</property>
                        <child type="suffix">
                          <object class="GtkScale" id="widget_tint_scale">
                            <property name="orientation">0</property>
                            <property name="draw-value">true</property>
                            <property name="digits">0</property>
                            <property name="round-digits">0</property>
                            <property name="width-request">200</property>
                            <property name="adjustment">
                              <object class="GtkAdjustment">
                                <property name="lower">0</property>
                                <property name="upper">100</property>
                                <property name="step-increment">1</property>
                                <property name="page-increment">5</property>
                                <property name="value">20</property>
                              </object>
                            </property>
                            <signal name="realize" handler="init_widget_tint"/>
                            <signal name="value-changed" handler="on_widget_tint_changed"/>
                          </object>
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="AdwActionRow" id="widget_shadow_row">
                        <property name="title">Тінь</property>
                        <child type="suffix">
                          <object class="GtkScale" id="widget_shadow_scale">
                            <property name="orientation">0</property>
                            <property name="draw-value">true</property>
                            <property name="digits">0</property>
                            <property name="round-digits">0</property>
                            <property name="width-request">200</property>
                            <property name="adjustment">
                              <object class="GtkAdjustment">
                                <property name="lower">0</property>
                                <property name="upper">100</property>
                                <property name="step-increment">1</property>
                                <property name="page-increment">5</property>
                                <property name="value">30</property>
                              </object>
                            </property>
                            <signal name="realize" handler="init_widget_shadow"/>
                            <signal name="value-changed" handler="on_widget_shadow_changed"/>
                          </object>
                        </child>
                      </object>
                    </child>
                  </object>
                </child>

                <!-- 6. Завантажувач (Bootloader) -->
                <child>
                  <object class="AdwPreferencesGroup">
                    <property name="title">Завантажувач (Bootloader)</property>
                    <property name="description">Параметри завантаження macW1Y Plymouth та логування ядра</property>
                    <child>
                      <object class="AdwSwitchRow" id="boot_verbose_switch">
                        <property name="title">Режим verbose</property>
                        <property name="subtitle">Текстовий лог завантаження термінала позаду логотипу macW1Y</property>
                        <signal name="realize" handler="init_boot_verbose"/>
                        <signal name="notify::active" handler="on_boot_verbose_changed"/>
                      </object>
                    </child>
                    <child>
                      <object class="AdwSwitchRow" id="boot_grub_switch">
                        <property name="title">Меню GRUB</property>
                        <property name="subtitle">Графічне меню вибору системи у стилі macW1Y під час старту</property>
                        <signal name="realize" handler="init_boot_grub"/>
                        <signal name="notify::active" handler="on_boot_grub_changed"/>
                      </object>
                    </child>
                    <child>
                      <object class="AdwSwitchRow" id="boot_pclogo_switch">
                        <property name="title">Логотип ПК</property>
                        <property name="subtitle">Відображати початковий логотип виробника комп'ютера (UEFI) перед стартом</property>
                        <signal name="realize" handler="init_boot_pclogo"/>
                        <signal name="notify::active" handler="on_boot_pclogo_changed"/>
                      </object>
                    </child>
                  </object>
                </child>

                <!-- 6. Цілісність та діагностика -->
                <child>
                  <object class="AdwPreferencesGroup">
                    <property name="title">Цілісність та діагностика</property>
                    <property name="description">Контроль еталону SSOT, розширень GNOME та автоматичне відновлення</property>
                    <child>
                      <object class="AdwActionRow" id="diag_status_row">
                        <property name="title">Стан оформлення macW1Y</property>
                        <property name="subtitle">Всі компоненти відповідають еталону SSOT (OK)</property>
                        <child type="prefix">
                          <object class="GtkImage">
                            <property name="icon-name">emblem-ok-symbolic</property>
                          </object>
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="AdwActionRow">
                        <property name="title">Дії обслуговування</property>
                        <property name="subtitle">Перевірити поточний стан або відновити оформлення</property>
                        <child type="suffix">
                          <object class="GtkButton" id="btn_run_diagnostics">
                            <property name="label">Запустити діагностику</property>
                            <property name="valign">center</property>
                            <signal name="clicked" handler="on_run_diagnostics_clicked"/>
                          </object>
                        </child>
                        <child type="suffix">
                          <object class="GtkButton" id="btn_restore_theme">
                            <property name="label">Відновити оформлення</property>
                            <property name="valign">center</property>
                            <style>
                              <class name="suggested-action"/>
                            </style>
                            <signal name="clicked" handler="on_restore_theme_clicked"/>
                          </object>
                        </child>
                      </object>
                    </child>
                  </object>
                </child>

              </object>
            </property>
          </object>
        </property>
      </object>
</interface>
