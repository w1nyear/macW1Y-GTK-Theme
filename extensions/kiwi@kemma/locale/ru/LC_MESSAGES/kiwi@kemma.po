# --- Control Center Glass prefs ---
msgid "Control Center Glass"
msgstr "Стекло пункта управления"

msgid "Blur and brightness of the Tahoe Quick Settings glass. Reopen the control center to apply."
msgstr "Размытие и яркость стекла быстрых настроек Tahoe. Закройте и откройте пункт управления, чтобы применить."

msgid "Glass Blur"
msgstr "Размытие стекла"

msgid "Blur radius of the control center glass (0-100)"
msgstr "Радиус размытия стекла пункта управления (0–100)"

msgid "Glass Brightness"
msgstr "Яркость стекла"

msgid "Brightness of the control center glass (50-200, 100 = neutral)"
msgstr "Яркость стекла пункта управления (50–200, 100 — нейтрально)"

msgid "Glass Saturation"
msgstr "Насыщенность стекла"

msgid "Color saturation of the control center glass (0-150, 100 = neutral)"
msgstr "Насыщенность цвета стекла пункта управления (0–150, 100 — нейтрально)"

msgid "Glass Tint"
msgstr "Оттенок стекла"

msgid "Strength of the glass tint wash (0-100)"
msgstr "Сила тонирования стекла (0–100)"

msgid "Glass Refraction"
msgstr "Преломление стекла"

msgid "Refraction strength of the glass (0-200, 100 = stock)"
msgstr "Сила преломления стекла (0–200, 100 — обычная)"

msgid "Glass Glare"
msgstr "Блики стекла"

msgid "Specular sheen on the glass, 0 = clean (0-100)"
msgstr "Зеркальный блеск на стекле, 0 — чистое (0–100)"

msgid "Shadow Blur"
msgstr "Размытие тени"

msgid "Blur radius of the panel shadow (0-80)"
msgstr "Радиус размытия тени панели (0–80)"

msgid "Shadow Opacity"
msgstr "Прозрачность тени"

msgid "Opacity of the panel shadow (0-100)"
msgstr "Непрозрачность тени панели (0–100)"

msgid "Shadow Glow"
msgstr "Свечение тени"

msgid "Wide soft diffusion of the panel shadow (0-120, 0 = off)"
msgstr "Широкое мягкое рассеивание тени панели (0–120, 0 — выкл.)"

msgid "Rim Width"
msgstr "Ширина кромки"

msgid "Width of the glass edge highlight, 10 = 1px (0-200)"
msgstr "Ширина подсветки кромки стекла, 10 = 1 пкс (0–200)"

msgid "Rim Intensity"
msgstr "Интенсивность кромки"

msgid "Strength of the glass edge highlight (0-100)"
msgstr "Сила подсветки кромки стекла (0–100)"

msgid "Rim Power"
msgstr "Резкость кромки"

msgid "Falloff sharpness of the edge highlight, 10 = 1.0 (0-200)"
msgstr "Резкость спада подсветки кромки, 10 = 1.0 (0–200)"

msgid "Rim Direction"
msgstr "Направление кромки"

msgid "Light directionality of the edge highlight, 10 = 1.0 (0-100)"
msgstr "Направленность света подсветки кромки, 10 = 1.0 (0–100)"

msgid "Rim Light"
msgstr "Яркость кромки"

msgid "Brightness of the edge highlight color (0-300, 100 = neutral)"
msgstr "Яркость цвета подсветки кромки (0–300, 100 — нейтрально)"

msgid "Specular"
msgstr "Зеркальные блики"

msgid "Mirror-like specular spots on the glass (0-100)"
msgstr "Зеркальные блики на стекле (0–100)"

msgid "Glass IOR"
msgstr "Преломление (IOR)"

msgid "Index of refraction of the glass, 100 = 1.0 (100-400)"
msgstr "Показатель преломления стекла, 100 = 1.0 (100–400)"

msgid "Chromatic Aberration"
msgstr "Хроматическая аберрация"

msgid "Color fringing on refracted edges (0-200)"
msgstr "Цветная кайма на преломлённых краях (0–200)"

msgid "Edge Smoothing"
msgstr "Сглаживание краёв"

msgid "Feather of the glass region borders, 10 = 1px (0-100)"
msgstr "Растушёвка границ стеклянных областей, 10 = 1 пкс (0–100)"

msgid "Surface Profile"
msgstr "Профиль поверхности"

msgid "Curvature profile of the glass surface, 100 = 1.0 (110-1500)"
msgstr "Профиль кривизны поверхности стекла, 100 = 1.0 (110–1500)"

msgid "Glass Depth"
msgstr "Глубина стекла"

msgid "Height of the glass surface relief (0-100)"
msgstr "Высота рельефа поверхности стекла (0–100)"

msgid "Notification Center"
msgstr "Центр уведомлений"

msgid "No Notifications"
msgstr "Нет уведомлений"

msgid "Clear all"
msgstr "Очистить всё"
