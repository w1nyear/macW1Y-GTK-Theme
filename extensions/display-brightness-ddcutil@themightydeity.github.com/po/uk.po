msgstr "Вимкнути перевірку стану дисплея"

msgid "Disables the check for the display power state before changing brightness, might help in detecting more displays"
msgstr "Вимикає перевірку стану живлення дисплея перед зміною яскравості, що може допомогти у виявленні більшої кількості моніторів"

msgid "Enable \"All\" Slider"
msgstr "Увімкнути повзунок «Усі»"

msgid "Enable \"Internal\" Slider"
msgstr "Увімкнути повзунок «Вбудований»"

msgid "Enter the new shortcut"
msgstr "Введіть нове скорочення"

msgid "General"
msgstr "Загальні"

msgid "Hide System Indicator"
msgstr "Сховати системний індикатор"

msgid "Increase Brightness"
msgstr "Збільшити яскравість"

msgid "Initializing"
msgstr "Ініціалізація"

msgid "Internal"
msgstr "Вбудований"

msgid "Keyboard Shortcuts"
msgstr "Клавіатурні скорочення"

