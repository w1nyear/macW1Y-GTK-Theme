#!/bin/bash
# Discrete GPU wrapper for Bottles
REAL_BIN=$(PATH=$(echo "$PATH" | sed -e 's|/usr/local/bin||g' -e 's|::|:|g') which bottles 2>/dev/null)
if [ -n "$REAL_BIN" ] && [ -x "$REAL_BIN" ]; then
    exec /usr/local/bin/prime-run "$REAL_BIN" "$@"
elif which flatpak >/dev/null 2>&1 && flatpak list | grep -q "com.usebottles.bottles"; then
    exec /usr/local/bin/prime-run flatpak run com.usebottles.bottles "$@"
else
    echo "Bottles is not installed." >&2
    exit 1
fi
