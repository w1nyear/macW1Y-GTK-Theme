#!/usr/bin/env python3
"""
mac-i18n-verify - Comprehensive Internationalization & Localization Verification Suite
Validates the advertised locale catalog, actual central dictionaries, runtime
artifacts, installer syntax, and deliberate English fallback behavior.
"""

import os
import sys
import json
import re
import subprocess

REPO_ROOT = os.path.abspath(os.path.join(os.path.dirname(__file__), ".."))
if not os.path.exists(os.path.join(REPO_ROOT, "config/i18n/catalog.json")):
    for candidate in ["/home/vitaliy/MACTHEMEFILES", "/home/vitaliy/macW1Y"]:
        if os.path.exists(os.path.join(candidate, "config/i18n/catalog.json")):
            REPO_ROOT = candidate
            break

C_RESET = "\033[0m"
C_BOLD = "\033[1m"
C_GREEN = "\033[1;32m"
C_RED = "\033[1;31m"
C_YELLOW = "\033[1;33m"
C_CYAN = "\033[1;36m"

def check(title, condition, detail=""):
    if condition:
        print(f"  {C_GREEN}✔{C_RESET} {title}")
        return True
    else:
        print(f"  {C_RED}✖{C_RESET} {title}")
        if detail:
            print(f"    {C_YELLOW}↳ {detail}{C_RESET}")
        return False

def main():
    print(f"\n{C_CYAN}{C_BOLD}=== macW1Y 0.7.1 i18n / l10n VALIDATION SUITE ==={C_RESET}\n")
    all_ok = True

    # 1. Catalog Verification
    print(f"{C_BOLD}1. Localization Catalog Audit (config/i18n/catalog.json):{C_RESET}")
    cat_path = os.path.join(REPO_ROOT, "config/i18n/catalog.json")
    if not os.path.exists(cat_path):
        check("Catalog file exists", False, "Missing config/i18n/catalog.json")
        all_ok = False
        return 1

    with open(cat_path, "r", encoding="utf-8") as f:
        catalog_data = json.load(f)

    catalog = catalog_data.get("catalog", [])
    total_langs = len(catalog)
    all_ok &= check(f"Catalog contains 209 supported Ubuntu/BCP-47 languages (found {total_langs})", total_langs == 209)

    tiers = catalog_data.get("tiers", {})
    t1_cnt = tiers.get("tier_1", {}).get("count", 0)
    t2_cnt = tiers.get("tier_2", {}).get("count", 0)
    t3_cnt = tiers.get("tier_3", {}).get("count", 0)
    t4_cnt = tiers.get("tier_4", {}).get("count", 0)

    all_catalog_codes = {item.get("code") for item in catalog}
    tier_codes = []
    for tier_name in ("tier_1", "tier_2", "tier_3", "tier_4"):
        tier_codes.extend(tiers.get(tier_name, {}).get("languages", []))
    tier_total = t1_cnt + t2_cnt + t3_cnt + t4_cnt
    all_ok &= check(f"Tier counts add up to catalog size ({tier_total})", tier_total == total_langs)
    all_ok &= check("Tier definitions cover each catalog code exactly once", len(tier_codes) == len(set(tier_codes)) == total_langs and set(tier_codes) == all_catalog_codes)
    all_ok &= check(f"Tier 1 primary locales: {t1_cnt}", t1_cnt == 2)
    all_ok &= check(f"Tier 2 major locales: {t2_cnt}", t2_cnt == 29)
    all_ok &= check(f"Tier 3 RTL locales: {t3_cnt}", t3_cnt == 3)
    all_ok &= check(f"Tier 4 additional locales: {t4_cnt}", t4_cnt == 175)

    # 2. Central Translations Dictionary Audit
    print(f"\n{C_BOLD}2. Central Translations Dictionary (config/i18n/translations.json):{C_RESET}")
    trans_path = os.path.join(REPO_ROOT, "config/i18n/translations.json")
    if not os.path.exists(trans_path):
        check("translations.json exists", False)
        all_ok = False
        return 1

    with open(trans_path, "r", encoding="utf-8") as f:
        translations = json.load(f)

    en_keys = set(translations.get("en", {}).keys())
    uk_keys = set(translations.get("uk", {}).keys())

    all_ok &= check(f"Primary English baseline contains keys ({len(en_keys)} keys)", len(en_keys) >= 80)
    all_ok &= check(f"Primary Ukrainian baseline contains keys ({len(uk_keys)} keys)", len(uk_keys) >= 80)

    missing_in_uk = en_keys - uk_keys
    all_ok &= check("Tier 1 Ukrainian key parity with English (0 missing)", len(missing_in_uk) == 0, f"Missing: {missing_in_uk}")

    incomplete_dictionaries = []
    for lang, dictionary in translations.items():
        missing = en_keys - set(dictionary)
        empty = [key for key, value in dictionary.items() if not isinstance(value, str) or not value.strip()]
        if missing or empty or set(dictionary) - en_keys:
            incomplete_dictionaries.append((lang, len(missing), len(empty), len(set(dictionary) - en_keys)))
    all_ok &= check(f"All shipped dictionaries have the same {len(en_keys)} keys and no empty values", not incomplete_dictionaries,
                    f"Problems: {incomplete_dictionaries[:5]}")
    declared_full = {item.get("code") for item in catalog if item.get("tier") in (1, 2, 3)}
    machine_codes = {item.get("code") for item in catalog if item.get("status") == "machine_translated_unreviewed"}
    actual_full = set(translations) - machine_codes
    all_ok &= check(f"Full-dictionary locales match declared Tier 1–3 ({len(declared_full)})", declared_full == actual_full,
                    f"Missing dictionaries: {sorted(declared_full - actual_full)}; extra: {sorted(actual_full - declared_full)}")
    catalog_machine = {item.get("code") for item in catalog if item.get("status") == "machine_translated_unreviewed"}
    fallback_codes = {item.get("code") for item in catalog if item.get("status") == "english_fallback"}
    all_ok &= check(f"Machine-translated dictionaries are marked for review ({len(machine_codes)})",
                    machine_codes == set(translations) - declared_full and all(code in translations for code in machine_codes))
    all_ok &= check(f"English fallback remains explicit ({len(fallback_codes)} locales)",
                    len(fallback_codes) + len(catalog_machine) == t4_cnt and
                    all(item.get("status") in {"english_fallback", "machine_translated_unreviewed"} for item in catalog if item.get("tier") == 4))

    # Placeholder checks ({query}, {time}, {rpm}, {size}, etc.)
    placeholder_re = re.compile(r"\{([a-zA-Z0-9_]+)\}")
    placeholder_mismatches = []
    for lang, dict_keys in translations.items():
        for k, text in dict_keys.items():
            en_text = translations["en"].get(k, "")
            en_placeholders = set(placeholder_re.findall(en_text))
            lang_placeholders = set(placeholder_re.findall(text))
            if en_placeholders != lang_placeholders:
                placeholder_mismatches.append((lang, k, en_placeholders, lang_placeholders))

    all_ok &= check("Placeholder consistency across all translations", len(placeholder_mismatches) == 0,
                    f"Mismatches: {placeholder_mismatches[:3]}")

    # 3. Runtime Files & Module Artifacts
    print(f"\n{C_BOLD}3. Runtime Module Generation & Extension Synchronization:{C_RESET}")
    runtime_targets = [
        "extensions/appmenu@ChathurangaBW.github.io/mac_i18n.js",
        "extensions/blur-my-shell@aunetx/components/mac_i18n.js",
        "extensions/kiwi@kemma/apps/mac_i18n.js",
        "extensions/eval-helper@mactheme/mac_i18n.js",
        "bin/mac_i18n.py",
        "control-center/mac_i18n.h",
        "src/mac_i18n.h",
    ]
    for rel in runtime_targets:
        full_p = os.path.join(REPO_ROOT, rel)
        exists = os.path.exists(full_p)
        size = os.path.getsize(full_p) if exists else 0
        all_ok &= check(f"{rel} exists and populated ({size} bytes)", exists and size > 500)

    print(f"\n{C_BOLD}4. Installer Script Syntax (localization is not implied):{C_RESET}")
    for sh_name in ["install.sh"]:
        sh_path = os.path.join(REPO_ROOT, sh_name)
        if not os.path.exists(sh_path):
            continue
        res_sh = subprocess.run(["bash", "-n", sh_path], capture_output=True, text=True)
        all_ok &= check(f"{sh_name} passes bash syntax validation", res_sh.returncode == 0, res_sh.stderr)

    # 5. Extension Guard & Pinned Lock Hashes
    print(f"\n{C_BOLD}5. GNOME Extensions Integrity & Version Lock:{C_RESET}")
    res_guard = subprocess.run([os.path.join(REPO_ROOT, "bin/mac-extension-guard"), "verify"], capture_output=True, text=True)
    all_ok &= check("All 21 managed extensions match pinned lock hashes", res_guard.returncode == 0, res_guard.stdout.strip())

    print(f"\n{C_BOLD}6. English Fallback Behavior (not translated coverage):{C_RESET}")
    sys.path.insert(0, os.path.join(REPO_ROOT, "bin"))
    import mac_i18n
    fb_values = [mac_i18n.t("power_performance", override_locale=code) for code in sorted(fallback_codes)]
    fb_expected = translations["en"]["power_performance"]
    all_ok &= check(f"All {len(fallback_codes)} Tier 4 codes fall back to English", all(value == fb_expected for value in fb_values))

    # Test unknown key fallback
    unk_val = mac_i18n.t("non_existent_key_xyz", fallback="DefaultFallback")
    all_ok &= check("Missing key falls back to parameter without error", unk_val == "DefaultFallback")

    # Test RTL detection
    ar_rtl = mac_i18n.RTL_LANGUAGES.issuperset({"ar", "he", "fa"})
    all_ok &= check("Tier 3 RTL language set includes ar, he, fa", ar_rtl)

    # SUMMARY
    print("\n" + "="*80)
    if all_ok:
        print(f"{C_GREEN}{C_BOLD}RESULT: Structural and fallback checks passed; full localization coverage is not certified.{C_RESET}\n")
        return 0
    else:
        print(f"{C_RED}{C_BOLD}RESULT: Validation failed with issues.{C_RESET}\n")
        return 1

if __name__ == "__main__":
    sys.exit(main())
