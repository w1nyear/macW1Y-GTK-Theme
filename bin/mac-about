    window.mac-about-window.mac-about-light button.about-more-btn:hover {
        background-color: #d8d8dc;
    }
    window.mac-about-window.mac-about-light button.about-more-btn:active {
        background-color: #ccccd1;
    }
    window.mac-about-window.mac-about-dark button.about-more-btn {
        background-color: #5b5b5e;
        color: #f5f5f7;
    }
    window.mac-about-window.mac-about-dark button.about-more-btn:hover {
        background-color: #6a6a6e;
    }
    window.mac-about-window.mac-about-dark button.about-more-btn:active {
        background-color: #4f4f52;
    }
    window.mac-about-window label.about-footer-link,
    window.mac-about-window label.about-footer-text {
        font-size: 10px;
        font-weight: 400;
    }
    window.mac-about-window.mac-about-light label.about-footer-link,
    window.mac-about-window.mac-about-light label.about-footer-text {
        color: #9a9aa0;
    }
    window.mac-about-window.mac-about-light label.about-footer-link.hovered {
        color: #5c5c62;
    }
    window.mac-about-window.mac-about-dark label.about-footer-link,
    window.mac-about-window.mac-about-dark label.about-footer-text {
        color: #78787d;
    }
    window.mac-about-window.mac-about-dark label.about-footer-link.hovered {
        color: #b5b5ba;
    }
    box.traffic-dot {
        min-width: 12px;
        min-height: 12px;
        border-radius: 9999px;
        padding: 0;
        margin: 0;
    }
    box.traffic-close {
        background-color: #ff5f57;
        border: 0.75px solid #e0443e;
    }
    box.traffic-close.hovered {
        background-color: #ff4b42;
    }
    box.traffic-close label.traffic-x {
        font-size: 9px;
        font-weight: 800;
        color: rgba(77, 0, 0, 0);
        margin-top: -1px;
    }
    box.traffic-close.hovered label.traffic-x {
        color: rgba(77, 0, 0, 0.80);
    }
    .mac-about-light box.traffic-muted {
        background-color: #e2e2e4;
        border: 0.75px solid #cbccce;
    }
    .mac-about-dark box.traffic-muted {
        background-color: #3f3f42;
        border: 0.75px solid #4e4e52;
    }
    """

    assets_dir = find_windows_assets_dir()
    wc_css = ""
    if assets_dir:
        def scaled_url(base: str) -> str:
            p1 = (assets_dir / f"{base}.png").as_uri()
            p2 = (assets_dir / f"{base}@2.png").as_uri()
            if (assets_dir / f"{base}@2.png").is_file():
                return f'-gtk-scaled(url("{p1}"), url("{p2}"))'
            return f'url("{p1}")'

        wc_css = f"""
        box.mac-wc-group {{
            padding: 0;
            margin: 0;
        }}
        box.mac-wc-btn {{
            min-width: 16px;
            min-height: 16px;
            padding: 0;
            margin: 0 3px;
            border-radius: 9999px;
            background-color: transparent;
            background-repeat: no-repeat;
            background-size: 16px 16px;
            background-position: center;
            border: none;
            box-shadow: none;
            transition: transform 220ms cubic-bezier(0.34, 1.56, 0.64, 1), filter 160ms ease;
        }}
        box.mac-wc-btn.close {{
            background-image: {scaled_url("button-close")};
        }}
        box.mac-wc-btn.minimize {{
            background-image: {scaled_url("button-minimize")};
        }}
        box.mac-wc-btn.maximize {{
            background-image: {scaled_url("button-maximize")};
        }}
        window.mac-about-window:backdrop box.mac-wc-btn.close {{
            background-image: {scaled_url("button-close-backdrop")};
        }}
        window.mac-about-window:backdrop box.mac-wc-btn.minimize {{
            background-image: {scaled_url("button-minimize-backdrop")};
        }}
        window.mac-about-window:backdrop box.mac-wc-btn.maximize {{
            background-image: {scaled_url("button-maximize-backdrop")};
        }}
        box.mac-wc-group.group-hover box.mac-wc-btn.close,
        box.mac-wc-group:hover box.mac-wc-btn.close,
        box.mac-wc-btn.close:hover {{
            background-image: {scaled_url("button-close-hover")};
        }}
        box.mac-wc-group.group-hover box.mac-wc-btn.minimize,
        box.mac-wc-group:hover box.mac-wc-btn.minimize,
        box.mac-wc-btn.minimize:hover {{
            background-image: {scaled_url("button-minimize-hover")};
        }}
        box.mac-wc-group.group-hover box.mac-wc-btn.maximize,
        box.mac-wc-group:hover box.mac-wc-btn.maximize,
        box.mac-wc-btn.maximize:hover {{
            background-image: {scaled_url("button-maximize-hover")};
        }}
        box.mac-wc-btn.close:active,
        box.mac-wc-group.group-hover box.mac-wc-btn.close:active {{
            background-image: {scaled_url("button-close-active")};
        }}
        box.mac-wc-btn.minimize:active,
        box.mac-wc-group.group-hover box.mac-wc-btn.minimize:active {{
            background-image: {scaled_url("button-minimize-active")};
        }}
        box.mac-wc-btn.maximize:active,
        box.mac-wc-group.group-hover box.mac-wc-btn.maximize:active {{
            background-image: {scaled_url("button-maximize-active")};
        }}
        """

    CSS = CSS + wc_css

    def make_traffic_dot(kind: str, on_click=None):
        dot = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL)
        dot.set_hexpand(False)
        dot.set_vexpand(False)
        dot.set_halign(Gtk.Align.CENTER)
        dot.set_valign(Gtk.Align.CENTER)
        if assets_dir:
            dot.set_size_request(16, 16)
            dot.add_css_class("mac-wc-btn")
            dot.add_css_class(kind)
            if on_click:
                dot.set_cursor_from_name("pointer")
                click = Gtk.GestureClick()
                click.set_button(1)
                click.connect("released", lambda _g, _n, _x, _y: on_click())
                dot.add_controller(click)
        else:
            dot.set_size_request(12, 12)
            dot.add_css_class("traffic-dot")
            if kind == "close":
                dot.add_css_class("traffic-close")
                lbl = Gtk.Label(label="×")
                lbl.add_css_class("traffic-x")
                lbl.set_hexpand(True)
                lbl.set_vexpand(True)
                lbl.set_halign(Gtk.Align.CENTER)
                lbl.set_valign(Gtk.Align.CENTER)
                dot.append(lbl)
                if on_click:
                    dot.set_cursor_from_name("pointer")
                    motion = Gtk.EventControllerMotion()
                    motion.connect("enter", lambda *_: dot.add_css_class("hovered"))
                    motion.connect("leave", lambda *_: dot.remove_css_class("hovered"))
                    dot.add_controller(motion)
                    click = Gtk.GestureClick()
                    click.set_button(1)
                    click.connect("released", lambda _g, _n, _x, _y: on_click())
                    dot.add_controller(click)
            else:
                dot.add_css_class("traffic-muted")
        return dot

    class MacAboutApp(Adw.Application):
        def __init__(self):
            super().__init__(
                application_id="org.macw1y.About",
                flags=Gio.ApplicationFlags.FLAGS_NONE,
            )
            self._win = None

        def do_activate(self):
            if self._win is not None:
                self._win.present()
                return

            provider = Gtk.CssProvider()
            provider.load_from_data(CSS.encode("utf-8"))
            Gtk.StyleContext.add_provider_for_display(
                Gdk.Display.get_default(),
                provider,
                Gtk.STYLE_PROVIDER_PRIORITY_USER + 10,
            )

            win = Gtk.ApplicationWindow(application=self)
            win.set_title("About This Mac")
            win.set_default_size(298, 540)
            win.set_size_request(298, 540)
            win.set_resizable(False)
            win.set_decorated(False)
            win.add_css_class("mac-about-window")

            style_mgr = Adw.StyleManager.get_default()

            def sync_theme(*_args):
                if style_mgr.get_dark():
                    win.remove_css_class("mac-about-light")
                    win.add_css_class("mac-about-dark")
                else:
                    win.remove_css_class("mac-about-dark")
                    win.add_css_class("mac-about-light")

            sync_theme()
            style_mgr.connect("notify::dark", sync_theme)

            # Escape / Ctrl+W closes the window
            key_ctrl = Gtk.EventControllerKey()

            def on_key(_ctrl, keyval, _keycode, state):
                if keyval == Gdk.KEY_Escape or (
                    keyval in (Gdk.KEY_w, Gdk.KEY_q)
                    and (state & Gdk.ModifierType.CONTROL_MASK)
                ):
                    win.close()
                    return True
                return False

            key_ctrl.connect("key-pressed", on_key)
            win.add_controller(key_ctrl)

            handle = Gtk.WindowHandle()
            root = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
            root.add_css_class("mac-about-card")
            root.set_size_request(298, 540)
            root.set_hexpand(True)
            root.set_vexpand(True)

            # Top macOS traffic lights bar matching global GTK4 titlebuttons style
            top_bar = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=0 if assets_dir else 8)
            top_bar.add_css_class("mac-about-header")
            top_bar.add_css_class("mac-wc-group")
            top_bar.set_margin_start(11 if assets_dir else 14)
            top_bar.set_margin_top(12 if assets_dir else 14)
            top_bar.set_margin_bottom(0)
            top_bar.set_halign(Gtk.Align.START)

            if assets_dir:
                grp_motion = Gtk.EventControllerMotion()
                grp_motion.connect("enter", lambda *_: top_bar.add_css_class("group-hover"))
                grp_motion.connect("leave", lambda *_: top_bar.remove_css_class("group-hover"))
                top_bar.add_controller(grp_motion)

            close_dot = make_traffic_dot("close", on_click=win.close)
            min_dot = make_traffic_dot("minimize", on_click=win.minimize)
            max_dot = make_traffic_dot("maximize")
            top_bar.append(close_dot)
            top_bar.append(min_dot)
            top_bar.append(max_dot)

            root.append(top_bar)

            # Body container
            body = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
            body.set_margin_start(18)
            body.set_margin_end(18)
            body.set_margin_bottom(30)
            body.set_vexpand(True)

            # Device illustration
            img_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
            img_box.set_halign(Gtk.Align.CENTER)
            img_box.set_margin_top(48)
            img_box.set_margin_bottom(24)
            asset_path = info.get("asset")
            if asset_path and os.path.isfile(asset_path):
                pic = Gtk.Picture.new_for_filename(asset_path)
                pic.set_can_shrink(True)
                pic.set_content_fit(Gtk.ContentFit.CONTAIN)
                if info["is_laptop"]:
                    pic.set_size_request(176, 108)
                else:
                    pic.set_size_request(176, 90)
                img_box.append(pic)
            else:
                icon_name = "computer-laptop" if info["is_laptop"] else "computer"
                img = Gtk.Image.new_from_icon_name(icon_name)
                img.set_pixel_size(96)
                img_box.append(img)
            body.append(img_box)

            # Device Title
            title_lbl = Gtk.Label(label=info["device_name"])
            title_lbl.add_css_class("about-title")
            title_lbl.set_justify(Gtk.Justification.CENTER)
            title_lbl.set_wrap(True)
            title_lbl.set_max_width_chars(22)
            title_lbl.set_halign(Gtk.Align.CENTER)
            body.append(title_lbl)

            # Subtitle (CPU family, Year)
            sub_lbl = Gtk.Label(label=info["subtitle"])
            sub_lbl.add_css_class("about-subtitle")
            sub_lbl.set_justify(Gtk.Justification.CENTER)
            sub_lbl.set_margin_top(3)
            sub_lbl.set_margin_bottom(20)
            sub_lbl.set_halign(Gtk.Align.CENTER)
            body.append(sub_lbl)

            # Specs grid
            st = info["strings"]
            grid = Gtk.Grid()
            grid.set_row_spacing(4)
            grid.set_column_spacing(9)
            grid.set_halign(Gtk.Align.CENTER)

            rows = [
                (st["chip"], info["chip_full"]),
                (st["memory"], info["memory"]),
                (st["startup_disk"], info["startup_disk"]),
                (st["serial_number"], info["serial"]),
                (st["os_label"], info["version"]),
            ]
            for idx, (k, v) in enumerate(rows):
                k_lbl = Gtk.Label(label=k)
                k_lbl.add_css_class("about-spec-key")
                k_lbl.set_halign(Gtk.Align.END)
                k_lbl.set_valign(Gtk.Align.START)

                v_lbl = Gtk.Label(label=v)
                v_lbl.add_css_class("about-spec-val")
                v_lbl.set_halign(Gtk.Align.START)
                v_lbl.set_valign(Gtk.Align.START)
                v_lbl.set_selectable(True)
                v_lbl.set_can_focus(False)
                v_lbl.set_wrap(True)
                v_lbl.set_max_width_chars(20)

                grid.attach(k_lbl, 0, idx, 1, 1)
                grid.attach(v_lbl, 1, idx, 1, 1)

            body.append(grid)

            # More Info... button
            more_btn = Gtk.Button(label=st["more_info"])
            more_btn.add_css_class("about-more-btn")
            more_btn.set_halign(Gtk.Align.CENTER)
            more_btn.set_valign(Gtk.Align.CENTER)
            more_btn.set_size_request(-1, 22)
            more_btn.set_margin_top(22)
            more_btn.set_margin_bottom(14)
            more_btn.set_cursor_from_name("pointer")

            def on_more_clicked(*_args):
                open_system_about()
                win.close()

            more_btn.connect("clicked", on_more_clicked)
            body.append(more_btn)

            # Spacer pushes footer cleanly above generous bottom margin
            spacer = Gtk.Box()
            spacer.set_vexpand(True)
            body.append(spacer)

            # Clickable grey GitHub hyperlink (custom gesture avoids Adwaita blue link tint)
            link_lbl = Gtk.Label()
            link_lbl.add_css_class("about-footer-link")
            link_lbl.set_halign(Gtk.Align.CENTER)
            link_lbl.set_justify(Gtk.Justification.CENTER)
            link_lbl.set_margin_bottom(4)
            link_lbl.set_cursor_from_name("pointer")
            link_lbl.set_tooltip_text(REPO_URL)
            escaped_text = GLib.markup_escape_text(st["github_link"])
            link_lbl.set_markup(f'<u>{escaped_text}</u>')
            link_motion = Gtk.EventControllerMotion()
            link_motion.connect("enter", lambda *_: link_lbl.add_css_class("hovered"))
            link_motion.connect("leave", lambda *_: link_lbl.remove_css_class("hovered"))
            link_lbl.add_controller(link_motion)
            link_click = Gtk.GestureClick()
            link_click.set_button(1)
            link_click.connect("released", lambda _g, _n, _x, _y: open_github_link())
            link_lbl.add_controller(link_click)
            body.append(link_lbl)

            # GPL v3 footer text
            lic_lbl = Gtk.Label(label=f"{st['license_line1']}\n{st['license_line2']}")
            lic_lbl.add_css_class("about-footer-text")
            lic_lbl.set_halign(Gtk.Align.CENTER)
            lic_lbl.set_justify(Gtk.Justification.CENTER)
            lic_lbl.set_margin_top(2)
            body.append(lic_lbl)

            root.append(body)
            handle.set_child(root)
            win.set_child(handle)

            self._win = win
            win.present()
            win.set_focus(None)

    app = MacAboutApp()
    return app.run(sys.argv[:1])


def main() -> int:
    info = collect_hardware_info()
    if "--json" in sys.argv or "--print-info" in sys.argv:
        out = dict(info)
        out.pop("strings", None)
        print(json.dumps(out, ensure_ascii=False, indent=2))
        return 0
    return run_gui(info)


if __name__ == "__main__":
    raise SystemExit(main())
