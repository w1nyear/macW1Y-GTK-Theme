def detect_locale() -> str:
    candidates = []
    locale_file = Path.home() / ".config" / "mac-styling" / "locale"
    if locale_file.is_file():
        try:
            raw = locale_file.read_text(encoding="utf-8", errors="ignore").strip()
            if raw:
                candidates.append(raw)
        except Exception:
            pass
    for env_key in ("LC_MESSAGES", "LC_ALL", "LANG"):
        val = os.environ.get(env_key, "").strip()
        if val:
            candidates.append(val)
    for cand in candidates:
        short = cand.split(".")[0].split("_")[0].split("-")[0].lower()
        if short in STRINGS:
            return short
    return "en"


def clean_dmi_value(val: str) -> str:
    val = (val or "").strip()
    if val.lower() in INVALID_DMI:
        return ""
    if set(val) <= {"0", "F", "f", "X", "x", "-", " "} and len(val) >= 4:
        return ""
    return val


def load_cached_hwinfo() -> dict:
    for p in (Path("/run/macw1y/hardware-info.json"), Path("/etc/macW1Y/hardware-info.json")):
        if p.is_file():
            try:
                return json.loads(p.read_text(encoding="utf-8"))
            except Exception:
                pass
    return {}


def read_dmi(name: str, cache: dict) -> str:
    p = Path("/sys/class/dmi/id") / name
    try:
        val = clean_dmi_value(p.read_text(encoding="utf-8", errors="ignore"))
        if val:
            return val
    except Exception:
        pass
    return clean_dmi_value(str(cache.get(name, "")))


def is_laptop_device(cache: dict) -> bool:
    ctype_raw = read_dmi("chassis_type", cache)
    if ctype_raw.isdigit():
        if int(ctype_raw) in LAPTOP_CHASSIS_TYPES:
            return True
    if glob.glob("/sys/class/power_supply/BAT*"):
        return True
    return False


def format_vendor(vendor: str) -> str:
    v = clean_dmi_value(vendor)
    if not v:
        return ""
    mapped = VENDOR_ALIASES.get(v.lower())
    if mapped:
        return mapped
    v = re.sub(r",?\s*\b(Inc\.?|Corp\.?|Corporation|Co\.?,?\s*Ltd\.?|Ltd\.?|LLC|GmbH)\b", "", v, flags=re.I).strip(" ,.")
    return v


def detect_device_name(cache: dict, is_laptop: bool) -> str:
    vendor = format_vendor(read_dmi("sys_vendor", cache) or read_dmi("board_vendor", cache))
    model = read_dmi("product_name", cache)
    family = read_dmi("product_family", cache)
    board = read_dmi("board_name", cache)

    if model:
        if vendor and not model.lower().startswith(vendor.lower()) and vendor.lower() not in model.lower():
            return f"{vendor} {model}"
        return model
    if family:
        if vendor and not family.lower().startswith(vendor.lower()):
            return f"{vendor} {family}"
        return family
    if board:
        if vendor and not board.lower().startswith(vendor.lower()):
            return f"{vendor} {board}"
        return board
    return "Laptop" if is_laptop else "Desktop PC"


def detect_cpu() -> tuple[str, str]:
    raw = ""
    try:
        for line in Path("/proc/cpuinfo").read_text(encoding="utf-8", errors="ignore").splitlines():
            if ":" not in line:
                continue
            k, v = line.split(":", 1)
            key = k.strip().lower()
            if key in ("model name", "model", "hardware"):
                raw = v.strip()
                if key == "model name":
                    break
    except Exception:
        pass

    if not raw and shutil.which("lscpu"):
        try:
            env = dict(os.environ, LC_ALL="C")
            out = subprocess.run(["lscpu"], stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True, env=env, timeout=2, check=False).stdout
            for line in out.splitlines():
                if line.lower().startswith("model name:"):
                    raw = line.split(":", 1)[1].strip()
                    break
        except Exception:
            pass

    if not raw:
        arch = os.uname().machine or "Unknown CPU"
        return arch, arch

    full = raw
    full = re.sub(r"\((?:R|TM|C)\)", "", full, flags=re.I)
    full = re.sub(r"^\d+(?:th|st|nd|rd)\s+Gen\s+", "", full, flags=re.I)
    full = re.sub(r"\s+@\s*[\d.]+\s*[GM]Hz.*$", "", full, flags=re.I)
    full = re.sub(r"\s+(?:w/|with)\s+Radeon.*$", "", full, flags=re.I)
    full = re.sub(r"\s+\d+-Core\s+Processor\b", "", full, flags=re.I)
    full = re.sub(r"\s+Processor\b", "", full, flags=re.I)
    full = re.sub(r"\s+CPU\b", "", full, flags=re.I)
    full = re.sub(r"\s+", " ", full).strip()

    short = full
    patterns = [
        r"(Intel\s+Core\s+Ultra\s+\d+)",
        r"(Intel\s+Core\s+i[3579])",
        r"(Intel\s+Core\s+[3579])",
        r"(Intel\s+Xeon(?:\s+\w+)?)",
        r"(Intel\s+Pentium|Intel\s+Celeron)",
        r"(AMD\s+Ryzen\s+Threadripper(?:\s+PRO)?\s+\d+)",
        r"(AMD\s+Ryzen\s+\d+)",
        r"(AMD\s+EPYC|AMD\s+FX)",
        r"(Apple\s+M\d+(?:\s+(?:Pro|Max|Ultra))?)",
    ]
    matched = False
    for pat in patterns:
        m = re.search(pat, full, re.I)
        if m:
            short = re.sub(r"\s+", " ", m.group(1)).strip()
            matched = True
            break
    if not matched:
        parts = full.split()
        short = " ".join(parts[:3]) if len(parts) > 3 else full

    return short, full


def detect_board_year(cache: dict) -> str:
    bios_date = read_dmi("bios_date", cache)
    m = re.search(r"\b(19\d{2}|20\d{2})\b", bios_date)
    return m.group(1) if m else ""


def detect_memory(cache: dict) -> str:
    cached_gb = cache.get("ram_gb")
    if isinstance(cached_gb, int) and 1 <= cached_gb <= 4096:
        return f"{cached_gb} GB"

    try:
        for line in Path("/proc/meminfo").read_text(encoding="utf-8", errors="ignore").splitlines():
            if line.startswith("MemTotal:"):
                kb = int(line.split()[1])
                gib = kb / (1024.0 * 1024.0)
                gb_dec = (kb * 1024.0) / 1e9
                standard_sizes = [1, 2, 3, 4, 6, 8, 12, 16, 24, 32, 48, 64, 96, 128, 192, 256, 384, 512, 1024]
                for std in standard_sizes:
                    if abs(gb_dec - std) / std <= 0.10 or abs(gib - std) / std <= 0.10:
                        return f"{std} GB"
                if gib >= 1:
                    return f"{round(gib)} GB"
                return f"{round(kb / 1024)} MB"
    except Exception:
        pass
    return "Unknown"


def detect_startup_disk() -> str:
    generic_partlabels = {
        "linux filesystem",
        "basic data partition",
        "efi system partition",
        "root",
        "rootfs",
        "/",
    }
    try:
        src = ""
        fs_label = ""
        res = subprocess.run(
            ["findmnt", "-n", "-o", "SOURCE,LABEL", "/"],
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            text=True,
            timeout=2,
            check=False,
        )
        if res.returncode == 0 and res.stdout.strip():
            # findmnt -P is safer with spaces in label
            p_res = subprocess.run(
                ["findmnt", "-n", "-P", "-o", "SOURCE,LABEL", "/"],
                stdout=subprocess.PIPE,
                stderr=subprocess.DEVNULL,
                text=True,
                timeout=2,
                check=False,
            )
            m_src = re.search(r'SOURCE="([^"]*)"', p_res.stdout)
            m_lbl = re.search(r'LABEL="([^"]*)"', p_res.stdout)
            src = (m_src.group(1) if m_src else "").split("[", 1)[0].strip()
            fs_label = (m_lbl.group(1) if m_lbl else "").strip()
        if fs_label and not re.fullmatch(r"[0-9a-fA-F-]{16,}", fs_label):
            return fs_label

        if src and os.path.exists(src):
            part_res = subprocess.run(
                ["lsblk", "-n", "-P", "-o", "LABEL,PARTLABEL,PKNAME,MODEL", src],
                stdout=subprocess.PIPE,
                stderr=subprocess.DEVNULL,
                text=True,
                timeout=2,
                check=False,
            )
            txt = part_res.stdout.splitlines()[0] if part_res.stdout else ""
            m_pl = re.search(r'PARTLABEL="([^"]*)"', txt)
            m_pk = re.search(r'PKNAME="([^"]*)"', txt)
            m_md = re.search(r'MODEL="([^"]*)"', txt)
            partlabel = (m_pl.group(1) if m_pl else "").strip()
            if partlabel and partlabel.lower() not in generic_partlabels:
                return partlabel
            model = (m_md.group(1) if m_md else "").strip()
            pkname = (m_pk.group(1) if m_pk else "").strip()
            if not model and pkname:
                d_res = subprocess.run(
                    ["lsblk", "-d", "-n", "-o", "MODEL", f"/dev/{pkname}"],
                    stdout=subprocess.PIPE,
                    stderr=subprocess.DEVNULL,
                    text=True,
                    timeout=2,
                    check=False,
                )
                model = d_res.stdout.strip()
            if model:
                return re.sub(r"\s+", " ", model).strip()
            if pkname:
                sys_model = Path(f"/sys/class/block/{pkname}/device/model")
                if sys_model.is_file():
                    return re.sub(r"\s+", " ", sys_model.read_text(encoding="utf-8", errors="ignore")).strip()
    except Exception:
        pass

    os_release = Path("/etc/os-release")
    if os_release.is_file():
        for line in os_release.read_text(encoding="utf-8", errors="ignore").splitlines():
            if line.startswith("PRETTY_NAME="):
                return line.split("=", 1)[1].strip().strip('"')
    return "Linux Disk"


def detect_serial(cache: dict, strings: dict) -> str:
    serial = (
        read_dmi("product_serial", cache)
        or read_dmi("board_serial", cache)
        or read_dmi("chassis_serial", cache)
        or clean_dmi_value(str(cache.get("serial", "")))
    )
    if serial:
        return serial
    return strings["unavailable"]


def detect_macw1y_version() -> str:
    candidates = [
        Path(__file__).resolve().parent.parent / "info.json",
        Path("/usr/share/mactheme/info.json"),
        Path("/etc/macW1Y/info.json"),
        Path.home() / ".local/share/macW1Y/info.json",
        Path.home() / ".config/mac-styling/info.json",
    ]
    for c in candidates:
        if c.is_file():
            try:
                data = json.loads(c.read_text(encoding="utf-8"))
                ver = str(data.get("version", "")).strip()
                if ver:
                    return ver
            except Exception:
                pass
    return "0.8"


def find_windows_assets_dir() -> Path | None:
    candidates = [
        Path.home() / ".config" / "gtk-4.0" / "windows-assets",
        Path(__file__).resolve().parent.parent / "config" / "gtk-4.0" / "windows-assets",
        Path("/usr/share/mactheme/gtk-4.0/windows-assets"),
        Path.home() / ".themes" / "macW1Y-Dark" / "gtk-4.0" / "windows-assets",
        Path("/usr/share/themes/macW1Y-Dark/gtk-4.0/windows-assets"),
    ]
    for c in candidates:
        if (c / "button-close.png").is_file():
            return c
    return None


def find_device_asset(is_laptop: bool) -> str | None:
    fname = "about-laptop.png" if is_laptop else "about-desktop.png"
    candidates = [
        Path(__file__).resolve().parent.parent / "assets" / "icons" / fname,
        Path("/usr/share/mactheme/icons") / fname,
        Path.home() / ".local/share/macW1Y/icons" / fname,
        Path.home() / "macW1Y/assets/icons" / fname,
        Path.home() / "MACTHEMEFILES/assets/icons" / fname,
    ]
    for c in candidates:
        if c.is_file():
            return str(c)
    return None


def collect_hardware_info() -> dict:
    lang = detect_locale()
    strings = STRINGS.get(lang, STRINGS["en"])
    cache = load_cached_hwinfo()
    is_laptop = is_laptop_device(cache)
    device_name = detect_device_name(cache, is_laptop)
    chip_short, chip_full = detect_cpu()
    year = detect_board_year(cache)
    subtitle = f"{chip_short}, {year}" if year else chip_short

    return {
        "locale": lang,
        "strings": strings,
        "is_laptop": is_laptop,
        "asset": find_device_asset(is_laptop),
        "device_name": device_name,
        "subtitle": subtitle,
        "chip_short": chip_short,
        "chip_full": chip_full,
        "year": year,
        "memory": detect_memory(cache),
        "startup_disk": detect_startup_disk(),
        "serial": detect_serial(cache, strings),
        "version": detect_macw1y_version(),
    }


def open_system_about():
    env = dict(os.environ)
    env["MAC_SETTINGS_OPEN_ABOUT"] = "1"
    args = ["gnome-control-center", "system", "about"]
    try:
        res = subprocess.run(
            ["gnome-control-center", "--list"],
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            text=True,
            timeout=2,
            check=False,
        )
        panels = res.stdout.lower() if res.returncode == 0 else ""
        if panels and "system" not in panels:
            if "info-overview" in panels:
                args = ["gnome-control-center", "info-overview"]
            elif "about" in panels:
                args = ["gnome-control-center", "about"]
    except Exception:
        pass

    try:
        subprocess.Popen(args, env=env, start_new_session=True)
    except Exception:
        pass


def open_github_link():
    try:
        from gi.repository import Gio
        Gio.AppInfo.launch_default_for_uri(REPO_URL, None)
    except Exception:
        try:
            subprocess.Popen(["xdg-open", REPO_URL], start_new_session=True)
        except Exception:
            pass


