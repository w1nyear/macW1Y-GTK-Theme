def update_file(path, content):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, "w", encoding="utf-8") as f:
        f.write(content)
    print(f"  ✓ Written: {path}")

def place_master_imports(file_path):
    if not os.path.exists(file_path):
        return
    with open(file_path, "r", encoding="utf-8") as f:
        content = f.read()

    # Strip existing macw1y imports
    content = re.sub(r"@import\s+url\([\"'][^\"']*macw1y-[^\"']*\.css[\"']\);\s*\n?", "", content)
    content = re.sub(r"/\* macW1Y Global Component Master Overrides \(SSOT\) \*/\s*\n?", "", content)

    # Place tokens at the very top, and components at the very bottom
    new_content = "@import url(\"macw1y-tokens.css\");\n" + content.lstrip()
    if not new_content.endswith("\n"):
        new_content += "\n"
    new_content += "\n/* macW1Y Global Component Master Overrides (SSOT) */\n@import url(\"macw1y-components.css\");\n"

    with open(file_path, "w", encoding="utf-8") as f:
        f.write(new_content)
    print(f"  ✓ Configured SSOT imports in {file_path}")

def build_all():
    print("===================================================================")
    print("       macW1Y 0.6 — Master UI Theme Compiler (mac-build-theme)     ")
    print("===================================================================")
    
    tokens = load_tokens()
    print("✓ Loaded SSOT tokens from config/macw1y-tokens.json")

    gtk4_tokens_dark = generate_gtk4_tokens_css(tokens, is_dark=True)
    gtk4_components_dark = generate_gtk4_components_css(tokens, is_dark=True)
    gtk4_tokens_light = generate_gtk4_tokens_css(tokens, is_dark=False)
    gtk4_components_light = generate_gtk4_components_css(tokens, is_dark=False)
    gtk3_tokens = generate_gtk3_tokens_css(tokens, is_dark=True)
    gtk3_components = generate_gtk3_components_css(tokens, is_dark=True)

    # 1. Repository Files (defaults to dark mode SSOT)
    update_file(os.path.join(REPO_DIR, "gtk-4.0/macw1y-tokens.css"), gtk4_tokens_dark)
    update_file(os.path.join(REPO_DIR, "gtk-4.0/macw1y-components.css"), gtk4_components_dark)
    update_file(os.path.join(REPO_DIR, "gtk-3.0/macw1y-tokens.css"), gtk3_tokens)
    update_file(os.path.join(REPO_DIR, "gtk-3.0/macw1y-components.css"), gtk3_components)

    all_theme_names = ["macW1Y-Dark", "macW1Y-Light", "macW1Y-Dark-solid", "macW1Y-Light-solid"]
    for tname in all_theme_names:
        tp = os.path.join(REPO_DIR, tname)
        if os.path.exists(tp):
            is_dark = "Dark" in tname
            t_gtk4_tok = generate_gtk4_tokens_css(tokens, is_dark=is_dark)
            t_gtk4_comp = generate_gtk4_components_css(tokens, is_dark=is_dark)
            t_gtk3_tok = generate_gtk3_tokens_css(tokens, is_dark=is_dark)
            t_gtk3_comp = generate_gtk3_components_css(tokens, is_dark=is_dark)
            update_file(os.path.join(tp, "gtk-4.0/macw1y-tokens.css"), t_gtk4_tok)
            update_file(os.path.join(tp, "gtk-4.0/macw1y-components.css"), t_gtk4_comp)
            update_file(os.path.join(tp, "gtk-3.0/macw1y-tokens.css"), t_gtk3_tok)
            update_file(os.path.join(tp, "gtk-3.0/macw1y-components.css"), t_gtk3_comp)

    # 2. Wire imports in repo gtk-4.0/gtk.css & fixes4.css
    place_master_imports(os.path.join(REPO_DIR, "gtk-4.0/gtk.css"))
    place_master_imports(os.path.join(REPO_DIR, "gtk-4.0/gtk-Dark.css"))
    place_master_imports(os.path.join(REPO_DIR, "gtk-3.0/gtk.css"))

    # Config directory files
    if os.path.exists(os.path.join(REPO_DIR, "config/gtk-4.0")):
        update_file(os.path.join(REPO_DIR, "config/gtk-4.0/macw1y-tokens.css"), gtk4_tokens_dark)
        update_file(os.path.join(REPO_DIR, "config/gtk-4.0/macw1y-components.css"), gtk4_components_dark)
        place_master_imports(os.path.join(REPO_DIR, "config/gtk-4.0/gtk.css"))
        place_master_imports(os.path.join(REPO_DIR, "config/gtk-4.0/gtk-Dark.css"))
        if os.path.exists(os.path.join(REPO_DIR, "config/gtk-4.0/gtk-Light.css")):
            place_master_imports(os.path.join(REPO_DIR, "config/gtk-4.0/gtk-Light.css"))
    if os.path.exists(os.path.join(REPO_DIR, "config/gtk-3.0")):
        update_file(os.path.join(REPO_DIR, "config/gtk-3.0/macw1y-tokens.css"), gtk3_tokens)
        update_file(os.path.join(REPO_DIR, "config/gtk-3.0/macw1y-components.css"), gtk3_components)
        place_master_imports(os.path.join(REPO_DIR, "config/gtk-3.0/gtk.css"))

    # 3. User ~/.config/gtk-4.0/ and ~/.config/gtk-3.0/
    user_gtk4 = os.path.join(HOME, ".config/gtk-4.0")
    user_gtk3 = os.path.join(HOME, ".config/gtk-3.0")
    update_file(os.path.join(user_gtk4, "macw1y-tokens.css"), gtk4_tokens_dark)
    update_file(os.path.join(user_gtk4, "macw1y-components.css"), gtk4_components_dark)
    update_file(os.path.join(user_gtk3, "macw1y-tokens.css"), gtk3_tokens)
    update_file(os.path.join(user_gtk3, "macw1y-components.css"), gtk3_components)

    # Ensure gtk-Light.css has master imports and gtk.css is based on Light
    if os.path.exists(os.path.join(user_gtk4, "gtk-Light.css")):
        place_master_imports(os.path.join(user_gtk4, "gtk-Light.css"))
    place_master_imports(os.path.join(user_gtk4, "gtk-Dark.css"))
    place_master_imports(os.path.join(user_gtk3, "gtk.css"))

    # 4. User ~/.themes/
    for tname in all_theme_names:
        user_theme = os.path.join(HOME, ".themes", tname)
        if os.path.exists(user_theme):
            is_dark = "Dark" in tname
            t_gtk4_tok = generate_gtk4_tokens_css(tokens, is_dark=is_dark)
            t_gtk4_comp = generate_gtk4_components_css(tokens, is_dark=is_dark)
            t_gtk3_tok = generate_gtk3_tokens_css(tokens, is_dark=is_dark)
            t_gtk3_comp = generate_gtk3_components_css(tokens, is_dark=is_dark)
            update_file(os.path.join(user_theme, "gtk-4.0/macw1y-tokens.css"), t_gtk4_tok)
            update_file(os.path.join(user_theme, "gtk-4.0/macw1y-components.css"), t_gtk4_comp)
            update_file(os.path.join(user_theme, "gtk-3.0/macw1y-tokens.css"), t_gtk3_tok)
            update_file(os.path.join(user_theme, "gtk-3.0/macw1y-components.css"), t_gtk3_comp)
            place_master_imports(os.path.join(user_theme, "gtk-4.0/gtk.css"))
            place_master_imports(os.path.join(user_theme, "gtk-3.0/gtk.css"))

    # 5. System /usr/share/themes/ if writable or via sudo
    for tname in all_theme_names:
        sys_theme = os.path.join("/usr/share/themes", tname)
        if os.path.exists(sys_theme):
            repo_t_path = os.path.join(REPO_DIR, tname)
            is_dark = "Dark" in tname
            t_gtk4_tok = generate_gtk4_tokens_css(tokens, is_dark=is_dark)
            t_gtk4_comp = generate_gtk4_components_css(tokens, is_dark=is_dark)
            t_gtk3_tok = generate_gtk3_tokens_css(tokens, is_dark=is_dark)
            t_gtk3_comp = generate_gtk3_components_css(tokens, is_dark=is_dark)
            try:
                update_file(os.path.join(sys_theme, "gtk-4.0/macw1y-tokens.css"), t_gtk4_tok)
                update_file(os.path.join(sys_theme, "gtk-4.0/macw1y-components.css"), t_gtk4_comp)
                update_file(os.path.join(sys_theme, "gtk-3.0/macw1y-tokens.css"), t_gtk3_tok)
                update_file(os.path.join(sys_theme, "gtk-3.0/macw1y-components.css"), t_gtk3_comp)
                place_master_imports(os.path.join(sys_theme, "gtk-4.0/gtk.css"))
                place_master_imports(os.path.join(sys_theme, "gtk-3.0/gtk.css"))
            except PermissionError:
                subprocess.run(["sudo", "cp", "-f", os.path.join(REPO_DIR, "gtk-4.0/macw1y-tokens.css"), os.path.join(sys_theme, "gtk-4.0/")], check=False)
                subprocess.run(["sudo", "cp", "-f", os.path.join(REPO_DIR, "gtk-4.0/macw1y-components.css"), os.path.join(sys_theme, "gtk-4.0/")], check=False)
                if os.path.exists(os.path.join(repo_t_path, "gtk-4.0/gtk.css")):
                    subprocess.run(["sudo", "cp", "-f", os.path.join(repo_t_path, "gtk-4.0/gtk.css"), os.path.join(sys_theme, "gtk-4.0/gtk.css")], check=False)
                if os.path.exists(os.path.join(repo_t_path, "gtk-3.0/gtk.css")):
                    subprocess.run(["sudo", "cp", "-f", os.path.join(repo_t_path, "gtk-3.0/gtk.css"), os.path.join(sys_theme, "gtk-3.0/gtk.css")], check=False)

    print("\n🎉 Master Theme Compilation 100% Successful!")
    print("===================================================================")

if __name__ == "__main__":
    build_all()
