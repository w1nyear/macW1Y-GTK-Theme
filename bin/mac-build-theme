def update_file(path, content):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, "w", encoding="utf-8") as f:
        f.write(content)
    print(f"  ✓ Written: {path}")

def place_master_imports(file_path):
    if not os.path.exists(file_path):
        return
    with open(file_path, "r", encoding="utf-8") as f:
        content = f.read()

    # Strip existing macw1y imports
    content = re.sub(r"@import\s+url\([\"'][^\"']*macw1y-[^\"']*\.css[\"']\);\s*\n?", "", content)
    content = re.sub(r"/\* macW1Y Global Component Master Overrides \(SSOT\) \*/\s*\n?", "", content)

    # Place tokens at the very top, and components at the very bottom
    new_content = "@import url(\"macw1y-tokens.css\");\n" + content.lstrip()
    if not new_content.endswith("\n"):
        new_content += "\n"
    new_content += "\n/* macW1Y Global Component Master Overrides (SSOT) */\n@import url(\"macw1y-components.css\");\n"

    with open(file_path, "w", encoding="utf-8") as f:
        f.write(new_content)
    print(f"  ✓ Configured SSOT imports in {file_path}")

def build_all():
    print("===================================================================")
    print("       macW1Y 0.4 — Master UI Theme Compiler (mac-build-theme)     ")
    print("===================================================================")
    
    tokens = load_tokens()
    print("✓ Loaded SSOT tokens from config/macw1y-tokens.json")

    gtk4_tokens = generate_gtk4_tokens_css(tokens)
    gtk4_components = generate_gtk4_components_css(tokens)
    gtk3_tokens = generate_gtk3_tokens_css(tokens)
    gtk3_components = generate_gtk3_components_css(tokens)

    # 1. Repository Files
    update_file(os.path.join(REPO_DIR, "gtk-4.0/macw1y-tokens.css"), gtk4_tokens)
    update_file(os.path.join(REPO_DIR, "gtk-4.0/macw1y-components.css"), gtk4_components)
    update_file(os.path.join(REPO_DIR, "gtk-3.0/macw1y-tokens.css"), gtk3_tokens)
    update_file(os.path.join(REPO_DIR, "gtk-3.0/macw1y-components.css"), gtk3_components)

    update_file(os.path.join(REPO_DIR, "macW1Y-Dark/gtk-4.0/macw1y-tokens.css"), gtk4_tokens)
    update_file(os.path.join(REPO_DIR, "macW1Y-Dark/gtk-4.0/macw1y-components.css"), gtk4_components)
    update_file(os.path.join(REPO_DIR, "macW1Y-Dark/gtk-3.0/macw1y-tokens.css"), gtk3_tokens)
    update_file(os.path.join(REPO_DIR, "macW1Y-Dark/gtk-3.0/macw1y-components.css"), gtk3_components)

    # 2. Wire imports in repo gtk-4.0/gtk.css & fixes4.css
    place_master_imports(os.path.join(REPO_DIR, "gtk-4.0/gtk.css"))
    place_master_imports(os.path.join(REPO_DIR, "gtk-4.0/gtk-Dark.css"))
    place_master_imports(os.path.join(REPO_DIR, "gtk-3.0/gtk.css"))

    # 3. User ~/.config/gtk-4.0/ and ~/.config/gtk-3.0/
    user_gtk4 = os.path.join(HOME, ".config/gtk-4.0")
    user_gtk3 = os.path.join(HOME, ".config/gtk-3.0")
    update_file(os.path.join(user_gtk4, "macw1y-tokens.css"), gtk4_tokens)
    update_file(os.path.join(user_gtk4, "macw1y-components.css"), gtk4_components)
    update_file(os.path.join(user_gtk3, "macw1y-tokens.css"), gtk3_tokens)
    update_file(os.path.join(user_gtk3, "macw1y-components.css"), gtk3_components)

    place_master_imports(os.path.join(user_gtk4, "gtk.css"))
    place_master_imports(os.path.join(user_gtk4, "gtk-Dark.css"))
    place_master_imports(os.path.join(user_gtk3, "gtk.css"))

    # 4. User ~/.themes/macW1Y-Dark/
    user_theme = os.path.join(HOME, ".themes/macW1Y-Dark")
    if os.path.exists(user_theme):
        update_file(os.path.join(user_theme, "gtk-4.0/macw1y-tokens.css"), gtk4_tokens)
        update_file(os.path.join(user_theme, "gtk-4.0/macw1y-components.css"), gtk4_components)
        update_file(os.path.join(user_theme, "gtk-3.0/macw1y-tokens.css"), gtk3_tokens)
        update_file(os.path.join(user_theme, "gtk-3.0/macw1y-components.css"), gtk3_components)
        place_master_imports(os.path.join(user_theme, "gtk-4.0/gtk.css"))
        place_master_imports(os.path.join(user_theme, "gtk-3.0/gtk.css"))

    # 5. System /usr/share/themes/macW1Y-Dark/ if writable or via sudo
    sys_theme = "/usr/share/themes/macW1Y-Dark"
    if os.path.exists(sys_theme):
        try:
            update_file(os.path.join(sys_theme, "gtk-4.0/macw1y-tokens.css"), gtk4_tokens)
            update_file(os.path.join(sys_theme, "gtk-4.0/macw1y-components.css"), gtk4_components)
            update_file(os.path.join(sys_theme, "gtk-3.0/macw1y-tokens.css"), gtk3_tokens)
            update_file(os.path.join(sys_theme, "gtk-3.0/macw1y-components.css"), gtk3_components)
            place_master_imports(os.path.join(sys_theme, "gtk-4.0/gtk.css"))
            place_master_imports(os.path.join(sys_theme, "gtk-3.0/gtk.css"))
        except PermissionError:
            subprocess.run(["sudo", "cp", "-f", os.path.join(REPO_DIR, "gtk-4.0/macw1y-tokens.css"), os.path.join(sys_theme, "gtk-4.0/")], check=False)
            subprocess.run(["sudo", "cp", "-f", os.path.join(REPO_DIR, "gtk-4.0/macw1y-components.css"), os.path.join(sys_theme, "gtk-4.0/")], check=False)
            subprocess.run(["sudo", "cp", "-f", os.path.join(REPO_DIR, "gtk-3.0/macw1y-tokens.css"), os.path.join(sys_theme, "gtk-3.0/")], check=False)
            subprocess.run(["sudo", "cp", "-f", os.path.join(REPO_DIR, "gtk-3.0/macw1y-components.css"), os.path.join(sys_theme, "gtk-3.0/")], check=False)
            subprocess.run(["sudo", "cp", "-f", os.path.join(REPO_DIR, "macW1Y-Dark/gtk-4.0/gtk.css"), os.path.join(sys_theme, "gtk-4.0/gtk.css")], check=False)
            subprocess.run(["sudo", "cp", "-f", os.path.join(REPO_DIR, "macW1Y-Dark/gtk-3.0/gtk.css"), os.path.join(sys_theme, "gtk-3.0/gtk.css")], check=False)

    print("\n🎉 Master Theme Compilation 100% Successful!")
    print("===================================================================")

if __name__ == "__main__":
    build_all()
