def generate_gtk3_tokens_css(tokens):
    c = tokens["colors"]
    g = tokens["geometry"]
    d = tokens["dimensions"]
    
    css = f"""/* macW1Y 0.4 — Master Design Tokens for GTK 3 */
/* DO NOT EDIT DIRECTLY: Generated from config/macw1y-tokens.json */

@define-color accent_bg_color {c["accent_bg"]};
@define-color accent_fg_color {c["accent_fg"]};
@define-color theme_base_color {c["window_bg"]};
@define-color theme_text_color {c["window_fg"]};
@define-color theme_bg_color {c["window_bg"]};
@define-color theme_fg_color {c["window_fg"]};
@define-color theme_selected_bg_color {c["accent_bg"]};
@define-color theme_selected_fg_color {c["accent_fg"]};
"""
    return css

def generate_gtk3_components_css(tokens):
    c = tokens["colors"]
    g = tokens["geometry"]
    d = tokens["dimensions"]
    e = tokens["effects"]
    t = tokens["typography"]

    css = f"""/* macW1Y 0.4 — Master Unified Component Stylesheet for GTK 3 */
/* DO NOT EDIT DIRECTLY: Generated from config/macw1y-tokens.json */

/* Window Background */
window,
