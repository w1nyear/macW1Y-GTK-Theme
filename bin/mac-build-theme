#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
macW1Y 0.4 — Centralized Master Theme Compiler (mac-build-theme)
Reads Single Source of Truth (SSOT) from config/macw1y-tokens.json
and generates unified stylesheets for GTK 4, GTK 3, and Libadwaita.
"""

import os
import sys
import json
import re
import subprocess

REPO_DIR = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
TOKENS_PATH = os.path.join(REPO_DIR, "config/macw1y-tokens.json")
HOME = os.path.expanduser("~")

def load_tokens():
    if not os.path.exists(TOKENS_PATH):
        print(f"Error: Tokens file not found at {TOKENS_PATH}")
        sys.exit(1)
    with open(TOKENS_PATH, "r", encoding="utf-8") as f:
        return json.load(f)

def generate_gtk4_tokens_css(tokens):
    c = tokens["colors"]
    g = tokens["geometry"]
    d = tokens["dimensions"]
    t = tokens["typography"]
    
    css = f"""/* macW1Y 0.4 — Generated Master Design Tokens for GTK 4 / Libadwaita */
/* DO NOT EDIT DIRECTLY: Generated from config/macw1y-tokens.json */

@define-color accent_bg_color {c["accent_bg"]};
@define-color accent_fg_color {c["accent_fg"]};
@define-color accent_color {c["accent_bg"]};
@define-color window_bg_color {c["window_bg"]};
@define-color window_fg_color {c["window_fg"]};
@define-color view_bg_color {c["window_bg"]};
@define-color view_fg_color {c["window_fg"]};
@define-color headerbar_bg_color transparent;
@define-color headerbar_fg_color {c["window_fg"]};
@define-color card_bg_color {c["card_bg"]};
@define-color card_fg_color {c["window_fg"]};
@define-color popover_bg_color {c["popover_bg"]};
@define-color popover_fg_color {c["window_fg"]};
@define-color dialog_bg_color {c["card_bg"]};
@define-color dialog_fg_color {c["window_fg"]};
@define-color destructive_bg_color {c["destructive_bg"]};
@define-color destructive_fg_color {c["destructive_fg"]};
@define-color success_bg_color {c["success_bg"]};
@define-color warning_bg_color {c["warning_bg"]};

:root {{
  --mac-window-bg: {c["window_bg"]};
  --mac-window-fg: {c["window_fg"]};
  --mac-sidebar-bg: {c["sidebar_bg"]};
  --mac-sidebar-bg-translucent: {c["sidebar_bg_translucent"]};
  --mac-card-bg: {c["card_bg"]};
  --mac-card-border: {c["card_border"]};
  --mac-card-shadow: {c["card_shadow"]};
  --mac-card-sep: {c["card_separator"]};
  --mac-row-hover: {c["row_hover"]};
  --mac-row-active: {c["row_active"]};
  --mac-accent-bg: {c["accent_bg"]};
  --mac-accent-fg: {c["accent_fg"]};
  --mac-text-primary: {c["text_primary"]};
  --mac-text-secondary: {c["text_secondary"]};
  --mac-text-disabled: {c["text_disabled"]};
  --mac-input-bg: {c["input_bg"]};
  --mac-input-border: {c["input_border"]};
  --mac-input-focus-bg: {c["input_focus_bg"]};
  --mac-input-focus-border: {c["input_focus_border"]};
  --mac-popover-bg: {c["popover_bg"]};
  --mac-popover-border: {c["popover_border"]};

  --mac-window-radius: {g["window_radius"]}px;
  --mac-card-radius: {g["card_radius"]}px;
  --mac-button-radius: {g["button_radius"]}px;
  --mac-button-action-radius: {g["button_action_radius"]}px;
  --mac-input-radius: {g["input_radius"]}px;
  --mac-menu-radius: {g["menu_radius"]}px;
  --mac-popover-radius: {g["popover_radius"]}px;

  --mac-row-min-height: {d["row_min_height"]}px;
  --mac-row-padding-x: {d["row_padding_x"]}px;
  --mac-switch-w: {d["switch_width"]}px;
  --mac-switch-h: {d["switch_height"]}px;
  --mac-slider-thumb: {d["slider_thumb_size"]}px;
}}
"""
    return css

