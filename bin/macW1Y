#!/usr/bin/env bash
# ==============================================================================
#   macW1Y — macW1Y Transformation, Developer & Debug CLI System
# ==============================================================================

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_DIR="$(dirname "$SCRIPT_DIR")"
VERSION="0.8"
for _info_path in "$REPO_DIR/info.json" "$SCRIPT_DIR/info.json" "/usr/share/mactheme/info.json" "$HOME/.local/share/macW1Y/info.json"; do
    if [ -f "$_info_path" ]; then
        _v=$(grep -Po '"version":\s*"\K[^"]+' "$_info_path" 2>/dev/null || sed -n 's/.*"version"[^"]*"\([^"]*\)".*/\1/p' "$_info_path" 2>/dev/null)
        if [ -n "$_v" ]; then
            VERSION="$_v"
            break
        fi
    fi
done

# ANSI Colors
C_RESET="\033[0m"
C_BOLD="\033[1m"
C_CYAN="\033[1;36m"
C_BLUE="\033[1;34m"
C_GREEN="\033[1;32m"
C_YELLOW="\033[1;33m"
C_RED="\033[1;31m"
C_MAGENTA="\033[1;35m"
C_GRAY="\033[0;90m"

SEARCH_DIRS=(
    "/usr/local/bin"
    "/usr/bin"
    "$SCRIPT_DIR"
    "/home/$USER/macW1Y/bin"
    "/home/$USER/MACTHEMEFILES/bin"
)

show_banner() {
    echo -e "${C_CYAN}  ╔════════════════════════════════════════════════════════════════════════════╗${C_RESET}"
    echo -e "${C_CYAN}  ║${C_RESET} ${C_BOLD}  m a c W 1 Y   D e b u g   &   C L I   E n v i r o n m e n t${C_RESET}          ${C_CYAN}║${C_RESET}"
    echo -e "${C_CYAN}  ║${C_RESET}      Developer Tools, System Diagnostics & Configuration (v${VERSION})      ${C_CYAN}║${C_RESET}"
    echo -e "${C_CYAN}  ╚════════════════════════════════════════════════════════════════════════════╝${C_RESET}"
}

show_help() {
    show_banner
    echo -e "\n ${C_BOLD}Usage:${C_RESET} ${C_GREEN}macW1Y${C_RESET} ${C_YELLOW}<command>${C_RESET} ${C_GRAY}[arguments...]${C_RESET}"
    echo -e "        ${C_GREEN}macW1Y${C_RESET} ${C_YELLOW}-?${C_RESET}  ${C_GRAY}(show this full command reference)${C_RESET}\n"

    echo -e " ${C_BOLD}${C_BLUE}▶ System & Setup:${C_RESET}"
    printf "   ${C_CYAN}%-26s${C_RESET} %-18s %s\n" "mac-gdm-bypass" "[bypass]" "Emergency GDM bypass & auto-login recovery to desktop GUI"
    printf "   ${C_CYAN}%-26s${C_RESET} %-18s %s\n" "mac-setup-wizard" "[wizard]" "Initial macW1Y setup wizard controller (start|status|reset|stop)"
    printf "   ${C_CYAN}%-26s${C_RESET} %-18s %s\n" "mac-diagnostics" "[diag]" "Run comprehensive system diagnostics & baseline check"
    printf "   ${C_CYAN}%-26s${C_RESET} %-18s %s\n" "mac-audit-sync" "[audit]" "Audit system files, libraries, dock & repo synchronization"
    printf "   ${C_CYAN}%-26s${C_RESET} %-18s %s\n" "mac-extension-guard" "[guard]" "GNOME Shell extensions version lock & integrity watchdog"
    printf "   ${C_CYAN}%-26s${C_RESET} %-18s %s\n" "mac-i18n-verify" "[i18n]" "Validate internationalization catalog & translations"
    printf "   ${C_CYAN}%-26s${C_RESET} %-18s %s\n" "mac-integrity-check" "[integrity]" "Verify package and modpack file checksums"

    echo -e "\n ${C_BOLD}${C_BLUE}▶ Styling & Themes:${C_RESET}"
    printf "   ${C_CYAN}%-26s${C_RESET} %-18s %s\n" "mac-apply-theme" "[theme]" "Switch macW1Y theme variant (dark, light, solid, default)"
    printf "   ${C_CYAN}%-26s${C_RESET} %-18s %s\n" "mac-apply-locale" "[locale]" "Synchronize system language and interface translations"
    printf "   ${C_CYAN}%-26s${C_RESET} %-18s %s\n" "mac-styling-settings" "[styling]" "Open macW1Y Liquid Glass and shader styling settings"
    printf "   ${C_CYAN}%-26s${C_RESET} %-18s %s\n" "mac-build-theme" "[build-theme]" "Recompile GTK3, GTK4, and GNOME Shell theme CSS"
    printf "   ${C_CYAN}%-26s${C_RESET} %-18s %s\n" "mac-login-sound" "[sound]" "Configure macW1Y startup chime sound"

    echo -e "\n ${C_BOLD}${C_BLUE}▶ Desktop & Widgets:${C_RESET}"
    printf "   ${C_CYAN}%-26s${C_RESET} %-18s %s\n" "mac-widgets-settings" "[widgets]" "Desktop widgets settings panel"
    printf "   ${C_CYAN}%-26s${C_RESET} %-18s %s\n" "mac-widget-picker" "[picker]" "Open interactive macW1Y desktop widget picker gallery"
    printf "   ${C_CYAN}%-26s${C_RESET} %-18s %s\n" "mac-clipboard" "[clipboard]" "Open smart macW1Y clipboard history dialog"
    printf "   ${C_CYAN}%-26s${C_RESET} %-18s %s\n" "mac-airdrop" "[airdrop]" "macW1Y AirDrop file receiver and network daemon"
    printf "   ${C_CYAN}%-26s${C_RESET} %-18s %s\n" "mac-touchpad-daemon" "[touchpad]" "macW1Y 3-finger / 4-finger gestures daemon"
    printf "   ${C_CYAN}%-26s${C_RESET} %-18s %s\n" "mac-sync-applications" "[sync-apps]" "Synchronize application launcher entries & desktop icons"
    printf "   ${C_CYAN}%-26s${C_RESET} %-18s %s\n" "mac-uninstall-app" "[uninstall-app]" "macW1Y drag-to-trash application uninstaller"
    printf "   ${C_CYAN}%-26s${C_RESET} %-18s %s\n" "mac-screenshot-process" "[screenshot]" "macW1Y screenshot & screen recording processor"

    echo -e "\n ${C_BOLD}${C_BLUE}▶ Hardware & Gaming:${C_RESET}"
    printf "   ${C_CYAN}%-26s${C_RESET} %-18s %s\n" "mac-gamemode" "[gamemode]" "macW1Y Game Mode optimization controller (on|off|auto|status)"
    printf "   ${C_CYAN}%-26s${C_RESET} %-18s %s\n" "mac-gpu-manager" "[gpu]" "Discrete / Integrated GPU manager and launcher"
    printf "   ${C_CYAN}%-26s${C_RESET} %-18s %s\n" "mac-graphics-profile" "[profile]" "Switch graphics profile (balanced|high|performance|auto)"
    printf "   ${C_CYAN}%-26s${C_RESET} %-18s %s\n" "mac-boot-config" "[boot]" "macW1Y macW1Y GRUB boot menu configuration"
    printf "   ${C_CYAN}%-26s${C_RESET} %-18s %s\n" "mac-wine-runner" "[wine]" "macW1Y Wine/Proton compatibility runner"
    printf "   ${C_CYAN}%-26s${C_RESET} %-18s %s\n" "mac-capcut-fix" "[capcut]" "Fix CapCut video editor hardware acceleration & rendering"

    echo -e "\n ${C_BOLD}${C_BLUE}▶ Debug & Maintenance:${C_RESET}"
    printf "   ${C_CYAN}%-26s${C_RESET} %-18s %s\n" "eval <javascript>" "[js]" "Execute JavaScript directly inside GNOME Shell"
    printf "   ${C_CYAN}%-26s${C_RESET} %-18s %s\n" "version" "[-v, --version]" "Display macW1Y system release and build version"
    printf "   ${C_CYAN}%-26s${C_RESET} %-18s %s\n" "help" "[-?, -h, --help]" "Show this comprehensive command reference"

    echo -e "\n ${C_BOLD}Examples:${C_RESET}"
    echo -e "   ${C_YELLOW}macW1Y mac-GDM-BYPASS${C_RESET}            ${C_GRAY}# Emergency bypass of GDM directly to desktop GUI${C_RESET}"
    echo -e "   ${C_YELLOW}macW1Y Mac-setup-wizard start${C_RESET}    ${C_GRAY}# Launch setup wizard on screen${C_RESET}"
    echo -e "   ${C_YELLOW}macW1Y mac-setup-wizard status${C_RESET}   ${C_GRAY}# View setup wizard configuration flag${C_RESET}"
    echo -e "   ${C_YELLOW}macW1Y diagnostics${C_RESET}               ${C_GRAY}# Run full system diagnostics${C_RESET}"
    echo -e "   ${C_YELLOW}macW1Y audit-sync${C_RESET}                ${C_GRAY}# Run complete system audit${C_RESET}"
    echo -e "   ${C_YELLOW}macW1Y extension-guard verify${C_RESET}    ${C_GRAY}# Verify extension integrity lock${C_RESET}"
    echo -e "   ${C_YELLOW}macW1Y -?${C_RESET}                        ${C_GRAY}# View this help reference${C_RESET}\n"
}

# Resolve canonical tool name from input command (case-insensitive)
resolve_target() {
    local raw="$1"
    local lower
    lower="$(echo "$raw" | tr '[:upper:]' '[:lower:]')"

    # Direct alias mappings
    case "$lower" in
        "mac-gdm-bypass"|"gdm-bypass"|"bypass"|"mac-gdm_bypass"|"gdm_bypass")
            echo "mac-gdm-bypass"
            return 0
            ;;
        "mac-setup-wizard"|"setup-wizard"|"wizard")
            echo "mac-setup-wizard"
            return 0
            ;;
        "mac-diagnostics"|"diagnostics"|"diag")
            echo "mac-diagnostics"
            return 0
            ;;
        "mac-audit-sync"|"audit-sync"|"audit")
            echo "mac-audit-sync"
            return 0
            ;;
        "mac-extension-guard"|"extension-guard"|"guard")
            echo "mac-extension-guard"
            return 0
            ;;
        "mac-i18n-verify"|"i18n-verify"|"i18n")
            echo "mac-i18n-verify"
            return 0
            ;;
        "mac-integrity-check"|"integrity-check"|"integrity")
            echo "mac-integrity-check"
            return 0
            ;;
        "mac-apply-theme"|"apply-theme"|"theme")
            echo "mac-apply-theme"
            return 0
            ;;
        "mac-apply-locale"|"apply-locale"|"locale")
            echo "mac-apply-locale"
            return 0
            ;;
        "mac-styling-settings"|"styling-settings"|"styling")
            echo "mac-styling-settings"
            return 0
            ;;
        "mac-widgets-settings"|"widgets-settings"|"widgets")
            echo "mac-widgets-settings"
            return 0
            ;;
        "mac-widget-picker"|"widget-picker"|"picker")
            echo "mac-widget-picker"
            return 0
            ;;
        "mac-airdrop"|"airdrop")
            echo "mac-airdrop"
            return 0
            ;;
        "mac-clipboard"|"clipboard")
            echo "mac-clipboard"
            return 0
            ;;
        "mac-gamemode"|"gamemode")
            echo "mac-gamemode"
            return 0
            ;;
        "mac-gpu-manager"|"gpu-manager"|"gpu")
            echo "mac-gpu-manager"
            return 0
            ;;
        "mac-graphics-profile"|"graphics-profile"|"profile")
            echo "mac-graphics-profile"
            return 0
            ;;
        "mac-boot-config"|"boot-config"|"boot")
            echo "mac-boot-config"
            return 0
            ;;
        "mac-build-theme"|"build-theme")
            echo "mac-build-theme"
            return 0
            ;;
        "mac-wine-runner"|"wine-runner"|"wine")
            echo "mac-wine-runner"
            return 0
            ;;
        "mac-capcut-fix"|"capcut-fix"|"capcut")
            echo "mac-capcut-fix"
            return 0
            ;;
        "mac-login-sound"|"login-sound"|"sound")
            echo "mac-login-sound"
            return 0
            ;;
        "mac-touchpad-daemon"|"touchpad-daemon"|"touchpad"|"gestures")
            echo "mac-touchpad-daemon"
            return 0
            ;;
        "mac-sync-applications"|"sync-applications"|"sync-apps")
            echo "mac-sync-applications"
            return 0
            ;;
        "mac-uninstall-app"|"uninstall-app")
            echo "mac-uninstall-app"
            return 0
            ;;
        "mac-screenshot-process"|"screenshot-process"|"screenshot")
            echo "mac-screenshot-process"
            return 0
            ;;
        *)
            echo "$lower"
            return 0
            ;;
    esac
}

find_binary() {
    local target="$1"
    
    # 1. Search in SEARCH_DIRS
    for dir in "${SEARCH_DIRS[@]}"; do
        if [ -x "$dir/$target" ]; then
            echo "$dir/$target"
            return 0
        fi
        if [ -x "$dir/mac-$target" ]; then
            echo "$dir/mac-$target"
            return 0
        fi
    done

    # 2. Search in system PATH
    if command -v "$target" >/dev/null 2>&1; then
        command -v "$target"
        return 0
    fi
    if command -v "mac-$target" >/dev/null 2>&1; then
        command -v "mac-$target"
        return 0
    fi

    return 1
}

# No arguments or help request
if [ $# -eq 0 ] || [ "$1" = "-?" ] || [ "$1" = "-h" ] || [ "$1" = "--help" ] || [ "$1" = "help" ]; then
    show_help
    exit 0
fi

# Version request
if [ "$1" = "-v" ] || [ "$1" = "--version" ] || [ "$1" = "version" ]; then
    echo "macW1Y Transformation & Debug System — v${VERSION}"
    exit 0
fi

# Shell Eval helper
if [ "$1" = "eval" ] || [ "$1" = "js" ]; then
    shift
    if [ $# -eq 0 ]; then
        echo -e "${C_RED}Error:${C_RESET} Missing JavaScript code to evaluate."
        echo "Usage: macW1Y eval <javascript_expression>"
        exit 1
    fi
    gdbus call --session --dest org.gnome.Shell \
        --object-path /org/gnome/Shell/Extensions/EvalHelper \
        --method org.gnome.Shell.Extensions.EvalHelper.Eval "$*"
    exit $?
fi

RAW_CMD="$1"
shift

RESOLVED="$(resolve_target "$RAW_CMD")"
BIN_PATH="$(find_binary "$RESOLVED")"

if [ -n "$BIN_PATH" ] && [ -x "$BIN_PATH" ]; then
    exec "$BIN_PATH" "$@"
else
    echo -e "${C_RED}Error:${C_RESET} Unknown macW1Y command '${C_BOLD}$RAW_CMD${C_RESET}'."
    echo -e "Run '${C_YELLOW}macW1Y -?${C_RESET}' to see the list of all available commands and debug tools.\n"
    exit 1
fi
