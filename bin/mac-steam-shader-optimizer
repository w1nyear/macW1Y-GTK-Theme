#!/bin/bash
# mac-steam-shader-optimizer
# Ensures Steam shader pre-caching always uses the configured GPU (Power -> Game Mode GPU Allocation)
# and limits CPU concurrency to 2 threads with idle priority to prevent 100°C CPU overheating.

SUBDIRS=(
    "ubuntu12_64"
    "ubuntu12_32"
    "steamrt64"
    "steamrt32"
)

get_steam_dirs() {
    local dirs=()
    for udir in /home/*; do
        [ -d "$udir" ] || continue
        dirs+=(
            "$udir/snap/steam/common/.local/share/Steam"
            "$udir/.local/share/Steam"
            "$udir/.steam/steam"
        )
    done
    if [ -n "$HOME" ] && [ -d "$HOME" ]; then
        dirs+=(
            "$HOME/snap/steam/common/.local/share/Steam"
            "$HOME/.local/share/Steam"
            "$HOME/.steam/steam"
        )
    fi
    local unique_dirs=()
    local seen=" "
    for d in "${dirs[@]}"; do
        if [ -d "$d" ] && [[ ! "$seen" =~ " $d " ]]; then
            seen="$seen$d "
            unique_dirs+=("$d")
        fi
    done
    echo "${unique_dirs[@]}"
}

WRAPPER_CONTENT='#!/bin/bash
# Steam Fossilize Replayer Smart Wrapper
# Offloads shader pre-caching to the target GPU selected in macOS / GNOME Settings
# Clamps CPU compilation threads to 2 and idle priority to prevent CPU boiling (100°C)

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REAL_BIN="$SCRIPT_DIR/fossilize_replay.real"
if [ ! -x "$REAL_BIN" ]; then
    REAL_BIN="$SCRIPT_DIR/fossilize_replay.bin"
fi

if [ ! -x "$REAL_BIN" ]; then
    echo "Fossilize real binary not found in $SCRIPT_DIR" >&2
    exit 1
fi

# 1. Determine target GPU from macOS / GNOME Settings config
TARGET_GPU=1
CONFIG_FILE="/etc/mac-gpu-targets.json"
if [ ! -f "$CONFIG_FILE" ] && [ -f "$HOME/.config/mac-gpu-targets.json" ]; then
    CONFIG_FILE="$HOME/.config/mac-gpu-targets.json"
fi

if [ -f "$CONFIG_FILE" ]; then
    G_VAL=$(grep -o '"games"[[:space:]]*:[[:space:]]*[0-9]*' "$CONFIG_FILE" 2>/dev/null | grep -o '[0-9]*$')
    if [ -n "$G_VAL" ]; then
        TARGET_GPU="$G_VAL"
    fi
fi

# 2. Configure Vulkan Driver & Offload based on selected GPU
if [ "$TARGET_GPU" -eq 1 ]; then
    # Discrete NVIDIA GPU selected
    export __NV_PRIME_RENDER_OFFLOAD=1
    export __GLX_VENDOR_LIBRARY_NAME=nvidia
    export __VK_LAYER_NV_optimus=NVIDIA_only
    export VK_LOADER_DRIVERS_SELECT="*nvidia*"
    unset DRI_PRIME
    unset MESA_VK_DEVICE_SELECT
    unset MESA_GLSL_CACHE_DIR
    
    if [ -f "/var/lib/snapd/lib/vulkan/icd.d/nvidia_icd.json" ]; then
        export VK_DRIVER_FILES="/var/lib/snapd/lib/vulkan/icd.d/nvidia_icd.json"
        export VK_ICD_FILENAMES="/var/lib/snapd/lib/vulkan/icd.d/nvidia_icd.json"
    elif [ -f "/usr/share/vulkan/icd.d/nvidia_icd.json" ]; then
        export VK_DRIVER_FILES="/usr/share/vulkan/icd.d/nvidia_icd.json"
        export VK_ICD_FILENAMES="/usr/share/vulkan/icd.d/nvidia_icd.json"
    fi
else
    # Integrated Intel GPU selected
    unset __NV_PRIME_RENDER_OFFLOAD
    unset __GLX_VENDOR_LIBRARY_NAME
    unset __VK_LAYER_NV_optimus
    export VK_LOADER_DRIVERS_SELECT="*intel*"
    if [ -f "/usr/share/vulkan/icd.d/intel_icd.json" ]; then
        export VK_DRIVER_FILES="/usr/share/vulkan/icd.d/intel_icd.json"
        export VK_ICD_FILENAMES="/usr/share/vulkan/icd.d/intel_icd.json"
    fi
fi

# 3. Filter CLI arguments:
# Remove uncapped --num-threads and inject --num-threads 2
# Ensure --device-index 0 is set
NEW_ARGS=()
skip_next=0
has_device=0
is_special=0

for arg in "$@"; do
    if [ "$arg" = "--help" ] || [ "$arg" = "-h" ] || [ "$arg" = "--version" ]; then
        is_special=1
    fi
    if [ $skip_next -eq 1 ]; then
        skip_next=0
        continue
    fi
    if [ "$arg" = "--num-threads" ]; then
        skip_next=1
        continue
    fi
    if [ "$arg" = "--device-index" ]; then
        has_device=1
    fi
    NEW_ARGS+=("$arg")
done

if [ $is_special -eq 0 ]; then
    # Limit compilation concurrency to 2 threads (cool, quiet, leaving 10 threads free)
    NEW_ARGS+=("--num-threads" "2")
    if [ $has_device -eq 0 ]; then
        NEW_ARGS+=("--device-index" "0")
    fi
fi

# 4. Execute real binary with idle scheduling priority (nice 19, ionice idle 3)
exec nice -n 19 ionice -c 3 "$REAL_BIN" "${NEW_ARGS[@]}"
'

install_wrappers() {
    local installed_count=0
    local dirs
    read -r -a dirs <<< "$(get_steam_dirs)"
    for sdir in "${dirs[@]}"; do
        if [ -d "$sdir" ]; then
            local owner
            owner=$(stat -c '%u:%g' "$sdir" 2>/dev/null || echo "1000:1000")
            for sub in "${SUBDIRS[@]}"; do
                local target_dir="$sdir/$sub"
                if [ -d "$target_dir" ]; then
                    local foz="$target_dir/fossilize_replay"
                    local foz_real="$target_dir/fossilize_replay.real"
                    local foz_bin="$target_dir/fossilize_replay.bin"

                    # If fossilize_replay exists and is an ELF executable
                    if [ -f "$foz" ] && head -c 4 "$foz" | grep -q 'ELF'; then
                        cp -f "$foz" "$foz_bin"
                        cp -f "$foz" "$foz_real"
                        echo "$WRAPPER_CONTENT" > "$foz"
                        chmod 755 "$foz" "$foz_bin" "$foz_real"
                        chown "$owner" "$foz" "$foz_bin" "$foz_real" 2>/dev/null || true
                        installed_count=$((installed_count + 1))
                    elif [ -f "$foz" ]; then
                        if [ ! -f "$foz_real" ] && [ -f "$foz_bin" ]; then
                            cp -f "$foz_bin" "$foz_real"
                        fi
                        echo "$WRAPPER_CONTENT" > "$foz"
                        chmod 755 "$foz"
                        [ -f "$foz_real" ] && chmod 755 "$foz_real"
                        chown "$owner" "$foz" "$foz_real" 2>/dev/null || true
                        installed_count=$((installed_count + 1))
                    fi
                fi
            done
        fi
    done
    echo "mac-steam-shader-optimizer: Verified $installed_count fossilize_replay wrappers."
}

clean_stale_caches() {
    local dirs
    read -r -a dirs <<< "$(get_steam_dirs)"
    for sdir in "${dirs[@]}"; do
        if [ -d "$sdir/steamapps/shadercache" ]; then
            find "$sdir/steamapps/shadercache" -maxdepth 4 -type d -name "anv_*" -exec rm -rf {} + 2>/dev/null
            find "$sdir/steamapps/shadercache" -maxdepth 3 -type d -name "mesa_shader_cache_sf" -exec rm -rf {} + 2>/dev/null
        fi
    done
    echo "mac-steam-shader-optimizer: Cleaned stale Mesa Intel shader caches."
}

verify_cs2_config() {
    local dirs
    read -r -a dirs <<< "$(get_steam_dirs)"
    for sdir in "${dirs[@]}"; do
        local cs2_sh="$sdir/steamapps/common/Counter-Strike Global Offensive/game/cs2.sh"
        if [ -f "$cs2_sh" ] && grep -q 'export SDL_VIDEO_DRIVER=x11' "$cs2_sh"; then
            sed -i 's/export SDL_VIDEO_DRIVER=x11/unset DISABLE_WAYLAND\n\t\texport SDL_VIDEO_DRIVER=wayland\n\t\texport SDL_VIDEODRIVER=wayland\n\t\texport SDL_VIDEO_WAYLAND_SCALE_TO_DISPLAY=1\n\t\texport SDL_VIDEO_WAYLAND_ALLOW_LIBDECOR=0/g' "$cs2_sh"
            echo "mac-steam-shader-optimizer: Updated CS2 launcher to native Wayland."
        fi
        local autoexec="$sdir/steamapps/common/Counter-Strike Global Offensive/game/csgo/cfg/autoexec.cfg"
        if [ -f "$autoexec" ] && ! grep -q 'bind "MOUSE_X" "yaw"' "$autoexec"; then
            cat << 'EOF' >> "$autoexec"

// Wayland & Linux Mouse Input / Camera Rotation Fix
bind "MOUSE_X" "yaw"
bind "MOUSE_Y" "pitch"
input_filter_relative_analog_inputs 0
EOF
            echo "mac-steam-shader-optimizer: Added mouse yaw/pitch binds to CS2 autoexec.cfg."
        fi
    done
}

case "$1" in
    clean)
        clean_stale_caches
        ;;
    status)
        local dirs
        read -r -a dirs <<< "$(get_steam_dirs)"
        for sdir in "${dirs[@]}"; do
            if [ -d "$sdir" ]; then
                for sub in "${SUBDIRS[@]}"; do
                    if [ -f "$sdir/$sub/fossilize_replay" ]; then
                        echo "Found: $sdir/$sub/fossilize_replay ($(file -b "$sdir/$sub/fossilize_replay"))"
                    fi
                done
            fi
        done
        ;;
    *)
        install_wrappers
        clean_stale_caches
        verify_cs2_config
        ;;
esac
