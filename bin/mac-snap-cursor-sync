#!/bin/bash
# Ensures macW1Y / macW1Y cursors override snap fallback directories
USER_HOME="${TARGET_HOME:-$HOME}"
if [ -n "$SUDO_USER" ] && [ "$SUDO_USER" != "root" ]; then
    USER_HOME=$(getent passwd "$SUDO_USER" 2>/dev/null | cut -d: -f6)
fi
SRC="$USER_HOME/.local/share/icons/macW1Y/cursors"
[ -d "$SRC" ] || SRC="/usr/share/icons/macW1Y/cursors"
[ -d "$SRC" ] || exit 0

# gtk-common-themes
GTK_SNAP=$(find /snap/gtk-common-themes/ -maxdepth 1 -mindepth 1 -type d ! -name "current" 2>/dev/null | sort -V | tail -n 1)
if [ -n "$GTK_SNAP" ] && [ -d "$GTK_SNAP/share/icons" ]; then
    for theme in Adwaita Yaru DMZ-White DMZ-Black; do
        TARGET="$GTK_SNAP/share/icons/$theme/cursors"
        if [ -d "$TARGET" ] && ! mountpoint -q "$TARGET"; then
            mount --bind "$SRC" "$TARGET" 2>/dev/null || true
        fi
    done
fi

# steam snap
STEAM_SNAP=$(find /snap/steam/ -maxdepth 1 -mindepth 1 -type d ! -name "current" 2>/dev/null | sort -V | tail -n 1)
if [ -n "$STEAM_SNAP" ] && [ -d "$STEAM_SNAP/usr/share/icons" ]; then
    for theme in Adwaita; do
        TARGET="$STEAM_SNAP/usr/share/icons/$theme/cursors"
        if [ -d "$TARGET" ] && ! mountpoint -q "$TARGET"; then
            mount --bind "$SRC" "$TARGET" 2>/dev/null || true
        fi
    done
fi
exit 0
