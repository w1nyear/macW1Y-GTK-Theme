#!/usr/bin/env python3
import sys, os, subprocess, shutil
from gi.repository import Gio

def main():
    if len(sys.argv) < 2:
        return
    path = sys.argv[1]
    if not os.path.exists(path):
        return
    real_path = os.path.realpath(path)
    
    app_info = Gio.DesktopAppInfo.new_from_filename(real_path)
    app_name = app_info.get_name() if app_info else os.path.basename(path).replace(".desktop", "")
    
    pkg_type = "unknown"
    pkg_name = ""
    
    if "/snap/" in real_path or "/var/lib/snapd/" in real_path:
        pkg_type = "snap"
        parts = real_path.split("/")
        for i, p in enumerate(parts):
            if p == "snap" and i + 1 < len(parts):
                pkg_name = parts[i+1]
                break
    elif "/flatpak/" in real_path:
        pkg_type = "flatpak"
        pkg_name = os.path.basename(real_path).replace(".desktop", "")
    elif real_path.startswith("/usr/"):
        if shutil.which("rpm"):
            try:
                res = subprocess.run(["rpm", "-qf", real_path, "--qf", "%{NAME}"], capture_output=True, text=True)
                if res.returncode == 0 and res.stdout.strip() and "not owned" not in res.stdout:
                    pkg_type = "rpm"
                    pkg_name = res.stdout.strip()
            except Exception:
                pass
        if pkg_type == "unknown" and shutil.which("pacman"):
            try:
                res = subprocess.run(["pacman", "-Qoq", real_path], capture_output=True, text=True)
                if res.returncode == 0 and res.stdout.strip():
                    pkg_type = "pacman"
                    pkg_name = res.stdout.strip()
            except Exception:
                pass
        if pkg_type == "unknown" and shutil.which("dpkg"):
            try:
                res = subprocess.run(["dpkg", "-S", real_path], capture_output=True, text=True)
                if res.returncode == 0:
                    pkg_type = "deb"
                    pkg_name = res.stdout.split(":")[0].strip()
            except Exception:
                pass
    elif real_path.startswith(os.path.expanduser("~/.local/")):
        pkg_type = "local"
    
    loc = "en"
    try:
        loc_f = os.path.expanduser("~/.config/mac-styling/locale")
        if os.path.exists(loc_f):
            with open(loc_f, "r") as lf:
                loc = lf.read().strip().lower()
        elif os.environ.get("LANG"):
            loc = os.environ.get("LANG", "").split(".")[0].split("_")[0].lower()
    except Exception:
        pass

    if loc.startswith("pl"):
        title_q = "Usuwanie programu"
        ok_lbl = "Usuń"
        cancel_lbl = "Anuluj"
        info_title = "Usunięto"
        info_text = f"Program \"{app_name}\" został pomyślnie usunięty z systemu."
        if pkg_name:
            prompt_text = f"Czy na pewno chcesz usunąć program \"{app_name}\" ({pkg_name}) z systemu?"
        else:
            prompt_text = f"Czy na pewno chcesz usunąć skrót lub program \"{app_name}\" z systemu?"
    elif loc.startswith("uk"):
        title_q = "Видалення програми"
        ok_lbl = "Видалити"
        cancel_lbl = "Скасувати"
        info_title = "Видалено"
        info_text = f"Програму \"{app_name}\" успішно видалено з системи."
        if pkg_name:
            prompt_text = f"Ви дійсно бажаєте видалити програму \"{app_name}\" ({pkg_name}) з системи?"
        else:
            prompt_text = f"Ви дійсно бажаєте видалити ярлик або програму \"{app_name}\" з системи?"
    elif loc.startswith("de"):
        title_q = "Anwendung deinstallieren"
        ok_lbl = "Deinstallieren"
        cancel_lbl = "Abbrechen"
        info_title = "Entfernt"
        info_text = f"Anwendung \"{app_name}\" wurde erfolgreich aus dem System entfernt."
        if pkg_name:
            prompt_text = f"Möchten Sie die Anwendung \"{app_name}\" ({pkg_name}) wirklich aus dem System entfernen?"
        else:
            prompt_text = f"Möchten Sie die Verknüpfung oder Anwendung \"{app_name}\" wirklich aus dem System entfernen?"
    elif loc.startswith("fr"):
        title_q = "Désinstaller l'application"
        ok_lbl = "Désinstaller"
        cancel_lbl = "Annuler"
        info_title = "Supprimé"
        info_text = f"L'application \"{app_name}\" a été supprimée avec succès du système."
        if pkg_name:
            prompt_text = f"Voulez-vous vraiment désinstaller l'application \"{app_name}\" ({pkg_name}) du système ?"
        else:
            prompt_text = f"Voulez-vous vraiment supprimer le raccourci ou l'application \"{app_name}\" du système ?"
    elif loc.startswith("es"):
        title_q = "Desinstalar aplicación"
        ok_lbl = "Desinstalar"
        cancel_lbl = "Cancelar"
        info_title = "Eliminado"
        info_text = f"La aplicación \"{app_name}\" se eliminó con éxito del sistema."
        if pkg_name:
            prompt_text = f"¿Está seguro de que desea desinstalar la aplicación \"{app_name}\" ({pkg_name}) del sistema?"
        else:
            prompt_text = f"¿Está seguro de que desea eliminar el acceso directo o la aplicación \"{app_name}\" del sistema?"
    elif loc.startswith("it"):
        title_q = "Disinstalla applicazione"
        ok_lbl = "Disinstalla"
        cancel_lbl = "Annulla"
        info_title = "Rimosso"
        info_text = f"L'applicazione \"{app_name}\" è stata rimossa con successo dal sistema."
        if pkg_name:
            prompt_text = f"Sei sicuro di voler disinstallare l'applicazione \"{app_name}\" ({pkg_name}) dal sistema?"
        else:
            prompt_text = f"Sei sicuro di voler rimuovere il collegamento o l'applicazione \"{app_name}\" dal sistema?"
    else:
        title_q = "Uninstall Application"
        ok_lbl = "Uninstall"
        cancel_lbl = "Cancel"
        info_title = "Removed"
        info_text = f"Application \"{app_name}\" was successfully removed from the system."
        if pkg_name:
            prompt_text = f"Are you sure you want to uninstall \"{app_name}\" ({pkg_name}) from the system?"
        else:
            prompt_text = f"Are you sure you want to remove application \"{app_name}\" from the system?"
        
    zenity_cmd = [
        "zenity", "--question",
        f"--title={title_q}",
        f"--text={prompt_text}",
        f"--ok-label={ok_lbl}",
        f"--cancel-label={cancel_lbl}",
        "--icon-name=user-trash"
    ]
    res = subprocess.run(zenity_cmd)
    if res.returncode != 0:
        return
        
    success = False
    if pkg_type == "deb" and pkg_name:
        cmd = ["pkexec", "apt-get", "remove", "-y", pkg_name]
        r = subprocess.run(cmd)
        success = (r.returncode == 0)
    elif pkg_type == "rpm" and pkg_name:
        cmd = ["pkexec", "dnf", "remove", "-y", pkg_name]
        r = subprocess.run(cmd)
        success = (r.returncode == 0)
    elif pkg_type == "pacman" and pkg_name:
        cmd = ["pkexec", "pacman", "-R", "--noconfirm", pkg_name]
        r = subprocess.run(cmd)
        success = (r.returncode == 0)
    elif pkg_type == "snap" and pkg_name:
        cmd = ["pkexec", "snap", "remove", pkg_name]
        r = subprocess.run(cmd)
        success = (r.returncode == 0)
    elif pkg_type == "flatpak" and pkg_name:
        cmd = ["flatpak", "uninstall", "-y", pkg_name]
        r = subprocess.run(cmd)
        success = (r.returncode == 0)
    else:
        try:
            os.remove(real_path)
            success = True
        except Exception:
            pass
            
    if os.path.exists(path) and os.path.islink(path):
        try:
            os.remove(path)
        except Exception:
            pass
            
    if success:
        subprocess.run(["zenity", "--info", f"--title={info_title}", f"--text={info_text}", "--timeout=3"])
        subprocess.run(["/usr/local/bin/mac-sync-applications"])

if __name__ == "__main__":
    main()
