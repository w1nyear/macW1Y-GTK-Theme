#!/usr/bin/env python3
import sys, os, subprocess, shutil
from gi.repository import Gio

def main():
    if len(sys.argv) < 2:
        return
    path = sys.argv[1]
    if not os.path.exists(path):
        return
    real_path = os.path.realpath(path)
    
    app_name = os.path.basename(path).replace(".desktop", "")
    try:
        app_info = Gio.DesktopAppInfo.new_from_filename(real_path)
        if app_info and app_info.get_name():
            app_name = app_info.get_name()
    except Exception:
        pass
    
    pkg_type = "unknown"
    pkg_name = ""
    
    if "/snap/" in real_path or "/var/lib/snapd/" in real_path:
        pkg_type = "snap"
        parts = real_path.split("/")
        for i, p in enumerate(parts):
            if p == "snap" and i + 1 < len(parts):
                pkg_name = parts[i+1]
                break
    elif "/flatpak/" in real_path:
        pkg_type = "flatpak"
        pkg_name = os.path.basename(real_path).replace(".desktop", "")
    elif real_path.startswith("/usr/"):
        if shutil.which("rpm"):
            try:
                res = subprocess.run(["rpm", "-qf", real_path, "--qf", "%{NAME}"], capture_output=True, text=True)
                if res.returncode == 0 and res.stdout.strip() and "not owned" not in res.stdout:
                    pkg_type = "rpm"
                    pkg_name = res.stdout.strip()
            except Exception:
                pass
        if pkg_type == "unknown" and shutil.which("pacman"):
            try:
                res = subprocess.run(["pacman", "-Qoq", real_path], capture_output=True, text=True)
                if res.returncode == 0 and res.stdout.strip():
                    pkg_type = "pacman"
                    pkg_name = res.stdout.strip()
            except Exception:
                pass
        if pkg_type == "unknown" and shutil.which("dpkg"):
            try:
                res = subprocess.run(["dpkg", "-S", real_path], capture_output=True, text=True)
                if res.returncode == 0:
                    pkg_type = "deb"
                    pkg_name = res.stdout.split(":")[0].strip()
            except Exception:
                pass
    elif real_path.startswith(os.path.expanduser("~/.local/")):
        pkg_type = "local"
    
    loc = "en"
    try:
        loc_f = os.path.expanduser("~/.config/mac-styling/locale")
        if os.path.exists(loc_f):
            with open(loc_f, "r") as lf:
                loc = lf.read().strip().lower()
        elif os.environ.get("LANG"):
            loc = os.environ.get("LANG", "").split(".")[0].split("_")[0].lower()
    except Exception:
        pass

    try:
        import mac_i18n
        title_q = mac_i18n.t("uninstall_title", "Uninstall Application", override_locale=loc)
        ok_lbl = mac_i18n.t("uninstall_app", "Uninstall", override_locale=loc)
        cancel_lbl = mac_i18n.t("cancel", "Cancel", override_locale=loc)
        info_title = mac_i18n.t("uninstall_success_title", "Removed", override_locale=loc)
        info_text = mac_i18n.tf("uninstall_success_text", {"app_name": app_name}, override_locale=loc)
        if pkg_name:
            prompt_text = mac_i18n.tf("uninstall_confirm_pkg", {"app_name": app_name, "pkg_name": pkg_name}, override_locale=loc)
        else:
            prompt_text = mac_i18n.tf("uninstall_confirm_app", {"app_name": app_name}, override_locale=loc)
    except Exception:
        if loc.startswith("uk"):
            title_q = "Видалення програми"
            ok_lbl = "Видалити"
            cancel_lbl = "Скасувати"
            info_title = "Видалено"
            info_text = f"Програму \"{app_name}\" успішно видалено з системи."
            prompt_text = f"Ви дійсно бажаєте видалити програму \"{app_name}\" ({pkg_name}) з системи?" if pkg_name else f"Ви дійсно бажаєте видалити ярлик або програму \"{app_name}\" з системи?"
        else:
            title_q = "Uninstall Application"
            ok_lbl = "Uninstall"
            cancel_lbl = "Cancel"
            info_title = "Removed"
            info_text = f"Application \"{app_name}\" was successfully removed from the system."
            prompt_text = f"Are you sure you want to uninstall \"{app_name}\" ({pkg_name}) from the system?" if pkg_name else f"Are you sure you want to remove the shortcut or application \"{app_name}\" from the system?"
        
    zenity_cmd = [
        "zenity", "--question",
        f"--title={title_q}",
        f"--text={prompt_text}",
        f"--ok-label={ok_lbl}",
        f"--cancel-label={cancel_lbl}",
        "--icon-name=user-trash"
    ]
    res = subprocess.run(zenity_cmd)
    if res.returncode != 0:
        return
        
    success = False
    if pkg_type == "deb" and pkg_name:
        cmd = ["pkexec", "apt-get", "remove", "-y", pkg_name]
        r = subprocess.run(cmd)
        success = (r.returncode == 0)
    elif pkg_type == "rpm" and pkg_name:
        cmd = ["pkexec", "dnf", "remove", "-y", pkg_name]
        r = subprocess.run(cmd)
        success = (r.returncode == 0)
    elif pkg_type == "pacman" and pkg_name:
        cmd = ["pkexec", "pacman", "-R", "--noconfirm", pkg_name]
        r = subprocess.run(cmd)
        success = (r.returncode == 0)
    elif pkg_type == "snap" and pkg_name:
        cmd = ["pkexec", "snap", "remove", pkg_name]
        r = subprocess.run(cmd)
        success = (r.returncode == 0)
    elif pkg_type == "flatpak" and pkg_name:
        cmd = ["flatpak", "uninstall", "-y", pkg_name]
        r = subprocess.run(cmd)
        success = (r.returncode == 0)
    else:
        try:
            os.remove(real_path)
            success = True
        except Exception:
            pass
            
    if success:
        if os.path.exists(path) and os.path.islink(path):
            try:
                os.remove(path)
            except Exception:
                pass
        subprocess.run(["zenity", "--info", f"--title={info_title}", f"--text={info_text}", "--timeout=3"])
        subprocess.run(["/usr/local/bin/mac-sync-applications"])
    else:
        err_title = "Помилка видалення" if loc == "uk" else "Uninstall Failed"
        err_text = f"Не вдалося видалити {app_name} або операцію було скасовано." if loc == "uk" else f"Failed to uninstall {app_name} or operation was cancelled."
        subprocess.run(["zenity", "--warning", f"--title={err_title}", f"--text={err_text}", "--timeout=4"])

if __name__ == "__main__":
    main()
