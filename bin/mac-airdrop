#!/usr/bin/env python3
import sys
import os
import time
import json
import signal
import subprocess
from pathlib import Path

# Ensure user site-packages are in sys.path
sys.path.insert(0, '/home/vitaliy/.local/lib/python3.14/site-packages')
sys.path.insert(0, '/home/vitaliy/.local/lib/python3.13/site-packages')
sys.path.insert(0, '/home/vitaliy/.local/lib/python3.12/site-packages')

CONFIG_DIR = Path.home() / '.config' / 'mac-airdrop'
CONFIG_FILE = CONFIG_DIR / 'config.json'
PID_FILE = CONFIG_DIR / 'daemon.pid'
DEFAULT_DROP_DIR = Path.home() / 'Завантажене' / 'AirDrop'
if not DEFAULT_DROP_DIR.parent.exists():
    DEFAULT_DROP_DIR = Path.home() / 'Downloads' / 'AirDrop'

def get_airdrop_locale():
    try:
        loc_f = os.path.expanduser("~/.config/mac-styling/locale")
        if os.path.exists(loc_f):
            with open(loc_f, "r", encoding="utf-8") as f:
                return f.read().strip().lower()
        if os.environ.get("LANGUAGE"):
            return os.environ.get("LANGUAGE", "").split(":")[0].split(".")[0].split("_")[0].lower()
        if os.environ.get("LANG"):
            return os.environ.get("LANG", "").split(".")[0].split("_")[0].lower()
    except Exception:
        pass
    return "en"

