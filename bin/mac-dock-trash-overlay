#!/usr/bin/env python3
import os
import sys
import subprocess
import re
import json
import signal

# Force X11 backend for XWayland XDND bridging
os.environ['GDK_BACKEND'] = 'x11'

import gi
gi.require_version('Gtk', '3.0')
from gi.repository import Gtk, Gdk, GLib, Gio

class MacDockTrashOverlay:
    def __init__(self):
        self.win = Gtk.Window(type=Gtk.WindowType.TOPLEVEL)
        self.win.set_title("mac_dock_trash_overlay")
        self.win.set_decorated(False)
        self.win.set_skip_taskbar_hint(True)
        self.win.set_skip_pager_hint(True)
        self.win.set_keep_above(True)
        self.win.set_accept_focus(False)
        self.win.set_type_hint(Gdk.WindowTypeHint.UTILITY)

        # Transparent background
        screen = self.win.get_screen()
        visual = screen.get_rgba_visual()
        if visual and screen.is_composited():
            self.win.set_visual(visual)

        css_provider = Gtk.CssProvider()
        css_provider.load_from_data(b"window { background-color: transparent; }")
        Gtk.StyleContext.add_provider_for_screen(
            screen,
            css_provider,
            Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION
        )

        # Register Drop Target for text/uri-list
        self.win.drag_dest_set(
            Gtk.DestDefaults.ALL,
            [],
            Gdk.DragAction.MOVE | Gdk.DragAction.COPY
        )
        self.win.drag_dest_add_uri_targets()

        self.win.connect('drag-motion', self.on_drag_motion)
        self.win.connect('drag-drop', self.on_drag_drop)
        self.win.connect('drag-data-received', self.on_drag_data_received)
        self.win.connect('button-press-event', self.on_button_press)

        self.last_coords = None
        self.update_position()
        self.win.show_all()

        # Sync position every 300ms
        GLib.timeout_add(300, self.update_position)

    def get_trash_coords(self):
        try:
            cmd = [
                'gdbus', 'call', '--session',
                '--dest', 'org.gnome.Shell',
                '--object-path', '/org/gnome/Shell/Extensions/EvalHelper',
                '--method', 'org.gnome.Shell.Extensions.EvalHelper.Eval',
                '''(() => {
                    let ext = globalThis.Main ? globalThis.Main.extensionManager.lookup('cupertino-dock-lite@rinzler69-wastaken.github.com') : null;
                    if (!ext || !ext.stateObj) return null;
                    let actor = ext.stateObj._getTrashActor();
                    if (!actor) return null;
                    let [x, y] = actor.get_transformed_position();
                    let [w, h] = actor.get_transformed_size();
                    let is_mapped = actor.is_mapped();
                    let opacity = actor.get_paint_opacity();
                    return JSON.stringify({
                        x: Math.round(x),
                        y: Math.round(y),
                        w: Math.round(w),
                        h: Math.round(h),
                        is_mapped: is_mapped,
                        opacity: opacity
                    });
                })()'''
            ]
            out = subprocess.check_output(cmd, timeout=1).decode('utf-8')
            cleaned = out.replace('\\\\', '').replace('\\"', '"')
            m = re.search(r'\{[^{}]*\}', cleaned)
            if m:
                return json.loads(m.group(0))
        except Exception:
            pass
        return None

    def update_position(self):
        coords = self.get_trash_coords()
        if coords:
            self.last_coords = coords
            is_visible = (
                coords.get('is_mapped', True) and
                coords.get('opacity', 255) > 50 and
                coords.get('y', 0) < 1080
            )
            if is_visible:
                x = coords['x']
                y = coords['y']
                w = coords['w']
                h = coords['h']
                self.win.move(x, y)
                self.win.resize(w, h)
                self.win.set_keep_above(True)
            else:
                self.win.move(-1000, -1000)
        return True

    def on_drag_motion(self, widget, context, x, y, time):
        Gdk.drag_status(context, Gdk.DragAction.MOVE, time)
        return True

    def on_drag_drop(self, widget, context, x, y, time):
        return True

    def on_drag_data_received(self, widget, context, x, y, data, info, time):
        uris = data.get_uris()
        success = False
        if uris:
            for uri in uris:
                try:
                    f = Gio.File.new_for_uri(uri)
                    f.trash(None)
                    success = True
                except Exception as e:
                    sys.stderr.write(f"[TrashOverlay] Error trashing {uri}: {e}\n")

        Gtk.drag_finish(context, success, False, time)
        if success:
            try:
                subprocess.Popen(['canberra-gtk-play', '-i', 'trash-empty'], stderr=subprocess.DEVNULL)
            except Exception:
                pass

    def on_button_press(self, widget, event):
        if event.button == 1:
            subprocess.Popen(['gio', 'open', 'trash:///'])
        elif event.button == 3:
            menu = Gtk.Menu()
            item_open = Gtk.MenuItem(label="Відкрити Кошик")
            item_open.connect('activate', lambda _: subprocess.Popen(['gio', 'open', 'trash:///']))
            menu.append(item_open)

            item_empty = Gtk.MenuItem(label="Очистити Кошик")
            def empty_trash(_):
                subprocess.Popen(['gio', 'trash', '--empty'])
                subprocess.Popen(['canberra-gtk-play', '-i', 'trash-empty'], stderr=subprocess.DEVNULL)
            item_empty.connect('activate', empty_trash)
            menu.append(item_empty)

            menu.show_all()
            menu.popup_at_pointer(event)

def main():
    signal.signal(signal.SIGINT, signal.SIG_DFL)
    signal.signal(signal.SIGTERM, signal.SIG_DFL)
    _app = MacDockTrashOverlay()
    Gtk.main()

if __name__ == '__main__':
    main()
