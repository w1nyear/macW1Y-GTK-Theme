#!/usr/bin/env python3
import sys
import os
import re
import json
import subprocess
import time

def main():
    if len(sys.argv) < 3:
        print("Usage: update-mac-styling-css <menubar_tint_0_100> <blur_tint_0_100>")
        sys.exit(1)

    try:
        p_val = float(sys.argv[1])
        b_val = float(sys.argv[2])
    except ValueError:
        sys.exit(1)

    p_tint = max(0.0, min(1.0, p_val / 100.0))
    b_tint = max(0.0, min(1.0, b_val / 100.0))

    styling_file = os.path.expanduser("~/.config/mac-styling/styling.json")
    dock_size = 12
    dock_spacing = 4
    if os.path.exists(styling_file):
        try:
            with open(styling_file, "r") as sf:
                sdata = json.load(sf)
                dock_size = sdata.get("dock_size", 12)
                dock_spacing = sdata.get("dock_spacing", 4)
        except Exception:
            pass

    half_spacing = int(dock_spacing / 2)
    top_pad = max(0, dock_size + 3)
    bot_pad = max(0, dock_size - 5)

    paths = [
        (os.path.expanduser("~/.themes/macW1Y-Dark/gnome-shell/gnome-shell.css"), False),
        (os.path.expanduser("~/.themes/macW1Y-Dark/gnome-shell/gnome-shell.css"), False),
        (os.path.expanduser("~/.themes/macW1Y-Light/gnome-shell/gnome-shell.css"), True),
        (os.path.expanduser("~/.themes/macW1Y-Light/gnome-shell/gnome-shell.css"), True)
    ]

    for css_path, is_light in paths:
        if not os.path.exists(css_path):
            continue
        try:
            with open(css_path, "r", encoding="utf-8") as f:
                c = f.read()

            # Menubar gradient darkness (always dark gradient for #panel across light and dark themes)
            c = re.sub(
                r'(#panel\s*\{[^}]*?background-gradient-start:\s*rgba\()([0-9.,\s]+)(\)\s*!important;)',
                rf'\g<1>0, 0, 0, {p_tint:.2f}\g<3>',
                c
            )
            c = re.sub(
                r'(#panel,\s*#panel\.gradient-panel,\s*#panel\.transparent-panel\s*\{[^}]*?background-gradient-start:\s*rgba\()([0-9.,\s]+)(\)\s*!important;)',
                rf'\g<1>0, 0, 0, {p_tint:.2f}\g<3>',
                c
            )

            # Dash background
            if is_light:
                c = re.sub(
                    r'(#dash\s+\.dash-background\s*\{[^}]*?background-color:\s*rgba\()([0-9.,\s]+)(\)\s*!important;)',
                    rf'\g<1>255, 255, 255, {b_tint:.2f}\g<3>',
                    c
                )
            else:
                c = re.sub(
                    r'(#dash\s+\.dash-background\s*\{[^}]*?background-color:\s*rgba\()([0-9.,\s]+)(\)\s*!important;)',
                    rf'\g<1>36, 36, 36, {b_tint:.2f}\g<3>',
                    c
                )

            # Dock container padding
            c = re.sub(
                r'(#dashtodockContainer\.bottom\s+#dash\s+#dashtodockDashContainer,\s*#dashtodockDashContainer\s*\{[^}]*?padding:\s*0\s+)[0-9]+px(\s*!important;)',
                rf'\g<1>{dock_size}px\g<2>',
                c
            )

            # App items vertical padding & margin
            c = re.sub(
                r'(\.dash-item-container\s+\.overview-tile\s*\{[^}]*?padding-top:\s*)[0-9]+px(\s*!important;[^}]*?padding-bottom:\s*)[0-9]+px(\s*!important;[^}]*?margin:\s*0\s*)[0-9]*px?(\s*!important;)',
                rf'\g<1>{top_pad}px\g<2>{bot_pad}px\g<3>{half_spacing}px\g<4>',
                c
            )

            with open(css_path, "w", encoding="utf-8") as f:
                f.write(c)
        except Exception as e:
            print(f"Error updating {css_path}: {e}")

    # Reload theme in GNOME Shell
    try:
        cur_theme = subprocess.check_output(
            ["gsettings", "get", "org.gnome.shell.extensions.user-theme", "name"],
            text=True
        ).strip().strip("'\"")
        if not cur_theme:
            cur_theme = "macW1Y-Dark"

        subprocess.run(["gsettings", "set", "org.gnome.shell.extensions.user-theme", "name", "''"], check=False)
        time.sleep(0.05)
        subprocess.run(["gsettings", "set", "org.gnome.shell.extensions.user-theme", "name", cur_theme], check=False)
    except Exception as e:
        print(f"Error reloading user-theme: {e}")

if __name__ == "__main__":
    main()
