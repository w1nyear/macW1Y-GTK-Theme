#!/usr/bin/env python3
"""
mac-extension-guard - GNOME Extensions Version Pinning & Integrity Watchdog for macW1Y
Handles:
- Checking extension integrity against config/extensions.lock.json
- Non-intrusive checking of EGO (extensions.gnome.org) updates without auto-updating
- Backup and safe rollback of extension directories and settings
"""

import os
import sys
import json
import time
import shutil
import hashlib
import urllib.request
import urllib.error
import urllib.parse
import subprocess

REPO_DIR = os.environ.get("MACW1Y_REPO") or os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
LOCK_CANDIDATES = [
    os.path.join(REPO_DIR, "config/extensions.lock.json"),
    os.path.expanduser("~/MACTHEMEFILES/config/extensions.lock.json"),
    os.path.expanduser("~/macW1Y/config/extensions.lock.json"),
    os.path.expanduser("~/.config/macw1y/extensions.lock.json"),
    os.path.expanduser("~/.local/share/macW1Y/config/extensions.lock.json"),
    "/usr/share/mactheme/config/extensions.lock.json",
]
LOCK_FILE = next((path for path in LOCK_CANDIDATES if os.path.isfile(path)), LOCK_CANDIDATES[0])
CONFIG_DIR = os.path.expanduser("~/.config/macw1y")
UPDATES_FILE = os.path.join(CONFIG_DIR, "extension-updates.json")
BACKUPS_DIR = os.path.join(CONFIG_DIR, "backups/extensions")
USER_EXT_DIR = os.path.expanduser("~/.local/share/gnome-shell/extensions")
USER_UPDATES_DIR = os.path.expanduser("~/.local/share/gnome-shell/extension-updates")
SYS_EXT_DIR = "/usr/share/gnome-shell/extensions"

os.makedirs(CONFIG_DIR, exist_ok=True)
os.makedirs(BACKUPS_DIR, exist_ok=True)

HASH_ALGORITHM = "sha256-tree-v2"

def dir_hash(d):
    """Canonical paths and framed contents; never hide unreadable files."""
    if not os.path.isdir(d):
        raise FileNotFoundError(d)
    h = hashlib.sha256()
    def field(value):
        h.update(len(value).to_bytes(8, "big"))
        h.update(value)
    def failed(error):
        raise error
    for root, dirs, files in os.walk(d, onerror=failed):
        dirs.sort()
        links = [name for name in dirs if os.path.islink(os.path.join(root, name))]
        dirs[:] = [name for name in dirs if name not in links]
        for name in sorted(files + links):
            path = os.path.join(root, name)
            if os.path.relpath(path, d) == os.path.join("schemas", "gschemas.compiled"):
                continue  # Generated by the target GLib; source XML remains covered.
            field(os.path.relpath(path, d).replace(os.sep, "/").encode())
            if os.path.islink(path):
                field(b"symlink")
                field(os.fsencode(os.readlink(path)))
            else:
                field(b"file")
                with open(path, "rb") as stream:
                    field(stream.read())
    return h.hexdigest()

def load_lock():
    with open(LOCK_FILE, "r", encoding="utf-8") as f:
        document = json.load(f)
        entries = document.get("extensions") if isinstance(document, dict) else None
    meta = document.get("_meta") if isinstance(document, dict) else None
    if not isinstance(meta, dict) or meta.get("hash_algorithm") != HASH_ALGORITHM:
        raise ValueError("Невідома версія алгоритму lock-файлу; потрібне оновлення маніфесту")
    if not isinstance(entries, dict) or not entries:
        raise ValueError("Lock-файл не містить жодного розширення")
    for uuid, entry in entries.items():
        if not isinstance(entry, dict) or not isinstance(entry.get("sha256"), str) or len(entry["sha256"]) != 64:
            raise ValueError(f"Неповний запис контрольної суми: {uuid}")
    return entries

def load_updates():
    if not os.path.exists(UPDATES_FILE):
        return {"last_check": 0, "updates": {}}
    try:
        with open(UPDATES_FILE, "r", encoding="utf-8") as f:
            return json.load(f)
    except Exception:
        return {"last_check": 0, "updates": {}}

def save_updates(data):
    try:
        with open(UPDATES_FILE, "w", encoding="utf-8") as f:
            json.dump(data, f, indent=2, ensure_ascii=False)
    except Exception as e:
        print(f"[Error saving updates state: {e}]", file=sys.stderr)

def get_installed_meta(uuid):
    p = os.path.join(USER_EXT_DIR, uuid)
    if not os.path.exists(p):
        p = os.path.join(SYS_EXT_DIR, uuid)
    if not os.path.exists(p):
        return None
    meta_p = os.path.join(p, "metadata.json")
    if os.path.exists(meta_p):
        try:
            with open(meta_p, "r", encoding="utf-8") as f:
                return json.load(f)
        except Exception:
            return {}
    return {}

def backup_extension(uuid):
    src = os.path.join(USER_EXT_DIR, uuid)
    if not os.path.exists(src):
        src = os.path.join(SYS_EXT_DIR, uuid)
    if not os.path.exists(src):
        print(f"Error: Extension {uuid} not found on disk.")
        return None
    
    timestamp = time.strftime("%Y%m%d_%H%M%S")
    dest = os.path.join(BACKUPS_DIR, f"{uuid}_{timestamp}")
    shutil.copytree(src, dest, symlinks=True)
    
    # Save current dconf settings for this extension if schema exists
    schema_dump = os.path.join(dest, "settings.ini")
    schema_name = f"org.gnome.shell.extensions.{uuid}"
    try:
        res = subprocess.run(["dconf", "dump", f"/org/gnome/shell/extensions/{uuid}/"],
                             stdout=subprocess.PIPE, text=True, check=False)
        if res.stdout:
            with open(schema_dump, "w") as sf:
                sf.write(res.stdout)
    except Exception:
        pass
    
    print(f"Backed up {uuid} -> {dest}")
    return dest

def restore_extension(uuid, backup_path=None):
    if not backup_path:
        # Find latest backup in BACKUPS_DIR
        candidates = [os.path.join(BACKUPS_DIR, d) for d in os.listdir(BACKUPS_DIR) if d.startswith(uuid)]
        if candidates:
            candidates.sort(key=os.path.getmtime, reverse=True)
            backup_path = candidates[0]
        else:
            # Fall back to repository copy
            repo_copy = os.path.join(REPO_DIR, "extensions", uuid)
            if os.path.exists(repo_copy):
                backup_path = repo_copy
            else:
                print(f"No backup or repository copy found for {uuid}.")
                return False

    dest = os.path.join(USER_EXT_DIR, uuid)
    if os.path.exists(dest):
        shutil.rmtree(dest)
    shutil.copytree(backup_path, dest, symlinks=True)
    
    # Restore dconf if present
    settings_ini = os.path.join(backup_path, "settings.ini")
    if os.path.exists(settings_ini):
        try:
            with open(settings_ini, "r") as sf:
                subprocess.run(["dconf", "load", f"/org/gnome/shell/extensions/{uuid}/"],
                               stdin=sf, check=False)
        except Exception:
            pass
            
    # Compile schemas if present
    schemas_dir = os.path.join(dest, "schemas")
    if os.path.exists(schemas_dir):
        subprocess.run(["glib-compile-schemas", schemas_dir], check=False)
        
    print(f"Restored {uuid} from {backup_path}.")
    return True

def cmd_check_updates(allow_network=True):
    locked = load_lock()
    updates_state = load_updates()
    updates = updates_state.get("updates", {})
    
    print("Checking for extension updates (non-intrusive)...")
    changed = False
    
    for uuid, info in locked.items():
        if info.get("source") != "extensions.gnome.org":
            continue
            
        if not allow_network:
            continue
            
        q = urllib.parse.quote(uuid)
        url = f"https://extensions.gnome.org/extension-info/?uuid={q}&shell_version=46"
        req = urllib.request.Request(url, headers={"User-Agent": "macW1Y-Extension-Guard/1.0"})
        try:
            with urllib.request.urlopen(req, timeout=3.5) as resp:
                data = json.loads(resp.read().decode())
                avail_v = data.get("version")
                pinned_v = info.get("pinned_version")
                
                # Compare versions
                if avail_v is not None and pinned_v is not None:
                    # If pinned_v is int and avail_v > pinned_v
                    is_newer = False
                    try:
                        if int(avail_v) > int(pinned_v):
                            is_newer = True
                    except Exception:
                        if str(avail_v) != str(pinned_v) and pinned_v != "custom":
                            is_newer = True
                            
                    if is_newer:
                        updates[uuid] = {
                            "name": info.get("name", uuid),
                            "installed_version": pinned_v,
                            "available_version": avail_v,
                            "has_custom_patches": info.get("has_custom_patches", False),
                            "status": "update_available_untested",
                            "first_detected": updates.get(uuid, {}).get("first_detected", time.strftime("%Y-%m-%d %H:%M:%S")),
                            "user_decision": updates.get(uuid, {}).get("user_decision", "none")
                        }
                        changed = True
                    else:
                        if uuid in updates and updates[uuid].get("status") == "update_available_untested":
                            del updates[uuid]
                            changed = True
        except urllib.error.HTTPError as e:
            # 404 means not hosted on EGO
            pass
        except Exception:
            # Offline / timeout / connection refused: never fail, keep cached state
            pass

    updates_state["last_check"] = time.time()
    updates_state["updates"] = updates
    save_updates(updates_state)
    
    pending = [u for u, v in updates.items() if v.get("status") == "update_available_untested" and v.get("user_decision") != "keep_current"]
    print(f"Check complete. {len(pending)} unverified updates pending review.")
    return len(pending)

def cmd_status():
    locked = load_lock()
    updates_state = load_updates()
    updates = updates_state.get("updates", {})
    
    print("\n" + "="*80)
    print(f"{'UUID':<42} {'PINNED':<8} {'INSTALLED':<10} {'STATUS':<18}")
    print("="*80)
    
    for uuid, info in sorted(locked.items()):
        meta = get_installed_meta(uuid)
        inst_v = meta.get("version", "N/A") if meta else "MISSING"
        pinned_v = info.get("pinned_version", "?")
        
        upd = updates.get(uuid)
        if upd and upd.get("status") == "update_available_untested":
            if upd.get("user_decision") == "keep_current":
                st = "UPDATE DEFERRED"
            else:
                st = f"UPDATE v{upd.get('available_version')} (UNTESTED)"
        else:
            p = os.path.join(USER_EXT_DIR, uuid)
            if not os.path.exists(p):
                p = os.path.join(SYS_EXT_DIR, uuid)
            current_hash = dir_hash(p) if os.path.exists(p) else ""
            if current_hash == info.get("sha256"):
                st = "LOCKED (OK)"
            else:
                st = "MODIFIED / UNLOCKED"
                
        print(f"{uuid:<42} {str(pinned_v):<8} {str(inst_v):<10} {st:<18}")
    print("="*80 + "\n")

def clean_staged_updates(locked):
    """Quarantine unverified staged EGO updates that would overwrite locked extensions on login."""
    if not os.path.isdir(USER_UPDATES_DIR):
        return
    quarantine_dir = os.path.join(CONFIG_DIR, "quarantine-updates")
    try:
        items = os.listdir(USER_UPDATES_DIR)
    except OSError:
        return
    for item in items:
        if item in locked:
            staged_path = os.path.join(USER_UPDATES_DIR, item)
            os.makedirs(quarantine_dir, exist_ok=True)
            dest = os.path.join(quarantine_dir, f"{item}_{int(time.time())}")
            try:
                shutil.move(staged_path, dest)
                print(f"[mac-extension-guard] Quarantined staged EGO update for locked extension: {item}")
            except Exception as e:
                print(f"[mac-extension-guard] Warning: could not quarantine {staged_path}: {e}", file=sys.stderr)

def cmd_verify():
    try:
        locked = load_lock()
    except (OSError, ValueError, TypeError) as error:
        print(f"VERIFICATION FAILED: {error}", file=sys.stderr)
        return False
    clean_staged_updates(locked)
    errors = []
    for uuid, info in locked.items():
        p = os.path.join(USER_EXT_DIR, uuid)
        if not os.path.exists(p):
            p = os.path.join(SYS_EXT_DIR, uuid)
        if not os.path.exists(p):
            errors.append(f"{uuid}: directory missing from system!")
            continue
        for required in ("metadata.json", "extension.js"):
            if not os.path.isfile(os.path.join(p, required)):
                errors.append(f"{uuid}: missing {required}")
        try:
            h = dir_hash(p)
        except OSError as error:
            errors.append(f"{uuid}: cannot read extension: {error}")
            continue
        if h != info.get("sha256"):
            errors.append(f"{uuid}: integrity hash mismatch (expected {info.get('sha256')[:8]}, got {h[:8]})")
            
    if errors:
        print("VERIFICATION FAILED:")
        for e in errors:
            print(" -", e)
        return False
    else:
        print(f"VERIFICATION SUCCESS: All {len(locked)} managed extensions match pinned lock hashes.")
        return True

def cmd_set_decision(uuid, decision):
    updates_state = load_updates()
    updates = updates_state.get("updates", {})
    if uuid in updates:
        updates[uuid]["user_decision"] = decision
        updates_state["updates"] = updates
        save_updates(updates_state)
        print(f"Set decision for {uuid} -> {decision}")
        return True
    return False


def show_extension_warning_dialog(uuid):
    locked = load_lock()
    info = locked.get(uuid, {})
    meta = get_installed_meta(uuid)
    
    inst_v = meta.get("version", info.get("pinned_version", "custom")) if meta else "N/A"
    updates_state = load_updates()
    upd = updates_state.get("updates", {}).get(uuid, {})
    avail_v = upd.get("available_version")
    raw_comps = info.get("macw1y_components")

    try:
        sys.path.insert(0, "/usr/local/bin")
        sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
        import mac_i18n
        def _guard_t(k, fb): return mac_i18n.t(k, fb)
        def _guard_tf(k, p, fb): return mac_i18n.tf(k, p, fb)
    except Exception:
        def _guard_t(k, fb): return fb
        def _guard_tf(k, p, fb): return fb.format(**p) if p else fb

    if not avail_v:
        avail_v = _guard_t("ext_guard_new_release", "new release")
    components = ", ".join(raw_comps if raw_comps else [_guard_t("ext_guard_default_comp", "macW1Y appearance")])
    
    try:
        import gi
        gi.require_version("Gtk", "4.0")
        gi.require_version("Adw", "1")
        from gi.repository import Gtk, Adw, Gio, GLib
    except Exception as e:
        print(f"Cannot show GTK dialog: {e}")
        return

    class WarningApp(Adw.Application):
        def __init__(self):
            super().__init__(application_id=f"org.gnome.macW1Y.Guard.{uuid.replace("@", "_").replace(".", "_")}",
                             flags=Gio.ApplicationFlags.FLAGS_NONE)

        def do_activate(self):
            win = Adw.ApplicationWindow(application=self)
            win.set_title(_guard_t("ext_guard_win_title", "macW1Y Version Guard"))
            body_text = _guard_tf(
                "ext_guard_body",
                {
                    "name": info.get("name", uuid),
                    "avail_v": avail_v,
                    "inst_v": inst_v,
                    "components": components,
                },
                (
                    f"Warning: A newer version ({avail_v}) is available for extension \"{info.get('name', uuid)}\".\n\n"
                    f"macW1Y has not yet been configured or tested to work with it. "
                    f"Updating may alter the visual style, disable certain features, or cause "
                    f"conflicts with Liquid Glass, menubar, dock, or other components.\n\n"
                    f"• Current locked version: {inst_v}\n"
                    f"• Available new version: {avail_v}\n"
                    f"• Dependent macW1Y components: {components}"
                ),
            )
            dlg_title = _guard_t("ext_guard_dlg_title", "Warning: Untested update available")
            btn_keep = _guard_t("ext_guard_btn_keep", "Keep Current Version")
            btn_update = _guard_t("ext_guard_btn_update", "Update Anyway")
            
            win.set_default_size(520, 320)
            
            dialog = Adw.AlertDialog.new(dlg_title, body_text)
            dialog.add_response("keep", btn_keep)
            dialog.add_response("update", btn_update)
            dialog.set_response_appearance("update", Adw.ResponseAppearance.DESTRUCTIVE)
            dialog.set_default_response("keep")
            dialog.set_close_response("keep")

            def on_dialog_response(dlg, resp):
                if resp == "keep":
                    cmd_set_decision(uuid, "keep_current")
                    print(f"[{uuid}] Selected: Keep current version.")
                elif resp == "update":
                    print(f"[{uuid}] Selected: Update anyway.")
                    # 1. Create mandatory backup
                    bkp = backup_extension(uuid)
                    print(f"[{uuid}] Mandatory restore backup created: {bkp}")
                    # 2. Mark update in progress
                    cmd_set_decision(uuid, "update_anyway")
                win.close()
                self.quit()

            dialog.connect("response", on_dialog_response)
            win.present()
            dialog.present(win)

    app = WarningApp()
    app.run(None)

if __name__ == "__main__":
    if len(sys.argv) < 2:
        cmd_status()
        sys.exit(0)
        
    cmd = sys.argv[1]
    if cmd == "status":
        cmd_status()
    elif cmd == "check":
        cmd_check_updates(allow_network=True)
    elif cmd == "verify":
        ok = cmd_verify()
        sys.exit(0 if ok else 1)
    elif cmd == "backup" and len(sys.argv) > 2:
        backup_extension(sys.argv[2])
    elif cmd == "restore" and len(sys.argv) > 2:
        bpath = sys.argv[3] if len(sys.argv) > 3 else None
        restore_extension(sys.argv[2], bpath)
    elif cmd == "decide" and len(sys.argv) > 3:
        cmd_set_decision(sys.argv[2], sys.argv[3])
    elif cmd == "dialog" and len(sys.argv) > 2:
        show_extension_warning_dialog(sys.argv[2])
    else:
        print("Usage: mac-extension-guard [status | check | verify | backup <uuid> | restore <uuid> | decide <uuid> <decision>]")
