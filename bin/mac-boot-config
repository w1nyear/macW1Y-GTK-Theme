#!/usr/bin/env python3
import sys
import os
import re
import glob
import shutil
import subprocess

import pwd

if os.geteuid() != 0:
    target_bin = "/usr/local/bin/mac-boot-config" if os.path.exists("/usr/local/bin/mac-boot-config") else os.path.abspath(__file__)
    os.execvp("sudo", ["sudo", target_bin] + sys.argv[1:])

def rebuild_initramfs():
    try:
        if shutil.which("update-initramfs") and os.path.isdir("/etc/initramfs-tools"):
            subprocess.run(["update-initramfs", "-u"], check=False)
        elif shutil.which("mkinitcpio") and glob.glob("/etc/mkinitcpio.d/*.preset"):
            subprocess.run(["mkinitcpio", "-P"], check=False)
        elif shutil.which("dracut"):
            subprocess.run(["dracut", "--regenerate-all", "--force"], check=False)
    except Exception:
        pass

def _boot_tr(key, fallback):
    try:
        sys.path.insert(0, "/usr/local/bin")
        sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
        import mac_i18n
        loc = None
        user = get_target_user()
        loc_f = os.path.expanduser(f"~{user}/.config/mac-styling/locale")
        if os.path.exists(loc_f):
            with open(loc_f, "r", encoding="utf-8") as f:
                loc = f.read().strip().lower() or None
        return mac_i18n.t(key, fallback, override_locale=loc)
    except Exception:
        return fallback

def update_systemd_boot(timeout=None):
    for p in ["/boot/loader/loader.conf", "/efi/loader/loader.conf"]:
        if os.path.exists(p):
            try:
                with open(p, "r") as f:
                    content = f.read()
                if timeout is not None:
                    if re.search(r"^#?timeout\s+.*", content, re.M):
                        content = re.sub(r"^#?timeout\s+.*", f"timeout {timeout}", content, flags=re.M)
                    else:
                        content += f"\ntimeout {timeout}\n"
                with open(p, "w") as f:
                    f.write(content)
                notify_user(_boot_tr("boot_cfg_title", "Boot Settings"), _boot_tr("boot_systemd_saved", "systemd-boot configuration saved!"))
                return True
            except Exception as e:
                print("Error updating loader.conf:", e)
    return False

def get_target_user():
    user = os.environ.get("SUDO_USER")
    if user and user != "root":
        return user
    # Check users with uid >= 1000 who have a session
    try:
        out = subprocess.check_output(["loginctl", "list-users", "--no-legend"], text=True)
        for line in out.strip().splitlines():
            parts = line.split()
            if len(parts) >= 2 and int(parts[0]) >= 1000:
                return parts[1]
    except Exception:
        pass
    user = os.environ.get("USER")
    if user and user != "root":
        return user
    try:
        return pwd.getpwuid(1000).pw_name
    except Exception:
        return "root"

def notify_user(title, msg):
    try:
        user = get_target_user()
        uid = subprocess.check_output(["id", "-u", user], text=True).strip()
        bus = f"unix:path=/run/user/{uid}/bus"
        env = {**os.environ, "DBUS_SESSION_BUS_ADDRESS": bus, "XDG_RUNTIME_DIR": f"/run/user/{uid}"}
        subprocess.run(["sudo", "-u", user, "env", f"DBUS_SESSION_BUS_ADDRESS={bus}", "gdbus", "call", "--session", "--dest", "org.freedesktop.Notifications", "--object-path", "/org/freedesktop/Notifications", "--method", "org.freedesktop.Notifications.Notify", _boot_tr("settings", "Settings"), "0", "", title, msg, "[]", "{}", "5000"], check=False, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except Exception:
        pass

def is_systemd_boot():
    if os.path.exists("/boot/loader/loader.conf"):
        try:
            res = subprocess.run(["bootctl", "is-installed"], capture_output=True, text=True)
            if res.returncode == 0:
                return True
        except Exception:
            pass
    return False

def get_grub_tools():
    mkconfig = "grub2-mkconfig" if shutil.which("grub2-mkconfig") else "grub-mkconfig"
    cfg_path = "/boot/grub/grub.cfg"
    if os.path.exists("/boot/grub2/grub.cfg") and not os.path.islink("/boot/grub2"):
        cfg_path = "/boot/grub2/grub.cfg"
    elif not os.path.exists("/boot/grub/grub.cfg") and os.path.exists("/boot/grub2"):
        cfg_path = "/boot/grub2/grub.cfg"
    return mkconfig, cfg_path

def update_grub():
    if is_systemd_boot():
        notify_user(_boot_tr("boot_cfg_title", "Boot Settings"), _boot_tr("boot_systemd_skip_grub", "systemd-boot detected. GRUB update skipped."))
        return True

    mkconfig, cfg_path = get_grub_tools()
    if not shutil.which(mkconfig):
        print(f"Neither grub-mkconfig nor grub2-mkconfig found; skipping.")
        return False

    # 1. Back up current working grub.cfg
    if os.path.exists(cfg_path) and os.path.getsize(cfg_path) > 1000:
        subprocess.run(["cp", "-a", cfg_path, f"{cfg_path}.bak"], check=False)

    # 2. Generate new config to a safe temporary file
    temp_cfg = f"{cfg_path}.tmp"
    res = subprocess.run([mkconfig, "-o", temp_cfg], capture_output=True, text=True)
    if res.returncode != 0:
        print(f"{mkconfig} failed:", res.stderr)
        if os.path.exists(temp_cfg):
            os.remove(temp_cfg)
        return False

    # 3. Validate syntax with grub-script-check if available
    check_bin = "grub2-script-check" if shutil.which("grub2-script-check") else "grub-script-check"
    if shutil.which(check_bin):
        check = subprocess.run([check_bin, temp_cfg], capture_output=True, text=True)
        if check.returncode != 0:
            print(f"{check_bin} failed:", check.stderr)
            if os.path.exists(temp_cfg):
                os.remove(temp_cfg)
            return False

    # 4. Verify that menuentry exists in the generated config
    with open(temp_cfg, "r") as f:
        cfg_str = f.read()
    if "menuentry " not in cfg_str:
        print("Validation error: no menuentry found in generated grub config!")
        if os.path.exists(temp_cfg):
            os.remove(temp_cfg)
        return False

    # 5. Atomic replace on filesystem
    os.replace(temp_cfg, cfg_path)
    os.chmod(cfg_path, 0o600)
    subprocess.run(["sync"], check=False)
    notify_user(_boot_tr("boot_cfg_title", "Boot Settings"), _boot_tr("boot_grub_saved", "GRUB configuration saved successfully!"))
    return True

def read_grub_default():
    with open("/etc/default/grub", "r") as f:
        return f.read()

def write_grub_default(content):
    with open("/etc/default/grub", "w") as f:
        f.write(content)

def set_grub(enable):
    if is_systemd_boot():
        update_systemd_boot(timeout=5 if enable else 0)
        return True

    c = read_grub_default()
    if enable:
        # 1. Timeout Style
        if re.search(r"^#?GRUB_TIMEOUT_STYLE=.*", c, re.M):
            c = re.sub(r"^#?GRUB_TIMEOUT_STYLE=.*", "GRUB_TIMEOUT_STYLE=menu", c, flags=re.M)
        else:
            c += "\nGRUB_TIMEOUT_STYLE=menu\n"

        # 2. Timeout (5s)
        if re.search(r"^#?GRUB_TIMEOUT=.*", c, re.M):
            c = re.sub(r"^#?GRUB_TIMEOUT=.*", "GRUB_TIMEOUT=5", c, flags=re.M)
        else:
            c += "\nGRUB_TIMEOUT=5\n"

        # 3. Theme (Enable macW1Y theme)
        if re.search(r"^#?GRUB_THEME=.*", c, re.M):
            c = re.sub(r"^#?GRUB_THEME=.*", 'GRUB_THEME="/boot/grub/themes/macw1y-boot/theme.txt"', c, flags=re.M)
        else:
            c += '\nGRUB_THEME="/boot/grub/themes/macw1y-boot/theme.txt"\n'

        # 4. Recordfail timeout
        if re.search(r"^#?GRUB_RECORDFAIL_TIMEOUT=.*", c, re.M):
            c = re.sub(r"^#?GRUB_RECORDFAIL_TIMEOUT=.*", "GRUB_RECORDFAIL_TIMEOUT=5", c, flags=re.M)
        else:
            c += "\nGRUB_RECORDFAIL_TIMEOUT=5\n"
    else:
        # Disable GRUB menu (fast direct boot)
        # 1. Timeout Style hidden
        if re.search(r"^#?GRUB_TIMEOUT_STYLE=.*", c, re.M):
            c = re.sub(r"^#?GRUB_TIMEOUT_STYLE=.*", "GRUB_TIMEOUT_STYLE=hidden", c, flags=re.M)
        else:
            c += "\nGRUB_TIMEOUT_STYLE=hidden\n"

        # 2. Timeout 0
        if re.search(r"^#?GRUB_TIMEOUT=.*", c, re.M):
            c = re.sub(r"^#?GRUB_TIMEOUT=.*", "GRUB_TIMEOUT=0", c, flags=re.M)
        else:
            c += "\nGRUB_TIMEOUT=0\n"

        # 3. Comment out theme so gfxmenu doesn't force menu display
        if re.search(r"^GRUB_THEME=.*", c, re.M):
            c = re.sub(r"^GRUB_THEME=.*", '#GRUB_THEME="/boot/grub/themes/macw1y-boot/theme.txt"', c, flags=re.M)

        # 4. Recordfail timeout 0
        if re.search(r"^#?GRUB_RECORDFAIL_TIMEOUT=.*", c, re.M):
            c = re.sub(r"^#?GRUB_RECORDFAIL_TIMEOUT=.*", "GRUB_RECORDFAIL_TIMEOUT=0", c, flags=re.M)
        else:
            c += "\nGRUB_RECORDFAIL_TIMEOUT=0\n"

    write_grub_default(c)
    update_grub()

def ensure_apple_center_image():
    targets = [
        "/boot/grub/themes/apple-mac/apple_center.png",
        "/boot/grub/themes/apple-mac-usb/apple_center.png",
        "/boot/grub/themes/macw1y-boot/apple_center.png"
    ]
    missing = [t for t in targets if not os.path.exists(t)]
    if missing:
        try:
            from PIL import Image
            logo_src = "/usr/share/plymouth/themes/apple-mac/logo.png"
            if not os.path.exists(logo_src):
                logo_src = "/usr/share/plymouth/themes/macw1y-boot/logo.png"
            if os.path.exists(logo_src):
                screen_w, screen_h = 1920, 1080
                logo = Image.open(logo_src).convert("RGBA")
                logo_h = int(screen_h * 0.092)
                logo_w = int(logo_h * (416 / 512))
                logo_resized = logo.resize((logo_w, logo_h), Image.Resampling.LANCZOS)
                bg = Image.new("RGB", (screen_w, screen_h), (0, 0, 0))
                pos_x = (screen_w - logo_w) // 2
                pos_y = (screen_h - logo_h) // 2
                bg.paste(logo_resized, (pos_x, pos_y), logo_resized)
                for t in targets:
                    os.makedirs(os.path.dirname(t), exist_ok=True)
                    bg.save(t, format="PNG")
                    os.chmod(t, 0o644)
        except Exception as e:
            print("Warning: failed to generate apple_center.png:", e)

def set_pclogo(enable):
    c = read_grub_default()
    if enable:
        if re.search(r"^#?GRUB_MAC_PCLOGO=.*", c, re.M):
            c = re.sub(r"^#?GRUB_MAC_PCLOGO=.*", "GRUB_MAC_PCLOGO=1", c, flags=re.M)
        else:
            c += "\nGRUB_MAC_PCLOGO=1\n"
    else:
        ensure_apple_center_image()
        if re.search(r"^#?GRUB_MAC_PCLOGO=.*", c, re.M):
            c = re.sub(r"^#?GRUB_MAC_PCLOGO=.*", "GRUB_MAC_PCLOGO=0", c, flags=re.M)
        else:
            c += "\nGRUB_MAC_PCLOGO=0\n"

    write_grub_default(c)
    update_grub()
    if enable:
        notify_user(_boot_tr("boot_cfg_title", "Boot Settings"), _boot_tr("boot_pclogo_on", "PC vendor boot logo enabled."))
    else:
        notify_user(_boot_tr("boot_cfg_title", "Boot Settings"), _boot_tr("boot_pclogo_off", "PC vendor logo disabled (replaced with macW1Y Apple logo)."))

def set_verbose(enable):
    c = read_grub_default()
    if enable:
        try:
            for theme in ["apple-mac", "macw1y-boot"]:
                p = f"/usr/share/plymouth/themes/{theme}"
                if os.path.isdir(p):
                    subprocess.run(["cp", "-f", f"{p}/1x1.png", f"{p}/verbose_on.png"], check=False)
            os.makedirs("/etc/plymouth", exist_ok=True)
            with open("/etc/plymouth/verbose_on", "w") as f:
                f.write("1\n")
            subprocess.run(["systemctl", "daemon-reload"], check=False)
            subprocess.run(["systemctl", "enable", "plymouth-verbose-logger.service"], check=False)
        except Exception:
            pass
        if re.search(r"^GRUB_CMDLINE_LINUX_DEFAULT=.*", c, re.M):
            c = re.sub(r"^GRUB_CMDLINE_LINUX_DEFAULT=.*", 'GRUB_CMDLINE_LINUX_DEFAULT="splash systemd.show_status=1 loglevel=4 bgrt.disable=1 vt.global_cursor_default=0"', c, flags=re.M)
        else:
            c += '\nGRUB_CMDLINE_LINUX_DEFAULT="splash systemd.show_status=1 loglevel=4 bgrt.disable=1 vt.global_cursor_default=0"\n'
    else:
        try:
            for theme in ["apple-mac", "macw1y-boot"]:
                for fn in ["verbose_on.png", "verbose_on.png.disabled"]:
                    fp = f"/usr/share/plymouth/themes/{theme}/{fn}"
                    if os.path.exists(fp):
                        try:
                            os.remove(fp)
                        except Exception:
                            pass
            if os.path.exists("/etc/plymouth/verbose_on"):
                try:
                    os.remove("/etc/plymouth/verbose_on")
                except Exception:
                    pass
            subprocess.run(["systemctl", "disable", "--now", "plymouth-verbose-logger.service"], check=False)
        except Exception:
            pass
        if re.search(r"^GRUB_CMDLINE_LINUX_DEFAULT=.*", c, re.M):
            c = re.sub(r"^GRUB_CMDLINE_LINUX_DEFAULT=.*", 'GRUB_CMDLINE_LINUX_DEFAULT="quiet splash bgrt.disable=1 vt.global_cursor_default=0 loglevel=3"', c, flags=re.M)
        else:
            c += '\nGRUB_CMDLINE_LINUX_DEFAULT="quiet splash bgrt.disable=1 vt.global_cursor_default=0 loglevel=3"\n'

    write_grub_default(c)
    update_grub()
    rebuild_initramfs()

if __name__ == "__main__":
    if len(sys.argv) < 3:
        print("Usage: mac-boot-config [set-grub|set-verbose|set-pclogo] [enable|disable]")
        sys.exit(1)
    action = sys.argv[1]
    val = sys.argv[2].lower() in ["enable", "true", "1", "yes"]
    if action == "set-grub":
        set_grub(val)
    elif action == "set-verbose":
        set_verbose(val)
    elif action == "set-pclogo":
        set_pclogo(val)
    else:
        print(f"Unknown action: {action}")
        sys.exit(1)
