#!/bin/bash
# mac-wine-runner: Seamless background runner for Windows executables (.exe, .msi, .bat, .cmd)
# Dynamically selects GPU based on Power Settings (mac-gpu-targets.json)
# Manages working directory, wineboot, and desktop notifications.

set -e

# Raise file descriptor limit to prevent EMFILE/STATUS_TOO_MANY_OPENED_FILES (0xc000011f)
ulimit -n 524288 2>/dev/null || true

# Clean harmful Vulkan loader overrides that break hybrid Intel/NVIDIA swapchains
unset VK_LOADER_DRIVERS_SELECT
unset __VK_LAYER_NV_optimus
unset VK_DRIVER_FILES
unset VK_ICD_FILENAMES

# Detect active system/macW1Y locale
LOCALE="en"
if [ -f "$HOME/.config/mac-styling/locale" ]; then
    LOCALE=$(cat "$HOME/.config/mac-styling/locale" | tr '[:upper:]' '[:lower:]' | tr -d ' \n\r')
elif [ -n "$LANGUAGE" ]; then
    LOCALE=$(echo "$LANGUAGE" | cut -d: -f1 | cut -d_ -f1 | tr '[:upper:]' '[:lower:]')
elif [ -n "$LANG" ]; then
    LOCALE=$(echo "$LANG" | cut -d. -f1 | cut -d_ -f1 | tr '[:upper:]' '[:lower:]')
fi

case "$LOCALE" in
    pl*)
        I18N_TITLE="Wybierz program Windows (.exe, .msi)"
        I18N_FILTER="Pliki Windows (*.exe, *.msi, *.bat, *.cmd) | *.exe *.EXE *.msi *.MSI *.bat *.BAT *.cmd *.CMD"
        I18N_USAGE="Użycie: mac-wine-runner <ścieżka_do_pliku.exe|msi|bat> [argumenty...]"
        I18N_NOT_FOUND="Błąd: plik '%s' nie został odnaleziony.\n"
        I18N_SETUP_TITLE="Konfiguracja Wine"
        I18N_SETUP_MSG="Inicjalizacja środowiska Windows po raz pierwszy..."
        I18N_ERR_TITLE="Błąd Wine"
        I18N_ERR_MSG="Wine nie jest zainstalowane w systemie."
        ;;
    uk*)
        I18N_TITLE="Оберіть Windows програму (.exe, .msi)"
        I18N_FILTER="Windows файли (*.exe, *.msi, *.bat, *.cmd) | *.exe *.EXE *.msi *.MSI *.bat *.BAT *.cmd *.CMD"
        I18N_USAGE="Використання: mac-wine-runner <шлях_до_файлу.exe|msi|bat> [аргументи...]"
        I18N_NOT_FOUND="Помилка: файл '%s' не знайдено.\n"
        I18N_SETUP_TITLE="Налаштування Wine"
        I18N_SETUP_MSG="Ініціалізація середовища Windows вперше..."
        I18N_ERR_TITLE="Помилка Wine"
        I18N_ERR_MSG="Wine не встановлено в системі."
        ;;
    de*)
        I18N_TITLE="Windows-Anwendung auswählen (.exe, .msi)"
        I18N_FILTER="Windows-Dateien (*.exe, *.msi, *.bat, *.cmd) | *.exe *.EXE *.msi *.MSI *.bat *.BAT *.cmd *.CMD"
        I18N_USAGE="Verwendung: mac-wine-runner <dateipfad.exe|msi|bat> [argumente...]"
        I18N_NOT_FOUND="Fehler: Datei '%s' nicht gefunden.\n"
        I18N_SETUP_TITLE="Wine-Einrichtung"
        I18N_SETUP_MSG="Windows-Umgebung wird erstmalig initialisiert..."
        I18N_ERR_TITLE="Wine-Fehler"
        I18N_ERR_MSG="Wine ist nicht im System installiert."
        ;;
    fr*)
        I18N_TITLE="Sélectionnez une application Windows (.exe, .msi)"
        I18N_FILTER="Fichiers Windows (*.exe, *.msi, *.bat, *.cmd) | *.exe *.EXE *.msi *.MSI *.bat *.BAT *.cmd *.CMD"
        I18N_USAGE="Utilisation : mac-wine-runner <chemin_fichier.exe|msi|bat> [arguments...]"
        I18N_NOT_FOUND="Erreur : fichier '%s' introuvable.\n"
        I18N_SETUP_TITLE="Configuration de Wine"
        I18N_SETUP_MSG="Initialisation de l'environnement Windows pour la première fois..."
        I18N_ERR_TITLE="Erreur Wine"
        I18N_ERR_MSG="Wine n'est pas installé sur le système."
        ;;
    es*)
        I18N_TITLE="Seleccionar aplicación de Windows (.exe, .msi)"
        I18N_FILTER="Archivos de Windows (*.exe, *.msi, *.bat, *.cmd) | *.exe *.EXE *.msi *.MSI *.bat *.BAT *.cmd *.CMD"
        I18N_USAGE="Uso: mac-wine-runner <ruta_archivo.exe|msi|bat> [argumentos...]"
        I18N_NOT_FOUND="Error: archivo '%s' no encontrado.\n"
        I18N_SETUP_TITLE="Configuración de Wine"
        I18N_SETUP_MSG="Inicializando entorno Windows por primera vez..."
        I18N_ERR_TITLE="Error de Wine"
        I18N_ERR_MSG="Wine no está instalado en el sistema."
        ;;
    it*)
        I18N_TITLE="Seleziona applicazione Windows (.exe, .msi)"
        I18N_FILTER="File Windows (*.exe, *.msi, *.bat, *.cmd) | *.exe *.EXE *.msi *.MSI *.bat *.BAT *.cmd *.CMD"
        I18N_USAGE="Uso: mac-wine-runner <percorso_file.exe|msi|bat> [argomenti...]"
        I18N_NOT_FOUND="Errore: file '%s' non trovato.\n"
        I18N_SETUP_TITLE="Configurazione Wine"
        I18N_SETUP_MSG="Inizializzazione ambiente Windows per la prima volta..."
        I18N_ERR_TITLE="Errore Wine"
        I18N_ERR_MSG="Wine non è installato nel sistema."
        ;;
    *)
        I18N_TITLE="Select Windows Application (.exe, .msi)"
        I18N_FILTER="Windows files (*.exe, *.msi, *.bat, *.cmd) | *.exe *.EXE *.msi *.MSI *.bat *.BAT *.cmd *.CMD"
        I18N_USAGE="Usage: mac-wine-runner <path_to_file.exe|msi|bat> [arguments...]"
        I18N_NOT_FOUND="Error: file '%s' not found.\n"
        I18N_SETUP_TITLE="Wine Setup"
        I18N_SETUP_MSG="Initializing Windows environment for the first time..."
        I18N_ERR_TITLE="Wine Error"
        I18N_ERR_MSG="Wine is not installed on the system."
        ;;
esac

if command -v python3 >/dev/null 2>&1; then
    _WINE_MAP=$(python3 - "$0" <<'PY' 2>/dev/null
import os, sys
script_dir = os.path.dirname(os.path.realpath(sys.argv[1]))
for p in ("/usr/local/bin", script_dir):
    if p not in sys.path:
        sys.path.insert(0, p)
import mac_i18n
vals = [
    mac_i18n.t("wine_pick_title"),
    mac_i18n.t("wine_filter"),
    mac_i18n.t("wine_usage"),
    mac_i18n.tf("wine_not_found", {"path": "%s"}) + "\\n",
    mac_i18n.t("wine_setup_title"),
    mac_i18n.t("wine_setup_msg"),
    mac_i18n.t("wine_err_title"),
    mac_i18n.t("wine_err_msg"),
]
for v in vals:
    print(v.replace("\n", " "))
PY
)
    if [ -n "$_WINE_MAP" ]; then
        readarray -t _WINE_LINES <<< "$_WINE_MAP"
        if [ "${#_WINE_LINES[@]}" -ge 8 ] && [ -n "${_WINE_LINES[0]}" ]; then
            I18N_TITLE="${_WINE_LINES[0]}"
            I18N_FILTER="${_WINE_LINES[1]} | *.exe *.EXE *.msi *.MSI *.bat *.BAT *.cmd *.CMD"
            I18N_USAGE="${_WINE_LINES[2]}"
            I18N_NOT_FOUND="${_WINE_LINES[3]%\\n}\n"
            I18N_SETUP_TITLE="${_WINE_LINES[4]}"
            I18N_SETUP_MSG="${_WINE_LINES[5]}"
            I18N_ERR_TITLE="${_WINE_LINES[6]}"
            I18N_ERR_MSG="${_WINE_LINES[7]}"
        fi
    fi
fi

if [ $# -lt 1 ]; then
    if [ -n "$DISPLAY" ] || [ -n "$WAYLAND_DISPLAY" ]; then
        if command -v zenity >/dev/null 2>&1; then
            TARGET=$(zenity --file-selection --title="$I18N_TITLE" --file-filter="$I18N_FILTER" 2>/dev/null || true)
            if [ -z "$TARGET" ]; then
                exit 0
            fi
        fi
    fi
    if [ -z "$TARGET" ]; then
        echo "$I18N_USAGE" >&2
        exit 1
    fi
else
    TARGET="$1"
    shift
fi

if [[ "$TARGET" =~ ^file:// ]]; then
    TARGET=$(python3 -c "import urllib.parse, sys; print(urllib.parse.unquote(urllib.parse.urlsplit(sys.argv[1]).path))" "$TARGET" 2>/dev/null || echo "$TARGET")
fi

if [ ! -e "$TARGET" ]; then
    printf "$I18N_NOT_FOUND" "$TARGET" >&2
    exit 1
fi

# Resolve absolute path and parent directory
ABS_TARGET="$(realpath "$TARGET")"
WORK_DIR="$(dirname "$ABS_TARGET")"
FILE_NAME="$(basename "$ABS_TARGET")"
APP_NAME="${FILE_NAME%.*}"
EXT="${FILE_NAME##*.}"
EXT_LOWER="$(echo "$EXT" | tr '[:upper:]' '[:lower:]')"

# Ensure WINEPREFIX is set and directory exists
export WINEPREFIX="${WINEPREFIX:-$HOME/.wine}"
export WINEDEBUG="${WINEDEBUG:--all}"

# If wine prefix doesn't exist yet, run silent wineboot
if [ ! -d "$WINEPREFIX" ]; then
    if [ -n "$DISPLAY" ] || [ -n "$WAYLAND_DISPLAY" ]; then
        notify-send -a "macW1Y" -i "system-software-install" "$I18N_SETUP_TITLE" "$I18N_SETUP_MSG" 2>/dev/null || true
    fi
    wineboot -u >/dev/null 2>&1 || true
fi

# Read target GPU configured in Power Settings (Параметри -> Живлення)
CONFIG_FILE="$HOME/.config/mac-gpu-targets.json"
[ -f "$CONFIG_FILE" ] || CONFIG_FILE="/etc/mac-gpu-targets.json"

IS_GAME=0
if echo "$ABS_TARGET $@" | grep -qi -E "game|steam|lutris|heroic|epic|gog|darksouls|cyberpunk|gta|witcher|cs2|cstrike|cstrike_online|rdr|elden"; then
    IS_GAME=1
fi

TARGET_GPU=""
if [ -f "$CONFIG_FILE" ]; then
    if [ "$IS_GAME" -eq 1 ]; then
        TARGET_GPU=$(grep -o '"games"[[:space:]]*:[[:space:]]*[0-9]*' "$CONFIG_FILE" 2>/dev/null | grep -o '[0-9]*$')
    fi
    if [ -z "$TARGET_GPU" ]; then
        TARGET_GPU=$(grep -o '"apps"[[:space:]]*:[[:space:]]*[0-9]*' "$CONFIG_FILE" 2>/dev/null | grep -o '[0-9]*$')
    fi
    if [ -z "$TARGET_GPU" ]; then
        TARGET_GPU=$(grep -o '"system"[[:space:]]*:[[:space:]]*[0-9]*' "$CONFIG_FILE" 2>/dev/null | grep -o '[0-9]*$')
    fi
fi

if [ -z "$TARGET_GPU" ] && [ -f "/etc/mac-gpu.state" ]; then
    STATE=$(cat /etc/mac-gpu.state 2>/dev/null)
    if [ "$STATE" = "nvidia" ] || [ "$STATE" = "apps_nvidia" ]; then
        TARGET_GPU=1
    else
        TARGET_GPU=0
    fi
fi

[ -z "$TARGET_GPU" ] && TARGET_GPU=0

GPU_LABEL="Intel"
if [ "$TARGET_GPU" -eq 1 ] && command -v nvidia-smi >/dev/null 2>&1; then
    GPU_LABEL="NVIDIA RTX 3050"
    export __NV_PRIME_RENDER_OFFLOAD=1
    export __GLX_VENDOR_LIBRARY_NAME=nvidia
    unset __VK_LAYER_NV_optimus
    export PROTON_ENABLE_NVAPI=1
    export DXVK_ENABLE_NVAPI=1
    export PROTON_HIDE_NVIDIA_GPU=0
    export __GL_SYNC_TO_VBLANK=0
    export vblank_mode=0
    export DXVK_FRAME_RATE=0
    export MANGOHUD_CONFIG="fps_limit=0"
    unset DRI_PRIME
    unset MESA_VK_DEVICE_SELECT
else
    GPU_LABEL="Intel Graphics"
    unset __NV_PRIME_RENDER_OFFLOAD
    unset __GLX_VENDOR_LIBRARY_NAME
    unset __VK_LAYER_NV_optimus
    unset PROTON_ENABLE_NVAPI
    unset DXVK_ENABLE_NVAPI
    unset DXVK_FRAME_RATE
    unset MESA_VK_DEVICE_SELECT
    export DRI_PRIME=0
    export MESA_LOADER_DRIVER_OVERRIDE=iris
fi

# Ensure critical runtime overrides are applied for stability.
# dcomp=d disables DirectComposition to prevent SwapChain11/bad allocation crashes in CEF/ANGLE apps.
if echo "$ABS_TARGET" | grep -qi "capcut"; then
    /usr/local/bin/mac-capcut-fix "$ABS_TARGET" 2>/dev/null || true
fi
DEFAULT_OVERRIDES="dcomp=d;msvcp140,msvcp140_1,msvcp140_2,msvcp140_codecvt_ids,vcruntime140,vcruntime140_1,vcomp140,concrt140,ucrtbase=n,b;d3d11,dxgi,d3dcompiler_47=n,b"
if [ -z "$WINEDLLOVERRIDES" ]; then
    export WINEDLLOVERRIDES="$DEFAULT_OVERRIDES"
else
    if [[ ! "$WINEDLLOVERRIDES" =~ dcomp= ]]; then
        export WINEDLLOVERRIDES="dcomp=d;$WINEDLLOVERRIDES"
    fi
fi

# Enable DirectComposition dummy swapchains and deferred surface creation in DXVK
if [ -z "$DXVK_CONFIG" ]; then
    export DXVK_CONFIG="dxgi.enableDummyCompositionSwapchain = True; dxgi.deferSurfaceCreation = True"
fi


cd "$WORK_DIR"

REAL_WINE=$(PATH=$(echo "$PATH" | sed -e 's|/usr/local/bin||g' -e 's|::|:|g') which wine 2>/dev/null || which wine 2>/dev/null)
if [ -z "$REAL_WINE" ] || [ ! -x "$REAL_WINE" ]; then
    if [ -x "/usr/bin/wine" ]; then
        REAL_WINE="/usr/bin/wine"
    fi
fi

if [ -z "$REAL_WINE" ]; then
    notify-send -u critical -a "macW1Y" "$I18N_ERR_TITLE" "$I18N_ERR_MSG" 2>/dev/null || true
    echo "$I18N_ERR_MSG" >&2
    exit 1
fi

case "$EXT_LOWER" in
    msi)
        exec "$REAL_WINE" msiexec /i "$ABS_TARGET" "$@"
        ;;
    bat|cmd)
        exec "$REAL_WINE" cmd /c "$ABS_TARGET" "$@"
        ;;
    *)
        exec "$REAL_WINE" "$ABS_TARGET" "$@"
        ;;
esac
