#!/bin/bash
# mac-wine-runner: Seamless background runner for Windows executables (.exe, .msi, .bat, .cmd)
# Dynamically selects GPU based on Power Settings (mac-gpu-targets.json)
# Manages working directory, wineboot, and desktop notifications.

set -e

# Raise file descriptor limit to prevent EMFILE/STATUS_TOO_MANY_OPENED_FILES (0xc000011f)
ulimit -n 524288 2>/dev/null || true

if [ $# -lt 1 ]; then
    if [ -n "$DISPLAY" ] || [ -n "$WAYLAND_DISPLAY" ]; then
        if command -v zenity >/dev/null 2>&1; then
            TARGET=$(zenity --file-selection --title="Оберіть Windows програму (.exe, .msi)" --file-filter="Windows файли (*.exe, *.msi, *.bat, *.cmd) | *.exe *.EXE *.msi *.MSI *.bat *.BAT *.cmd *.CMD" 2>/dev/null || true)
            if [ -z "$TARGET" ]; then
                exit 0
            fi
        fi
    fi
    if [ -z "$TARGET" ]; then
        echo "Використання: mac-wine-runner <шлях_до_файлу.exe|msi|bat> [аргументи...]" >&2
        exit 1
    fi
else
    TARGET="$1"
    shift
fi

if [[ "$TARGET" =~ ^file:// ]]; then
    TARGET=$(python3 -c "import urllib.parse, sys; print(urllib.parse.unquote(urllib.parse.urlsplit(sys.argv[1]).path))" "$TARGET" 2>/dev/null || echo "$TARGET")
fi

if [ ! -e "$TARGET" ]; then
    echo "Помилка: файл '$TARGET' не знайдено." >&2
    exit 1
fi

# Resolve absolute path and parent directory
ABS_TARGET="$(realpath "$TARGET")"
WORK_DIR="$(dirname "$ABS_TARGET")"
FILE_NAME="$(basename "$ABS_TARGET")"
APP_NAME="${FILE_NAME%.*}"
EXT="${FILE_NAME##*.}"
EXT_LOWER="$(echo "$EXT" | tr '[:upper:]' '[:lower:]')"

# Ensure WINEPREFIX is set and directory exists
export WINEPREFIX="${WINEPREFIX:-$HOME/.wine}"
export WINEDEBUG="${WINEDEBUG:--all}"

# If wine prefix doesn't exist yet, run silent wineboot
if [ ! -d "$WINEPREFIX" ]; then
    if [ -n "$DISPLAY" ] || [ -n "$WAYLAND_DISPLAY" ]; then
        notify-send -a "macOS" -i "system-software-install" "Налаштування Wine" "Ініціалізація середовища Windows вперше..." 2>/dev/null || true
    fi
    wineboot -u >/dev/null 2>&1 || true
fi

# Read target GPU configured in Power Settings (Параметри -> Живлення)
CONFIG_FILE="$HOME/.config/mac-gpu-targets.json"
[ -f "$CONFIG_FILE" ] || CONFIG_FILE="/etc/mac-gpu-targets.json"

IS_GAME=0
if echo "$ABS_TARGET $@" | grep -qi -E "game|steam|lutris|heroic|epic|gog|darksouls|cyberpunk|gta|witcher|cs2|cstrike|cstrike_online|rdr|elden"; then
    IS_GAME=1
fi

TARGET_GPU=""
if [ -f "$CONFIG_FILE" ]; then
    if [ "$IS_GAME" -eq 1 ]; then
        TARGET_GPU=$(grep -o '"games"[[:space:]]*:[[:space:]]*[0-9]*' "$CONFIG_FILE" 2>/dev/null | grep -o '[0-9]*$')
    fi
    if [ -z "$TARGET_GPU" ]; then
        TARGET_GPU=$(grep -o '"apps"[[:space:]]*:[[:space:]]*[0-9]*' "$CONFIG_FILE" 2>/dev/null | grep -o '[0-9]*$')
    fi
    if [ -z "$TARGET_GPU" ]; then
        TARGET_GPU=$(grep -o '"system"[[:space:]]*:[[:space:]]*[0-9]*' "$CONFIG_FILE" 2>/dev/null | grep -o '[0-9]*$')
    fi
fi

if [ -z "$TARGET_GPU" ] && [ -f "/etc/mac-gpu.state" ]; then
    STATE=$(cat /etc/mac-gpu.state 2>/dev/null)
    if [ "$STATE" = "nvidia" ] || [ "$STATE" = "apps_nvidia" ]; then
        TARGET_GPU=1
    else
        TARGET_GPU=0
    fi
fi

[ -z "$TARGET_GPU" ] && TARGET_GPU=0

GPU_LABEL="Intel"
if [ "$TARGET_GPU" -eq 1 ] && command -v nvidia-smi >/dev/null 2>&1; then
    GPU_LABEL="NVIDIA RTX 3050"
    export __NV_PRIME_RENDER_OFFLOAD=1
    export __GLX_VENDOR_LIBRARY_NAME=nvidia
    unset __VK_LAYER_NV_optimus
    export PROTON_ENABLE_NVAPI=1
    export DXVK_ENABLE_NVAPI=1
    export PROTON_HIDE_NVIDIA_GPU=0
    export __GL_SYNC_TO_VBLANK=0
    export vblank_mode=0
    export DXVK_FRAME_RATE=0
    export MANGOHUD_CONFIG="fps_limit=0"
    unset DRI_PRIME
    unset MESA_VK_DEVICE_SELECT
else
    GPU_LABEL="Intel Graphics"
    unset __NV_PRIME_RENDER_OFFLOAD
    unset __GLX_VENDOR_LIBRARY_NAME
    unset __VK_LAYER_NV_optimus
    unset PROTON_ENABLE_NVAPI
    unset DXVK_ENABLE_NVAPI
    unset DXVK_FRAME_RATE
    unset MESA_VK_DEVICE_SELECT
    export DRI_PRIME=0
    export MESA_LOADER_DRIVER_OVERRIDE=iris
fi

# Ensure critical runtime overrides are applied for stability.
# dcomp=d disables DirectComposition to prevent SwapChain11/bad allocation crashes in CEF/ANGLE apps.
DEFAULT_OVERRIDES="dcomp=d;msvcp140,msvcp140_1,msvcp140_2,msvcp140_codecvt_ids,vcruntime140,vcruntime140_1,vcomp140,concrt140,ucrtbase=n,b;d3d11,dxgi,d3dcompiler_47=n,b"
if [ -z "$WINEDLLOVERRIDES" ]; then
    export WINEDLLOVERRIDES="$DEFAULT_OVERRIDES"
else
    if [[ ! "$WINEDLLOVERRIDES" =~ dcomp= ]]; then
        export WINEDLLOVERRIDES="dcomp=d;$WINEDLLOVERRIDES"
    fi
fi

# Enable DirectComposition dummy swapchains and deferred surface creation in DXVK
if [ -z "$DXVK_CONFIG" ]; then
    export DXVK_CONFIG="dxgi.enableDummyCompositionSwapchain = True; dxgi.deferSurfaceCreation = True"
fi


cd "$WORK_DIR"

REAL_WINE=$(PATH=$(echo "$PATH" | sed -e 's|/usr/local/bin||g' -e 's|::|:|g') which wine 2>/dev/null || which wine 2>/dev/null)
if [ -z "$REAL_WINE" ] || [ ! -x "$REAL_WINE" ]; then
    if [ -x "/usr/bin/wine" ]; then
        REAL_WINE="/usr/bin/wine"
    fi
fi

if [ -z "$REAL_WINE" ]; then
    notify-send -u critical -a "macOS" "Помилка Wine" "Wine не встановлено в системі." 2>/dev/null || true
    echo "Wine is not installed." >&2
    exit 1
fi

case "$EXT_LOWER" in
    msi)
        exec "$REAL_WINE" msiexec /i "$ABS_TARGET" "$@"
        ;;
    bat|cmd)
        exec "$REAL_WINE" cmd /c "$ABS_TARGET" "$@"
        ;;
    *)
        exec "$REAL_WINE" "$ABS_TARGET" "$@"
        ;;
esac
