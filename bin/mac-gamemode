#!/usr/bin/env python3
"""
mac-gamemode: Advanced Gaming Performance & Thermal Orchestrator for macW1Y
Supports Acer Nitro V15 ANV15-51 (Intel i5-13420H + NVIDIA RTX 3050 Laptop GPU)
Provides 3 distinct modes:
  1. Gaming (Turbo 4.6 GHz, P-core thread pinning, RTX 3050 Dynamic Boost, ACPI balanced-performance)
  2. Balanced (Dynamic 0.8-4.6 GHz, EPP balance_performance, ACPI balanced, quiet idle)
  3. Quiet (Dynamic 0.8-3.4 GHz, EPP power, ACPI quiet, fan noise reduction)
"""
import sys, os, time, glob, subprocess, re

STATE_FILE = '/etc/mac-gamemode.state'

# Intel Core i5-13420H Topology:
# Cores 0-3 (Threads 0-7): 4 Performance Cores (P-cores, up to 4.60 GHz Turbo, 12MB L3 Cache)
# Cores 4-7 (Threads 8-11): 4 Efficient Cores (E-cores, up to 3.40 GHz Turbo, 4MB L2 Cache)
P_CORES = {0, 1, 2, 3, 4, 5, 6, 7}
E_CORES = {8, 9, 10, 11}
ALL_CORES = set(range(12))

# Thermal limits:
# Intel Raptor Lake TjMax is 100.0°C.
# 95°C protects hardware during heavy gaming while allowing full Turbo Boost headroom.
GAME_HARD_LIMIT = 95.0
GAME_RECOVERY_TEMP = 88.0

LOADING_HARD_LIMIT = 88.0
LOADING_RECOVERY_TEMP = 80.0

HARDWARE_MAX_FREQ = 4600000  # 4.60 GHz max hardware Turbo
TARGET_MIN_FREQ = 800000     # 800 MHz cool idle downclock

GAME_EXCLUDES = {
    'systemd', 'oom_reaper', 'khungtaskd', 'switcheroo-control',
    'switcheroo-cont', 'mac-switcheroo-', 'xdg-desktop-portal',
    'xdg-document-portal', 'ibus-portal', 'python3', 'bash', 'sh',
    'zsh', 'gnome-shell', 'mutter', 'xwayland', 'pipewire',
    'wireplumber', 'pulseaudio', 'fossilize_replay', 'fossilize_repla',
    'fossilize', 'steamwebhelper', 'steam', 'srt-bwrap', 'pv-adverb',
    'bwrap', 'pressure-vessel-adverb', 'services.exe', 'winedevice.exe',
    'plugplay.exe', 'svchost.exe', 'rpcss.exe', 'conhost.exe',
    'explorer.exe', 'wineboot.exe'
}

GAME_REGEXES = [
    re.compile(r'steam_app_\d+'),
    re.compile(r'steamapps/common/(?!Steam Linux Runtime)[^/]+'),
    re.compile(r'\.exe($|\s)'),
    re.compile(r'\bcstrike'),
    re.compile(r'\bcs2\b'),
    re.compile(r'\bcsgo\b'),
    re.compile(r'\bdota2\b'),
    re.compile(r'\bhl2'),
    re.compile(r'watch_dogs'),
    re.compile(r'watchdogs'),
    re.compile(r'disrupt'),
    re.compile(r'cyberpunk'),
    re.compile(r'witcher'),
    re.compile(r'\bgta'),
    re.compile(r'gamescope'),
    re.compile(r'\bproton\b'),
    re.compile(r'\blutris'),
    re.compile(r'\bheroic'),
    re.compile(r'rpcs3'),
    re.compile(r'yuzu'),
    re.compile(r'ryujinx'),
    re.compile(r'cemu'),
    re.compile(r'pcsx2'),
    re.compile(r'retroarch'),
    re.compile(r'prismlauncher'),
    re.compile(r'bottles'),
    re.compile(r'gamemoderun'),
    re.compile(r'nvidia-game-run'),
    re.compile(r'unityplayer'),
    re.compile(r'unrealengine'),
    re.compile(r'minecraft'),
    re.compile(r'vkcube'),
    re.compile(r'superposition'),
    re.compile(r'unigine')
]

BG_KEYWORDS = [
    'tracker-miner', 'tracker-extract', 'updatedb', 'mandb'
]

_last_cpu_stat = (0, 0)

def get_cpu_utilization():
    global _last_cpu_stat
    try:
        with open('/proc/stat', 'r') as f:
            line = f.readline()
        fields = [float(x) for x in line.strip().split()[1:]]
        idle_time = fields[3] + (fields[4] if len(fields) > 4 else 0)
        total_time = sum(fields)
        prev_idle, prev_total = _last_cpu_stat
        _last_cpu_stat = (idle_time, total_time)
        delta_total = total_time - prev_total
        delta_idle = idle_time - prev_idle
        if delta_total <= 0:
            return 0.0
        return max(0.0, min(100.0, (1.0 - (delta_idle / delta_total)) * 100.0))
    except Exception:
        return 0.0

def get_system_stall_pressure():
    try:
        if os.path.exists('/proc/pressure/cpu'):
            with open('/proc/pressure/cpu', 'r') as f:
                content = f.read()
            m = re.search(r'avg10=([0-9.]+)', content)
            if m and float(m.group(1)) > 1.8:
                return True
        with open('/proc/loadavg', 'r') as f:
            lavg = float(f.read().split()[0])
            if lavg > 3.0:
                return True
    except Exception:
        pass
    return False

def is_game_process(comm, cmdline, pid=None):
    comm_l = comm.lower()
    cmdline_l = cmdline.lower()
    if comm_l in GAME_EXCLUDES:
        return False
    if any(comm_l.startswith(p) for p in ['xdg-', 'systemd-', 'ibus-']):
        return False
    full = comm_l + ' ' + cmdline_l
    for r in GAME_REGEXES:
        if r.search(full):
            return True
            
    if pid is not None:
        try:
            with open(f'/proc/{pid}/environ', 'rb') as f:
                env_raw = f.read(4096).decode('utf-8', 'ignore')
                if ('STEAM_COMPAT_DATA_PATH' in env_raw or 
                    'DXVK_CONFIG_FILE' in env_raw):
                    if comm_l not in GAME_EXCLUDES:
                        return True
        except Exception:
            pass
    return False

def is_bg_process(comm, cmdline):
    full = (comm + ' ' + cmdline).lower()
    for kw in BG_KEYWORDS:
        if kw in full:
            return True
    return False

def is_on_battery():
    for p in ['/sys/class/power_supply/ACAD/online', '/sys/class/power_supply/AC/online']:
        if os.path.exists(p):
            try:
                with open(p, 'r') as f:
                    return f.read().strip() == '0'
            except Exception:
                pass
    return False

def set_platform_profile(profile):
    """
    Sets the ACPI platform profile matching supported choices on this laptop
    (e.g. low-power, quiet, balanced, balanced-performance).
    """
    targets = [
        '/sys/firmware/acpi/platform_profile',
        '/sys/devices/platform/acer-wmi/platform-profile/platform-profile-0/profile'
    ]
    choices = []
    if os.path.exists('/sys/firmware/acpi/platform_profile_choices'):
        try:
            with open('/sys/firmware/acpi/platform_profile_choices', 'r') as f:
                choices = f.read().strip().split()
        except Exception:
            pass

    val = profile
    if profile in ['performance', 'balanced-performance', 'gaming', 'game']:
        if 'balanced-performance' in choices:
            val = 'balanced-performance'
        elif 'performance' in choices:
            val = 'performance'
        else:
            val = 'balanced'
    elif profile in ['quiet', 'silent', 'low']:
        if 'quiet' in choices:
            val = 'quiet'
        elif 'low-power' in choices:
            val = 'low-power'
        else:
            val = 'balanced'
    elif profile in ['balanced', 'normal', 'desktop']:
        val = 'balanced' if 'balanced' in choices else profile

    for p in targets:
        if os.path.exists(p):
            try:
                with open(p, 'w') as f:
                    f.write(f'{val}\n')
            except Exception:
                pass

def set_intel_igpu_min_freq(freq_mhz):
    targets = [
        '/sys/class/drm/card1/gt_min_freq_mhz',
        '/sys/class/drm/card0/gt_min_freq_mhz'
    ]
    for p in targets:
        if os.path.exists(p):
            try:
                with open(p, 'w') as f:
                    f.write(f'{freq_mhz}\n')
            except Exception:
                pass

def apply_sysctl(params):
    for k, v in params.items():
        try:
            subprocess.run(['sysctl', '-w', f'{k}={v}'], capture_output=True, check=False)
        except Exception:
            pass

def set_cpu_freq(governor='powersave', epp='balance_performance', min_freq=TARGET_MIN_FREQ, max_freq=HARDWARE_MAX_FREQ, turbo=True):
    """
    Configures Intel P-State scaling:
    - turbo=True: maintains Intel Turbo Boost enabled (no_turbo = 0) up to hardware max (4.6 GHz).
    - Uses EPP (energy_performance_preference) for smooth dynamic frequency transitions.
    """
    no_turbo_path = '/sys/devices/system/cpu/intel_pstate/no_turbo'
    if os.path.exists(no_turbo_path):
        try:
            with open(no_turbo_path, 'w') as f:
                f.write('0\n' if turbo else '1\n')
        except Exception:
            pass

    for cpu in glob.glob('/sys/devices/system/cpu/cpu[0-9]*'):
        gov_path = os.path.join(cpu, 'cpufreq', 'scaling_governor')
        epp_path = os.path.join(cpu, 'cpufreq', 'energy_performance_preference')
        min_path = os.path.join(cpu, 'cpufreq', 'scaling_min_freq')
        max_path = os.path.join(cpu, 'cpufreq', 'scaling_max_freq')
        
        if os.path.exists(max_path):
            try:
                with open(max_path, 'w') as f:
                    f.write(f'{max_freq}\n')
            except Exception:
                pass
        if os.path.exists(gov_path):
            try:
                with open(gov_path, 'w') as f:
                    f.write(f'{governor}\n')
            except Exception:
                pass
        if os.path.exists(epp_path):
            try:
                with open(epp_path, 'w') as f:
                    f.write(f'{epp}\n')
            except Exception:
                pass
        if os.path.exists(min_path):
            try:
                with open(min_path, 'w') as f:
                    f.write(f'{min_freq}\n')
            except Exception:
                pass

def set_wifi_powersave(enable):
    try:
        val = 'on' if enable else 'off'
        out = subprocess.check_output(['iw', 'dev'], text=True)
        for line in out.splitlines():
            line = line.strip()
            if line.startswith('Interface '):
                iface = line.split()[1]
                subprocess.run(['iw', 'dev', iface, 'set', 'power_save', val], capture_output=True)
    except Exception:
        pass

def set_gpu_performance(enable, throttled=False):
    """
    Configures GPU performance parameters harmoniously with nvidia-powerd:
    - Resets any locked clocks to allow full dynamic scaling.
    - Sets ACPI platform profile (balanced-performance during gaming).
    - Ensures NVIDIA persistence mode is active.
    """
    try:
        subprocess.run(['nvidia-smi', '-rgc'], capture_output=True)
        subprocess.run(['nvidia-smi', '-rmc'], capture_output=True)
        if enable and not throttled:
            subprocess.run(['nvidia-smi', '-pm', '1'], capture_output=True)
            set_intel_igpu_min_freq(800)
            set_platform_profile('balanced-performance')
        elif enable and throttled:
            set_intel_igpu_min_freq(400)
            set_platform_profile('balanced')
        else:
            set_intel_igpu_min_freq(100)
            set_platform_profile('balanced')
    except Exception:
        pass

def get_current_temperatures():
    """Returns (cpu_temp, gpu_temp) in Celsius."""
    cpu_temp = 0.0
    for z in ['/sys/class/thermal/thermal_zone8/temp', '/sys/class/thermal/thermal_zone6/temp', '/sys/class/thermal/thermal_zone0/temp']:
        if os.path.exists(z):
            try:
                with open(z) as f:
                    val = int(f.read().strip()) / 1000.0
                    if val > cpu_temp:
                        cpu_temp = val
            except Exception:
                pass
    gpu_temp = 0.0
    try:
        res = subprocess.run(['nvidia-smi', '--query-gpu=temperature.gpu', '--format=csv,noheader,nounits'], capture_output=True, text=True, check=False)
        gpu_temp = float(res.stdout.strip())
    except Exception:
        pass
    return cpu_temp, gpu_temp

def optimize_processes():
    """
    Optimizes CPU scheduling and priority:
    - Game processes and all their threads are strictly pinned to P-CORES (0-7: 4.60 GHz, 12MB L3 Cache)
    - Background indexing/heavy jobs are pinned to E-CORES (8-11) with idle priority
    """
    for pid_dir in glob.glob('/proc/[0-9]*'):
        try:
            pid = int(os.path.basename(pid_dir))
            comm_path = os.path.join(pid_dir, 'comm')
            cmd_path = os.path.join(pid_dir, 'cmdline')
            if not os.path.exists(comm_path):
                continue
            with open(comm_path, 'r', errors='ignore') as f:
                comm = f.read().strip()
            with open(cmd_path, 'r', errors='ignore') as f:
                cmdline = f.read().replace('\x00', ' ').strip()
            
            if is_game_process(comm, cmdline, pid):
                try:
                    os.setpriority(os.PRIO_PROCESS, pid, -15)
                except Exception:
                    pass
                try:
                    subprocess.run(['ionice', '-c', '2', '-n', '0', '-p', str(pid)], capture_output=True)
                except Exception:
                    pass
                try:
                    os.sched_setaffinity(pid, P_CORES)
                    task_dir = f'/proc/{pid}/task'
                    if os.path.exists(task_dir):
                        for tid_str in os.listdir(task_dir):
                            try:
                                os.sched_setaffinity(int(tid_str), P_CORES)
                            except Exception:
                                pass
                except Exception:
                    pass
            elif is_bg_process(comm, cmdline):
                try:
                    os.setpriority(os.PRIO_PROCESS, pid, 19)
                except Exception:
                    pass
                try:
                    subprocess.run(['ionice', '-c', '3', '-p', str(pid)], capture_output=True)
                except Exception:
                    pass
                try:
                    os.sched_setaffinity(pid, E_CORES)
                except Exception:
                    pass
        except Exception:
            continue

def get_manual_override():
    if os.path.exists(STATE_FILE):
        try:
            with open(STATE_FILE, 'r') as f:
                c = f.read().strip().lower()
                if c in ['1', 'on', 'game', 'gaming']:
                    return 'gaming'
                if c in ['0', 'off', 'balanced']:
                    return 'balanced'
                if c in ['quiet', 'silent']:
                    return 'quiet'
        except Exception:
            pass
    return None

def set_manual_override(mode):
    try:
        with open(STATE_FILE, 'w') as f:
            if mode == 'gaming':
                f.write('1\n')
            elif mode == 'balanced':
                f.write('0\n')
            elif mode == 'quiet':
                f.write('quiet\n')
            else:
                f.write('auto\n')
    except Exception:
        pass

def any_game_running():
    for pid_dir in glob.glob('/proc/[0-9]*'):
        try:
            pid = int(os.path.basename(pid_dir))
            comm_path = os.path.join(pid_dir, 'comm')
            cmd_path = os.path.join(pid_dir, 'cmdline')
            if not os.path.exists(comm_path):
                continue
            with open(comm_path, 'r', errors='ignore') as f:
                comm = f.read().strip()
            with open(cmd_path, 'r', errors='ignore') as f:
                cmdline = f.read().replace('\x00', ' ').strip()
            if is_game_process(comm, cmdline, pid):
                return True
        except Exception:
            continue
    return False

def apply_game_boost_mode(throttled=False):
    """
    Mode: Active 3D gaming.
    User Rule: Full maximum performance in games.
    If sustained temp > 95°C, smoothly balance EPP to maintain safe operation without crippled FPS.
    """
    if throttled:
        set_cpu_freq('powersave', 'balance_performance', TARGET_MIN_FREQ, HARDWARE_MAX_FREQ, turbo=True)
        set_gpu_performance(True, throttled=True)
    else:
        set_cpu_freq('powersave', 'performance', TARGET_MIN_FREQ, HARDWARE_MAX_FREQ, turbo=True)
        set_gpu_performance(True, throttled=False)

    apply_sysctl({
        'vm.max_map_count': '2147483642',
        'vm.swappiness': '10',
        'vm.vfs_cache_pressure': '50',
        'vm.compaction_proactiveness': '0',
        'net.ipv4.tcp_slow_start_after_idle': '0',
        'net.ipv4.tcp_notsent_lowat': '16384'
    })
    set_wifi_powersave(False)
    optimize_processes()

def apply_app_loading_burst(throttled=False):
    """
    Mode: Application Loading / Responsiveness Boost.
    Allows CPU to boost freely up to 4.60 GHz for short tasks and app responsiveness.
    """
    set_cpu_freq('powersave', 'balance_performance', TARGET_MIN_FREQ, HARDWARE_MAX_FREQ, turbo=True)
    set_gpu_performance(False)
    set_wifi_powersave(False)

def apply_desktop_cool_mode():
    """
    Mode: Balanced (Default Desktop).
    Allows full dynamic scaling (0.8 - 4.60 GHz with Turbo enabled) and quiet idle.
    """
    epp = 'power' if is_on_battery() else 'balance_performance'
    set_cpu_freq('powersave', epp, TARGET_MIN_FREQ, HARDWARE_MAX_FREQ, turbo=True)
    apply_sysctl({
        'vm.swappiness': '60',
        'vm.vfs_cache_pressure': '100',
        'vm.compaction_proactiveness': '20',
        'net.ipv4.tcp_slow_start_after_idle': '1'
    })
    set_gpu_performance(False)
    set_wifi_powersave(True)

def apply_quiet_mode():
    """
    Mode: Quiet / Power Saver.
    Limits noise and thermal dissipation.
    """
    set_cpu_freq('powersave', 'power', TARGET_MIN_FREQ, 3400000, turbo=True)
    apply_sysctl({
        'vm.swappiness': '60',
        'vm.vfs_cache_pressure': '100',
        'vm.compaction_proactiveness': '20',
        'net.ipv4.tcp_slow_start_after_idle': '1'
    })
    set_gpu_performance(False)
    set_platform_profile('quiet')
    set_wifi_powersave(True)

def daemon_loop():
    print(f'mac-gamemode: daemon started (Dynamic Boost: Turbo up to {HARDWARE_MAX_FREQ//1000000} GHz, Game Limit <= {GAME_HARD_LIMIT}°C)', flush=True)
    current_mode = None
    last_optimize_time = 0
    game_overtemp_count = 0
    is_game_throttling = False

    while True:
        try:
            now = time.time()
            cpu_t, gpu_t = get_current_temperatures()
            peak_temp = max(cpu_t, gpu_t)

            manual_ovr = get_manual_override()
            game_active = any_game_running()

            if manual_ovr == 'gaming' or (manual_ovr is None and game_active):
                # --- GAME MODE ---
                if peak_temp >= GAME_HARD_LIMIT:
                    game_overtemp_count += 1
                    if game_overtemp_count >= 3 and not is_game_throttling:
                        is_game_throttling = True
                        print(f'mac-gamemode: [THERMAL GUARD] Sustained Temp={peak_temp:.1f}°C >= {GAME_HARD_LIMIT}°C -> Balancing EPP.', flush=True)
                        current_mode = None
                else:
                    game_overtemp_count = 0
                    if is_game_throttling and peak_temp < GAME_RECOVERY_TEMP:
                        is_game_throttling = False
                        print(f'mac-gamemode: [THERMAL RECOVERED] Temp={peak_temp:.1f}°C < {GAME_RECOVERY_TEMP}°C -> Restoring maximum game EPP.', flush=True)
                        current_mode = None

                target_mode = 'GAME_THROTTLED' if is_game_throttling else 'GAME_MAX'

                if target_mode != current_mode:
                    apply_game_boost_mode(throttled=is_game_throttling)
                    current_mode = target_mode
                    last_optimize_time = now
                elif now - last_optimize_time >= 5.0:
                    optimize_processes()
                    last_optimize_time = now

            elif manual_ovr == 'quiet':
                # --- QUIET MODE ---
                if current_mode != 'QUIET':
                    apply_quiet_mode()
                    current_mode = 'QUIET'
                    print(f'mac-gamemode: Mode -> QUIET (Silent fan profile, Temp={peak_temp:.1f}°C)', flush=True)

            else:
                # --- BALANCED (DESKTOP) MODE ---
                cpu_util = get_cpu_utilization()
                system_stalling = get_system_stall_pressure()

                needs_boost = (cpu_util > 35.0 or system_stalling)
                target_mode = 'APP_BOOST' if needs_boost else 'DESKTOP_NORMAL'

                if target_mode != current_mode:
                    if target_mode == 'APP_BOOST':
                        apply_app_loading_burst(throttled=False)
                        print(f'mac-gamemode: Mode -> APP_BOOST (Util={cpu_util:.1f}%, Stalling={system_stalling}, Temp={peak_temp:.1f}°C)', flush=True)
                    else:
                        apply_desktop_cool_mode()
                        print(f'mac-gamemode: Mode -> DESKTOP_NORMAL (Dynamic 0.8-4.60 GHz, Temp={peak_temp:.1f}°C)', flush=True)
                    current_mode = target_mode

        except Exception:
            pass
        time.sleep(1.0)

if __name__ == '__main__':
    cmd = sys.argv[1].lower() if len(sys.argv) > 1 else 'status'
    if cmd in ['on', 'game', 'gaming']:
        set_manual_override('gaming')
        apply_game_boost_mode()
        print('mac-gamemode: Gaming Mode ENABLED (Turbo 4.6 GHz, P-cores, RTX 3050 Boost)')
    elif cmd in ['off', 'balanced']:
        set_manual_override('balanced')
        apply_desktop_cool_mode()
        print('mac-gamemode: Balanced Mode ENABLED (Dynamic 0.8-4.6 GHz, Cool Desktop)')
    elif cmd in ['quiet', 'silent']:
        set_manual_override('quiet')
        apply_quiet_mode()
        print('mac-gamemode: Quiet Mode ENABLED (Low noise, Silent ACPI profile)')
    elif cmd in ['auto', 'default']:
        set_manual_override(None)
        print('mac-gamemode: Switched to AUTO mode (Balanced by default, Gaming during games)')
    elif cmd == 'status':
        ovr = get_manual_override()
        game_active = any_game_running()
        cpu_t, gpu_t = get_current_temperatures()
        no_t = 'Unknown'
        if os.path.exists('/sys/devices/system/cpu/intel_pstate/no_turbo'):
            with open('/sys/devices/system/cpu/intel_pstate/no_turbo') as f:
                no_t = 'Disabled' if f.read().strip() == '1' else 'Enabled (Full Boost)'
        cur_max = 'Unknown'
        if os.path.exists('/sys/devices/system/cpu/cpu0/cpufreq/scaling_max_freq'):
            with open('/sys/devices/system/cpu/cpu0/cpufreq/scaling_max_freq') as f:
                cur_max = f"{int(f.read().strip())/1000000:.2f} GHz"
        acpi_prof = 'Unknown'
        if os.path.exists('/sys/firmware/acpi/platform_profile'):
            with open('/sys/firmware/acpi/platform_profile') as f:
                acpi_prof = f.read().strip()
        epp_prof = 'Unknown'
        if os.path.exists('/sys/devices/system/cpu/cpu0/cpufreq/energy_performance_preference'):
            with open('/sys/devices/system/cpu/cpu0/cpufreq/energy_performance_preference') as f:
                epp_prof = f.read().strip()

        ovr_str = 'Auto (Automatic Game Detection)'
        if ovr == 'gaming': ovr_str = 'Forced Gaming'
        elif ovr == 'balanced': ovr_str = 'Forced Balanced'
        elif ovr == 'quiet': ovr_str = 'Forced Quiet'

        effective = 'Gaming' if (ovr == 'gaming' or (ovr is None and game_active)) else ('Quiet' if ovr == 'quiet' else 'Balanced')
        print(f"Profile Mode    : {ovr_str}")
        print(f"Effective State : {effective}")
        print(f"Game Active     : {'YES' if game_active else 'NO'}")
        print(f"ACPI Platform   : {acpi_prof}")
        print(f"CPU EPP Policy  : {epp_prof}")
        print(f"Turbo Boost     : {no_t}")
        print(f"Max Frequency   : {cur_max}")
        print(f"CPU Temp        : {cpu_t:.1f} °C (Game Limit: {GAME_HARD_LIMIT}°C)")
        print(f"GPU Temp        : {gpu_t:.1f} °C")
        sys.exit(0 if (ovr == 'gaming' or game_active) else 1)
    elif cmd == 'daemon':
        daemon_loop()
    elif cmd == 'optimize':
        optimize_processes()
    else:
        print('Usage: mac-gamemode [gaming|balanced|quiet|auto|status|daemon|optimize]')
