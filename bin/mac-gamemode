#!/usr/bin/env python3
import sys, os, time, glob, subprocess, re

STATE_FILE = '/etc/mac-gamemode.state'
P_CORES = {0, 1, 2, 3, 4, 5, 6, 7}
E_CORES = {8, 9, 10, 11}
ALL_CORES = set(range(12))

GAME_EXCLUDES = {
    'systemd', 'oom_reaper', 'khungtaskd', 'switcheroo-control',
    'switcheroo-cont', 'xdg-desktop-portal', 'xdg-document-portal',
    'ibus-portal', 'python3', 'bash', 'sh', 'zsh', 'gnome-shell',
    'mutter', 'xwayland', 'pipewire', 'wireplumber', 'pulseaudio'
}

GAME_REGEXES = [
    re.compile(r'steam_app_\d+'),
    re.compile(r'steamapps/common'),
    re.compile(r'pressure-vessel'),
    re.compile(r'\.exe($|\s)'),
    re.compile(r'\bcstrike'),
    re.compile(r'\bcs2\b'),
    re.compile(r'\bcsgo\b'),
    re.compile(r'\bdota2\b'),
    re.compile(r'\bhl2'),
    re.compile(r'watch_dogs'),
    re.compile(r'watchdogs'),
    re.compile(r'disrupt'),
    re.compile(r'cyberpunk'),
    re.compile(r'witcher'),
    re.compile(r'\bgta'),
    re.compile(r'gamescope'),
    re.compile(r'\bwine\b'),
    re.compile(r'\bwineserver\b'),
    re.compile(r'\bproton\b'),
    re.compile(r'\blutris'),
    re.compile(r'\bheroic'),
    re.compile(r'rpcs3'),
    re.compile(r'yuzu'),
    re.compile(r'ryujinx'),
    re.compile(r'cemu'),
    re.compile(r'pcsx2'),
    re.compile(r'retroarch'),
    re.compile(r'prismlauncher'),
    re.compile(r'vkcube'),
    re.compile(r'superposition'),
    re.compile(r'unigine')
]

BG_KEYWORDS = [
    'tracker-miner', 'tracker-extract', 'updatedb', 'mandb'
]

def is_game_process(comm, cmdline, pid=None):
    comm_l = comm.lower()
    cmdline_l = cmdline.lower()
    if comm_l in GAME_EXCLUDES:
        return False
    if any(comm_l.startswith(p) for p in ['xdg-', 'systemd-', 'ibus-']):
        return False
    full = comm_l + ' ' + cmdline_l
    for r in GAME_REGEXES:
        if r.search(full):
            return True
            
    # Check process environment for NVIDIA PRIME Offload / Proton / Steam if PID provided
    if pid is not None:
        try:
            with open(f'/proc/{pid}/environ', 'rb') as f:
                env_raw = f.read(4096).decode('utf-8', 'ignore')
                if ('STEAM_COMPAT_DATA_PATH' in env_raw or 
                    'DXVK_CONFIG_FILE' in env_raw or
                    'PRESSURE_VESSEL_APP_ID' in env_raw):
                    return True
        except Exception:
            pass
    return False

def is_bg_process(comm, cmdline):
    full = (comm + ' ' + cmdline).lower()
    for kw in BG_KEYWORDS:
        if kw in full:
            return True
    return False

def get_power_profile():
    try:
        res = subprocess.run(['powerprofilesctl', 'get'], capture_output=True, text=True, check=False)
        return res.stdout.strip()
    except Exception:
        return 'balanced'

def is_on_battery():
    for p in ['/sys/class/power_supply/ACAD/online', '/sys/class/power_supply/AC/online']:
        if os.path.exists(p):
            try:
                with open(p, 'r') as f:
                    return f.read().strip() == '0'
            except Exception:
                pass
    return False

def set_platform_profile(profile):
    """
    Sets the ACPI platform profile (e.g. balanced-performance or balanced).
    Strictly preserves fan speed and never modifies fan controls.
    """
    targets = [
        '/sys/firmware/acpi/platform_profile',
        '/sys/devices/platform/acer-wmi/platform-profile/platform-profile-0/profile'
    ]
    for p in targets:
        if os.path.exists(p):
            try:
                with open(p, 'w') as f:
                    f.write(f'{profile}\n')
            except Exception:
                pass

def set_intel_igpu_min_freq(freq_mhz):
    """
    Sets Intel iGPU minimum frequency to prevent Wayland display buffer starvation
    and presentation queue bottlenecks when transferring frames from the discrete GPU.
    """
    targets = [
        '/sys/class/drm/card1/gt_min_freq_mhz',
        '/sys/class/drm/card0/gt_min_freq_mhz'
    ]
    for p in targets:
        if os.path.exists(p):
            try:
                with open(p, 'w') as f:
                    f.write(f'{freq_mhz}\n')
            except Exception:
                pass

def apply_sysctl(params):
    for k, v in params.items():
        try:
            subprocess.run(['sysctl', '-w', f'{k}={v}'], capture_output=True, check=False)
        except Exception:
            pass

def set_cpu_freq(governor, epp, min_freq):
    for cpu in glob.glob('/sys/devices/system/cpu/cpu[0-9]*'):
        gov_path = os.path.join(cpu, 'cpufreq', 'scaling_governor')
        epp_path = os.path.join(cpu, 'cpufreq', 'energy_performance_preference')
        min_path = os.path.join(cpu, 'cpufreq', 'scaling_min_freq')
        max_path = os.path.join(cpu, 'cpufreq', 'scaling_max_freq')
        max_info = os.path.join(cpu, 'cpufreq', 'cpuinfo_max_freq')
        if os.path.exists(max_info) and os.path.exists(max_path):
            try:
                with open(max_info, 'r') as f:
                    max_v = f.read().strip()
                with open(max_path, 'w') as f:
                    f.write(f'{max_v}\n')
            except Exception:
                pass
        if os.path.exists(gov_path):
            try:
                with open(gov_path, 'w') as f:
                    f.write(f'{governor}\n')
            except Exception:
                pass
        if os.path.exists(epp_path):
            try:
                with open(epp_path, 'w') as f:
                    f.write(f'{epp}\n')
            except Exception:
                pass
        if os.path.exists(min_path):
            try:
                with open(min_path, 'w') as f:
                    f.write(f'{min_freq}\n')
            except Exception:
                pass

def set_wifi_powersave(enable):
    try:
        val = 'on' if enable else 'off'
        out = subprocess.check_output(['iw', 'dev'], text=True)
        for line in out.splitlines():
            line = line.strip()
            if line.startswith('Interface '):
                iface = line.split()[1]
                subprocess.run(['iw', 'dev', iface, 'set', 'power_save', val], capture_output=True)
    except Exception:
        pass

def set_gpu_performance(enable):
    try:
        if enable:
            # 1. Enable NVIDIA persistence mode
            subprocess.run(['nvidia-smi', '-pm', '1'], capture_output=True)
            # 2. Lock NVIDIA memory clocks to maximum (5411 MHz)
            subprocess.run(['nvidia-smi', '-lmc', '5411,5411'], capture_output=True)
            # 3. Lock NVIDIA graphics clocks to boost range (1650 - 2100 MHz)
            subprocess.run(['nvidia-smi', '-lgc', '1650,2100'], capture_output=True)
            # 4. Set Intel iGPU minimum frequency to 800 MHz (eliminates presentation lag)
            set_intel_igpu_min_freq(800)
            # 5. Set Acer platform profile to balanced-performance (unthrottled EC power limits)
            set_platform_profile('balanced-performance')
        else:
            # 1. Reset graphics clocks to dynamic range
            subprocess.run(['nvidia-smi', '-rgc'], capture_output=True)
            # 2. Reset memory clocks to dynamic range
            subprocess.run(['nvidia-smi', '-rmc'], capture_output=True)
            # 3. Reset Intel iGPU minimum frequency to 100 MHz
            set_intel_igpu_min_freq(100)
            # 4. Reset Acer platform profile to balanced
            set_platform_profile('balanced')
    except Exception:
        pass

def optimize_processes():
    for pid_dir in glob.glob('/proc/[0-9]*'):
        try:
            pid = int(os.path.basename(pid_dir))
            comm_path = os.path.join(pid_dir, 'comm')
            cmd_path = os.path.join(pid_dir, 'cmdline')
            if not os.path.exists(comm_path):
                continue
            with open(comm_path, 'r', errors='ignore') as f:
                comm = f.read().strip()
            with open(cmd_path, 'r', errors='ignore') as f:
                cmdline = f.read().replace('\x00', ' ').strip()
            
            if is_game_process(comm, cmdline, pid):
                # Set MMCSS priority (-20) on process
                try:
                    os.setpriority(os.PRIO_PROCESS, pid, -20)
                except Exception:
                    pass
                # Set Realtime / High I/O priority
                try:
                    subprocess.run(['ionice', '-c', '2', '-n', '0', '-p', str(pid)], capture_output=True)
                except Exception:
                    pass
                # Pin main process and ALL child threads to P-cores
                try:
                    os.sched_setaffinity(pid, P_CORES)
                except Exception:
                    pass
                task_dir = os.path.join(pid_dir, 'task')
                if os.path.exists(task_dir):
                    for tid_str in os.listdir(task_dir):
                        try:
                            tid = int(tid_str)
                            os.sched_setaffinity(tid, P_CORES)
                        except Exception:
                            pass
            elif is_bg_process(comm, cmdline):
                # Move background tasks to E-cores with low priority
                try:
                    os.sched_setaffinity(pid, E_CORES)
                except Exception:
                    pass
                try:
                    os.setpriority(os.PRIO_PROCESS, pid, 19)
                except Exception:
                    pass
        except Exception:
            continue

def get_state():
    if os.path.exists(STATE_FILE):
        try:
            with open(STATE_FILE, 'r') as f:
                return f.read().strip() == '1'
        except Exception:
            pass
    return False

def set_state(val):
    with open(STATE_FILE, 'w') as f:
        f.write('1\n' if val else '0\n')

def any_game_running():
    for pid_dir in glob.glob('/proc/[0-9]*'):
        try:
            pid = int(os.path.basename(pid_dir))
            comm_path = os.path.join(pid_dir, 'comm')
            cmd_path = os.path.join(pid_dir, 'cmdline')
            if not os.path.exists(comm_path):
                continue
            with open(comm_path, 'r', errors='ignore') as f:
                comm = f.read().strip()
            with open(cmd_path, 'r', errors='ignore') as f:
                cmdline = f.read().replace('\x00', ' ').strip()
            if is_game_process(comm, cmdline, pid):
                return True
        except Exception:
            continue
    return False

def turn_on():
    set_state(True)
    set_cpu_freq('performance', 'performance', 2400000)
    apply_sysctl({
        'vm.max_map_count': '2147483642',
        'vm.swappiness': '10',
        'vm.vfs_cache_pressure': '50',
        'vm.compaction_proactiveness': '0',
        'net.ipv4.tcp_slow_start_after_idle': '0',
        'net.ipv4.tcp_notsent_lowat': '16384'
    })
    set_gpu_performance(True)
    set_wifi_powersave(False)
    optimize_processes()
    print('mac-gamemode: ON (P-cores pinned, nice -20, sysctl, Intel iGPU & discrete GPU max boost applied)')

def turn_off():
    set_state(False)
    set_cpu_freq('powersave', 'balance_performance', 800000)
    apply_sysctl({
        'vm.swappiness': '60',
        'vm.vfs_cache_pressure': '100',
        'vm.compaction_proactiveness': '20',
        'net.ipv4.tcp_slow_start_after_idle': '1'
    })
    set_gpu_performance(False)
    set_wifi_powersave(True)
    print('mac-gamemode: OFF (Restored balanced desktop power profile)')

def daemon_loop():
    print('mac-gamemode: daemon started (unified power & GPU management)')
    current_active = None
    last_optimize_time = 0

    while True:
        try:
            manual_on = get_state()
            perf_profile = (get_power_profile() == 'performance')
            game_active = any_game_running()

            should_be_on = manual_on or perf_profile or game_active

            if should_be_on != current_active:
                if should_be_on:
                    turn_on()
                else:
                    turn_off()
                current_active = should_be_on
                last_optimize_time = time.time()
            elif should_be_on:
                now = time.time()
                if now - last_optimize_time >= 3.0:
                    optimize_processes()
                    last_optimize_time = now
        except Exception:
            pass
        time.sleep(2)

if __name__ == '__main__':
    cmd = sys.argv[1] if len(sys.argv) > 1 else 'status'
    if cmd == 'on':
        turn_on()
    elif cmd == 'off':
        turn_off()
    elif cmd == 'auto':
        manual_on = get_state()
        perf_profile = (get_power_profile() == 'performance')
        game_active = any_game_running()
        if manual_on or perf_profile or game_active:
            turn_on()
        else:
            turn_off()
    elif cmd == 'status':
        is_on = get_state()
        perf_profile = (get_power_profile() == 'performance')
        game_active = any_game_running()
        print(f"Manual State    : {'ON' if is_on else 'OFF'}")
        print(f"Power Profile   : {get_power_profile()}")
        print(f"Game Active     : {'YES' if game_active else 'NO'}")
        print(f"Effective State : {'PERFORMANCE (MAX)' if (is_on or perf_profile or game_active) else 'BALANCED'}")
        sys.exit(0 if (is_on or perf_profile or game_active) else 1)
    elif cmd == 'daemon':
        daemon_loop()
    elif cmd == 'optimize':
        optimize_processes()
    else:
        print('Usage: mac-gamemode [on|off|auto|status|daemon|optimize]')
