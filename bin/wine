#!/bin/bash
# Discrete GPU wrapper for Wine
REAL_BIN=$(PATH=$(echo "$PATH" | sed -e 's|/usr/local/bin||g' -e 's|::|:|g') which wine 2>/dev/null)
if [ -n "$REAL_BIN" ] && [ -x "$REAL_BIN" ]; then
    exec /usr/local/bin/prime-run "$REAL_BIN" "$@"
else
    echo "Wine is not installed." >&2
    exit 1
fi
