#!/usr/bin/env python3
"""
mac-diagnostics - Comprehensive Health & Integrity Diagnostic Tool for macW1Y
Audits:
- Themes, icons, fonts, cursors vs SSOT manifest
- GNOME extensions status & versions vs extensions.lock.json
- Menubar & Dock state
- Liquid Glass & Mutter Blur actors
- Background daemons & locks
- One-click safe repair (--fix)
"""

import os
import sys
import json
import time
import subprocess

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
try:
    import mac_i18n
    IS_UK = (mac_i18n.get_locale() == 'uk')
except Exception:
    IS_UK = True

REPO_DIR = "/home/vitaliy/MACTHEMEFILES"
MANIFEST_PATH = os.path.join(REPO_DIR, "config/macw1y-manifest.json")
LOCK_PATH = os.path.join(REPO_DIR, "config/extensions.lock.json")
HOME = os.path.expanduser("~")

C_RESET = "\033[0m"
C_BOLD = "\033[1m"
C_GREEN = "\033[1;32m"
C_RED = "\033[1;31m"
C_YELLOW = "\033[1;33m"
C_CYAN = "\033[1;36m"

def get_gsettings(schema, key):
    try:
        res = subprocess.check_output(["gsettings", "get", schema, key], text=True, stderr=subprocess.DEVNULL).strip()
        return res.strip("'\"")
    except Exception:
        return "N/A"

def eval_js(js_code):
    try:
        res = subprocess.check_output(
            ["gdbus", "call", "--session", "--dest", "org.gnome.Shell",
             "--object-path", "/org/gnome/Shell/Extensions/EvalHelper",
             "--method", "org.gnome.Shell.Extensions.EvalHelper.Eval", js_code],
            text=True, stderr=subprocess.DEVNULL
        )
        return res.strip()
    except Exception:
        return None

def run_diagnostics(auto_fix=False):
    title = "=== macW1Y СИСТЕМНА ДІАГНОСТИКА ТА ПЕРЕВІРКА ЦІЛІСНОСТІ ===" if IS_UK else "=== macW1Y SYSTEM DIAGNOSTICS & INTEGRITY AUDIT ==="
    time_lbl = "Час" if IS_UK else "Timestamp"
    print(f"\n{C_CYAN}{C_BOLD}{title}{C_RESET}")
    print(f"{time_lbl}: {time.strftime('%Y-%m-%d %H:%M:%S')}\n")

    issues = []
    
    # 1. SSOT Manifest check
    sec1 = "1. Перевірка теми та зовнішнього вигляду (SSOT):" if IS_UK else "1. Themes & Appearance SSOT Audit:"
    print(f"{C_BOLD}{sec1}{C_RESET}")
    if not os.path.exists(MANIFEST_PATH):
        issues.append("SSOT manifest config/macw1y-manifest.json не знайдено!")
        print(f"  {C_RED}✖ Маніфест macw1y-manifest.json відсутній!{C_RESET}")
    else:
        with open(MANIFEST_PATH, "r") as f:
            manifest = json.load(f)
        th = manifest.get("theme", {})
        
        checks = [
            ("GTK Theme", "org.gnome.desktop.interface", "gtk-theme", th["gtk_theme"]),
            ("Icon Theme", "org.gnome.desktop.interface", "icon-theme", th["icon_theme"]),
            ("Cursor Theme", "org.gnome.desktop.interface", "cursor-theme", th["cursor_theme"]),
            ("Font Name", "org.gnome.desktop.interface", "font-name", th["font_name"]),
            ("Shell Theme", "org.gnome.shell.extensions.user-theme", "name", th["shell_theme"]),
            ("Sound Theme", "org.gnome.desktop.sound", "theme-name", th["sound_theme"]),
        ]
        
        for label, schema, key, expected in checks:
            cur = get_gsettings(schema, key)
            if cur == expected:
                print(f"  {C_GREEN}✔{C_RESET} {label:<16}: {cur} (OK)")
            else:
                print(f"  {C_RED}✖{C_RESET} {label:<16}: {cur} (Очікувалося: {expected})")
                issues.append(f"{label}: фактично '{cur}', очікувалося '{expected}'")

    # 2. GNOME Extensions Status & Version Lock
    sec2 = "2. Перевірка GNOME Extensions та Version Lock:" if IS_UK else "2. GNOME Extensions Status & Version Lock:"
    print(f"\n{C_BOLD}{sec2}{C_RESET}")
    if os.path.exists(LOCK_PATH):
        with open(LOCK_PATH, "r") as f:
            lock = json.load(f).get("extensions", {})
            
        try:
            enabled_exts = set(subprocess.check_output(["gnome-extensions", "list", "--enabled"], text=True).splitlines())
        except Exception:
            enabled_exts = set()
            
        missing_count = 0
        for uuid, info in lock.items():
            if uuid not in enabled_exts:
                dis_msg = f"Розширення {uuid} ВИМКНЕНО!" if IS_UK else f"Extension {uuid} is DISABLED!"
                print(f"  {C_RED}✖{C_RESET} {dis_msg}")
                issues.append(f"Розширення {uuid} не увімкнено" if IS_UK else f"Extension {uuid} is not enabled")
                missing_count += 1
                
        if missing_count == 0:
            ok_cnt = f"Всі {len(lock)} зафіксованих розширень macW1Y активні." if IS_UK else f"All {len(lock)} pinned macW1Y extensions are active."
            print(f"  {C_GREEN}✔{C_RESET} {ok_cnt}")
            
        # Verify hashes
        res_v = subprocess.run(["/usr/local/bin/mac-extension-guard", "verify"], stdout=subprocess.PIPE, text=True)
        if res_v.returncode == 0:
            guard_ok = "Цілісність SHA256 усіх розширень відповідає lock-файлу." if IS_UK else "SHA256 integrity of all extensions matches lock file."
            print(f"  {C_GREEN}✔{C_RESET} {guard_ok}")
        else:
            mod_warn = "Виявлено зміни в локальних файлах розширень:" if IS_UK else "Changes detected in local extension files:"
            print(f"  {C_YELLOW}⚠{C_RESET} {mod_warn}")
            for l in res_v.stdout.splitlines():
                if "mismatch" in l or "missing" in l:
                    print(f"    {l}")
                    issues.append(l)
    else:
        no_lock = "Lock-файл config/extensions.lock.json відсутній!" if IS_UK else "Lock file config/extensions.lock.json missing!"
        issues.append(no_lock)
        print(f"  {C_RED}✖ {no_lock}{C_RESET}")

    # 3. Menubar & Dock Health
    sec3 = "3. Перевірка компонентів Menubar та Dock:" if IS_UK else "3. Menubar & Dock Health:"
    print(f"\n{C_BOLD}{sec3}{C_RESET}")
    # Check AppMenu
    appmenu_active = "appmenu@ChathurangaBW.github.io" in enabled_exts
    if appmenu_active:
        print(f"  {C_GREEN}✔{C_RESET} " + ("AppMenu (Global Menubar) активний." if IS_UK else "AppMenu (Global Menubar) active."))
    else:
        print(f"  {C_RED}✖{C_RESET} " + ("AppMenu НЕ активний!" if IS_UK else "AppMenu is NOT active!"))
        issues.append("AppMenu вимкнено" if IS_UK else "AppMenu disabled")
        
    # Check Cupertino / Dash2dock
    dock_active = ("dash2dock-motion@unmade.space" in enabled_exts) and ("cupertino-dock-lite@rinzler69-wastaken.github.com" in enabled_exts)
    if dock_active:
        print(f"  {C_GREEN}✔{C_RESET} " + ("macOS Cupertino Glass Dock активний." if IS_UK else "macOS Cupertino Glass Dock active."))
    else:
        print(f"  {C_RED}✖{C_RESET} " + ("Компоненти Dock (dash2dock-motion або cupertino-dock-lite) вимкнено!" if IS_UK else "Dock components are disabled!"))
        issues.append("Компоненти Dock вимкнено" if IS_UK else "Dock components disabled")

    # 4. Liquid Glass & Mutter Blur
    sec4 = "4. Перевірка Liquid Glass та Clutter Blur:" if IS_UK else "4. Liquid Glass & Clutter Blur Audit:"
    print(f"\n{C_BOLD}{sec4}{C_RESET}")
    lg_active = "liquid-glass@thinkingcoding1231.gmail.com" in enabled_exts
    bms_active = "blur-my-shell@aunetx" in enabled_exts
    
    if lg_active:
        print(f"  {C_GREEN}✔{C_RESET} " + ("Liquid Glass shader активний." if IS_UK else "Liquid Glass shader active."))
    else:
        print(f"  {C_RED}✖{C_RESET} " + ("Liquid Glass extension вимкнено!" if IS_UK else "Liquid Glass extension disabled!"))
        issues.append("Liquid Glass вимкнено" if IS_UK else "Liquid Glass disabled")
        
    if bms_active:
        print(f"  {C_GREEN}✔{C_RESET} " + ("Blur my Shell (Mutter blur actor) активний." if IS_UK else "Blur my Shell (Mutter blur actor) active."))
    else:
        print(f"  {C_RED}✖{C_RESET} " + ("Blur my Shell вимкнено!" if IS_UK else "Blur my Shell disabled!"))
        issues.append("Blur my Shell вимкнено" if IS_UK else "Blur my Shell disabled")

    # 5. Background Daemons & Mutex Locks
    sec5 = "5. Перевірка фонових процесів та блокувань:" if IS_UK else "5. Background Processes & Mutex Locks:"
    print(f"\n{C_BOLD}{sec5}{C_RESET}")
    try:
        pids = subprocess.check_output(["pgrep", "-f", "mac-sync-applications daemon"], text=True).splitlines()
        if len(pids) == 1:
            print(f"  {C_GREEN}✔{C_RESET} " + (f"Демон mac-sync-applications працює в єдиному екземплярі (PID {pids[0]})." if IS_UK else f"mac-sync-applications daemon running as single instance (PID {pids[0]})."))
        elif len(pids) > 1:
            print(f"  {C_RED}✖{C_RESET} " + (f"Виявлено подвійний запуск mac-sync-applications: PIDs {pids}" if IS_UK else f"Duplicate mac-sync-applications running: PIDs {pids}"))
            issues.append(f"Подвійний запуск mac-sync-applications (PIDs: {pids})" if IS_UK else f"Duplicate mac-sync-applications (PIDs: {pids})")
        else:
            print(f"  {C_YELLOW}⚠{C_RESET} " + ("Демон mac-sync-applications не знайдено серед процесів." if IS_UK else "mac-sync-applications daemon not found."))
    except Exception:
        print(f"  {C_YELLOW}⚠{C_RESET} " + ("Демон mac-sync-applications не запущений." if IS_UK else "mac-sync-applications daemon not running."))

    # SUMMARY
    print("\n" + "="*80)
    if not issues:
        ok_res = "РЕЗУЛЬТАТ: Система стабільна. Всі компоненти macW1Y відповідають еталону." if IS_UK else "RESULT: System healthy and stable. All macW1Y components match SSOT standard."
        print(f"{C_GREEN}{C_BOLD}{ok_res}{C_RESET}")
        return 0
    else:
        err_res = f"РЕЗУЛЬТАТ: Виявлено {len(issues)} невідповідностей:" if IS_UK else f"RESULT: Found {len(issues)} discrepancies:"
        print(f"{C_RED}{C_BOLD}{err_res}{C_RESET}")
        for iss in issues:
            print(f"  • {iss}")
            
        if auto_fix:
            print(f"\n{C_CYAN}" + ("Запуск автоматичного відновлення (--fix)..." if IS_UK else "Running automatic repair (--fix)...") + f"{C_RESET}")
            subprocess.run(["/usr/local/bin/mac-apply-theme"], check=False)
            subprocess.run(["systemctl", "--user", "restart", "mac-app-manager.service"], check=False)
            print(f"{C_GREEN}" + ("Автоматичне відновлення завершено. Перезапустіть перевірку." if IS_UK else "Automatic repair complete. Re-run diagnostics.") + f"{C_RESET}")
        else:
            fix_tip = "Для автоматичного виправлення запустіть: mac-diagnostics --fix" if IS_UK else "To automatically repair, run: mac-diagnostics --fix"
            print(f"\n{C_YELLOW}{fix_tip}{C_RESET}")
        return 1

if __name__ == "__main__":
    fix_mode = len(sys.argv) > 1 and sys.argv[1] == "--fix"
    code = run_diagnostics(auto_fix=fix_mode)
    sys.exit(code)
