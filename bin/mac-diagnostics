#!/usr/bin/env python3
"""
mac-diagnostics - Comprehensive Health & Integrity Diagnostic Tool for macW1Y
Audits:
- Themes, icons, fonts, cursors vs SSOT manifest
- GNOME extensions status & versions vs extensions.lock.json
- Menubar & Dock state
- Liquid Glass & Mutter Blur actors
- Background daemons & locks
- One-click safe repair (--fix)
"""

import os
import sys
import json
import time
import subprocess

sys.path.insert(0, '/usr/local/bin')
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
try:
    import mac_i18n
    def _dt(key, fb): return mac_i18n.t(key, fb)
    def _dtf(key, params, fb): return mac_i18n.tf(key, params, fb)
except Exception:
    def _dt(key, fb): return fb
    def _dtf(key, params, fb): return fb.format(**params) if params else fb

def _resolve_repo_dir():
    candidates = [
        os.environ.get("MACW1Y_REPO", ""),
        os.path.abspath(os.path.join(os.path.dirname(os.path.realpath(__file__)), "..")),
        os.path.expanduser("~/macW1Y"),
        os.path.expanduser("~/MACTHEMEFILES"),
        "/usr/share/mactheme",
    ]
    for c in candidates:
        if c and os.path.isfile(os.path.join(c, "config/macw1y-manifest.json")):
            return c
    return "/usr/share/mactheme" if os.path.isdir("/usr/share/mactheme") else os.path.expanduser("~/macW1Y")

REPO_DIR = _resolve_repo_dir()
MANIFEST_PATH = next((p for p in [
    os.path.join(REPO_DIR, "config/macw1y-manifest.json"),
    os.path.expanduser("~/.config/macw1y/macw1y-manifest.json"),
    "/usr/share/mactheme/config/macw1y-manifest.json",
] if os.path.isfile(p)), os.path.join(REPO_DIR, "config/macw1y-manifest.json"))
LOCK_PATH = next((p for p in [
    os.path.join(REPO_DIR, "config/extensions.lock.json"),
    os.path.expanduser("~/.config/macw1y/extensions.lock.json"),
    "/usr/share/mactheme/config/extensions.lock.json",
] if os.path.isfile(p)), os.path.join(REPO_DIR, "config/extensions.lock.json"))
HOME = os.path.expanduser("~")

C_RESET = "\033[0m"
C_BOLD = "\033[1m"
C_GREEN = "\033[1;32m"
C_RED = "\033[1;31m"
C_YELLOW = "\033[1;33m"
C_CYAN = "\033[1;36m"

def get_gsettings(schema, key):
    try:
        res = subprocess.check_output(["gsettings", "get", schema, key], text=True, stderr=subprocess.DEVNULL).strip()
        return res.strip("'\"")
    except Exception:
        return "N/A"

def eval_js(js_code):
    try:
        res = subprocess.check_output(
            ["gdbus", "call", "--session", "--dest", "org.gnome.Shell",
             "--object-path", "/org/gnome/Shell/Extensions/EvalHelper",
             "--method", "org.gnome.Shell.Extensions.EvalHelper.Eval", js_code],
            text=True, stderr=subprocess.DEVNULL
        )
        return res.strip()
    except Exception:
        return None

def run_diagnostics(auto_fix=False):
    title = _dt("diag_title", "=== macW1Y SYSTEM DIAGNOSTICS & INTEGRITY AUDIT ===")
    time_lbl = _dt("diag_timestamp", "Timestamp")
    print(f"\n{C_CYAN}{C_BOLD}{title}{C_RESET}")
    print(f"{time_lbl}: {time.strftime('%Y-%m-%d %H:%M:%S')}\n")

    issues = []
    
    # 1. SSOT Manifest check
    sec1 = _dt("diag_sec1", "1. Themes & Appearance SSOT Audit:")
    print(f"{C_BOLD}{sec1}{C_RESET}")
    if not os.path.exists(MANIFEST_PATH):
        msg_m = _dt("diag_manifest_missing", "Manifest config/macw1y-manifest.json not found!")
        issues.append(msg_m)
        print(f"  {C_RED}✖ {msg_m}{C_RESET}")
    else:
        with open(MANIFEST_PATH, "r") as f:
            manifest = json.load(f)
        th = manifest.get("theme", {})
        
        checks = [
            ("GTK Theme", "org.gnome.desktop.interface", "gtk-theme", th["gtk_theme"]),
            ("Icon Theme", "org.gnome.desktop.interface", "icon-theme", th["icon_theme"]),
            ("Cursor Theme", "org.gnome.desktop.interface", "cursor-theme", th["cursor_theme"]),
            ("Font Name", "org.gnome.desktop.interface", "font-name", th["font_name"]),
            ("Shell Theme", "org.gnome.shell.extensions.user-theme", "name", th["shell_theme"]),
            ("Sound Theme", "org.gnome.desktop.sound", "theme-name", th["sound_theme"]),
        ]
        
        for label, schema, key, expected in checks:
            cur = get_gsettings(schema, key)
            if cur == expected:
                print(f"  {C_GREEN}✔{C_RESET} {label:<16}: {cur} (OK)")
            else:
                exp_str = _dtf("diag_expected_fmt", {"expected": expected}, "Expected: {expected}")
                print(f"  {C_RED}✖{C_RESET} {label:<16}: {cur} ({exp_str})")
                issues.append(_dtf("integrity_ssot_mismatch", {"key": label, "cur": cur, "expected": expected}, "Mismatch {key}: active '{cur}', expected '{expected}'"))

    # 2. GNOME Extensions Status & Version Lock
    sec2 = _dt("diag_sec2", "2. GNOME Extensions Status & Version Lock:")
    print(f"\n{C_BOLD}{sec2}{C_RESET}")
    enabled_exts = set()
    if os.path.exists(LOCK_PATH):
        with open(LOCK_PATH, "r") as f:
            lock = json.load(f).get("extensions", {})
            
        try:
            enabled_exts = set(subprocess.check_output(["gnome-extensions", "list", "--enabled"], text=True, stderr=subprocess.DEVNULL).splitlines())
        except Exception:
            enabled_exts = set()
        if not enabled_exts:
            ev_exts = eval_js("[...Main.extensionManager._extensions.values()].filter(e => e.state === 1).map(e => e.uuid).join('\\n')")
            if ev_exts and ev_exts.startswith("('"):
                raw = ev_exts[2:].rsplit("',)", 1)[0].replace("\\n", "\n")
                enabled_exts = {x.strip() for x in raw.splitlines() if x.strip()}
            
        missing_count = 0
        for uuid, info in lock.items():
            if uuid not in enabled_exts:
                dis_msg = _dtf("diag_ext_disabled", {"uuid": uuid}, "Extension {uuid} is DISABLED!")
                print(f"  {C_RED}✖{C_RESET} {dis_msg}")
                issues.append(dis_msg)
                missing_count += 1
                
        if missing_count == 0:
            ok_cnt = _dtf("diag_all_ext_active", {"count": len(lock)}, "All {count} pinned macW1Y extensions are active.")
            print(f"  {C_GREEN}✔{C_RESET} {ok_cnt}")
            
        # Verify hashes
        res_v = subprocess.run(["/usr/local/bin/mac-extension-guard", "verify"], stdout=subprocess.PIPE, text=True)
        if res_v.returncode == 0:
            guard_ok = _dt("diag_guard_ok", "SHA256 integrity of all extensions matches lock file.")
            print(f"  {C_GREEN}✔{C_RESET} {guard_ok}")
        else:
            mod_warn = _dt("diag_guard_warn", "Changes detected in local extension files:")
            print(f"  {C_YELLOW}⚠{C_RESET} {mod_warn}")
            for l in res_v.stdout.splitlines():
                if "mismatch" in l or "missing" in l:
                    print(f"    {l}")
                    issues.append(l)
    else:
        no_lock = _dt("diag_lock_missing", "Lock file config/extensions.lock.json missing!")
        issues.append(no_lock)
        print(f"  {C_RED}✖ {no_lock}{C_RESET}")

    # 3. Menubar & Dock Health
    sec3 = _dt("diag_sec3", "3. Menubar & Dock Health:")
    print(f"\n{C_BOLD}{sec3}{C_RESET}")
    # Check AppMenu
    appmenu_active = "appmenu@ChathurangaBW.github.io" in enabled_exts
    if appmenu_active:
        print(f"  {C_GREEN}✔{C_RESET} " + _dt("diag_appmenu_ok", "AppMenu (Global Menubar) active."))
    else:
        m_off = _dt("diag_appmenu_off", "AppMenu is NOT active!")
        print(f"  {C_RED}✖{C_RESET} " + m_off)
        issues.append(m_off)
        
    # Check Cupertino / Dash2dock
    dock_active = ("dash2dock-motion@unmade.space" in enabled_exts) and ("cupertino-dock-lite@rinzler69-wastaken.github.com" in enabled_exts)
    if dock_active:
        print(f"  {C_GREEN}✔{C_RESET} " + _dt("diag_dock_ok", "macW1Y Cupertino Glass Dock active."))
    else:
        d_off = _dt("diag_dock_off", "Dock components (dash2dock-motion or cupertino-dock-lite) disabled!")
        print(f"  {C_RED}✖{C_RESET} " + d_off)
        issues.append(d_off)

    # 4. Liquid Glass & Mutter Blur
    sec4 = _dt("diag_sec4", "4. Liquid Glass & Clutter Blur Audit:")
    print(f"\n{C_BOLD}{sec4}{C_RESET}")
    lg_active = "liquid-glass@thinkingcoding1231.gmail.com" in enabled_exts
    bms_active = "blur-my-shell@aunetx" in enabled_exts
    
    if lg_active:
        print(f"  {C_GREEN}✔{C_RESET} " + _dt("diag_lg_ok", "Liquid Glass shader active."))
    else:
        l_off = _dt("diag_lg_off", "Liquid Glass extension disabled!")
        print(f"  {C_RED}✖{C_RESET} " + l_off)
        issues.append(l_off)
        
    if bms_active:
        print(f"  {C_GREEN}✔{C_RESET} " + _dt("diag_bms_ok", "Blur my Shell active."))
    else:
        b_off = _dt("diag_bms_off", "Blur my Shell disabled!")
        print(f"  {C_RED}✖{C_RESET} " + b_off)
        issues.append(b_off)

    # 5. Background Daemons & Mutex Locks
    sec5 = _dt("diag_sec5", "5. Background Processes & Mutex Locks:")
    print(f"\n{C_BOLD}{sec5}{C_RESET}")
    try:
        pids = subprocess.check_output(["pgrep", "-f", "mac-sync-applications daemon"], text=True).splitlines()
        if len(pids) == 1:
            print(f"  {C_GREEN}✔{C_RESET} " + _dtf("diag_sync_single", {"pid": pids[0]}, "mac-sync-applications daemon running (PID {pid})."))
        elif len(pids) > 1:
            dup_msg = _dtf("diag_sync_dup", {"pids": pids}, "Duplicate mac-sync-applications processes: PIDs {pids}")
            print(f"  {C_RED}✖{C_RESET} " + dup_msg)
            issues.append(dup_msg)
        else:
            print(f"  {C_YELLOW}⚠{C_RESET} " + _dt("diag_sync_not_running", "mac-sync-applications daemon not running."))
    except Exception:
        print(f"  {C_YELLOW}⚠{C_RESET} " + _dt("diag_sync_not_running", "mac-sync-applications daemon not running."))

    # SUMMARY
    print("\n" + "="*80)
    if not issues:
        ok_res = _dt("diag_ok_summary", "RESULT: System healthy and stable. All macW1Y components match SSOT standard.")
        print(f"{C_GREEN}{C_BOLD}{ok_res}{C_RESET}")
        return 0
    else:
        err_res = _dtf("diag_issues_found", {"count": len(issues)}, "RESULT: Found {count} discrepancies:")
        print(f"{C_RED}{C_BOLD}{err_res}{C_RESET}")
        for iss in issues:
            print(f"  • {iss}")
            
        if auto_fix:
            print(f"\n{C_CYAN}" + _dt("diag_fix_running", "Running automatic repair (--fix)...") + f"{C_RESET}")
            subprocess.run(["/usr/local/bin/mac-apply-theme"], check=False)
            subprocess.run(["systemctl", "--user", "restart", "mac-app-manager.service"], check=False)
            print(f"{C_GREEN}" + _dt("diag_fix_done", "Automatic repair complete. Re-run diagnostics.") + f"{C_RESET}")
        else:
            fix_tip = _dt("diag_fix_tip", "To automatically repair, run: mac-diagnostics --fix")
            print(f"\n{C_YELLOW}{fix_tip}{C_RESET}")
        return 1

if __name__ == "__main__":
    fix_mode = len(sys.argv) > 1 and sys.argv[1] == "--fix"
    code = run_diagnostics(auto_fix=fix_mode)
    sys.exit(code)
