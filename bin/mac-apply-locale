#!/usr/bin/env python3
"""
mac-apply-locale — System & Modpack Real-Time Locale Synchronization Engine for macW1Y
Applies language selection in real-time across AccountsService, systemd, PAM,
XDG environment, GNOME Shell, and keyboard layouts.
"""

import os
import sys
import json
import pwd
import subprocess
import shutil

