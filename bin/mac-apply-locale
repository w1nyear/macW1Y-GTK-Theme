def normalize_lang(arg):
    if not arg:
        return "en"
    clean = arg.strip().lower().replace("-", "_").split(".")[0]
    if clean in LOCALE_MAP:
        return clean
    base = clean.split("_")[0]
    if base in LOCALE_MAP:
        return base
    for k, v in LOCALE_MAP.items():
        if v["posix"].lower().startswith(clean):
            return k
    return "en"

def ensure_locale_generated(posix):
    try:
        r = subprocess.run(["locale", "-a"], capture_output=True, text=True, check=True)
        installed = [x.strip().lower().replace("-", "").replace("_", "") for x in r.stdout.splitlines()]
        needle = posix.lower().replace("-", "").replace("_", "").replace(".utf8", "").replace(".utf8", "")
        if not any(needle in x for x in installed):
            print(f"[mac-apply-locale] Generating missing system locale: {posix}...")
            subprocess.run(["sudo", "locale-gen", posix], check=False, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except Exception as e:
        print(f"[mac-apply-locale] Warning: error checking/generating locale: {e}", file=sys.stderr)

def apply_accounts_service(uid, posix):
    try:
        cmd1 = ["gdbus", "call", "--system", "--dest", "org.freedesktop.Accounts",
                "--object-path", f"/org/freedesktop/Accounts/User{uid}",
                "--method", "org.freedesktop.Accounts.User.SetLanguage", posix]
        subprocess.run(cmd1, capture_output=True, check=False)

        cmd2 = ["gdbus", "call", "--system", "--dest", "org.freedesktop.Accounts",
                "--object-path", f"/org/freedesktop/Accounts/User{uid}",
                "--method", "org.freedesktop.Accounts.User.SetFormatsLocale", posix]
        subprocess.run(cmd2, capture_output=True, check=False)

        cmd3 = ["gdbus", "call", "--system", "--dest", "org.freedesktop.Accounts",
                "--object-path", f"/org/freedesktop/Accounts/User{uid}",
                "--method", "org.freedesktop.Accounts.User.SetLanguages", f"['{posix}', 'en_US.UTF-8']"]
        subprocess.run(cmd3, capture_output=True, check=False)
    except Exception as e:
        print(f"[mac-apply-locale] Warning: AccountsService update failed: {e}", file=sys.stderr)

def apply_systemd_env(posix, lang_env):
    try:
        subprocess.run(["systemctl", "--user", "set-environment",
                        f"LANG={posix}", f"LANGUAGE={lang_env}", f"LC_MESSAGES={posix}"], check=False)
    except Exception:
        pass
    try:
        subprocess.run(["dbus-update-activation-environment", "--systemd",
                        f"LANG={posix}", f"LANGUAGE={lang_env}", f"LC_MESSAGES={posix}"], check=False)
    except Exception:
        pass

def apply_system_locale(posix, lang_env):
    try:
        subprocess.run(["localectl", "set-locale", f"LANG={posix}"], check=False, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except Exception:
        pass
    try:
        subprocess.run(["sudo", "update-locale", f"LANG={posix}", f"LANGUAGE={lang_env}"], check=False, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except Exception:
        pass

def write_user_configs(lang_code, posix, lang_env):
    home = os.path.expanduser("~")

    # 1. ~/.config/mac-styling/locale
    styling_file = os.path.join(home, ".config/mac-styling/locale")
    os.makedirs(os.path.dirname(styling_file), exist_ok=True)
    with open(styling_file, "w", encoding="utf-8") as f:
        f.write(f"{lang_code}\n")

    # 2. ~/.config/locale.conf
    locale_conf = os.path.join(home, ".config/locale.conf")
    with open(locale_conf, "w", encoding="utf-8") as f:
        f.write(f"LANG={posix}\nLANGUAGE={lang_env}\nLC_MESSAGES={posix}\n")

    # 3. ~/.pam_environment
    pam_env = os.path.join(home, ".pam_environment")
    with open(pam_env, "w", encoding="utf-8") as f:
        f.write(f"""LANGUAGE\tDEFAULT={lang_env}
LANG\tDEFAULT={posix}
LC_NUMERIC\tDEFAULT={posix}
LC_TIME\tDEFAULT={posix}
LC_MONETARY\tDEFAULT={posix}
LC_PAPER\tDEFAULT={posix}
LC_NAME\tDEFAULT={posix}
LC_ADDRESS\tDEFAULT={posix}
LC_TELEPHONE\tDEFAULT={posix}
LC_MEASUREMENT\tDEFAULT={posix}
LC_IDENTIFICATION\tDEFAULT={posix}
PAPERSIZE\tDEFAULT=a4
""")

    # 4. Ensure ~/.profile and ~/.bashrc source ~/.config/locale.conf
    profile = os.path.join(home, ".profile")
    bashrc = os.path.join(home, ".bashrc")
    snippet = """
# macW1Y locale configuration
if [ -f "$HOME/.config/locale.conf" ]; then
    . "$HOME/.config/locale.conf"
    export LANG LANGUAGE LC_MESSAGES
fi
"""
    for sh_file in [profile, bashrc]:
        if os.path.exists(sh_file):
            try:
                with open(sh_file, "r", encoding="utf-8") as f:
                    content = f.read()
                if "macW1Y locale configuration" not in content:
                    with open(sh_file, "a", encoding="utf-8") as f:
                        f.write(snippet)
            except Exception:
                pass

    # 5. Prevent xdg-user-dirs-gtk prompt on locale change (macW1Y style: preserve directory structure)
    try:
        user_dirs_conf = os.path.join(home, ".config/user-dirs.conf")
        with open(user_dirs_conf, "w", encoding="utf-8") as f:
            f.write("enabled=False\n")

        user_dirs_locale = os.path.join(home, ".config/user-dirs.locale")
        loc_base = posix.split(".")[0]
        with open(user_dirs_locale, "w", encoding="utf-8") as f:
            f.write(f"{loc_base}\n")

        autostart_dir = os.path.join(home, ".config/autostart")
        os.makedirs(autostart_dir, exist_ok=True)
        autostart_desktop = os.path.join(autostart_dir, "user-dirs-update-gtk.desktop")
        with open(autostart_desktop, "w", encoding="utf-8") as f:
            f.write("[Desktop Entry]\nType=Application\nName=User folders update\nExec=true\nHidden=true\nX-GNOME-Autostart-enabled=false\n")
    except Exception:
        pass

def apply_keyboard_layout(xkb_code):
    if not xkb_code:
        return
    try:
        r = subprocess.run(["gsettings", "get", "org.gnome.desktop.input-sources", "sources"], capture_output=True, text=True)
        if r.returncode == 0:
            out = r.stdout.strip()
            # If xkb is already in list, do not duplicate
            if f"'xkb', '{xkb_code}'" not in out:
                if xkb_code == "us":
                    new_val = "[('xkb', 'us')]"
                else:
                    new_val = f"[('xkb', 'us'), ('xkb', '{xkb_code}')]"
                subprocess.run(["gsettings", "set", "org.gnome.desktop.input-sources", "sources", new_val], check=False)
    except Exception as e:
        print(f"[mac-apply-locale] Warning: could not set input sources: {e}", file=sys.stderr)

def notify_gnome_shell(lang_code, posix, lang_env):
    js = f"""(() => {{
        const GLib = imports.gi.GLib;
        const Gettext = imports.gettext;
        GLib.setenv('LANG', '{posix}', true);
        GLib.setenv('LANGUAGE', '{lang_env}', true);
        GLib.setenv('LC_MESSAGES', '{posix}', true);
        try {{
            Gettext.setlocale(Gettext.LocaleCategory.ALL, '{posix}');
        }} catch (_) {{}}
        globalThis._macModpackLocale = '{lang_code}';

        // Update clock / date menu in top bar
        try {{
            if (Main.panel?.statusArea?.dateMenu?._clock) {{
                if (typeof Main.panel.statusArea.dateMenu._clock.notify === 'function') {{
                    Main.panel.statusArea.dateMenu._clock.notify('clock');
                }}
            }}
        }} catch (_) {{}}

        // Notify menubar if present
        try {{
            if (globalThis._macMenuBarController && typeof globalThis._macMenuBarController.updateLocale === 'function') {{
                globalThis._macMenuBarController.updateLocale('{lang_code}');
            }}
        }} catch (_) {{}}

        return true;
    }})()"""

    try:
        cmd = ["gdbus", "call", "--session", "--dest", "org.gnome.Shell",
               "--object-path", "/org/gnome/Shell/Extensions/EvalHelper",
               "--method", "org.gnome.Shell.Extensions.EvalHelper.Eval", js]
        subprocess.run(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=False)
    except Exception:
        pass

def show_notification(info):
    title = info.get("notif_title", "macW1Y: System Language")
    body = info.get("notif_body", "System language updated successfully!")
    icon = "/home/vitaliy/.themes/macW1Y-Dark/icons/preferences-desktop-locale-symbolic.svg"
    if not os.path.exists(icon):
        icon = "preferences-desktop-locale"
    try:
        subprocess.run(["notify-send", "-a", "macW1Y", "-i", icon, title, body], check=False)
    except Exception:
        pass

def main():
    if len(sys.argv) < 2 or sys.argv[1] in ["-h", "--help", "help"]:
        loc_file = os.path.expanduser("~/.config/mac-styling/locale")
        cur = "uk"
        if os.path.exists(loc_file):
            try:
                cur = open(loc_file).read().strip()
            except Exception:
                pass
        print(f"Current macW1Y locale: {cur}")
        print("Usage: mac-apply-locale <lang_code> [--quiet]")
        print("       mac-apply-locale --list")
        print("       mac-apply-locale --help")
        return 0

    if sys.argv[1] in ["--list", "-l", "list"]:
        print("Supported macW1Y languages:")
        for code, data in sorted(LOCALE_MAP.items(), key=lambda x: x[1]["name"]):
            print(f"  {code:5} -> {data['name']:25} ({data['posix']})")
        return 0

    raw_arg = sys.argv[1]
    quiet = "--quiet" in sys.argv or "-q" in sys.argv

    lang_code = normalize_lang(raw_arg)
    info = LOCALE_MAP.get(lang_code, LOCALE_MAP["en"])
    posix = info["posix"]
    lang_env = info["lang_env"]
    xkb = info.get("xkb", "us")
    uid = os.getuid()

    print(f"🌍 Applying language: {info['name']} ({lang_code}) -> POSIX: {posix}")

    # 1. Ensure system glibc locale is generated
    ensure_locale_generated(posix)

    # 2. Write user environment & configuration files
    write_user_configs(lang_code, posix, lang_env)

    # 3. Apply to systemd user session
    apply_systemd_env(posix, lang_env)

    # 4. Apply to AccountsService (D-Bus)
    apply_accounts_service(uid, posix)

    # 5. Apply to system localectl and /etc/default/locale
    apply_system_locale(posix, lang_env)

    # 6. Apply keyboard input sources
    apply_keyboard_layout(xkb)

    # 7. Update GNOME Shell live environment & clock
    notify_gnome_shell(lang_code, posix, lang_env)

    # 8. Send notification if not quiet
    if not quiet:
        show_notification(info)

    print(f"✓ Language successfully applied: {info['name']} ({posix})")
    return 0

if __name__ == "__main__":
    sys.exit(main())
