#!/usr/bin/env python3
"""
mac-apply-theme - Idempotent Master Theme & Settings Applicator for macW1Y
Reads Single Source of Truth (SSOT) from config/macw1y-manifest.json.
Guaranteed safe:
- Never wipes working configs or extensions
- File locking (flock) prevents parallel race conditions
- Only applies changes when current values differ (zero-churn idempotency)
"""

import os
import sys
import json
import fcntl
import shutil
import subprocess

def find_repo_dir():
    candidates = [
        os.path.abspath(os.path.join(os.path.dirname(__file__), "..")),
        os.getcwd(),
        os.environ.get("MACW1Y_REPO", ""),
        os.path.expanduser("~/macW1Y"),
        os.path.expanduser("~/MACTHEMEFILES"),
        "/usr/share/mactheme",
    ]
    for c in candidates:
        if c and os.path.exists(os.path.join(c, "config/macw1y-manifest.json")):
            return c
    return os.path.abspath(os.path.join(os.path.dirname(__file__), ".."))

REPO_DIR = find_repo_dir()
MANIFEST_PATH = os.path.join(REPO_DIR, "config/macw1y-manifest.json")
HOME = os.path.expanduser("~")
RUNTIME_DIR = os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}")
LOCK_FILE = os.path.join(RUNTIME_DIR, "macw1y-apply.lock")

def acquire_lock():
    try:
        fd = open(LOCK_FILE, "w")
        fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        fd.write(f"{os.getpid()}\n")
        fd.flush()
        return fd
    except (BlockingIOError, IOError):
        print("[mac-apply-theme] Another instance is currently applying theme settings. Exiting cleanly.")
        sys.exit(0)

def get_file_md5(path):
    if not os.path.exists(path):
        return None
    import hashlib
    h = hashlib.md5()
    with open(path, "rb") as f:
        while chunk := f.read(8192):
            h.update(chunk)
    return h.hexdigest()

def gsettings_get(schema, key):
    try:
        res = subprocess.check_output(["gsettings", "get", schema, key], text=True, stderr=subprocess.DEVNULL).strip()
        return res.strip("'\"")
    except Exception:
        return None

def gsettings_set(schema, key, val, val_type=None):
    cur = gsettings_get(schema, key)
    if cur is None:
        return False
    str_val = str(val)
    if val_type == "bool" or isinstance(val, bool) or str_val.lower() in ("true", "false"):
        cur_bool = cur.lower() in ("true", "1")
        tar_bool = (str_val.lower() == "true") if isinstance(val, str) else bool(val)
        if cur_bool == tar_bool:
            return False
    elif val_type == "float" or isinstance(val, float):
        try:
            if abs(float(cur) - float(val)) < 0.001:
                return False
        except Exception:
            pass
    elif val_type == "int" or isinstance(val, int):
        try:
            if int(cur) == int(val):
                return False
        except Exception:
            pass
    else:
        if cur == str_val or cur == str_val.strip("'\""):
            return False
    try:
        if val_type == "bool":
            subprocess.run(["gsettings", "set", schema, key, "true" if val else "false"], check=False)
        elif val_type == "int":
            subprocess.run(["gsettings", "set", schema, key, str(val)], check=False)
        elif val_type == "float":
            subprocess.run(["gsettings", "set", schema, key, f"{float(val):.2f}"], check=False)
        else:
            subprocess.run(["gsettings", "set", schema, key, str_val], check=False)
        return True
    except Exception:
        return False

def update_ini_file(path, key_values):
    if not os.path.exists(path):
        os.makedirs(os.path.dirname(path), exist_ok=True)
        lines = ["[Settings]\n"]
    else:
        with open(path, "r", encoding="utf-8") as f:
            lines = f.readlines()

    modified = False
    existing_keys = set()
    new_lines = []
    
    for l in lines:
        if "=" in l and not l.strip().startswith("#"):
            k, v = l.split("=", 1)
            k = k.strip()
            existing_keys.add(k)
            if k in key_values:
                target_v = str(key_values[k])
                if v.strip() != target_v:
                    new_lines.append(f"{k}={target_v}\n")
                    modified = True
                else:
                    new_lines.append(l)
            else:
                new_lines.append(l)
        else:
            new_lines.append(l)

    for k, v in key_values.items():
        if k not in existing_keys:
            new_lines.append(f"{k}={v}\n")
            modified = True

    if modified:
        with open(path, "w", encoding="utf-8") as f:
            f.writelines(new_lines)
    return modified

def main():
    lock_fd = acquire_lock()
    print("[mac-apply-theme] Applying Single Source of Truth (SSOT)...")

    # 0. Ensure master design tokens and components are compiled
    build_script = os.path.join(REPO_DIR, "bin/mac-build-theme")
    if os.path.exists(build_script):
        try:
            subprocess.run([sys.executable, build_script], check=False, stdout=subprocess.DEVNULL)
        except Exception:
            pass

    if not os.path.exists(MANIFEST_PATH):
        print(f"Error: Manifest {MANIFEST_PATH} not found!")
        sys.exit(1)

    with open(MANIFEST_PATH, "r", encoding="utf-8") as f:
        manifest = json.load(f)

    th = manifest.get("theme", {})
    changes_count = 0

    # Determine Light vs Dark mode
    active_scheme = gsettings_get("org.gnome.desktop.interface", "color-scheme") or th.get("color_scheme", "prefer-dark")
    is_light = active_scheme in ("prefer-light", "default")

    cur_gtk_theme = "macW1Y-Light" if is_light else "macW1Y-Dark"
    cur_icon_theme = "macW1Y" if is_light else "macW1Y-dark"
    cur_wm_theme = "macW1Y-Light" if is_light else "macW1Y-Dark"
    cur_shell_theme = "macW1Y-Light" if is_light else "macW1Y-Dark"
    cur_color_scheme = "prefer-light" if is_light else "prefer-dark"

    # 1. Desktop Interface
    if gsettings_set("org.gnome.desktop.interface", "gtk-theme", cur_gtk_theme): changes_count += 1
    if gsettings_set("org.gnome.desktop.interface", "icon-theme", cur_icon_theme): changes_count += 1
    if gsettings_set("org.gnome.desktop.interface", "cursor-theme", th.get("cursor_theme", "macW1Y")): changes_count += 1
    if gsettings_set("org.gnome.desktop.interface", "font-name", th.get("font_name", "default 10")): changes_count += 1
    if gsettings_set("org.gnome.desktop.interface", "document-font-name", th.get("document_font_name", "default 10")): changes_count += 1
    if gsettings_set("org.gnome.desktop.interface", "monospace-font-name", th.get("monospace_font_name", "DefaultMono 10")): changes_count += 1
    if gsettings_set("org.gnome.desktop.interface", "font-antialiasing", "grayscale"): changes_count += 1
    if gsettings_set("org.gnome.desktop.interface", "color-scheme", cur_color_scheme): changes_count += 1

    # 2. WM Preferences
    if gsettings_set("org.gnome.desktop.wm.preferences", "theme", cur_wm_theme): changes_count += 1
    if gsettings_set("org.gnome.desktop.wm.preferences", "button-layout", th.get("button_layout", "close,minimize,maximize:")): changes_count += 1

    # 3. User Theme Extension
    if gsettings_set("org.gnome.shell.extensions.user-theme", "name", cur_shell_theme): changes_count += 1

    # 4. Sound Theme
    if gsettings_set("org.gnome.desktop.sound", "theme-name", th.get("sound_theme", "macW1Y")): changes_count += 1
    if gsettings_set("org.gnome.desktop.sound", "event-sounds", "true", "bool"): changes_count += 1
    if gsettings_set("org.gnome.desktop.sound", "input-feedback-sounds", "true", "bool"): changes_count += 1

    # 5. GTK 3.0 & 4.0 settings.ini
    ini_dict = {
        "gtk-theme-name": cur_gtk_theme,
        "gtk-icon-theme-name": cur_icon_theme,
        "gtk-font-name": th.get("font_name", "default 10"),
        "gtk-cursor-theme-name": th.get("cursor_theme", "macW1Y"),
        "gtk-decoration-layout": th.get("button_layout", "close,minimize,maximize:"),
        "gtk-application-prefer-dark-theme": "0" if is_light else "1"
    }
    for ini_path in [os.path.join(HOME, ".config/gtk-3.0/settings.ini"),
                     os.path.join(HOME, ".config/gtk-4.0/settings.ini")]:
        if update_ini_file(ini_path, ini_dict):
            changes_count += 1

    # 5b. Universal Cursor Enforcement (Xresources, X11, GTK2, Snaps)
    try:
        xresources_path = os.path.join(HOME, ".Xresources")
        xr_content = "Xcursor.theme: macW1Y\nXcursor.size: 24\n"
        with open(xresources_path, "w") as xrf:
            xrf.write(xr_content)
        if shutil.which("xrdb"):
            subprocess.run(["xrdb", "-merge", xresources_path], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        
        # Trigger snap cursor sync daemon/script if available
        if os.path.exists("/usr/local/bin/mac-snap-cursor-sync"):
            subprocess.run(["/usr/local/bin/mac-snap-cursor-sync"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except Exception:
        pass

    # 6. Liquid Glass settings
    lg = manifest.get("liquid_glass", {})
    lg_schema = lg.get("schema", "org.gnome.shell.extensions.liquid-glass@thinkingcoding1231.gmail.com")
    try:
        # Check if schema installed
        test = subprocess.run(["gsettings", "list-keys", lg_schema], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        if test.returncode == 0:
            for k, v in lg.items():
                if k == "schema": continue
                gk = k.replace("_", "-")
                if isinstance(v, float):
                    if gsettings_set(lg_schema, gk, v, "float"): changes_count += 1
                elif isinstance(v, int):
                    if gsettings_set(lg_schema, gk, v, "int"): changes_count += 1
                elif isinstance(v, bool):
                    if gsettings_set(lg_schema, gk, v, "bool"): changes_count += 1
                else:
                    if gsettings_set(lg_schema, gk, str(v)): changes_count += 1
    except Exception:
        pass

    # 7. Blur-my-shell settings
    bms = manifest.get("blur_my_shell", {})
    if "panel" in bms:
        for k, v in bms["panel"].items():
            gk = k.replace("_", "-")
            vt = "bool" if isinstance(v, bool) else ("int" if isinstance(v, int) else None)
            if gsettings_set("org.gnome.shell.extensions.blur-my-shell.panel", gk, v, vt): changes_count += 1
    if "applications" in bms:
        for k, v in bms["applications"].items():
            gk = k.replace("_", "-")
            vt = "bool" if isinstance(v, bool) else ("int" if isinstance(v, int) else None)
            if gsettings_set("org.gnome.shell.extensions.blur-my-shell.applications", gk, v, vt): changes_count += 1

    # 8. Extensions state check
    exts = manifest.get("extensions", {})
    req_exts = exts.get("required", [])
    bloat_exts = exts.get("disabled_bloat", [])

    try:
        enabled_list = subprocess.check_output(["gnome-extensions", "list", "--enabled"], text=True, stderr=subprocess.DEVNULL).splitlines()
        enabled_set = set(enabled_list)

        for e in req_exts:
            if e not in enabled_set:
                subprocess.run(["gnome-extensions", "enable", e], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                changes_count += 1

        for e in bloat_exts:
            if e in enabled_set:
                subprocess.run(["gnome-extensions", "disable", e], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                changes_count += 1
    except Exception:
        pass

    # 9. macW1Y Desktop Transition Overlay sync with backup & watchdog wrapper
    overlay_src = os.path.join(REPO_DIR, "gnome-shell-overlay/ui/layout.js")
    overlay_dst = "/usr/share/mactheme/gnome-shell-overlay/ui/layout.js"
    orig_dst = "/usr/share/mactheme/gnome-shell-overlay/ui/layout.js.orig"
    wrapper_src = os.path.join(REPO_DIR, "bin/gnome-shell")
    wrapper_dst = "/usr/bin/gnome-shell"

    if os.path.exists(overlay_src):
        try:
            subprocess.run(["sudo", "mkdir", "-p", "/usr/share/mactheme/gnome-shell-overlay/ui"], check=False)
            if not os.path.exists(orig_dst):
                # Extract upstream layout.js for safe rollback backup
                import glob
                libs = glob.glob("/usr/lib/gnome-shell/libshell-*.so")
                if libs:
                    with open("/tmp/mac_orig_layout.js", "w") as f:
                        subprocess.run(["gresource", "extract", libs[0], "/org/gnome/shell/ui/layout.js"], stdout=f, check=False)
                    subprocess.run(["sudo", "cp", "-f", "/tmp/mac_orig_layout.js", orig_dst], check=False)
                    subprocess.run(["sudo", "chmod", "644", orig_dst], check=False)
                    if os.path.exists("/tmp/mac_orig_layout.js"):
                        os.unlink("/tmp/mac_orig_layout.js")

            if not os.path.exists(overlay_dst) or get_file_md5(overlay_src) != get_file_md5(overlay_dst):
                subprocess.run(["sudo", "cp", "-f", overlay_src, overlay_dst], check=False)
                subprocess.run(["sudo", "chmod", "644", overlay_dst], check=False)
                changes_count += 1

            # Shell watchdog overlay is disabled on RPM/Pacman systems (preserve packaged binary)
            is_debian = os.path.exists("/etc/debian_version") and shutil.which("dpkg-divert") is not None
            if is_debian and os.path.exists(wrapper_src):
                if not os.path.exists("/usr/bin/gnome-shell.real"):
                    subprocess.run(["sudo", "dpkg-divert", "--add", "--rename", "--divert", "/usr/bin/gnome-shell.real", "/usr/bin/gnome-shell"], check=False)
                if not os.path.exists(wrapper_dst) or get_file_md5(wrapper_src) != get_file_md5(wrapper_dst):
                    subprocess.run(["sudo", "cp", "-f", wrapper_src, wrapper_dst], check=False)
                    subprocess.run(["sudo", "chmod", "755", wrapper_dst], check=False)
                    changes_count += 1
        except Exception:
            pass

    # 10. GNOME Control Center overlay sync
    cc_src_dir = os.path.join(REPO_DIR, "gnome-control-center-overlay")
    cc_dst_dir = "/usr/share/mactheme/gnome-control-center-overlay"
    if os.path.isdir(cc_src_dir):
        try:
            subprocess.run(["sudo", "mkdir", "-p", cc_dst_dir], check=False)
            for fname in os.listdir(cc_src_dir):
                sf = os.path.join(cc_src_dir, fname)
                df = os.path.join(cc_dst_dir, fname)
                if os.path.isfile(sf):
                    if not os.path.exists(df) or get_file_md5(sf) != get_file_md5(df):
                        subprocess.run(["sudo", "cp", "-f", sf, df], check=False)
                        if fname.endswith(".so"):
                            subprocess.run(["sudo", "chmod", "755", df], check=False)
                        else:
                            subprocess.run(["sudo", "chmod", "644", df], check=False)
                        changes_count += 1
        except Exception:
            pass

    print(f"[mac-apply-theme] Completed. Applied {changes_count} changes (0 changes means already perfectly in sync).")

if __name__ == "__main__":
    main()
