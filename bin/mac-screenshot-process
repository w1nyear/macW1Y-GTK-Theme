#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
mac-screenshot-process — macW1Y default Screenshot & Screencast Processing Engine
Handles:
- Immediate macW1Y camera shutter sound on capture
- Post-processing & upscaling (Native / 1080p / 2K / 4K) using Lanczos3 / Unsharp Mask
- Format conversion (PNG, JPEG, WebP)
- Video transcoding (MP4 / WebM / MKV, H.264 / VP9 / AV1, 60fps / 30fps)
- Background filesystem watcher daemon for screenshot/screencast directories
"""

import os
import sys
import time
import json
import fcntl
import hashlib
import signal
import shutil
import argparse
import subprocess
from pathlib import Path

CONFIG_FILE = Path(os.path.expanduser("~/.config/mac-styling/screenshot.json"))
SHUTTER_SOUND_PATHS = (
    "/usr/share/sounds/macW1Y/stereo/camera-shutter.ogg",
    os.path.expanduser("~/.local/share/sounds/macW1Y/stereo/camera-shutter.ogg"),
    "/usr/share/sounds/macOS/stereo/camera-shutter.ogg",
    os.path.expanduser("~/.local/share/sounds/macOS/stereo/camera-shutter.ogg"),
)
SHUTTER_SOUND = SHUTTER_SOUND_PATHS[0]

DEFAULT_CONFIG = {
    "image_format": 0,           # 0=PNG, 1=JPEG, 2=WebP
    "image_quality": 95,         # 70 - 100
    "show_cursor": True,
    "shutter_sound": True,
    "timer_delay": 0,
    "video_container": 0,        # 0=MP4, 1=WebM, 2=MKV
    "video_codec": 0,            # 0=H.264, 1=VP9, 2=AV1
    "video_fps": 0,              # 0=60, 1=30
    "record_audio": False,
    "processing_enabled": True,
    "processing_target": 2,      # 0=native, 1=1080p, 2=2k, 3=4k
    "processing_algorithm": 0,   # 0=lanczos, 1=bicubic, 2=unsharp
    "processing_scope": 0,       # 0=both, 1=screenshots, 2=screencasts
    "keep_original": False,
    "screenshots_dir": "~/Зображення/Знімки екрана",
    "screencasts_dir": "~/Відео/Трансляції з екрана"
}

def load_config():
    if CONFIG_FILE.exists():
        try:
            with open(CONFIG_FILE, "r", encoding="utf-8") as f:
                cfg = json.load(f)
                res = DEFAULT_CONFIG.copy()
                res.update(cfg)
                return res
        except Exception:
            pass
    return DEFAULT_CONFIG.copy()

def get_locale_code():
    try:
        loc_f = os.path.expanduser("~/.config/mac-styling/locale")
        if os.path.exists(loc_f):
            with open(loc_f, "r", encoding="utf-8") as f:
                return f.read().strip().lower()
        if os.environ.get("LANGUAGE"):
            return os.environ.get("LANGUAGE", "").split(":")[0].split(".")[0].split("_")[0].lower()
        if os.environ.get("LANG"):
            return os.environ.get("LANG", "").split(".")[0].split("_")[0].lower()
    except Exception:
        pass
    return "en"

SCREENSHOT_I18N = {
    "pl": {"app": "Zrzut ekranu", "video_saved": "Nagranie ekranu zapisane", "original": "Oryginalna"},
    "uk": {"app": "Скріншот", "video_saved": "Запис екрана збережено", "original": "Оригінальна"},
    "de": {"app": "Bildschirmfoto", "video_saved": "Bildschirmaufnahme gespeichert", "original": "Original"},
    "fr": {"app": "Capture d'écran", "video_saved": "Enregistrement d'écran enregistré", "original": "Originale"},
    "es": {"app": "Captura de pantalla", "video_saved": "Grabación de pantalla guardada", "original": "Original"},
    "it": {"app": "Schermata", "video_saved": "Registrazione dello schermo salvata", "original": "Originale"},
    "en": {"app": "Screenshot", "video_saved": "Screen recording saved", "original": "Original"}
}

def ss_tr(key):
    base = get_locale_code().split('_')[0]
    return SCREENSHOT_I18N.get(base, SCREENSHOT_I18N["en"]).get(key, SCREENSHOT_I18N["en"].get(key, key))

def resolve_shutter_sound():
    """Return the first installed camera shutter sound path, if any."""
    candidates = SHUTTER_SOUND_PATHS if SHUTTER_SOUND == SHUTTER_SOUND_PATHS[0] else (SHUTTER_SOUND, *SHUTTER_SOUND_PATHS)
    return next((path for path in candidates if os.path.exists(path)), None)


def play_shutter():
    cfg = load_config()
    if not cfg.get("shutter_sound", True):
        return
    shutter_path = resolve_shutter_sound()
    if shutter_path:
        try:
            if shutil.which("pw-play"):
                subprocess.Popen(["pw-play", shutter_path], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            elif shutil.which("canberra-gtk-play"):
                subprocess.Popen(["canberra-gtk-play", "-f", shutter_path], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            elif shutil.which("aplay"):
                subprocess.Popen(["aplay", "-q", shutter_path], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        except Exception:
            pass

def notify(title, message="", icon="applets-screenshooter-symbolic"):
    if shutil.which("notify-send"):
        try:
            cmd = [
                "notify-send",
                "-a", ss_tr("app"),
                "-h", "string:x-canonical-private-synchronous:mac-screenshot-notify",
                "-i", icon,
                title
            ]
            if message:
                cmd.append(message)
            subprocess.Popen(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        except Exception:
            pass

def get_target_resolution(code):
    # 0=native, 1=1080p, 2=2k, 3=4k
    if code == 1:
        return 1920, 1080, "1080p Full HD"
    elif code == 2:
        return 2560, 1440, "2K Quad HD"
    elif code == 3:
        return 3840, 2160, "4K Ultra HD"
    return None, None, ss_tr("original")

def contrast_adaptive_sharpen(img, strength=0.85):
    """
    AMD FidelityFX Contrast-Adaptive Sharpening (CAS).
    Sharpen without halos or ringing by adaptively clamping weights to local min/max.
    """
    try:
        import numpy as np
        from PIL import Image
        arr = np.array(img, dtype=np.float32) / 255.0
        has_alpha = (arr.ndim == 3 and arr.shape[2] == 4)
        rgb = arr[:, :, :3] if arr.ndim == 3 else np.dstack([arr, arr, arr])

        top    = np.roll(rgb, -1, axis=0)
        bottom = np.roll(rgb,  1, axis=0)
        left   = np.roll(rgb, -1, axis=1)
        right  = np.roll(rgb,  1, axis=1)

        c_min = np.minimum(np.minimum(top, bottom), np.minimum(left, right))
        c_min = np.minimum(c_min, rgb)
        c_max = np.maximum(np.maximum(top, bottom), np.maximum(left, right))
        c_max = np.maximum(c_max, rgb)

        amp = np.minimum(c_min, 1.0 - c_max) / (c_max + 1e-5)
        w = -np.sqrt(np.clip(amp, 0.0, 1.0)) * (strength * 0.25)

        sharp = (rgb + w * (top + bottom + left + right)) / (1.0 + 4.0 * w)
        sharp = np.clip(sharp, 0.0, 1.0)

        if has_alpha:
            out = np.dstack([sharp, arr[:, :, 3]])
        elif arr.ndim == 2:
            out = sharp[:, :, 0]
        else:
            out = sharp
        return Image.fromarray((out * 255.0).astype(np.uint8))
    except Exception:
        return img

def super_resolve_image(img, target_w, target_h, algo_idx=0):
    """
    Multi-stage Super-Resolution pipeline with progressive scaling,
    FidelityFX CAS and scale-adaptive unsharp edge steepening.
    """
    from PIL import Image, ImageFilter
    orig_w, orig_h = img.size

    aspect = orig_w / float(orig_h)
    target_aspect = (target_w / float(target_h)) if target_h else (16.0 / 9.0)

    if aspect >= target_aspect:
        new_w = target_w
        new_h = int(round(new_w / aspect))
    else:
        new_h = target_h if target_h else int(round(target_w / aspect))
        new_w = int(round(new_h * aspect))

    scale = new_w / float(orig_w)

    has_alpha = (img.mode == "RGBA")
    if has_alpha:
        alpha = img.split()[3]
        base_img = img.convert("RGB")
    else:
        alpha = None
        base_img = img.convert("RGB") if img.mode != "RGB" else img

    resample_method = Image.Resampling.LANCZOS if algo_idx in [0, 2] else Image.Resampling.BICUBIC

    if scale > 1.05:
        curr = base_img

        # Progressive multi-stage resampling for high magnification (prevents diffuse sinc blur ramps)
        if scale > 1.8:
            while curr.size[0] * 1.8 < new_w:
                step_w = int(round(curr.size[0] * 1.5))
                step_h = int(round(curr.size[1] * 1.5))
                curr = curr.resize((step_w, step_h), resample=resample_method)
                curr = contrast_adaptive_sharpen(curr, strength=0.6)

        # Final resize to target resolution
        curr = curr.resize((new_w, new_h), resample=resample_method)

        # CAS pre-sharpening
        cas_strength = 0.9 if algo_idx in [0, 2] else 0.55
        curr = contrast_adaptive_sharpen(curr, strength=cas_strength)

        # Adaptive dual-radius unsharp masking tailored to magnification factor
        macro_radius = max(1.2, min(3.2, 0.6 + 0.28 * scale))
        macro_pct = int(130 + min(75, 12 * scale))
        curr = curr.filter(ImageFilter.UnsharpMask(radius=macro_radius, percent=macro_pct, threshold=1))

        micro_radius = 0.8
        micro_pct = 120 if algo_idx != 1 else 80
        curr = curr.filter(ImageFilter.UnsharpMask(radius=micro_radius, percent=micro_pct, threshold=1))

        if algo_idx == 2:
            curr = curr.filter(ImageFilter.UnsharpMask(radius=1.5, percent=135, threshold=2))

        # Final lock-in CAS pass to eliminate any micro-ringing
        curr = contrast_adaptive_sharpen(curr, strength=0.75)
        out_img = curr
    else:
        out_img = base_img.resize((new_w, new_h), resample=resample_method)
        if algo_idx in [0, 2]:
            out_img = contrast_adaptive_sharpen(out_img, strength=0.6)
            out_img = out_img.filter(ImageFilter.UnsharpMask(radius=1.0, percent=110, threshold=1))

    if has_alpha and alpha is not None:
        alpha_scaled = alpha.resize((new_w, new_h), resample=Image.Resampling.LANCZOS)
        if scale > 1.2:
            alpha_scaled = alpha_scaled.filter(ImageFilter.UnsharpMask(radius=1.0, percent=125, threshold=1))
        out_img.putalpha(alpha_scaled)

    return out_img, (new_w, new_h)

def process_image(file_path):
    p = Path(file_path).resolve()
    if not p.exists() or p.stat().st_size == 0:
        return None

    # Avoid processing already processed files or files in Originals
    if "Originals" in p.parts or p.stem.endswith("_processed") or p.stem.endswith("_temp"):
        return None

    cfg = load_config()
    format_idx = cfg.get("image_format", 0)       # 0=PNG, 1=JPEG, 2=WebP
    quality = int(cfg.get("image_quality", 95))
    processing_enabled = cfg.get("processing_enabled", True)
    target_idx = cfg.get("processing_target", 2)
    algo_idx = cfg.get("processing_algorithm", 0) # 0=lanczos, 1=bicubic, 2=unsharp
    scope_idx = cfg.get("processing_scope", 0)    # 0=both, 1=screenshots, 2=screencasts
    keep_orig = cfg.get("keep_original", False)

    apply_proc = processing_enabled and (scope_idx in [0, 1])

    ext_map = {0: ".png", 1: ".jpg", 2: ".webp"}
    target_ext = ext_map.get(format_idx, ".png")

    target_w, target_h, target_name = get_target_resolution(target_idx) if apply_proc else (None, None, None)

    need_format_convert = (p.suffix.lower() != target_ext)
    need_upscale = bool(apply_proc and target_w)

    # Fast check: if neither format conversion nor upscaling is requested, nothing to do
    if not need_format_convert and not need_upscale:
        return None

    try:
        from PIL import Image, ImageFilter
    except ImportError:
        return None

    try:
        lock_handle = _acquire_process_lock(p)
        if not p.exists() or p.stat().st_size == 0:
            return None
        time.sleep(0.15)
        with Image.open(p) as img:
            orig_w, orig_h = img.size

            # Check if upscaling is actually needed (image is smaller than target)
            do_resize = False
            if need_upscale and target_w and (target_w > orig_w or (target_h and target_h > orig_h)):
                do_resize = True

            # If format matches and no resizing needed, skip entirely
            if not need_format_convert and not do_resize:
                return None

            if keep_orig:
                orig_dir = p.parent / "Originals"
                orig_dir.mkdir(parents=True, exist_ok=True)
                shutil.copy2(p, orig_dir / p.name)

            out_img = img

            if do_resize:
                out_img, _ = super_resolve_image(img, target_w, target_h, algo_idx)
            elif apply_proc and algo_idx in [0, 2]:
                out_img = contrast_adaptive_sharpen(img, strength=0.6)
                if algo_idx == 2:
                    out_img = out_img.filter(ImageFilter.UnsharpMask(radius=1.0, percent=115, threshold=1))

            # Convert color mode for JPEG if RGBA
            if target_ext in [".jpg", ".jpeg"] and out_img.mode in ("RGBA", "P"):
                rgb_img = Image.new("RGB", out_img.size, (255, 255, 255))
                if out_img.mode == "RGBA":
                    rgb_img.paste(out_img, mask=out_img.split()[3])
                else:
                    rgb_img.paste(out_img)
                out_img = rgb_img

            dest_path = p.with_suffix(target_ext)

            save_kwargs = {}
            target_dpi = (144, 144) if target_idx == 2 else ((288, 288) if target_idx == 3 else (96, 96))
            if target_ext in [".jpg", ".jpeg"]:
                save_kwargs = {"quality": quality, "subsampling": 0, "optimize": True, "dpi": target_dpi}
            elif target_ext == ".webp":
                save_kwargs = {"quality": quality, "method": 6}
            elif target_ext == ".png":
                save_kwargs = {"compress_level": 6, "optimize": True, "dpi": target_dpi}

            out_img.save(dest_path, **save_kwargs)

        # If extension changed, remove original file
        if dest_path != p and p.exists():
            p.unlink()

        _mark_done(p)
        _mark_done(dest_path)
        # Screenshots: GNOME Shell already sends the native screenshot notification.
        # Do not send any processing notifications so there is exactly ONE notification for screenshots.
        return dest_path
    except Exception as e:
        print(f"Error processing image {file_path}: {e}", file=sys.stderr)
        return None
    finally:
        if 'lock_handle' in locals() and lock_handle:
            try:
                fcntl.flock(lock_handle, fcntl.LOCK_UN)
                lock_handle.close()
            except Exception:
                pass

LOCK_DIR = Path("/tmp/macw1y_ss_locks")


def _path_key(file_path):
    return hashlib.sha1(str(Path(file_path).resolve()).encode("utf-8", "ignore")).hexdigest()


def _acquire_process_lock(file_path):
    LOCK_DIR.mkdir(parents=True, exist_ok=True)
    lock_file = open(LOCK_DIR / f"{_path_key(file_path)}.lock", "w")
    fcntl.flock(lock_file, fcntl.LOCK_EX)
    return lock_file


def _mark_done(file_path):
    try:
        LOCK_DIR.mkdir(parents=True, exist_ok=True)
        marker = LOCK_DIR / f"{_path_key(file_path)}.done"
        marker.write_text(str(time.time()), encoding="utf-8")
    except Exception:
        pass


def _was_recently_done(file_path, max_age=25.0):
    try:
        marker = LOCK_DIR / f"{_path_key(file_path)}.done"
        if marker.exists():
            return (time.time() - marker.stat().st_mtime) < max_age
    except Exception:
        pass
    return False


def _audio_pending_or_active():
    try:
        active = LOCK_DIR / "audio_active.flag"
        pending = LOCK_DIR / "audio_pending_mux.flag"
        now = time.time()
        if active.exists() and (now - active.stat().st_mtime) < 3600:
            return True
        if pending.exists() and (now - pending.stat().st_mtime) < 6.0:
            return True
    except Exception:
        pass
    return False


def _default_sink_monitor():
    try:
        if shutil.which("pactl"):
            sink = subprocess.check_output(
                ["pactl", "get-default-sink"], text=True, stderr=subprocess.DEVNULL
            ).strip()
            if sink:
                return f"{sink}.monitor"
            out = subprocess.check_output(
                ["pactl", "list", "short", "sources"], text=True, stderr=subprocess.DEVNULL
            )
            for line in out.splitlines():
                parts = line.split("\t")
                if len(parts) >= 2 and parts[1].endswith(".monitor"):
                    return parts[1]
    except Exception:
        pass
    return None


def pick_folder_dialog():
    try:
        import gi
        gi.require_version("Gtk", "4.0")
        from gi.repository import Gtk, Gio

        result = {"path": ""}
        loc = get_locale_code().split("_")[0]
        titles = {
            "uk": "Виберіть папку збереження",
            "ru": "Выберите папку сохранения",
            "pl": "Wybierz folder zapisu",
            "de": "Speicherort auswählen",
        }
        title = titles.get(loc, "Choose Save Location")

        class PickerApp(Gtk.Application):
            def __init__(self):
                super().__init__(application_id="org.macw1y.ScreenshotFolderPicker",
                                 flags=Gio.ApplicationFlags.NON_UNIQUE)

            def do_activate(self):
                self.hold()
                dialog = Gtk.FileDialog(title=title, modal=True)

                def on_done(dlg, res):
                    try:
                        folder = dlg.select_folder_finish(res)
                        if folder:
                            p = folder.get_path()
                            if p:
                                result["path"] = p
                    except Exception:
                        pass
                    self.release()
                    self.quit()

                dialog.select_folder(None, None, on_done)

        app = PickerApp()
        app.run([])
        if result["path"]:
            print(result["path"], flush=True)
            return 0
        return 1
    except Exception:
        if shutil.which("zenity"):
            try:
                out = subprocess.check_output(
                    ["zenity", "--file-selection", "--directory"],
                    text=True, stderr=subprocess.DEVNULL
                ).strip()
                if out:
                    print(out, flush=True)
                    return 0
            except Exception:
                pass
        return 1


def record_audio_stream(out_path, mic_device=None, system_audio=False):
    if not out_path or not shutil.which("ffmpeg"):
        return 1
    sources = []
    if mic_device:
        sources.append(mic_device)
    if system_audio:
        mon = _default_sink_monitor()
        if mon and mon not in sources:
            sources.append(mon)
    if not sources:
        return 1

    LOCK_DIR.mkdir(parents=True, exist_ok=True)
    active_flag = LOCK_DIR / "audio_active.flag"
    pending_flag = LOCK_DIR / "audio_pending_mux.flag"
    active_flag.write_text(str(os.getpid()), encoding="utf-8")

    cmd = ["ffmpeg", "-y", "-hide_banner", "-loglevel", "error"]
    for src in sources:
        cmd.extend(["-f", "pulse", "-i", src])
    if len(sources) > 1:
        cmd.extend(["-filter_complex", f"amix=inputs={len(sources)}:duration=longest:dropout_transition=0"])
    cmd.extend(["-c:a", "pcm_s16le", "-ar", "48000", "-ac", "2", str(out_path)])

    stop_requested = {"flag": False}
    proc = subprocess.Popen(cmd, stdin=subprocess.PIPE, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

    def _request_stop(_signum, _frame):
        if stop_requested["flag"]:
            return
        stop_requested["flag"] = True
        try:
            if proc.poll() is None and proc.stdin:
                proc.stdin.write(b"q\n")
                proc.stdin.flush()
        except Exception:
            try:
                proc.send_signal(signal.SIGINT)
            except Exception:
                pass

    signal.signal(signal.SIGINT, _request_stop)
    signal.signal(signal.SIGTERM, _request_stop)

    try:
        while proc.poll() is None:
            if stop_requested["flag"]:
                try:
                    proc.wait(timeout=2.0)
                except subprocess.TimeoutExpired:
                    proc.terminate()
                break
            time.sleep(0.08)
    finally:
        try:
            active_flag.unlink(missing_ok=True)
        except Exception:
            pass
        try:
            pending_flag.write_text(str(time.time()), encoding="utf-8")
        except Exception:
            pass
    return 0


def process_video(file_path, audio_file=None):
    p = Path(file_path).resolve()
    audio_path = Path(audio_file).resolve() if audio_file else None
    has_audio = bool(audio_path and audio_path.exists() and audio_path.stat().st_size > 44)
    if not p.exists() or p.stat().st_size == 0:
        if audio_path and audio_path.exists():
            audio_path.unlink(missing_ok=True)
        return None

    if "Originals" in p.parts or p.stem.endswith("_processed") or p.stem.endswith("_temp"):
        return None

    lock_handle = None
    try:
        lock_handle = _acquire_process_lock(p)
        # Re-check in case another worker (e.g. daemon) already replaced p with another container
        if not p.exists() or p.stat().st_size == 0:
            return None

        # Wait for screencast recorder to finish writing (file size stabilization)
        prev_size = -1
        for _ in range(30):
            try:
                cur_size = p.stat().st_size
                if cur_size == prev_size and cur_size > 1024:
                    break
                prev_size = cur_size
            except Exception:
                pass
            time.sleep(0.4)

        cfg = load_config()
        container_idx = cfg.get("video_container", 0)  # 0=MP4, 1=WebM, 2=MKV
        codec_idx = cfg.get("video_codec", 0)          # 0=H.264, 1=VP9, 2=AV1
        fps_idx = cfg.get("video_fps", 0)              # 0=60, 1=30
        processing_enabled = cfg.get("processing_enabled", True)
        target_idx = cfg.get("processing_target", 2)
        scope_idx = cfg.get("processing_scope", 0)     # 0=both, 1=screenshots, 2=screencasts
        keep_orig = cfg.get("keep_original", False)

        apply_proc = processing_enabled and (scope_idx in [0, 2])

        cont_map = {0: ".mp4", 1: ".webm", 2: ".mkv"}
        target_ext = cont_map.get(container_idx, ".mp4") if apply_proc else (p.suffix.lower() or ".webm")
        if target_ext not in (".mp4", ".webm", ".mkv"):
            target_ext = ".mp4"

        target_w, target_h, _target_name = get_target_resolution(target_idx) if apply_proc else (None, None, None)

        if not shutil.which("ffmpeg"):
            return None

        dest_path = p.with_suffix(target_ext)
        temp_path = p.with_name(f"{p.stem}_temp{target_ext}")

        if keep_orig and apply_proc:
            orig_dir = p.parent / "Originals"
            orig_dir.mkdir(parents=True, exist_ok=True)
            shutil.copy2(p, orig_dir / p.name)

        cmd = ["ffmpeg", "-y", "-i", str(p)]
        if has_audio:
            cmd.extend(["-i", str(audio_path)])

        if not apply_proc and has_audio:
            # Fast remux with audio without full video re-encode
            cmd.extend(["-map", "0:v:0", "-map", "1:a:0", "-c:v", "copy"])
        else:
            # Video filter for resolution scaling & contrast-adaptive super-resolution
            vf_filters = []
            if target_w:
                orig_vw, orig_vh = None, None
                if shutil.which("ffprobe"):
                    try:
                        probe = subprocess.check_output([
                            "ffprobe", "-v", "error", "-select_streams", "v:0",
                            "-show_entries", "stream=width,height", "-of", "csv=s=x:p=0", str(p)
                        ], text=True, stderr=subprocess.DEVNULL).strip()
                        if "x" in probe:
                            orig_vw, orig_vh = map(int, probe.split("x")[:2])
                    except Exception:
                        pass

                if orig_vw and orig_vw < target_w:
                    vf_filters.append(f"scale={target_w}:-2:flags=lanczos+accurate_rnd")
                    vf_filters.append("cas=0.85")
                    vf_filters.append("unsharp=5:5:0.8:5:5:0.0")
                elif orig_vw and orig_vw >= target_w:
                    vf_filters.append(f"scale={target_w}:-2:flags=lanczos+accurate_rnd")
                    vf_filters.append("cas=0.6")
                else:
                    vf_filters.append(f"scale={target_w}:-2:flags=lanczos+accurate_rnd")
                    vf_filters.append("cas=0.85")
                    vf_filters.append("unsharp=5:5:0.8:5:5:0.0")
            else:
                vf_filters.append("cas=0.55")

            if vf_filters:
                cmd.extend(["-vf", ",".join(vf_filters)])

            if target_ext == ".webm":
                cmd.extend(["-c:v", "libvpx-vp9", "-crf", "24", "-b:v", "0"])
            elif codec_idx == 0:
                cmd.extend(["-c:v", "libx264", "-preset", "medium", "-crf", "20", "-pix_fmt", "yuv420p"])
            elif codec_idx == 1:
                cmd.extend(["-c:v", "libvpx-vp9", "-crf", "24", "-b:v", "0"])
            elif codec_idx == 2:
                if "libsvtav1" in subprocess.getoutput("ffmpeg -encoders 2>/dev/null"):
                    cmd.extend(["-c:v", "libsvtav1", "-crf", "28", "-preset", "6"])
                else:
                    cmd.extend(["-c:v", "libx264", "-preset", "medium", "-crf", "20", "-pix_fmt", "yuv420p"])

            target_fps = 60 if fps_idx == 0 else 30
            cmd.extend(["-r", str(target_fps)])
            if has_audio:
                cmd.extend(["-map", "0:v:0", "-map", "1:a:0"])

        if target_ext == ".webm":
            cmd.extend(["-c:a", "libopus", "-b:a", "160k"])
        else:
            cmd.extend(["-c:a", "aac", "-b:a", "192k"])
        if has_audio:
            cmd.append("-shortest")

        cmd.append(str(temp_path))

        res = subprocess.run(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        if res.returncode == 0 and temp_path.exists() and temp_path.stat().st_size > 0:
            if dest_path.exists() and dest_path != p:
                dest_path.unlink()
            temp_path.rename(dest_path)
            if dest_path != p and p.exists():
                p.unlink()

            _mark_done(p)
            _mark_done(dest_path)
            notify(ss_tr("video_saved"), "", icon="video-x-generic-symbolic")
            return dest_path
    except Exception as e:
        print(f"Error processing video {file_path}: {e}", file=sys.stderr)
        if 'temp_path' in locals() and temp_path.exists():
            temp_path.unlink(missing_ok=True)
    finally:
        try:
            (LOCK_DIR / "audio_pending_mux.flag").unlink(missing_ok=True)
        except Exception:
            pass
        if audio_path and audio_path.exists():
            try:
                audio_path.unlink(missing_ok=True)
            except Exception:
                pass
        if lock_handle:
            try:
                fcntl.flock(lock_handle, fcntl.LOCK_UN)
                lock_handle.close()
            except Exception:
                pass
    return None

def run_daemon():
    print("[mac-screenshot-process] Daemon started, watching screenshot and screencast directories via inotify...")
    home = Path(os.path.expanduser("~"))
    watch_dirs = [
        home / "Зображення" / "Знімки екрана",
        home / "Obrazy" / "Zrzuty ekranu",
        home / "Pictures" / "Screenshots",
        home / "Відео" / "Трансляції з екрана",
        home / "Wideo" / "Nagrania ekranu",
        home / "Videos" / "Screencasts"
    ]

    for d in watch_dirs:
        d.mkdir(parents=True, exist_ok=True)

    # Track by inode and canonical path so we NEVER reprocess any file
    processed_inodes = set()
    processed_paths = set()

    # Pre-populate with all existing files on disk so they are never re-processed
    for d in watch_dirs:
        if d.exists():
            for f in d.iterdir():
                if f.is_file():
                    try:
                        processed_inodes.add(f.stat().st_ino)
                        processed_paths.add(str(f.resolve()))
                    except Exception:
                        pass

    # Try setting up inotify for 100% event-driven, zero-polling operation
    inotify_fd = -1
    wd_to_dir = {}
    libc = None
    try:
        import ctypes
        import select
        import struct

        libc = ctypes.CDLL("libc.so.6", use_errno=True)
        IN_CLOEXEC = 0o2000000
        IN_NONBLOCK = 0o0004000
        IN_CLOSE_WRITE = 0x00000008
        IN_MOVED_TO = 0x00000080

        inotify_fd = libc.inotify_init1(IN_CLOEXEC | IN_NONBLOCK)
        if inotify_fd >= 0:
            for d in watch_dirs:
                if d.exists():
                    wd = libc.inotify_add_watch(inotify_fd, str(d).encode("utf-8"), IN_CLOSE_WRITE | IN_MOVED_TO)
                    if wd >= 0:
                        wd_to_dir[wd] = d
    except Exception as e:
        print(f"[mac-screenshot-process] inotify init fallback: {e}", file=sys.stderr)
        inotify_fd = -1

    def handle_candidate(f):
        if not f.is_file() or f.name.startswith("."):
            return
        canonical_path = str(f.resolve())
        try:
            st = f.stat()
        except Exception:
            return

        # If this file was already processed or seen, skip it
        if st.st_ino in processed_inodes or canonical_path in processed_paths:
            return

        # Mark it immediately so subsequent loop cycles skip it
        processed_inodes.add(st.st_ino)
        processed_paths.add(canonical_path)

        # Wait for screenshot/screencast writer to finish writing
        prev_size = -1
        for _ in range(15):
            try:
                cur_size = f.stat().st_size
                if cur_size > 0 and cur_size == prev_size:
                    break
                prev_size = cur_size
            except Exception:
                pass
            time.sleep(0.1)

        # Process new file
        if f.suffix.lower() in [".png", ".jpg", ".jpeg", ".webp"]:
            if not f.stem.endswith("_temp") and "Originals" not in f.parts:
                time.sleep(0.25)
                if _was_recently_done(f):
                    return
                dest = process_image(f)
                if dest and dest.exists():
                    try:
                        processed_inodes.add(dest.stat().st_ino)
                        processed_paths.add(str(dest.resolve()))
                    except Exception:
                        pass
        elif f.suffix.lower() in [".webm", ".mp4", ".mkv"]:
            if not f.stem.endswith("_temp") and "Originals" not in f.parts:
                # If audio sidecar recording/muxing is active or pending, give `--file --audio-file` first claim
                for _ in range(15):
                    if not _audio_pending_or_active():
                        break
                    time.sleep(0.2)
                if _was_recently_done(f):
                    return
                dest = process_video(f)
                if dest and dest.exists():
                    try:
                        processed_inodes.add(dest.stat().st_ino)
                        processed_paths.add(str(dest.resolve()))
                    except Exception:
                        pass

    while True:
        try:
            if inotify_fd >= 0:
                # Kernel sleeps here until a file event actually occurs (0% CPU, 0 disk reads)
                r, _, _ = select.select([inotify_fd], [], [], 30.0)
                if r:
                    try:
                        data = os.read(inotify_fd, 4096)
                        offset = 0
                        while offset < len(data):
                            wd, mask, cookie, name_len = struct.unpack_from("iIII", data, offset)
                            offset += 16
                            if name_len > 0:
                                name_bytes = data[offset:offset + name_len]
                                offset += name_len
                                name = name_bytes.split(b"\x00", 1)[0].decode("utf-8", "ignore")
                                if wd in wd_to_dir and name:
                                    target_file = wd_to_dir[wd] / name
                                    if target_file.exists():
                                        handle_candidate(target_file)
                    except BlockingIOError:
                        pass
                else:
                    # Periodic 30s check: ensure newly created folders are watched
                    for d in watch_dirs:
                        if d.exists() and d not in wd_to_dir.values() and libc:
                            wd = libc.inotify_add_watch(inotify_fd, str(d).encode("utf-8"), IN_CLOSE_WRITE | IN_MOVED_TO)
                            if wd >= 0:
                                wd_to_dir[wd] = d
            else:
                # Low power fallback: scan with 5-second sleep instead of 0.5s
                for d in watch_dirs:
                    if not d.exists():
                        continue
                    for f in d.iterdir():
                        handle_candidate(f)
                time.sleep(5.0)
        except Exception as e:
            time.sleep(2.0)

def main():
    parser = argparse.ArgumentParser(description="macW1Y default Screenshot Processing Engine")
    parser.add_argument("--file", "-f", help="Path to screenshot or screencast file to process")
    parser.add_argument("--audio-file", help="Optional WAV sidecar path to mux into screencast video")
    parser.add_argument("--play-shutter", action="store_true", help="Play the macW1Y camera shutter sound")
    parser.add_argument("--pick-folder", action="store_true", help="Open GTK4 folder chooser dialog and print selected path")
    parser.add_argument("--record-audio", action="store_true", help="Record microphone and/or system monitor audio to --out WAV")
    parser.add_argument("--out", help="Output WAV path for --record-audio")
    parser.add_argument("--mic", help="Pulse/PipeWire source name for --record-audio")
    parser.add_argument("--system-audio", action="store_true", help="Include default sink monitor in --record-audio")
    parser.add_argument("--daemon", action="store_true", help="Run background watcher daemon")
    args = parser.parse_args()

    if args.play_shutter:
        play_shutter()
        return

    if args.pick_folder:
        sys.exit(pick_folder_dialog())

    if args.record_audio:
        sys.exit(record_audio_stream(args.out, mic_device=args.mic, system_audio=args.system_audio))

    if args.daemon:
        run_daemon()
        return

    if args.file:
        p = Path(args.file)
        if p.suffix.lower() in [".png", ".jpg", ".jpeg", ".webp"]:
            process_image(p)
        elif p.suffix.lower() in [".webm", ".mp4", ".mkv"]:
            process_video(p, audio_file=args.audio_file)
        return

    parser.print_help()

if __name__ == "__main__":
    main()
