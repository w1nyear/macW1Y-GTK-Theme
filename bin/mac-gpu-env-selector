#!/bin/bash
# mac-gpu-env-selector: Applies GPU environment based on power settings (mac-gpu-targets.json)
# Usage: source mac-gpu-env-selector [app_name_or_path]

TARGET_HINT="${1:-}"
CONFIG_FILE="$HOME/.config/mac-gpu-targets.json"
[ -f "$CONFIG_FILE" ] || CONFIG_FILE="/etc/mac-gpu-targets.json"

IS_GAME=0
if echo "$TARGET_HINT" | grep -qi -E "game|steam|lutris|heroic|epic|gog|darksouls|cyberpunk|gta|witcher|cs2|cstrike|cstrike_online|rdr|elden"; then
    IS_GAME=1
fi

TARGET_GPU=""
if [ -f "$CONFIG_FILE" ]; then
    if [ "$IS_GAME" -eq 1 ]; then
        TARGET_GPU=$(grep -o '"games"[[:space:]]*:[[:space:]]*[0-9]*' "$CONFIG_FILE" 2>/dev/null | grep -o '[0-9]*$')
    fi
    if [ -z "$TARGET_GPU" ]; then
        TARGET_GPU=$(grep -o '"apps"[[:space:]]*:[[:space:]]*[0-9]*' "$CONFIG_FILE" 2>/dev/null | grep -o '[0-9]*$')
    fi
    if [ -z "$TARGET_GPU" ]; then
        TARGET_GPU=$(grep -o '"system"[[:space:]]*:[[:space:]]*[0-9]*' "$CONFIG_FILE" 2>/dev/null | grep -o '[0-9]*$')
    fi
fi

if [ -z "$TARGET_GPU" ] && [ -f "/etc/mac-gpu.state" ]; then
    STATE=$(cat /etc/mac-gpu.state 2>/dev/null)
    if [ "$STATE" = "nvidia" ] || [ "$STATE" = "apps_nvidia" ]; then
        TARGET_GPU=1
    else
        TARGET_GPU=0
    fi
fi

[ -z "$TARGET_GPU" ] && TARGET_GPU=0

if [ "$TARGET_GPU" -eq 1 ] && command -v nvidia-smi >/dev/null 2>&1; then
    export __NV_PRIME_RENDER_OFFLOAD=1
    export __GLX_VENDOR_LIBRARY_NAME=nvidia
    export PROTON_ENABLE_NVAPI=1
    export DXVK_ENABLE_NVAPI=1
    export PROTON_HIDE_NVIDIA_GPU=0
    export __GL_SYNC_TO_VBLANK=0
    export vblank_mode=0
    export DXVK_FRAME_RATE=0
    export MANGOHUD_CONFIG="fps_limit=0"
    unset DRI_PRIME
    unset MESA_VK_DEVICE_SELECT
else
    unset __NV_PRIME_RENDER_OFFLOAD
    unset __GLX_VENDOR_LIBRARY_NAME
    unset __VK_LAYER_NV_optimus
    unset PROTON_ENABLE_NVAPI
    unset DXVK_ENABLE_NVAPI
    unset DXVK_FRAME_RATE
    unset MESA_VK_DEVICE_SELECT
    export DRI_PRIME=0
    export MESA_LOADER_DRIVER_OVERRIDE=iris
fi
