            (self.tr("menu_close_window", "Close Window"), "app.close", "⌘W"),
        ]
        self.btn_file = self._make_menu_btn(self.tr("menu_file", "File"), items_file)
        bar.append(self.btn_file)

        items_edit = [
            (self.tr("menu_undo", "Undo"), "app.undo", "⌘Z"),
