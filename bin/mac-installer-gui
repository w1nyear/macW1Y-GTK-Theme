# ------------------------------------------------------------------------------
# Main Application Window
# ------------------------------------------------------------------------------
class MacRecoveryInstallerWindow(Gtk.ApplicationWindow):
    def __init__(self, app, action_override=None, preview_screen=None, preview_modal=None):
        super().__init__(application=app)
        self.set_title("Встановлення macW1Y")
        self.set_decorated(False)
        self.fullscreen()

        self.username = get_target_username()
        self.display_name = get_user_display_name(self.username)
        self.avatar_path = get_user_avatar_path(self.username)
        self.version = get_modpack_version()
        self.disk_info = get_disk_capacity_info()

        self.cached_password = ""
        self.selected_action = action_override or "install"
        self.preview_screen = preview_screen
        self.preview_modal = preview_modal

        self.worker_thread = None
        self.worker_cancelled = False
        self.worker_process = None

        self._build_ui()
        self._setup_keybindings()

        if self.preview_screen:
            self.switch_to_screen(self.preview_screen)

        if self.preview_modal:
            GLib.timeout_add(200, self._trigger_preview_modal)

        for arg in sys.argv:
            if arg.startswith("--open-menu="):
                m_name = arg.split("=")[1]
                GLib.timeout_add(200, lambda name=m_name: self._popup_menu_by_name(name))

    def _popup_menu_by_name(self, name):
        mapping = {
            "apple": getattr(self, "btn_apple", None),
            "file": getattr(self, "btn_file", None),
            "edit": getattr(self, "btn_edit", None),
            "utils": getattr(self, "btn_utils", None),
            "win": getattr(self, "btn_win", None),
        }
        btn = mapping.get(name)
        if btn:
            btn.set_active(True)
        return GLib.SOURCE_REMOVE

    def _trigger_preview_modal(self):
        m = self.preview_modal
        if m in ["password", "screen2"]:
            self._show_modal_password()
        elif m in ["loading", "screen5"]:
            self._show_modal_loading_info()
        elif m in ["terms_confirm", "screen7"]:
            self._show_modal_terms_confirm()
        elif m in ["admin", "padlock", "screen9", "screen11"]:
            self._show_modal_admin_padlock()
        elif m in ["cancel", "screen13"]:
            self._show_modal_cancel_confirm()
        return GLib.SOURCE_REMOVE

    def _build_ui(self):
        root_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        root_box.add_css_class("mac-recovery-root")
        root_box.add_css_class("mac-desktop-backdrop")
        self.set_child(root_box)

        # 1. Top Menubar
        menubar = self._create_menubar()
        root_box.append(menubar)

        # 2. Main Content Area (Centering Container)
        center_area = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        center_area.set_vexpand(True)
        center_area.set_hexpand(True)
        center_area.set_halign(Gtk.Align.CENTER)
        center_area.set_valign(Gtk.Align.CENTER)
        root_box.append(center_area)

        # Overlay container for Dialog Card + Modal Sheets
        self.card_overlay = Gtk.Overlay()
        center_area.append(self.card_overlay)

        # Dialog Card
        self.card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        self.card.add_css_class("mac-recovery-card")
        self.card_overlay.set_child(self.card)

        # Stack for screens
        self.stack = Gtk.Stack()
        self.stack.set_transition_type(Gtk.StackTransitionType.CROSSFADE)
        self.stack.set_transition_duration(250)
        self.card.append(self.stack)

        # Modal sheet container in overlay
        self.modal_dim = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        self.modal_dim.add_css_class("mac-modal-dim")
        self.modal_dim.set_halign(Gtk.Align.FILL)
        self.modal_dim.set_valign(Gtk.Align.FILL)
        self.modal_dim.set_visible(False)
        self.card_overlay.add_overlay(self.modal_dim)

        self.modal_sheet_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        self.modal_sheet_box.set_halign(Gtk.Align.CENTER)
        self.modal_sheet_box.set_valign(Gtk.Align.CENTER)
        self.modal_sheet_box.set_vexpand(True)
        self.modal_sheet_box.set_hexpand(True)
        self.modal_dim.append(self.modal_sheet_box)

        # Build individual screens
        self.stack.add_named(self._build_screen_user(), "screen_user")
        self.stack.add_named(self._build_screen_options(), "screen_options")
        self.stack.add_named(self._build_screen_welcome(), "screen_welcome")
        self.stack.add_named(self._build_screen_terms(), "screen_terms")
        self.stack.add_named(self._build_screen_disk(), "screen_disk")
        self.stack.add_named(self._build_screen_progress(), "screen_progress")
        self.stack.add_named(self._build_screen_reboot(), "screen_reboot")

        self.stack.set_visible_child_name("screen_user")

    def _setup_keybindings(self):
        controller = Gtk.EventControllerKey()
        controller.connect("key-pressed", self._on_key_pressed)
        self.add_controller(controller)

    def _on_key_pressed(self, controller, keyval, keycode, state):
        if keyval == Gdk.KEY_Escape:
            if self.modal_dim.get_visible():
                self.hide_modal()
            return True
        return False

    def _create_menubar(self):
        bar = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=2)
        bar.add_css_class("mac-recovery-menubar")

        # Apple Icon
        menu_apple = Gio.Menu()
        menu_apple.append("Про macW1Y", "app.about")
        menu_apple.append("Перезавантажити...", "app.reboot")
        menu_apple.append("Вимкнути комп'ютер...", "app.poweroff")

        apple_svg = os.path.join(ASSETS_DIR, "apple_logo.svg")
        if os.path.exists(apple_svg):
            img_apple = Gtk.Image.new_from_file(apple_svg)
            img_apple.set_pixel_size(15)
            self.btn_apple = self._make_menu_btn(None, menu_apple, icon_widget=img_apple)
        else:
            self.btn_apple = self._make_menu_btn("", menu_apple, is_bold=True)
        bar.append(self.btn_apple)

        # App Title
        lbl_app = Gtk.Label(label="Встановлення macW1Y")
        lbl_app.add_css_class("mac-menubar-title")
        bar.append(lbl_app)

        # Menus: Файл, Правка, Утиліти, Вікно
        menu_file = Gio.Menu()
        menu_file.append("Новий образ...", "app.noop")
        menu_file.append("Закрити вікно", "app.close")
        self.btn_file = self._make_menu_btn("Файл", menu_file)
        bar.append(self.btn_file)

        menu_edit = Gio.Menu()
        menu_edit.append("Відмінити", "app.undo")
        menu_edit.append("Повторити", "app.redo")
        self.btn_edit = self._make_menu_btn("Правка", menu_edit)
        bar.append(self.btn_edit)

        menu_utils = Gio.Menu()
        menu_utils.append("Термінал...", "app.terminal")
        menu_utils.append("Інформація про систему...", "app.sysinfo")
        self.btn_utils = self._make_menu_btn("Утиліти", menu_utils)
        bar.append(self.btn_utils)

        menu_win = Gio.Menu()
        menu_win.append("Мінімізувати", "app.minimize")
        menu_win.append("Збільшити", "app.noop")
        self.btn_win = self._make_menu_btn("Вікно", menu_win)
        bar.append(self.btn_win)

        spacer = Gtk.Box()
        spacer.set_hexpand(True)
        bar.append(spacer)

        now_str = time.strftime("%d %b  %H:%M")
        lbl_clock = Gtk.Label(label=now_str)
        lbl_clock.add_css_class("mac-menubar-item")
        bar.append(lbl_clock)

        return bar

    def _make_menu_btn(self, label_text, menu_model, is_bold=False, icon_widget=None):
        btn = Gtk.MenuButton()
        btn.set_has_frame(False)
        if hasattr(btn, "set_always_show_arrow"):
            btn.set_always_show_arrow(False)
        if icon_widget:
            btn.set_child(icon_widget)
        else:
            lbl = Gtk.Label(label=label_text)
            if is_bold:
                lbl.add_css_class("mac-menubar-title")
            else:
                lbl.add_css_class("mac-menubar-item")
            btn.set_child(lbl)
        if menu_model:
            btn.set_menu_model(menu_model)
        btn.add_css_class("mac-menubar-button")
        return btn

    # --------------------------------------------------------------------------
    # Modal Sheet Management
    # --------------------------------------------------------------------------
    def show_modal(self, widget):
        while child := self.modal_sheet_box.get_first_child():
            self.modal_sheet_box.remove(child)
        self.modal_sheet_box.append(widget)
        self.modal_dim.set_visible(True)

    def hide_modal(self):
        self.modal_dim.set_visible(False)
        while child := self.modal_sheet_box.get_first_child():
            self.modal_sheet_box.remove(child)

    def switch_to_screen(self, screen_name):
        self.hide_modal()
        target = screen_name if screen_name.startswith("screen_") else f"screen_{screen_name}"
        self.stack.set_visible_child_name(target)

