    def _animate_icon_size(self, start_size, target_size, duration=0.35):
        if hasattr(self, "_icon_anim_tick") and self._icon_anim_tick:
            self.remove_tick_callback(self._icon_anim_tick)
            self._icon_anim_tick = 0

        start_time = time.time()

        def on_tick(widget, frame_clock):
            elapsed = time.time() - start_time
            tau = min(1.0, elapsed / duration)
            p = 1.0 - math.pow(1.0 - tau, 3)
            cur_size = int(start_size + (target_size - start_size) * p)
            self.img_wizard_icon.set_pixel_size(cur_size)
            if tau >= 1.0:
                self.img_wizard_icon.set_pixel_size(target_size)
                self._icon_anim_tick = 0
                return False
            return True

        self._icon_anim_tick = self.add_tick_callback(on_tick)

    def morph_welcome_to_terms(self, animated=True):
        self.wizard_mode = "terms"
        self.lbl_wizard_sub.set_label(self.tr("installer_terms_title", "License Agreement"))
        self.btn_wizard_action.set_label(self.tr("installer_agree", "Agree"))

        if not animated:
            self.img_wizard_icon.set_pixel_size(130)
            self.rev_terms.set_reveal_child(True)
            self.rev_left_btn.set_reveal_child(True)
            return

        self._animate_icon_size(210, 130, duration=0.35)
        self.rev_terms.set_reveal_child(True)
        self.rev_left_btn.set_reveal_child(True)

    def morph_terms_to_welcome(self, animated=True):
        self.wizard_mode = "welcome"
        ver = get_package_version()
        is_uk = getattr(self, "selected_language", "uk") == "uk"
        if getattr(self, "selected_action", "install") == "clean_update":
            sub_text = f"Для налаштування оновлення macW1Y {ver} натисніть «Продовжити»." if is_uk else f"To configure macW1Y {ver} update, click Continue."
        else:
            sub_text = self.tr("installer_wizard_sub", "To configure macW1Y installation, click Continue.")
        self.lbl_wizard_sub.set_label(sub_text)
        self.lbl_wizard_title.set_label(f"macW1Y {ver}")
        self.btn_wizard_action.set_label(self.tr("installer_continue_btn", "Continue"))

        if not animated:
            self.img_wizard_icon.set_pixel_size(210)
            self.rev_terms.set_reveal_child(False)
            self.rev_left_btn.set_reveal_child(False)
            return

        self._animate_icon_size(130, 210, duration=0.35)
        self.rev_terms.set_reveal_child(False)
        self.rev_left_btn.set_reveal_child(False)

    def _on_wizard_action_clicked(self, btn):
        if self.wizard_mode == "welcome":
            self._show_modal_loading_info()
        elif self.wizard_mode == "terms":
            is_mock = "--preview" in sys.argv or "--mock-installer" in sys.argv or "-let_me_try_bradar" in sys.argv or "--let_me_try_bradar" in sys.argv or os.environ.get("MAC_MOCK_INSTALLER") == "1"
            if self.cached_password or is_mock or os.environ.get("MAC_INSTALLER_SCRIPT"):
                self.switch_to_screen("screen_progress")
                self._start_worker_execution()
            else:
                self._show_modal_admin_padlock()

    # --------------------------------------------------------------------------
    # Screen 5: Loading Installer Info Modal (Photo 5)
    # --------------------------------------------------------------------------
    def _show_modal_loading_info(self):
        # Fade out welcome title & subtitle while loading to prevent overlap/collision
        if hasattr(self, "lbl_wizard_title"):
            self.lbl_wizard_title.set_opacity(0.0)
        if hasattr(self, "lbl_wizard_sub"):
            self.lbl_wizard_sub.set_opacity(0.0)

        sheet = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=14)
        sheet.add_css_class("mac-modal-sheet")
        sheet.add_css_class("mac-loading-pill")
        sheet.set_halign(Gtk.Align.CENTER)
        sheet.set_valign(Gtk.Align.CENTER)

        spinner = Gtk.Spinner()
        spinner.set_size_request(22, 22)
        spinner.start()
        sheet.append(spinner)

        lbl = Gtk.Label(label="Завантаження інформації про інсталяцію...")
        lbl.add_css_class("mac-modal-title")
        lbl.set_valign(Gtk.Align.CENTER)
        sheet.append(lbl)

        self.show_modal(sheet)

        if not ("--preview" in sys.argv and "--modal" in sys.argv):
            GLib.timeout_add(1000, self._finish_loading_info)

    def _finish_loading_info(self):
        self.hide_modal()
        if hasattr(self, "lbl_wizard_title"):
            self.lbl_wizard_title.set_opacity(1.0)
        if hasattr(self, "lbl_wizard_sub"):
            self.lbl_wizard_sub.set_opacity(1.0)
        self.morph_welcome_to_terms(animated=True)
        return GLib.SOURCE_REMOVE

