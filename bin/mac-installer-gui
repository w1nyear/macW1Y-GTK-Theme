import mac_i18n

def _load_supported_languages():
    cat_path = os.path.join(SCRIPT_DIR, "config", "i18n", "catalog.json")
    if os.path.exists(cat_path):
        try:
            with open(cat_path, "r", encoding="utf-8") as f:
                data = json.load(f)
            langs = []
            for item in data.get("catalog", []):
                native = item.get("native") or item.get("name")
                cap_native = native[0].upper() + native[1:] if len(native) > 1 else native
                langs.append({
                    "code": item["code"],
                    "native": cap_native,
                    "name": item.get("name"),
                    "rtl": item.get("rtl", False)
                })
            return langs
        except Exception:
            pass
    return [
        {"code": "uk", "native": "Українська", "name": "Ukrainian"},
        {"code": "en", "native": "English", "name": "English"},
    ]

SUPPORTED_LANGUAGES = _load_supported_languages()

