        lbl_rst = Gtk.Label(label="Перезавантажити")
        lbl_rst.add_css_class("mac-subtitle")
        b_restart.append(lbl_rst)
        nav_box.append(b_restart)

        b_next = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        b_next.set_halign(Gtk.Align.CENTER)
        btn_next = Gtk.Button()
        btn_next.add_css_class("mac-circle-nav-btn")
        btn_next.set_has_frame(False)
        btn_next.set_halign(Gtk.Align.CENTER)
        img_nxt = Gtk.Image.new_from_file(os.path.join(ASSETS_DIR, "btn_next.svg"))
        img_nxt.set_pixel_size(36)
        btn_next.set_child(img_nxt)
        btn_next.connect("clicked", lambda b: self._show_modal_password())
        b_next.append(btn_next)
        lbl_nxt = Gtk.Label(label="Далі")
        lbl_nxt.add_css_class("mac-subtitle")
        b_next.append(lbl_nxt)
        nav_box.append(b_next)

