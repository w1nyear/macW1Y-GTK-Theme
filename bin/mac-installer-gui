    # --------------------------------------------------------------------------
    # Screen 9 & 11: Admin Privilege Escalation Modal (Photos 9 & 11)
    # --------------------------------------------------------------------------
    def _show_modal_admin_padlock(self):
        sheet = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14)
        sheet.add_css_class("mac-modal-sheet")

        top_h = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=14)
        img_lock = Gtk.Image.new_from_file(os.path.join(ASSETS_DIR, "padlock.svg"))
        img_lock.set_pixel_size(52)
        top_h.append(img_lock)

        txt_v = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        lbl_t = Gtk.Label(label="При встановленні робиться спроба змінити системні налаштування.")
        lbl_t.add_css_class("mac-title-medium")
        lbl_t.set_wrap(True)
        lbl_t.set_max_width_chars(38)
        lbl_t.set_halign(Gtk.Align.START)
        txt_v.append(lbl_t)

        lbl_s = Gtk.Label(label="Щоб дозволити цю дію, введіть пароль адміністратора:")
        lbl_s.add_css_class("mac-subtitle")
        lbl_s.set_halign(Gtk.Align.START)
        txt_v.append(lbl_s)
        top_h.append(txt_v)
        sheet.append(top_h)

        row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        row.set_margin_top(4)
        lbl_p = Gtk.Label(label="Пароль:")
        lbl_p.add_css_class("mac-subtitle")
        row.append(lbl_p)

        entry = Gtk.Entry()
        entry.add_css_class("mac-entry")
        entry.set_visibility(False)
        entry.set_invisible_char("•")
        entry.set_input_purpose(Gtk.InputPurpose.FREE_FORM)
        entry.set_hexpand(True)
        entry.set_icon_from_icon_name(Gtk.EntryIconPosition.SECONDARY, "view-reveal-symbolic")
        entry.set_icon_activatable(Gtk.EntryIconPosition.SECONDARY, True)

        def on_padlock_reveal(e, pos):
            if pos == Gtk.EntryIconPosition.SECONDARY:
                v = not e.get_visibility()
                e.set_visibility(v)
                e.set_icon_from_icon_name(
                    Gtk.EntryIconPosition.SECONDARY,
                    "view-conceal-symbolic" if v else "view-reveal-symbolic"
                )
        entry.connect("icon-press", on_padlock_reveal)

        if self.cached_password:
            entry.set_text(self.cached_password)

        entry.connect("notify::has-focus", lambda e, p: GLib.idle_add(lambda: e.select_region(-1, -1)))
        row.append(entry)
        sheet.append(row)

        lbl_err = Gtk.Label()
        lbl_err.add_css_class("mac-subtitle")
        lbl_err.set_visible(False)
        sheet.append(lbl_err)

        btn_row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
        btn_row.set_halign(Gtk.Align.END)
        btn_row.set_margin_top(8)

        btn_cancel = Gtk.Button(label="Скасувати")
        btn_cancel.add_css_class("mac-btn-secondary")
        btn_cancel.connect("clicked", lambda b: self.hide_modal())
        btn_row.append(btn_cancel)

        btn_allow = Gtk.Button(label="Дозволити")
        btn_allow.add_css_class("mac-btn-primary")

        def on_allow():
            pwd = entry.get_text()
            if not pwd:
                lbl_err.set_markup("<span color='#ff453a'>Введіть пароль адміністратора.</span>")
                lbl_err.set_visible(True)
                return

            btn_allow.set_sensitive(False)
            btn_allow.set_label("Перевірка...")

            def check_thread():
                try:
                    p = subprocess.run(["sudo", "-S", "-v"],
                                       input=(pwd + "\n").encode(),
                                       stdout=subprocess.DEVNULL,
                                       stderr=subprocess.DEVNULL,
                                       check=False)
                    ok = (p.returncode == 0)
                except Exception:
                    ok = False

                def finish():
                    btn_allow.set_sensitive(True)
                    btn_allow.set_label("Дозволити")
                    if ok or "--preview" in sys.argv:
                        self.cached_password = pwd
                        self.hide_modal()
                        self.switch_to_screen("screen_progress")
                        self._start_worker_execution()
                    else:
                        lbl_err.set_markup("<span color='#ff453a'>Невірний пароль. Спробуйте ще раз.</span>")
                        lbl_err.set_visible(True)
                        entry.grab_focus()
                        entry.set_position(-1)
                        entry.select_region(-1, -1)

                GLib.idle_add(finish)

            threading.Thread(target=check_thread, daemon=True).start()

        btn_allow.connect("clicked", lambda b: on_allow())
        entry.connect("activate", lambda e: on_allow())
        btn_row.append(btn_allow)
        sheet.append(btn_row)

        self.show_modal(sheet)
        GLib.timeout_add(100, lambda: (entry.grab_focus(), entry.set_position(-1), entry.select_region(-1, -1), False)[-1])

