.mac-lang-item.selected label,
button.mac-lang-item.selected:hover label,
.mac-lang-item.selected:hover label {
    color: #ffffff;
    font-weight: 600;
}
"""

# ------------------------------------------------------------------------------
# Popover Menu with default / macW1Y Sliding Hover Pill & Frosted Glass
# ------------------------------------------------------------------------------
class MacMenuPopover(Gtk.Popover):
    """
    Authentic macW1Y Menubar Popover:
    - Frosted glass backdrop (dark tint + subtle light edge + deep drop shadow)
    - System accent color for the sliding selection indicator
    - Rounded menu container (24px) and pill-shaped menu items (border-radius: 9999px)
    - Sliding hover pill indicator that smoothly glides from item to item on cursor movement
    - Subtle fade & scale entrance and exit animations
    """
    def __init__(self, items, parent_btn=None):
        super().__init__()
        self.set_has_arrow(False)
        if "--preview" in sys.argv or any(a.startswith("--open-menu=") for a in sys.argv):
            self.set_autohide(False)
        else:
            self.set_autohide(True)
        self.add_css_class("mac-popover-menu")
        self.parent_btn = parent_btn
        self.is_closing = False

        self.overlay = Gtk.Overlay()

        # Sliding pill background indicator
        self.pill = Gtk.Box()
        self.pill.add_css_class("mac-menu-hover-pill")
        self.pill.set_can_target(False)
        self.pill.set_hexpand(True)
        self.pill.set_valign(Gtk.Align.START)
        self.pill.set_halign(Gtk.Align.FILL)
        self.pill.set_opacity(0.0)
        self.pill.set_margin_start(4)
        self.pill.set_margin_end(4)

        self.bg_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        self.bg_box.append(self.pill)
        self.overlay.set_child(self.bg_box)

        # Items container
        self.items_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        self.items_box.add_css_class("mac-menu-items-box")
        self.items_box.set_margin_top(4)
        self.items_box.set_margin_bottom(4)
        self.items_box.set_margin_start(4)
        self.items_box.set_margin_end(4)

        self.overlay.add_overlay(self.items_box)
        self.overlay.set_measure_overlay(self.items_box, True)
        self.set_child(self.overlay)

        # Animation State
        self.current_y = 0.0
        self.target_y = 0.0
        self.current_h = 26.0
        self.target_h = 26.0
        self.current_opacity = 0.0
        self.target_opacity = 0.0
        self.tick_id = 0
        self.item_buttons = []

        for item in items:
            if item is None:
                # Separator
                sep = Gtk.Box()
                sep.add_css_class("mac-menu-separator")
                self.items_box.append(sep)
                continue

            if isinstance(item, tuple):
                label_text = item[0]
                action_name = item[1] if len(item) > 1 else None
                shortcut = item[2] if len(item) > 2 else None
                is_header = item[3] if len(item) > 3 else False
            else:
                label_text = str(item)
                action_name = None
                shortcut = None
                is_header = False

            if is_header:
                lbl = Gtk.Label(label=label_text)
                lbl.add_css_class("mac-menu-header-item")
                lbl.set_halign(Gtk.Align.START)
                self.items_box.append(lbl)
                continue

            btn = Gtk.Button()
            btn.set_has_frame(False)
            btn.add_css_class("mac-menu-item-btn")

            row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=14)
            lbl = Gtk.Label(label=label_text)
            lbl.set_halign(Gtk.Align.START)
            lbl.set_hexpand(True)
            row.append(lbl)

            if shortcut:
                lbl_sc = Gtk.Label(label=shortcut)
                lbl_sc.add_css_class("mac-menu-shortcut")
                lbl_sc.set_halign(Gtk.Align.END)
                row.append(lbl_sc)

            btn.set_child(row)

            if action_name:
                btn.connect("clicked", lambda b, act=action_name: self._on_item_activated(act))

            # Motion controller on button to glide highlight pill
            motion = Gtk.EventControllerMotion()
            motion.connect("enter", lambda c, x, y, b=btn: self.glide_to(b))
            btn.add_controller(motion)

            self.items_box.append(btn)
            self.item_buttons.append(btn)

        # Motion controller on items container to fade out when leaving
        box_motion = Gtk.EventControllerMotion()
        box_motion.connect("leave", lambda c: self.glide_leave())
        self.items_box.add_controller(box_motion)

    def _on_item_activated(self, action_name):
        self.animated_popdown(lambda: self._dispatch_action(action_name))

    def _dispatch_action(self, action_name):
        app = Gio.Application.get_default()
        if app and hasattr(app, "lookup_action"):
            act_id = action_name.replace("app.", "")
            act = app.lookup_action(act_id)
            if act:
                act.activate(None)

    def glide_to(self, btn):
        self.active_btn = btn
        ok, bounds = btn.compute_bounds(self.overlay)
        if ok and bounds.get_height() > 15:
            ty = max(0.0, float(bounds.get_y()))
            th = float(bounds.get_height())
        else:
            ty = 4.0
            th = 32.0
            if hasattr(self, "items_box"):
                child = self.items_box.get_first_child()
                while child and child != btn:
                    _, ch, _, _ = child.measure(Gtk.Orientation.VERTICAL, -1)
                    ty += max(ch, 1) + 2
                    child = child.get_next_sibling()
            _, bh, _, _ = btn.measure(Gtk.Orientation.VERTICAL, -1)
            th = max(bh, 30)

        self.target_y = ty
        self.target_h = th
        self.target_opacity = 1.0
        if self.current_opacity == 0.0:
            self.current_y = self.target_y
            self.current_h = self.target_h
            self.pill.set_margin_top(int(round(self.current_y)))
            self.pill.set_size_request(-1, max(26, int(round(self.current_h))))
            self.current_opacity = 1.0
            self.pill.set_opacity(1.0)
        self._start_anim()

    def glide_leave(self):
        self.target_opacity = 0.0
        self._start_anim()

    def _start_anim(self):
        if self.tick_id == 0:
            self.tick_id = self.add_tick_callback(self._on_tick)

    def _on_tick(self, widget, frame_clock):
        self.current_y += (self.target_y - self.current_y) * 0.38
        self.current_h += (self.target_h - self.current_h) * 0.38
        self.current_opacity += (self.target_opacity - self.current_opacity) * 0.35

        self.pill.set_margin_top(int(round(self.current_y)))
        self.pill.set_size_request(-1, max(26, int(round(self.current_h))))
        self.pill.set_opacity(self.current_opacity)

        if (abs(self.target_y - self.current_y) < 0.4 and 
            abs(self.target_h - self.current_h) < 0.4 and 
            abs(self.target_opacity - self.current_opacity) < 0.02):
            self.current_y = self.target_y
            self.current_h = self.target_h
            self.current_opacity = self.target_opacity
            self.pill.set_margin_top(int(round(self.current_y)))
            self.pill.set_size_request(-1, max(26, int(round(self.current_h))))
            self.pill.set_opacity(self.current_opacity)
            self.tick_id = 0
            return GLib.SOURCE_REMOVE

        return GLib.SOURCE_CONTINUE

    def animated_popdown(self, on_closed=None):
        if self.is_closing:
            return
        self.is_closing = True
        self.add_css_class("mac-popover-closing")
        def _finish():
            self.popdown()
            self.remove_css_class("mac-popover-closing")
            self.is_closing = False
            if on_closed:
                on_closed()
            return GLib.SOURCE_REMOVE
        GLib.timeout_add(110, _finish)

# ------------------------------------------------------------------------------
# LiquidGlass Card Overlay & Modal Sheet Host
# ------------------------------------------------------------------------------
class MacGlassOverlay(Gtk.Overlay):
    """
    LiquidGlass Container Overlay:
    Captures underlying recovery card into a render node when an alert or modal is open,
    supplying it to MacModalSheetHost for authentic 5px Gaussian backdrop blur.
    """
    def __init__(self, owner=None):
        super().__init__()
        self.owner = owner

    def do_snapshot(self, snapshot):
        card = self.get_child()
        if not card:
            return

        modal_dim = getattr(self.owner, 'modal_dim', None)
        modal_host = getattr(self.owner, 'modal_sheet_host', None)
        modal_visible = (
            modal_dim is not None and
            modal_dim.get_visible() and
            modal_host is not None and
            modal_host.opacity_val > 0.01
        )

        if not modal_visible:
            child = self.get_first_child()
            while child:
                self.snapshot_child(child, snapshot)
                child = child.get_next_sibling()
            return

        # Snapshot background card into render node
        card_snap = Gtk.Snapshot()
        self.snapshot_child(card, card_snap)
        card_node = card_snap.to_node()
        if not card_node:
            child = self.get_first_child()
            while child:
                self.snapshot_child(child, snapshot)
                child = child.get_next_sibling()
            return

        # Supply background node to host
        modal_host.backdrop_node = card_node

        # Draw card in base snapshot
        snapshot.append_node(card_node)

        # Draw overlay children (dim container and modal sheet with LiquidGlass backdrop blur)
        child = card.get_next_sibling()
        while child:
            self.snapshot_child(child, snapshot)
            child = child.get_next_sibling()


class MacModalSheetHost(Gtk.Box):
    """
    Host container for Alert Modals supporting authentic macW1Y spring pop entrance,
    smooth ease-in scale down exit, and real-time LiquidGlass 5px backdrop blur.
    """
    def __init__(self):
        super().__init__(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        self.set_halign(Gtk.Align.CENTER)
        self.set_valign(Gtk.Align.CENTER)
        self.set_vexpand(True)
        self.set_hexpand(True)
        self.scale_val = 1.0
        self.opacity_val = 1.0
        self._anim_tick_id = 0
        self._anim_state = "idle"
        self._start_time = 0
        self._duration = 0.32
        self._on_finish_cb = None
        self.backdrop_node = None

    def set_content(self, widget):
        while child := self.get_first_child():
            self.remove(child)
        if widget:
            self.append(widget)

    def _render_liquid_glass_backdrop(self, snapshot, child):
        if not getattr(self, "backdrop_node", None):
            return
        try:
            ok, bounds = child.compute_bounds(self)
            if not ok or bounds.size.width <= 2 or bounds.size.height <= 2:
                return

            # LiquidGlass 5px Gaussian backdrop blur
            blur_node = Gsk.BlurNode.new(self.backdrop_node, 5.0)

            is_pill = child.has_css_class("mac-loading-pill")
            corner_radius = (bounds.size.height / 2.0) if is_pill else 28.0
            rrect = Gsk.RoundedRect()
            rrect.init_from_rect(bounds, corner_radius)

            snapshot.push_rounded_clip(rrect)
            snapshot.save()

            card_overlay = self.get_ancestor(Gtk.Overlay)
            if card_overlay:
                ok_h, h_bounds = self.compute_bounds(card_overlay)
                if ok_h:
                    snapshot.translate(Graphene.Point().init(-h_bounds.origin.x, -h_bounds.origin.y))

            snapshot.append_node(blur_node)
            snapshot.restore()
            snapshot.pop()
        except Exception:
            pass

    def do_snapshot(self, snapshot):
        w = self.get_width()
        h = self.get_height()
        need_transform = (self.scale_val != 1.0 or self.opacity_val < 1.0)
        if need_transform:
            snapshot.save()
            if self.opacity_val < 1.0:
                snapshot.push_opacity(max(0.0, min(1.0, self.opacity_val)))
            if self.scale_val != 1.0:
                cx = w / 2.0
                cy = h / 2.0
                snapshot.translate(Graphene.Point().init(cx, cy))
                snapshot.scale(self.scale_val, self.scale_val)
                snapshot.translate(Graphene.Point().init(-cx, -cy))

        child = self.get_first_child()
        if child:
            self._render_liquid_glass_backdrop(snapshot, child)

        while child:
            self.snapshot_child(child, snapshot)
            child = child.get_next_sibling()

        if need_transform:
            if self.opacity_val < 1.0:
                snapshot.pop()
            snapshot.restore()

    def start_open_animation(self):
        self._on_finish_cb = None
        if self._anim_tick_id:
            self.remove_tick_callback(self._anim_tick_id)
            self._anim_tick_id = 0
        self._anim_state = "opening"
        self._start_time = time.time()
        self._duration = 0.32
        self.scale_val = 0.78
        self.opacity_val = 0.0
        self.queue_draw()
        self._anim_tick_id = self.add_tick_callback(self._on_tick)

    def start_close_animation(self, on_finish=None):
        if self._anim_tick_id:
            self.remove_tick_callback(self._anim_tick_id)
            self._anim_tick_id = 0
        self._on_finish_cb = on_finish
        self._anim_state = "closing"
        self._start_time = time.time()
        self._duration = 0.16
        self.queue_draw()
        self._anim_tick_id = self.add_tick_callback(self._on_tick)

    def _on_tick(self, widget, frame_clock):
        elapsed = time.time() - self._start_time
        tau = min(1.0, elapsed / self._duration)

        if self._anim_state == "opening":
            # Spring formula with damped bounce:
            self.scale_val = 1.0 - 0.22 * math.exp(-5.2 * tau) * math.cos(6.8 * tau)
            self.opacity_val = min(1.0, tau / 0.40)
            if tau >= 1.0:
                self.scale_val = 1.0
                self.opacity_val = 1.0
                self._anim_state = "idle"
                self._anim_tick_id = 0
                self.queue_draw()
                return False
        elif self._anim_state == "closing":
            p = tau * tau * (3.0 - 2.0 * tau)
            self.scale_val = 1.0 - 0.18 * p
            self.opacity_val = 1.0 - p
            if tau >= 1.0:
                self.scale_val = 0.82
                self.opacity_val = 0.0
                self._anim_state = "idle"
                self._anim_tick_id = 0
                self.queue_draw()
                if self._on_finish_cb:
                    cb = self._on_finish_cb
                    self._on_finish_cb = None
                    cb()
                return False

        self.queue_draw()
        return True

# ------------------------------------------------------------------------------
# Main Application Window
# ------------------------------------------------------------------------------
class MacRecoveryInstallerWindow(Gtk.ApplicationWindow):
    def __init__(self, app, action_override=None, preview_screen=None, preview_modal=None, cached_password=None, initial_lang=None):
        super().__init__(application=app)
        self.set_title("Встановлення macW1Y")
        self.set_decorated(False)
        self._fullscreen_menu_layout = "--fullscreen-preview" in sys.argv or not any(
            arg in sys.argv for arg in ("--preview", "--no-kiosk")
        )
        if "--fullscreen-preview" in sys.argv:
            self.fullscreen()
        elif "--preview" in sys.argv or "--no-kiosk" in sys.argv:
            self.set_default_size(1920, 1080)
        else:
            self.fullscreen()

        self.username = get_target_username()
        self.display_name = get_user_display_name(self.username)
        self.avatar_path = get_user_avatar_path(self.username)
        self.version = get_modpack_version()
        self.disk_info = get_disk_capacity_info()

        self.selected_language = "uk"
        if initial_lang:
            self.selected_language = initial_lang
        else:
            try:
                loc_file = os.path.expanduser("~/.config/mac-styling/locale")
                if os.path.exists(loc_file):
                    with open(loc_file, "r", encoding="utf-8") as f:
                        v = f.read().strip()
                        if v:
                            self.selected_language = v
                else:
                    sys_lang = os.environ.get("LANG", "uk_UA.UTF-8").split(".")[0].replace("-", "_").lower().split("_")[0]
                    for l in SUPPORTED_LANGUAGES:
                        if l["code"] == sys_lang:
                            self.selected_language = l["code"]
                            break
            except Exception:
                self.selected_language = "uk"

        self.cached_password = cached_password or ""
        self.selected_action = action_override or "install"
        self.preview_screen = preview_screen
        self.preview_modal = preview_modal

        self.worker_thread = None
        self.worker_cancelled = False
        self.worker_process = None
        self.current_fraction = 0.02
        self.target_fraction = 0.02
        self._prog_tick_id = 0
        self.last_progress_time = time.time()
        self.worker_done = False

        settings = Gtk.Settings.get_default()
        if settings and hasattr(settings.props, "gtk_entry_select_on_focus"):
            try:
                settings.set_property("gtk-entry-select-on-focus", False)
            except Exception:
                pass

        self._build_ui()
        self._setup_keybindings()

        if self.preview_screen:
            self.switch_to_screen(self.preview_screen)
        else:
            self.switch_to_screen("screen_language")

        if self.preview_modal:
            GLib.timeout_add(200, self._trigger_preview_modal)

        if "--morph-test" in sys.argv:
            GLib.timeout_add(1000, lambda: self._on_wizard_action_clicked(None))

        for arg in sys.argv:
            if arg.startswith("--open-menu="):
                m_name = arg.split("=")[1]
                GLib.timeout_add(1400, lambda name=m_name: self._popup_menu_by_name(name))

    def tr(self, key, fallback="", **kwargs):
        res = mac_i18n.t(key, fallback=fallback, override_locale=getattr(self, "selected_language", "uk"))
        if kwargs:
            try:
                return res.format(**kwargs)
            except Exception:
                pass
        return res

    def _popup_menu_by_name(self, name):
        if name in ["context", "pkm"]:
            rect = Gdk.Rectangle()
            rect.x = 240
            rect.y = 30
            rect.width = 1
            rect.height = 1
            self.context_popover.set_pointing_to(rect)
            self.context_popover.popup()
            pop = self.context_popover
            for arg in sys.argv:
                if arg.startswith("--hover-item="):
                    try:
                        idx = int(arg.split("=")[1])
                        if hasattr(pop, "item_buttons") and 0 <= idx < len(pop.item_buttons):
                            pop.glide_to(pop.item_buttons[idx])
                    except Exception:
                        pass
            return GLib.SOURCE_REMOVE

        mapping = {
            "main": getattr(self, "btn_main", None),
            "file": getattr(self, "btn_file", None),
            "edit": getattr(self, "btn_edit", None),
            "utils": getattr(self, "btn_utils", None),
            "win": getattr(self, "btn_win", None),
            "wifi": getattr(self, "btn_wifi", None),
            "battery": getattr(self, "btn_bat", None),
        }
        btn = mapping.get(name)
        if btn:
            pop = btn.get_popover()
            if pop:
                pop.popup()
                for arg in sys.argv:
                    if arg.startswith("--hover-item="):
                        try:
                            idx = int(arg.split("=")[1])
                            if hasattr(pop, "item_buttons") and 0 <= idx < len(pop.item_buttons):
                                pop.glide_to(pop.item_buttons[idx])
                        except Exception:
                            pass
        return GLib.SOURCE_REMOVE

    def _trigger_preview_modal(self):
        m = self.preview_modal
        if m in ["password", "screen2"]:
            self._show_modal_password()
        elif m in ["loading", "screen5"]:
            self._show_modal_loading_info()
        elif m in ["terms_confirm", "screen7"]:
            self._show_modal_terms_confirm()
        elif m in ["admin", "padlock", "screen9", "screen11"]:
            self._show_modal_admin_padlock()
        elif m in ["cancel", "screen13"]:
            self._show_modal_cancel_confirm()
        elif m in ["reboot", "restart", "alert"]:
            self._show_modal_reboot_confirm()
        elif m in ["benchmark_warn", "bench_warn", "warn"]:
            self._show_modal_benchmark_warning()
        elif m in ["run_bench", "bench_run"]:
            self.switch_to_screen("screen_benchmark_progress")
            self._start_benchmark_execution()
        elif m in ["uninstall"]:
            self._show_modal_uninstall_confirm()
        return GLib.SOURCE_REMOVE

    def _build_ui(self):
        root_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        root_box.add_css_class("mac-recovery-root")
        root_box.add_css_class("mac-desktop-backdrop")
        self.set_child(root_box)
        self.root_box = root_box

        # Context menu popover parented directly to root_box
        context_items = [
            ("Про macW1Y", "app.about"),
            None,
            ("Термінал...", "app.terminal"),
            ("Бенчмарк...", "app.benchmark"),
            ("Дискова утиліта...", "app.disk_utility"),
            None,
            ("Перезавантажити...", "app.reboot"),
            ("Вимкнути комп'ютер...", "app.poweroff"),
        ]
        self.context_popover = MacMenuPopover(context_items)
        self.context_popover.set_parent(root_box)

        # 1. Top Menubar
        self.menubar_box = self._create_menubar()
        self.menubar_box.set_margin_top(0)
        root_box.append(self.menubar_box)

        # Right-click context menu gesture on window root
        gesture_root = Gtk.GestureClick()
        gesture_root.set_button(Gdk.BUTTON_SECONDARY)
        gesture_root.connect("pressed", self._on_context_menu_pressed)
        root_box.add_controller(gesture_root)

        # 2. Main Content Area (Centering Container)
        center_area = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        center_area.set_vexpand(True)
        center_area.set_hexpand(True)
        center_area.set_halign(Gtk.Align.CENTER)
        center_area.set_valign(Gtk.Align.CENTER)
        root_box.append(center_area)

        # Overlay container for Dialog Card + Modal Sheets (LiquidGlass)
        self.card_overlay = MacGlassOverlay(self)
        center_area.append(self.card_overlay)

        # Dialog Card
        self.card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        self.card.add_css_class("mac-recovery-card")
        self.card_overlay.set_child(self.card)

        # Stack for screens
        self.stack = Gtk.Stack()
        self.stack.set_transition_type(Gtk.StackTransitionType.SLIDE_LEFT)
        self.stack.set_transition_duration(280)
        self.stack.set_hhomogeneous(False)
        self.stack.set_vhomogeneous(False)
        self.card.append(self.stack)

        is_rtl = mac_i18n.is_rtl(self.selected_language)
        self.set_direction(Gtk.TextDirection.RTL if is_rtl else Gtk.TextDirection.LTR)
        self.set_title(self.tr("installer_app_title", "macW1Y Installation"))
        self.root_box = root_box

        # Modal sheet container in overlay
        self.modal_dim = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        self.modal_dim.add_css_class("mac-modal-dim")
        self.modal_dim.set_halign(Gtk.Align.FILL)
        self.modal_dim.set_valign(Gtk.Align.FILL)
        self.modal_dim.set_visible(False)
        self.card_overlay.add_overlay(self.modal_dim)

        self.modal_sheet_host = MacModalSheetHost()
        self.modal_dim.append(self.modal_sheet_host)

        # Build individual screens
        self.stack.add_named(self._build_screen_language(), "screen_language")
        self.stack.add_named(self._build_screen_user(), "screen_user")
        self.stack.add_named(self._build_screen_options(), "screen_options")
        self.stack.add_named(self._build_screen_wizard(), "screen_welcome")
        self.stack.add_named(self._build_screen_disk(), "screen_disk")
        self.stack.add_named(self._build_screen_progress(), "screen_progress")
        self.stack.add_named(self._build_screen_reboot(), "screen_reboot")
        self.stack.add_named(self._build_screen_benchmark_intro(), "screen_benchmark_intro")
        self.stack.add_named(self._build_screen_benchmark_progress(), "screen_benchmark_progress")
        self.stack.add_named(self._build_screen_benchmark_result(), "screen_benchmark_result")

        self.stack.set_visible_child_name("screen_language")

    def _setup_keybindings(self):
        controller = Gtk.EventControllerKey()
        controller.connect("key-pressed", self._on_key_pressed)
        self.add_controller(controller)

    def _on_key_pressed(self, controller, keyval, keycode, state):
        if keyval == Gdk.KEY_Escape:
            if self.modal_dim.get_visible():
                self.hide_modal()
            return True
        return False

    def _on_context_menu_pressed(self, gesture, n_press, x, y):
        if hasattr(self, "context_popover") and self.context_popover:
            widget = gesture.get_widget()
            rx, ry = x, y
            if hasattr(self, "root_box") and widget != self.root_box:
                try:
                    success, p = widget.compute_point(self.root_box, Graphene.Point().init(x, y))
                    if success:
                        rx, ry = p.x, p.y
                except Exception:
                    pass
            rect = Gdk.Rectangle()
            rect.x = max(10, int(rx))
            rect.y = max(10, int(ry))
            rect.width = 1
            rect.height = 1
            self.context_popover.set_pointing_to(rect)
            self.context_popover.popup()

    def _create_menubar(self):
        bar = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=2)
        bar.add_css_class("mac-recovery-menubar")

        # macW1Y Icon
        items_main = [
            (self.tr("menu_about", "About macW1Y"), "app.about"),
            None,
            (self.tr("menu_reboot", "Restart…"), "app.reboot"),
            (self.tr("menu_poweroff", "Shut Down…"), "app.poweroff"),
        ]

        system_svg = os.path.join(ASSETS_DIR, "system_logo.svg")
        if os.path.exists(system_svg):
            img_logo = Gtk.Image.new_from_file(system_svg)
            img_logo.set_pixel_size(15)
            self.btn_main = self._make_menu_btn(None, items_main, icon_widget=img_logo)
        else:
            self.btn_main = self._make_menu_btn("", items_main, is_bold=True)
        bar.append(self.btn_main)

        # App Title
        lbl_app = Gtk.Label(label=self.tr("installer_app_title", "macW1Y Installation"))
        lbl_app.add_css_class("mac-menubar-title")
        bar.append(lbl_app)

        # Menus: File, Edit, Utilities, Window
        items_file = [
            (self.tr("menu_new_image", "New Image…"), "app.noop", "⌘N"),
