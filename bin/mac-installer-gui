    # --------------------------------------------------------------------------
    # Screen 9 & 11: Admin Privilege Escalation Modal (Photos 9 & 11)
    # --------------------------------------------------------------------------
    def _show_modal_admin_padlock(self):
        sheet = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=7)
        sheet.add_css_class("mac-modal-sheet")
        sheet.add_css_class("mac-alert-sheet")

        img_lock = Gtk.Image.new_from_file(os.path.join(ASSETS_DIR, "padlock.svg"))
        img_lock.set_pixel_size(42)
        img_lock.set_halign(Gtk.Align.CENTER)
        img_lock.add_css_class("mac-rounded-icon")
        sheet.append(img_lock)

        lbl_t = Gtk.Label(label=self.tr("installer_admin_title", "macW1Y Installer requests permission"))
        lbl_t.add_css_class("mac-modal-title")
        lbl_t.set_wrap(True)
        lbl_t.set_max_width_chars(28)
        lbl_t.set_halign(Gtk.Align.START)
        lbl_t.set_xalign(0.0)
        sheet.append(lbl_t)

        lbl_s = Gtk.Label(label=self.tr("installer_admin_desc", "Enter administrator password to make changes to the system."))
        lbl_s.add_css_class("mac-modal-desc")
        lbl_s.set_halign(Gtk.Align.START)
        lbl_s.set_xalign(0.0)
        lbl_s.set_wrap(True)
        lbl_s.set_max_width_chars(30)
        sheet.append(lbl_s)

        # User selector pill (Photo 3)
        user_pill = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
        user_pill.add_css_class("mac-modal-user-pill")
        user_pill.set_hexpand(True)
        user_pill.set_halign(Gtk.Align.FILL)
        user_pill.set_margin_top(2)

        lbl_u = Gtk.Label(label=self.display_name)
        lbl_u.set_hexpand(True)
        lbl_u.set_halign(Gtk.Align.START)
        lbl_u.set_xalign(0.0)
        user_pill.append(lbl_u)

        lbl_chev = Gtk.Label(label="⇕")
        lbl_chev.set_halign(Gtk.Align.END)
        lbl_chev.set_opacity(0.7)
        user_pill.append(lbl_chev)
        sheet.append(user_pill)

        # Password Entry full-width (Photo 3)
        entry = Gtk.PasswordEntry()
        entry.add_css_class("mac-entry")
        entry.set_show_peek_icon(False)
        entry.set_hexpand(True)
        entry.set_halign(Gtk.Align.FILL)
        entry.set_margin_top(1)

        if self.cached_password:
            entry.set_text(self.cached_password)

        sheet.append(entry)

        lbl_err = Gtk.Label()
        lbl_err.add_css_class("mac-modal-desc")
        lbl_err.set_halign(Gtk.Align.START)
        lbl_err.set_xalign(0.0)
        lbl_err.set_visible(False)
        sheet.append(lbl_err)

        btn_row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        btn_row.set_homogeneous(True)
        btn_row.set_hexpand(True)
        btn_row.set_halign(Gtk.Align.FILL)
        btn_row.set_margin_top(8)

        btn_cancel = Gtk.Button(label=self.tr("btn_cancel", "Cancel"))
        btn_cancel.add_css_class("mac-modal-btn-secondary")
        btn_cancel.set_hexpand(True)
        btn_cancel.set_halign(Gtk.Align.FILL)
        btn_cancel.connect("clicked", lambda b: self.hide_modal())
        btn_row.append(btn_cancel)

        btn_allow = Gtk.Button(label=self.tr("installer_allow_btn", "Allow"))
        btn_allow.add_css_class("mac-modal-btn-primary")
        btn_allow.set_hexpand(True)
        btn_allow.set_halign(Gtk.Align.FILL)

        def on_allow():
            pwd = entry.get_text()
            if not pwd:
                lbl_err.set_markup("<span color='#ff453a'>Введіть пароль адміністратора.</span>")
                lbl_err.set_visible(True)
                return

            btn_allow.set_sensitive(False)
            btn_allow.set_label("Перевірка...")

            def check_thread():
                try:
                    p = subprocess.run(["sudo", "-S", "-v"],
                                       input=(pwd + "\n").encode(),
                                       stdout=subprocess.DEVNULL,
                                       stderr=subprocess.DEVNULL,
                                       check=False)
                    ok = (p.returncode == 0)
                except Exception:
                    ok = False

                def finish():
                    btn_allow.set_sensitive(True)
                    btn_allow.set_label("Дозволити")
                    if ok or "--preview" in sys.argv:
                        self.cached_password = pwd
                        self.hide_modal()
                        self.switch_to_screen("screen_progress")
                        self._start_worker_execution()
                    else:
                        lbl_err.set_markup("<span color='#ff453a'>Невірний пароль. Спробуйте ще раз.</span>")
                        lbl_err.set_visible(True)
                        entry.set_text("")
                        entry.grab_focus()

                GLib.idle_add(finish)

            threading.Thread(target=check_thread, daemon=True).start()

        btn_allow.connect("clicked", lambda b: on_allow())
        entry.connect("activate", lambda e: on_allow())
        btn_row.append(btn_allow)
        sheet.append(btn_row)

        self.show_modal(sheet)
        GLib.idle_add(entry.grab_focus)

