        btn_reboot.set_hexpand(True)
        btn_reboot.set_halign(Gtk.Align.FILL)
        btn_reboot.connect("clicked", lambda b: self._execute_reboot())
        btn_row.append(btn_reboot)

        sheet.append(btn_row)
        self.show_modal(sheet)
        GLib.idle_add(btn_cancel.grab_focus)

    def _execute_reboot(self):
        self.hide_modal()
        is_mock = "--preview" in sys.argv or "--mock-installer" in sys.argv or "-let_me_try_bradar" in sys.argv or "--let_me_try_bradar" in sys.argv or os.environ.get("MAC_MOCK_INSTALLER") == "1"
        if is_mock:
            print("Mock mode: reboot simulated")
            self._show_simple_alert("Тестування завершено", "Встановлення macW1Y успішно протестовано в тестовому режимі!\nУ режимі муляжу перезавантаження комп'ютера не виконується.")
            return
        kiosk_guard.leave()
        try:
            subprocess.run(["systemctl", "reboot"], check=False)
        except Exception:
            subprocess.run(["reboot"], check=False)

    def _on_abort_installation(self, btn):
        self.worker_cancelled = True
        if hasattr(self, "_prog_tick_id") and self._prog_tick_id:
            try:
                self.remove_tick_callback(self._prog_tick_id)
            except Exception:
                pass
            self._prog_tick_id = 0
        if self.worker_process:
            try:
                self.worker_process.terminate()
            except Exception:
                pass
        self.hide_modal()
        kiosk_guard.leave()
        self.get_application().quit()

