# ------------------------------------------------------------------------------
# Popover Menu with Tahoe / macW1Y Sliding Hover Pill & Frosted Glass
# ------------------------------------------------------------------------------
class MacMenuPopover(Gtk.Popover):
    """
    Authentic macW1Y Menubar Popover:
    - Frosted glass backdrop (dark tint + subtle light edge + deep drop shadow)
    - System accent color for the sliding selection indicator
    - Rounded menu container (24px) and pill-shaped menu items (border-radius: 9999px)
    - Sliding hover pill indicator that smoothly glides from item to item on cursor movement
    - Subtle fade & scale entrance and exit animations
    """
    def __init__(self, items, parent_btn=None):
        super().__init__()
        self.set_has_arrow(False)
        if "--preview" in sys.argv or any(a.startswith("--open-menu=") for a in sys.argv):
            self.set_autohide(False)
        else:
            self.set_autohide(True)
        self.add_css_class("mac-popover-menu")
        self.parent_btn = parent_btn
        self.is_closing = False

        self.overlay = Gtk.Overlay()

        # Sliding pill background indicator
        self.pill = Gtk.Box()
        self.pill.add_css_class("mac-menu-hover-pill")
        self.pill.set_can_target(False)
        self.pill.set_hexpand(True)
        self.pill.set_valign(Gtk.Align.START)
        self.pill.set_halign(Gtk.Align.FILL)
        self.pill.set_opacity(0.0)
        self.pill.set_margin_start(4)
        self.pill.set_margin_end(4)

        self.bg_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        self.bg_box.append(self.pill)
        self.overlay.set_child(self.bg_box)

        # Items container
        self.items_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        self.items_box.add_css_class("mac-menu-items-box")
        self.items_box.set_margin_top(4)
        self.items_box.set_margin_bottom(4)
        self.items_box.set_margin_start(4)
        self.items_box.set_margin_end(4)

        self.overlay.add_overlay(self.items_box)
        self.overlay.set_measure_overlay(self.items_box, True)
        self.set_child(self.overlay)

        # Animation State
        self.current_y = 0.0
        self.target_y = 0.0
        self.current_h = 26.0
        self.target_h = 26.0
        self.current_opacity = 0.0
        self.target_opacity = 0.0
        self.tick_id = 0
        self.item_buttons = []

        for item in items:
            if item is None:
                # Separator
                sep = Gtk.Box()
                sep.add_css_class("mac-menu-separator")
                self.items_box.append(sep)
                continue

            if isinstance(item, tuple):
                label_text = item[0]
                action_name = item[1] if len(item) > 1 else None
                shortcut = item[2] if len(item) > 2 else None
                is_header = item[3] if len(item) > 3 else False
            else:
                label_text = str(item)
                action_name = None
                shortcut = None
                is_header = False

            if is_header:
                lbl = Gtk.Label(label=label_text)
                lbl.add_css_class("mac-menu-header-item")
                lbl.set_halign(Gtk.Align.START)
                self.items_box.append(lbl)
                continue

            btn = Gtk.Button()
            btn.set_has_frame(False)
            btn.add_css_class("mac-menu-item-btn")

            row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=14)
            lbl = Gtk.Label(label=label_text)
            lbl.set_halign(Gtk.Align.START)
            lbl.set_hexpand(True)
            row.append(lbl)

            if shortcut:
                lbl_sc = Gtk.Label(label=shortcut)
                lbl_sc.add_css_class("mac-menu-shortcut")
                lbl_sc.set_halign(Gtk.Align.END)
                row.append(lbl_sc)

            btn.set_child(row)

            if action_name:
                btn.connect("clicked", lambda b, act=action_name: self._on_item_activated(act))

            # Motion controller on button to glide highlight pill
            motion = Gtk.EventControllerMotion()
            motion.connect("enter", lambda c, x, y, b=btn: self.glide_to(b))
            btn.add_controller(motion)

            self.items_box.append(btn)
            self.item_buttons.append(btn)

        # Motion controller on items container to fade out when leaving
        box_motion = Gtk.EventControllerMotion()
        box_motion.connect("leave", lambda c: self.glide_leave())
        self.items_box.add_controller(box_motion)

    def _on_item_activated(self, action_name):
        self.animated_popdown(lambda: self._dispatch_action(action_name))

    def _dispatch_action(self, action_name):
        app = Gio.Application.get_default()
        if app and hasattr(app, "lookup_action"):
            act_id = action_name.replace("app.", "")
            act = app.lookup_action(act_id)
            if act:
                act.activate(None)

    def glide_to(self, btn):
        self.active_btn = btn
        ok, bounds = btn.compute_bounds(self.overlay)
        if ok and bounds.get_height() > 15:
            ty = max(0.0, float(bounds.get_y()))
            th = float(bounds.get_height())
        else:
            ty = 4.0
            th = 32.0
            if hasattr(self, "items_box"):
                child = self.items_box.get_first_child()
                while child and child != btn:
                    _, ch, _, _ = child.measure(Gtk.Orientation.VERTICAL, -1)
                    ty += max(ch, 1) + 2
                    child = child.get_next_sibling()
            _, bh, _, _ = btn.measure(Gtk.Orientation.VERTICAL, -1)
            th = max(bh, 30)

        self.target_y = ty
        self.target_h = th
        self.target_opacity = 1.0
        if self.current_opacity == 0.0:
            self.current_y = self.target_y
            self.current_h = self.target_h
            self.pill.set_margin_top(int(round(self.current_y)))
            self.pill.set_size_request(-1, max(26, int(round(self.current_h))))
            self.current_opacity = 1.0
            self.pill.set_opacity(1.0)
        self._start_anim()

    def glide_leave(self):
        self.target_opacity = 0.0
        self._start_anim()

    def _start_anim(self):
        if self.tick_id == 0:
            self.tick_id = self.add_tick_callback(self._on_tick)

    def _on_tick(self, widget, frame_clock):
        self.current_y += (self.target_y - self.current_y) * 0.38
        self.current_h += (self.target_h - self.current_h) * 0.38
        self.current_opacity += (self.target_opacity - self.current_opacity) * 0.35

        self.pill.set_margin_top(int(round(self.current_y)))
        self.pill.set_size_request(-1, max(26, int(round(self.current_h))))
        self.pill.set_opacity(self.current_opacity)

        if (abs(self.target_y - self.current_y) < 0.4 and 
            abs(self.target_h - self.current_h) < 0.4 and 
            abs(self.target_opacity - self.current_opacity) < 0.02):
            self.current_y = self.target_y
            self.current_h = self.target_h
            self.current_opacity = self.target_opacity
            self.pill.set_margin_top(int(round(self.current_y)))
            self.pill.set_size_request(-1, max(26, int(round(self.current_h))))
            self.pill.set_opacity(self.current_opacity)
            self.tick_id = 0
            return GLib.SOURCE_REMOVE

        return GLib.SOURCE_CONTINUE

    def animated_popdown(self, on_closed=None):
        if self.is_closing:
            return
        self.is_closing = True
        self.add_css_class("mac-popover-closing")
        def _finish():
            self.popdown()
            self.remove_css_class("mac-popover-closing")
            self.is_closing = False
            if on_closed:
                on_closed()
            return GLib.SOURCE_REMOVE
        GLib.timeout_add(110, _finish)

# ------------------------------------------------------------------------------
# Main Application Window
# ------------------------------------------------------------------------------
class MacRecoveryInstallerWindow(Gtk.ApplicationWindow):
    def __init__(self, app, action_override=None, preview_screen=None, preview_modal=None, cached_password=None, initial_lang=None):
        super().__init__(application=app)
        self.set_title("Встановлення macW1Y")
        self.set_decorated(False)
        if "--preview" in sys.argv or "--no-kiosk" in sys.argv:
            self.set_default_size(1920, 1080)
        else:
            self.fullscreen()

        self.username = get_target_username()
        self.display_name = get_user_display_name(self.username)
        self.avatar_path = get_user_avatar_path(self.username)
        self.version = get_modpack_version()
        self.disk_info = get_disk_capacity_info()

        self.selected_language = "uk"
        if initial_lang:
            self.selected_language = initial_lang
        else:
            try:
                loc_file = os.path.expanduser("~/.config/mac-styling/locale")
                if os.path.exists(loc_file):
                    with open(loc_file, "r", encoding="utf-8") as f:
                        v = f.read().strip()
                        if v:
                            self.selected_language = v
                else:
                    sys_lang = os.environ.get("LANG", "uk_UA.UTF-8").split(".")[0].replace("-", "_").lower().split("_")[0]
                    for l in SUPPORTED_LANGUAGES:
                        if l["code"] == sys_lang:
                            self.selected_language = l["code"]
                            break
            except Exception:
                self.selected_language = "uk"

        self.cached_password = cached_password or ""
        self.selected_action = action_override or "install"
        self.preview_screen = preview_screen
        self.preview_modal = preview_modal

        self.worker_thread = None
        self.worker_cancelled = False
        self.worker_process = None

        self._build_ui()
        self._setup_keybindings()

        if self.preview_screen:
            self.switch_to_screen(self.preview_screen)
        else:
            self.switch_to_screen("screen_language")

        if self.preview_modal:
            GLib.timeout_add(200, self._trigger_preview_modal)

        for arg in sys.argv:
            if arg.startswith("--open-menu="):
                m_name = arg.split("=")[1]
                GLib.timeout_add(1400, lambda name=m_name: self._popup_menu_by_name(name))

    def _popup_menu_by_name(self, name):
        if name in ["context", "pkm"]:
            rect = Gdk.Rectangle()
            rect.x = 240
            rect.y = 30
            rect.width = 1
            rect.height = 1
            self.context_popover.set_pointing_to(rect)
            self.context_popover.popup()
            pop = self.context_popover
            for arg in sys.argv:
                if arg.startswith("--hover-item="):
                    try:
                        idx = int(arg.split("=")[1])
                        if hasattr(pop, "item_buttons") and 0 <= idx < len(pop.item_buttons):
                            pop.glide_to(pop.item_buttons[idx])
                    except Exception:
                        pass
            return GLib.SOURCE_REMOVE

        mapping = {
            "apple": getattr(self, "btn_apple", None),
            "file": getattr(self, "btn_file", None),
            "edit": getattr(self, "btn_edit", None),
            "utils": getattr(self, "btn_utils", None),
            "win": getattr(self, "btn_win", None),
            "wifi": getattr(self, "btn_wifi", None),
            "battery": getattr(self, "btn_bat", None),
        }
        btn = mapping.get(name)
        if btn:
            pop = btn.get_popover()
            if pop:
                pop.popup()
                for arg in sys.argv:
                    if arg.startswith("--hover-item="):
                        try:
                            idx = int(arg.split("=")[1])
                            if hasattr(pop, "item_buttons") and 0 <= idx < len(pop.item_buttons):
                                pop.glide_to(pop.item_buttons[idx])
                        except Exception:
                            pass
        return GLib.SOURCE_REMOVE

    def _trigger_preview_modal(self):
        m = self.preview_modal
        if m in ["password", "screen2"]:
            self._show_modal_password()
        elif m in ["loading", "screen5"]:
            self._show_modal_loading_info()
        elif m in ["terms_confirm", "screen7"]:
            self._show_modal_terms_confirm()
        elif m in ["admin", "padlock", "screen9", "screen11"]:
            self._show_modal_admin_padlock()
        elif m in ["cancel", "screen13"]:
            self._show_modal_cancel_confirm()
        elif m in ["reboot", "restart", "alert"]:
            self._show_modal_reboot_confirm()
        elif m in ["uninstall"]:
            self._show_modal_uninstall_confirm()
        return GLib.SOURCE_REMOVE

    def _build_ui(self):
        root_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        root_box.add_css_class("mac-recovery-root")
        root_box.add_css_class("mac-desktop-backdrop")
        self.set_child(root_box)
        self.root_box = root_box

        # Context menu popover parented directly to root_box
        context_items = [
            ("Про macW1Y", "app.about"),
            None,
            ("Термінал...", "app.terminal"),
            ("Дискова утиліта...", "app.noop"),
            None,
            ("Перезавантажити...", "app.reboot"),
            ("Вимкнути комп'ютер...", "app.poweroff"),
        ]
        self.context_popover = MacMenuPopover(context_items)
        self.context_popover.set_parent(self)

        # 1. Top Menubar
        menubar = self._create_menubar()
        root_box.append(menubar)

        # Right-click context menu gesture on window root
        gesture_root = Gtk.GestureClick()
        gesture_root.set_button(Gdk.BUTTON_SECONDARY)
        gesture_root.connect("pressed", self._on_context_menu_pressed)
        root_box.add_controller(gesture_root)

        # 2. Main Content Area (Centering Container)
        center_area = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        center_area.set_vexpand(True)
        center_area.set_hexpand(True)
        center_area.set_halign(Gtk.Align.CENTER)
        center_area.set_valign(Gtk.Align.CENTER)
        root_box.append(center_area)

        # Overlay container for Dialog Card + Modal Sheets
        self.card_overlay = Gtk.Overlay()
        center_area.append(self.card_overlay)

        # Dialog Card
        self.card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        self.card.add_css_class("mac-recovery-card")
        self.card_overlay.set_child(self.card)

        # Stack for screens
        self.stack = Gtk.Stack()
        self.stack.set_transition_type(Gtk.StackTransitionType.CROSSFADE)
        self.stack.set_transition_duration(250)
        self.stack.set_hhomogeneous(False)
        self.stack.set_vhomogeneous(False)
        self.card.append(self.stack)

        # Modal sheet container in overlay
        self.modal_dim = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        self.modal_dim.add_css_class("mac-modal-dim")
        self.modal_dim.set_halign(Gtk.Align.FILL)
        self.modal_dim.set_valign(Gtk.Align.FILL)
        self.modal_dim.set_visible(False)
        self.card_overlay.add_overlay(self.modal_dim)

        self.modal_sheet_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        self.modal_sheet_box.set_halign(Gtk.Align.CENTER)
        self.modal_sheet_box.set_valign(Gtk.Align.CENTER)
        self.modal_sheet_box.set_vexpand(True)
        self.modal_sheet_box.set_hexpand(True)
        self.modal_dim.append(self.modal_sheet_box)

        # Build individual screens
        self.stack.add_named(self._build_screen_language(), "screen_language")
        self.stack.add_named(self._build_screen_user(), "screen_user")
        self.stack.add_named(self._build_screen_options(), "screen_options")
        self.stack.add_named(self._build_screen_welcome(), "screen_welcome")
        self.stack.add_named(self._build_screen_terms(), "screen_terms")
        self.stack.add_named(self._build_screen_disk(), "screen_disk")
        self.stack.add_named(self._build_screen_progress(), "screen_progress")
        self.stack.add_named(self._build_screen_reboot(), "screen_reboot")

        self.stack.set_visible_child_name("screen_language")

    def _setup_keybindings(self):
        controller = Gtk.EventControllerKey()
        controller.connect("key-pressed", self._on_key_pressed)
        self.add_controller(controller)

    def _on_key_pressed(self, controller, keyval, keycode, state):
        if keyval == Gdk.KEY_Escape:
            if self.modal_dim.get_visible():
                self.hide_modal()
            return True
        return False

    def _on_context_menu_pressed(self, gesture, n_press, x, y):
        if hasattr(self, "context_popover") and self.context_popover:
            widget = gesture.get_widget()
            rx, ry = x, y
            if hasattr(self, "root_box") and widget != self.root_box:
                try:
                    success, p = widget.compute_point(self.root_box, Graphene.Point().init(x, y))
                    if success:
                        rx, ry = p.x, p.y
                except Exception:
                    pass
            rect = Gdk.Rectangle()
            rect.x = max(10, int(rx))
            rect.y = max(10, int(ry))
            rect.width = 1
            rect.height = 1
            self.context_popover.set_pointing_to(rect)
            self.context_popover.popup()

    def _create_menubar(self):
        bar = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=2)
        bar.add_css_class("mac-recovery-menubar")

        # Apple Icon
        items_apple = [
            ("Про macW1Y", "app.about"),
            None,
            ("Перезавантажити...", "app.reboot"),
            ("Вимкнути комп'ютер...", "app.poweroff"),
        ]

        apple_svg = os.path.join(ASSETS_DIR, "apple_logo.svg")
        if os.path.exists(apple_svg):
            img_apple = Gtk.Image.new_from_file(apple_svg)
            img_apple.set_pixel_size(15)
            self.btn_apple = self._make_menu_btn(None, items_apple, icon_widget=img_apple)
        else:
            self.btn_apple = self._make_menu_btn("", items_apple, is_bold=True)
        bar.append(self.btn_apple)

        # App Title
        lbl_app = Gtk.Label(label="Встановлення macW1Y")
        lbl_app.add_css_class("mac-menubar-title")
        bar.append(lbl_app)

        # Menus: Файл, Правка, Утиліти, Вікно
        items_file = [
            ("Новий образ...", "app.noop", "⌘N"),
            None,
            ("Закрити вікно", "app.close", "⌘W"),
        ]
        self.btn_file = self._make_menu_btn("Файл", items_file)
        bar.append(self.btn_file)

        items_edit = [
            ("Відмінити", "app.undo", "⌘Z"),
            ("Повторити", "app.redo", "⇧⌘Z"),
            None,
            ("Вирізати", "app.noop", "⌘X"),
            ("Скопіювати", "app.noop", "⌘C"),
            ("Вставити", "app.noop", "⌘V"),
        ]
        self.btn_edit = self._make_menu_btn("Правка", items_edit)
        bar.append(self.btn_edit)

        items_utils = [
            ("Термінал...", "app.terminal"),
            ("Дискова утиліта...", "app.noop"),
            ("Інформація про систему...", "app.sysinfo"),
        ]
        self.btn_utils = self._make_menu_btn("Утиліти", items_utils)
        bar.append(self.btn_utils)

        items_win = [
            ("Мінімізувати", "app.minimize", "⌘M"),
            ("Збільшити", "app.noop"),
        ]
        self.btn_win = self._make_menu_btn("Вікно", items_win)
        bar.append(self.btn_win)

        spacer = Gtk.Box()
        spacer.set_hexpand(True)
        bar.append(spacer)

        # Right Status Area: Wi-Fi Icon and Battery with Percentage ONLY
        right_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
        right_box.set_valign(Gtk.Align.CENTER)
        right_box.set_margin_end(14)

        # Wi-Fi Menu Button
        wifi_svg = os.path.join(ASSETS_DIR, "wifi_icon.svg")
        if os.path.exists(wifi_svg):
            img_wifi = Gtk.Image.new_from_file(wifi_svg)
        else:
            img_wifi = Gtk.Image.new_from_icon_name("network-wireless-signal-excellent-symbolic")
        img_wifi.set_pixel_size(15)

        items_wifi = [
            ("Wi-Fi: Увімкнено", None, None, True),
            ("Мережа: macW1Y-Recovery", None, "✓"),
            None,
            ("Параметри мережі...", "app.noop"),
        ]
        self.btn_wifi = self._make_menu_btn(None, items_wifi, icon_widget=img_wifi)
        right_box.append(self.btn_wifi)

        # Battery Area: Percentage + Battery Icon
        bat_pct = get_battery_info()
        lbl_bat = Gtk.Label(label=bat_pct)
        lbl_bat.add_css_class("mac-menubar-item")

        bat_svg = os.path.join(ASSETS_DIR, "battery_icon.svg")
        if os.path.exists(bat_svg):
            img_bat = Gtk.Image.new_from_file(bat_svg)
        else:
            img_bat = Gtk.Image.new_from_icon_name("battery-level-100-symbolic")
        img_bat.set_pixel_size(16)

        bat_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=5)
        bat_box.set_valign(Gtk.Align.CENTER)
        bat_box.append(lbl_bat)
        bat_box.append(img_bat)

        items_bat = [
            (f"Акумулятор: {bat_pct}", None, None, True),
            ("Джерело живлення: Адаптер", None),
            None,
            ("Параметри акумулятора...", "app.noop"),
        ]
        self.btn_bat = self._make_menu_btn(None, items_bat, icon_widget=bat_box)
        right_box.append(self.btn_bat)

        bar.append(right_box)

        # Right-click (ПКМ) gesture on menubar
        gesture_bar = Gtk.GestureClick()
        gesture_bar.set_button(Gdk.BUTTON_SECONDARY)
        gesture_bar.connect("pressed", self._on_context_menu_pressed)
        bar.add_controller(gesture_bar)

        return bar

    def _make_menu_btn(self, label_text, items, is_bold=False, icon_widget=None):
        btn = Gtk.MenuButton()
        btn.set_has_frame(False)
        if hasattr(btn, "set_always_show_arrow"):
            btn.set_always_show_arrow(False)
        if icon_widget:
            btn.set_child(icon_widget)
        else:
            lbl = Gtk.Label(label=label_text)
            if is_bold:
                lbl.add_css_class("mac-menubar-title")
            else:
                lbl.add_css_class("mac-menubar-item")
            btn.set_child(lbl)
        pop = MacMenuPopover(items, parent_btn=btn)
        btn.set_popover(pop)
        btn.add_css_class("mac-menubar-button")
        return btn

    # --------------------------------------------------------------------------
    # Modal Sheet Management
    # --------------------------------------------------------------------------
    def show_modal(self, widget):
        while child := self.modal_sheet_box.get_first_child():
            self.modal_sheet_box.remove(child)
        self.modal_sheet_box.append(widget)
        self.stack.add_css_class("mac-blurred-backdrop")
        self.modal_dim.set_visible(True)

    def hide_modal(self):
        self.modal_dim.set_visible(False)
        self.stack.remove_css_class("mac-blurred-backdrop")
        while child := self.modal_sheet_box.get_first_child():
            self.modal_sheet_box.remove(child)

    def switch_to_screen(self, screen_name):
        self.hide_modal()
        target = screen_name if screen_name.startswith("screen_") else f"screen_{screen_name}"
        if target in ["screen_lang", "screen_language"]:
            target = "screen_language"
        self.stack.set_visible_child_name(target)
        if target == "screen_options":
            self.card.add_css_class("mac-card-options")
        else:
            self.card.remove_css_class("mac-card-options")

    # --------------------------------------------------------------------------
    # Screen 0: Language Selection (macOS Setup Wizard style)
    # --------------------------------------------------------------------------
    def _build_screen_language(self):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        box.set_vexpand(True)
        box.set_valign(Gtk.Align.CENTER)
        box.set_halign(Gtk.Align.CENTER)

        # 1. Header Globe Icon
        globe_svg = os.path.join(ASSETS_DIR, "globe_blue.svg")
        if not os.path.exists(globe_svg):
            globe_svg = os.path.join(ASSETS_DIR, "safari_globe.svg")
        img_globe = Gtk.Image.new_from_file(globe_svg)
        img_globe.set_pixel_size(56)
        img_globe.set_halign(Gtk.Align.CENTER)
        img_globe.set_margin_bottom(12)
        box.append(img_globe)

        # 2. Header Title & Subtitle
        cur_lang = getattr(self, "selected_language", "uk")
        info = LANGUAGE_I18N.get(cur_lang, LANGUAGE_I18N["en"])

        self.lbl_lang_title = Gtk.Label(label=info["title"])
        self.lbl_lang_title.add_css_class("mac-title-large")
        self.lbl_lang_title.set_halign(Gtk.Align.CENTER)
        box.append(self.lbl_lang_title)

        self.lbl_lang_sub = Gtk.Label(label=info["subtitle"])
        self.lbl_lang_sub.add_css_class("mac-subtitle")
        self.lbl_lang_sub.set_halign(Gtk.Align.CENTER)
        self.lbl_lang_sub.set_margin_top(6)
        self.lbl_lang_sub.set_margin_bottom(18)
        box.append(self.lbl_lang_sub)

        # 3. Outer Language List Card
        card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        card.add_css_class("mac-lang-card")
        card.set_halign(Gtk.Align.CENTER)

        scroll = Gtk.ScrolledWindow()
        scroll.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        scroll.set_propagate_natural_height(False)
        scroll.set_min_content_width(372)
        scroll.set_min_content_height(256)
        scroll.set_max_content_height(256)
        card.append(scroll)

        items_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        items_box.set_margin_start(4)
        items_box.set_margin_end(4)
        items_box.set_margin_top(4)
        items_box.set_margin_bottom(4)
        scroll.set_child(items_box)

        self.lang_buttons = {}
        sorted_langs = get_sorted_languages(cur_lang)

        for lang in sorted_langs:
            code = lang["code"]
            btn = Gtk.Button()
            btn.add_css_class("mac-lang-item")
            btn.set_has_frame(False)
            btn.set_cursor_from_name("pointer")

            lbl = Gtk.Label(label=lang["native"])
            lbl.set_halign(Gtk.Align.START)
            lbl.set_hexpand(True)
            btn.set_child(lbl)

            if code == cur_lang:
                btn.add_css_class("selected")

            btn.connect("clicked", lambda b, c=code: self._on_language_selected(c))
            self.lang_buttons[code] = (btn, lbl)
            items_box.append(btn)

        box.append(card)

        # 4. Bottom Action Buttons
        btn_row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=14)
        btn_row.set_halign(Gtk.Align.CENTER)
        btn_row.set_margin_top(22)

        self.btn_lang_restart = Gtk.Button(label=info["restart"])
        self.btn_lang_restart.add_css_class("mac-btn-pill")
        self.btn_lang_restart.connect("clicked", lambda b: self._on_system_reboot())
        btn_row.append(self.btn_lang_restart)

        self.btn_lang_continue = Gtk.Button(label=info["continue"])
        self.btn_lang_continue.add_css_class("mac-btn-pill-primary")
        self.btn_lang_continue.connect("clicked", lambda b: self._on_language_continue())
        btn_row.append(self.btn_lang_continue)

        box.append(btn_row)
        return box

    def _on_language_selected(self, lang_code):
        self.selected_language = lang_code
        info = LANGUAGE_I18N.get(lang_code, LANGUAGE_I18N.get("en", {}))
        if hasattr(self, "lbl_lang_title") and self.lbl_lang_title:
            self.lbl_lang_title.set_label(info.get("title", "Select Language"))
        if hasattr(self, "lbl_lang_sub") and self.lbl_lang_sub:
            self.lbl_lang_sub.set_label(info.get("subtitle", "Select primary language"))
        if hasattr(self, "btn_lang_continue") and self.btn_lang_continue:
            self.btn_lang_continue.set_label(info.get("continue", "Continue"))
        if hasattr(self, "btn_lang_restart") and self.btn_lang_restart:
            self.btn_lang_restart.set_label(info.get("restart", "Restart"))

        for c, (btn, lbl) in getattr(self, "lang_buttons", {}).items():
            if c == lang_code:
                btn.add_css_class("selected")
            else:
                btn.remove_css_class("selected")

    def _on_language_continue(self):
        try:
            loc_dir = os.path.expanduser("~/.config/mac-styling")
            os.makedirs(loc_dir, exist_ok=True)
            with open(os.path.join(loc_dir, "locale"), "w", encoding="utf-8") as f:
                f.write(f"{self.selected_language}\n")
        except Exception:
            pass
        self.switch_to_screen("screen_user")

    # --------------------------------------------------------------------------
    # Screen 1: User Account Selection (Photo 1)
    # --------------------------------------------------------------------------
