            None,
            (self.tr("menu_cut", "Cut"), "app.noop", "⌘X"),
            (self.tr("menu_copy", "Copy"), "app.noop", "⌘C"),
            (self.tr("menu_paste", "Paste"), "app.noop", "⌘V"),
        ]
        self.btn_edit = self._make_menu_btn(self.tr("menu_edit", "Edit"), items_edit)
        bar.append(self.btn_edit)

        items_utils = [
            (self.tr("menu_terminal", "Terminal…"), "app.terminal"),
            (self.tr("menu_benchmark", "Benchmark…"), "app.benchmark"),
            (self.tr("menu_disk_utility", "Disk Utility…"), "app.disk_utility"),
            (self.tr("menu_sysinfo", "System Information…"), "app.sysinfo"),
        ]
        self.btn_utils = self._make_menu_btn(self.tr("menu_utilities", "Utilities"), items_utils)
        bar.append(self.btn_utils)

        items_win = [
            (self.tr("menu_minimize", "Minimize"), "app.minimize", "⌘M"),
            (self.tr("menu_zoom", "Zoom"), "app.noop"),
        ]
        self.btn_win = self._make_menu_btn(self.tr("menu_window", "Window"), items_win)
        bar.append(self.btn_win)

        spacer = Gtk.Box()
        spacer.set_hexpand(True)
        bar.append(spacer)

        # Right Status Area: Wi-Fi Icon and Battery with Percentage ONLY
        right_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
        right_box.set_valign(Gtk.Align.CENTER)
        right_box.set_margin_end(14)

        # Wi-Fi Menu Button
        wifi_svg = os.path.join(ASSETS_DIR, "wifi_icon.svg")
        if os.path.exists(wifi_svg):
            img_wifi = Gtk.Image.new_from_file(wifi_svg)
        else:
            img_wifi = Gtk.Image.new_from_icon_name("network-wireless-signal-excellent-symbolic")
        img_wifi.set_pixel_size(15)

        items_wifi = [
            (self.tr("menu_wifi_on", "Wi-Fi: On"), None, None, True),
            (self.tr("menu_wifi_network", "Network: macW1Y-Recovery"), None, "✓"),
            None,
            (self.tr("menu_network_settings", "Network Settings…"), "app.noop"),
        ]
        self.btn_wifi = self._make_menu_btn(None, items_wifi, icon_widget=img_wifi)
        right_box.append(self.btn_wifi)

        # Battery Area: Percentage + Battery Icon
        bat_pct = get_battery_info()
        lbl_bat = Gtk.Label(label=bat_pct)
        lbl_bat.add_css_class("mac-menubar-item")

        bat_svg = os.path.join(ASSETS_DIR, "battery_icon.svg")
        if os.path.exists(bat_svg):
            img_bat = Gtk.Image.new_from_file(bat_svg)
        else:
            img_bat = Gtk.Image.new_from_icon_name("battery-level-100-symbolic")
        img_bat.set_pixel_size(16)

        bat_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=5)
        bat_box.set_valign(Gtk.Align.CENTER)
        bat_box.append(lbl_bat)
        bat_box.append(img_bat)

        bat_txt = self.tr("menu_battery_pct", "Battery: {bat_pct}", bat_pct=bat_pct)
        items_bat = [
            (bat_txt, None, None, True),
            (self.tr("power_source_adapter", "Power Source: Power Adapter"), None),
            None,
            (self.tr("battery_settings", "Battery Settings…"), "app.noop"),
        ]
        self.btn_bat = self._make_menu_btn(None, items_bat, icon_widget=bat_box)
        right_box.append(self.btn_bat)

        bar.append(right_box)

        # Right-click (ПКМ) gesture on menubar
        gesture_bar = Gtk.GestureClick()
        gesture_bar.set_button(Gdk.BUTTON_SECONDARY)
        gesture_bar.connect("pressed", self._on_context_menu_pressed)
        bar.add_controller(gesture_bar)

        return bar

    def _make_menu_btn(self, label_text, items, is_bold=False, icon_widget=None):
        btn = Gtk.MenuButton()
        btn.set_has_frame(False)
        if hasattr(btn, "set_always_show_arrow"):
            btn.set_always_show_arrow(False)
        if icon_widget:
            btn.set_child(icon_widget)
        else:
            lbl = Gtk.Label(label=label_text)
            if is_bold:
                lbl.add_css_class("mac-menubar-title")
            else:
                lbl.add_css_class("mac-menubar-item")
            btn.set_child(lbl)
        pop = MacMenuPopover(items, parent_btn=btn)
        btn.set_popover(pop)
        btn.add_css_class("mac-menubar-button")
        return btn

    # --------------------------------------------------------------------------
    # Modal Sheet Management (Spring pop entrance & smooth ease-in exit)
    # --------------------------------------------------------------------------
    def show_modal(self, widget):
        self.modal_sheet_host.set_content(widget)
        self.modal_dim.set_visible(True)
        self.modal_sheet_host.start_open_animation()

    def hide_modal(self, immediate=False):
        if not self.modal_dim.get_visible():
            return
        def _on_closed():
            self.modal_dim.set_visible(False)
            self.modal_sheet_host.set_content(None)
            self.modal_sheet_host.backdrop_node = None
            if hasattr(self, "lbl_wizard_title"):
                self.lbl_wizard_title.set_opacity(1.0)
            if hasattr(self, "lbl_wizard_sub"):
                self.lbl_wizard_sub.set_opacity(1.0)
        if immediate:
            host = self.modal_sheet_host
            if host._anim_tick_id:
                host.remove_tick_callback(host._anim_tick_id)
                host._anim_tick_id = 0
            host._on_finish_cb = None
            host._anim_state = "idle"
            host.opacity_val = 0.0
            _on_closed()
        else:
            self.modal_sheet_host.start_close_animation(on_finish=_on_closed)

    def _animate_screen_fade(self, old_child, new_child, duration=0.28):
        if hasattr(self, "_fade_anim_tick") and self._fade_anim_tick:
            try:
                self.remove_tick_callback(self._fade_anim_tick)
            except Exception:
                pass
            self._fade_anim_tick = 0

        if not old_child or not new_child:
            return

        start_time = time.time()
        new_child.set_opacity(0.0)

        def on_tick(widget, frame_clock):
            elapsed = time.time() - start_time
            tau = min(1.0, elapsed / duration)
            p = tau * tau * (3.0 - 2.0 * tau)
            old_child.set_opacity(max(0.0, 1.0 - p))
            new_child.set_opacity(min(1.0, p))
            if tau >= 1.0:
                old_child.set_opacity(1.0)
                new_child.set_opacity(1.0)
                self._fade_anim_tick = 0
                return False
            return True

        self._fade_anim_tick = self.add_tick_callback(on_tick)

    def _animate_card_size(self, start_w, start_h, target_w, target_h, duration=0.30, on_done=None):
        if hasattr(self, "_card_size_anim_tick") and self._card_size_anim_tick:
            try:
                self.remove_tick_callback(self._card_size_anim_tick)
            except Exception:
                pass
            self._card_size_anim_tick = 0

        start_time = time.time()

        def on_tick(widget, frame_clock):
            elapsed = time.time() - start_time
            tau = min(1.0, elapsed / duration)
            p = 1.0 - math.pow(1.0 - tau, 3)
            cur_w = int(start_w + (target_w - start_w) * p)
            cur_h = int(start_h + (target_h - start_h) * p)
            self.card.set_size_request(cur_w, cur_h)
            if tau >= 1.0:
                self.card.set_size_request(target_w, target_h)
                self._card_size_anim_tick = 0
                if on_done:
                    on_done()
                return False
            return True

        self._card_size_anim_tick = self.add_tick_callback(on_tick)

    def switch_to_screen(self, screen_name):
        self.hide_modal(immediate=True)
        target = screen_name if screen_name.startswith("screen_") else f"screen_{screen_name}"
        if target in ["screen_lang", "screen_language"]:
            target = "screen_language"

        curr = self.stack.get_visible_child_name()
        old_child = self.stack.get_visible_child()

        if target in ["screen_welcome", "welcome"]:
            target_child = self.stack.get_child_by_name("screen_welcome")
            self._set_stack_slide_direction("screen_welcome")
            if old_child and target_child and old_child != target_child:
                self._animate_screen_fade(old_child, target_child, duration=0.28)
            self.stack.set_visible_child_name("screen_welcome")
            self.morph_terms_to_welcome(animated=False)
            self.card.remove_css_class("mac-card-options")
            self.card.set_size_request(-1, -1)
            return
        elif target in ["screen_terms", "terms"]:
            target_child = self.stack.get_child_by_name("screen_welcome")
            self._set_stack_slide_direction("screen_welcome")
            if old_child and target_child and old_child != target_child:
                self._animate_screen_fade(old_child, target_child, duration=0.28)
            self.stack.set_visible_child_name("screen_welcome")
            self.morph_welcome_to_terms(animated=False)
            self.card.remove_css_class("mac-card-options")
            self.card.set_size_request(-1, -1)
            return

        target_child = self.stack.get_child_by_name(target)
        self._set_stack_slide_direction(target)

        if old_child and target_child and old_child != target_child:
            self._animate_screen_fade(old_child, target_child, duration=0.28)

        if curr in ["screen_user", "screen_language"] and target == "screen_options":
            self.card.add_css_class("mac-card-options")
            self._animate_card_size(650, 490, 480, 350, duration=0.30, on_done=lambda: self.card.set_size_request(-1, -1))
        elif curr == "screen_options" and target in ["screen_user", "screen_language", "screen_welcome", "screen_benchmark_intro", "screen_benchmark_progress", "screen_benchmark_result"]:
            self.card.remove_css_class("mac-card-options")
            self._animate_card_size(480, 350, 650, 490, duration=0.30, on_done=lambda: self.card.set_size_request(-1, -1))
        elif target == "screen_options":
            self.card.add_css_class("mac-card-options")
            self.card.set_size_request(-1, -1)
        else:
            self.card.remove_css_class("mac-card-options")
            self.card.set_size_request(-1, -1)

        self.stack.set_visible_child_name(target)

    def _set_stack_slide_direction(self, target):
        SCREEN_ORDER = [
            "screen_language",
            "screen_user",
            "screen_options",
            "screen_benchmark_intro",
            "screen_benchmark_progress",
            "screen_benchmark_result",
            "screen_welcome",
            "screen_disk",
            "screen_progress",
            "screen_reboot"
        ]
        curr = self.stack.get_visible_child_name()
        if curr in SCREEN_ORDER and target in SCREEN_ORDER:
            c_idx = SCREEN_ORDER.index(curr)
            t_idx = SCREEN_ORDER.index(target)
            if t_idx > c_idx:
                self.stack.set_transition_type(Gtk.StackTransitionType.SLIDE_LEFT)
            elif t_idx < c_idx:
                self.stack.set_transition_type(Gtk.StackTransitionType.SLIDE_RIGHT)

    # --------------------------------------------------------------------------
    # Screen 0: Language Selection (macW1Y Setup Wizard style)
    # --------------------------------------------------------------------------
    def _build_screen_language(self):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        box.set_vexpand(True)
        box.set_valign(Gtk.Align.FILL)
        box.set_halign(Gtk.Align.CENTER)

        # 1. Header Globe Icon
        globe_svg = os.path.join(ASSETS_DIR, "globe_blue.svg")
        if not os.path.exists(globe_svg):
            globe_svg = os.path.join(ASSETS_DIR, "safari_globe.svg")
        img_globe = Gtk.Image.new_from_file(globe_svg)
        img_globe.set_pixel_size(54)
        img_globe.set_halign(Gtk.Align.CENTER)
        img_globe.set_margin_top(6)
        img_globe.set_margin_bottom(10)
        box.append(img_globe)

        # 2. Header Title & Subtitle
        cur_lang = getattr(self, "selected_language", "uk")
        info = LANGUAGE_I18N.get(cur_lang, LANGUAGE_I18N["en"])

        self.lbl_lang_title = Gtk.Label(label=info["title"])
        self.lbl_lang_title.add_css_class("mac-title-large")
        self.lbl_lang_title.set_halign(Gtk.Align.CENTER)
        box.append(self.lbl_lang_title)

        self.lbl_lang_sub = Gtk.Label(label=info["subtitle"])
        self.lbl_lang_sub.add_css_class("mac-subtitle")
        self.lbl_lang_sub.set_halign(Gtk.Align.CENTER)
        self.lbl_lang_sub.set_margin_top(4)
        self.lbl_lang_sub.set_margin_bottom(12)
        box.append(self.lbl_lang_sub)

        # 3. Outer Language List Card
        card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        card.add_css_class("mac-lang-card")
        card.set_halign(Gtk.Align.CENTER)

        scroll = Gtk.ScrolledWindow()
        scroll.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        scroll.set_propagate_natural_height(False)
        scroll.set_min_content_width(372)
        scroll.set_min_content_height(264)
        scroll.set_max_content_height(264)
        scroll.set_vexpand(True)
        card.append(scroll)

        items_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        items_box.set_margin_start(4)
        items_box.set_margin_end(4)
        items_box.set_margin_top(4)
        items_box.set_margin_bottom(2)
        scroll.set_child(items_box)

        self.lang_buttons = {}
        sorted_langs = get_sorted_languages(cur_lang)

        for lang in sorted_langs:
            code = lang["code"]
            btn = Gtk.Button()
            btn.add_css_class("mac-lang-item")
            btn.set_has_frame(False)
            btn.set_cursor_from_name("pointer")

            lbl = Gtk.Label(label=lang["native"])
            lbl.set_halign(Gtk.Align.START)
            lbl.set_hexpand(True)
            btn.set_child(lbl)

            if code == cur_lang:
                btn.add_css_class("selected")

            btn.connect("clicked", lambda b, c=code: self._on_language_selected(c))
            self.lang_buttons[code] = (btn, lbl)
            items_box.append(btn)

        box.append(card)

        # Spacer to anchor buttons at bottom
        spacer = Gtk.Box()
        spacer.set_vexpand(True)
        box.append(spacer)

        # 4. Bottom Action Buttons (Circular Navigation Buttons)
        nav_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=0)
        nav_box.set_halign(Gtk.Align.CENTER)
        nav_box.set_valign(Gtk.Align.END)
        nav_box.set_spacing(100)
        nav_box.set_margin_top(18)
        nav_box.set_margin_bottom(6)

        # Left circular button: Back (Назад)
        b_back = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        b_back.set_halign(Gtk.Align.CENTER)
        self.btn_lang_back = Gtk.Button()
        self.btn_lang_back.add_css_class("mac-circle-nav-btn")
        self.btn_lang_back.set_has_frame(False)
        self.btn_lang_back.set_halign(Gtk.Align.CENTER)
        img_back = Gtk.Image.new_from_file(os.path.join(ASSETS_DIR, "btn_restart.svg"))
        img_back.set_pixel_size(36)
        self.btn_lang_back.set_child(img_back)
        self.btn_lang_back.connect("clicked", lambda b: self._on_language_back())
        b_back.append(self.btn_lang_back)

        self.lbl_lang_back = Gtk.Label(label=self.tr("btn_back", "Back"))
        self.lbl_lang_back.add_css_class("mac-subtitle")
        b_back.append(self.lbl_lang_back)
        nav_box.append(b_back)

        # Right circular button: Continue (Продовжити)
        b_next = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        b_next.set_halign(Gtk.Align.CENTER)
        self.btn_lang_continue = Gtk.Button()
        self.btn_lang_continue.add_css_class("mac-circle-nav-btn")
        self.btn_lang_continue.set_has_frame(False)
        self.btn_lang_continue.set_halign(Gtk.Align.CENTER)
        img_next = Gtk.Image.new_from_file(os.path.join(ASSETS_DIR, "btn_next.svg"))
        img_next.set_pixel_size(36)
        self.btn_lang_continue.set_child(img_next)
        self.btn_lang_continue.connect("clicked", lambda b: self._on_language_continue())
        b_next.append(self.btn_lang_continue)

        self.lbl_lang_continue = Gtk.Label(label=self.tr("installer_continue_btn", "Continue"))
        self.lbl_lang_continue.add_css_class("mac-subtitle")
        b_next.append(self.lbl_lang_continue)
        nav_box.append(b_next)

        box.append(nav_box)
        return box

    def _rebuild_subsequent_screens(self):
        # Recreate menubar in newly selected language
        if hasattr(self, "menubar_box") and self.menubar_box and hasattr(self, "root_box") and self.root_box:
            self.root_box.remove(self.menubar_box)
            self.menubar_box = self._create_menubar()
            self.root_box.prepend(self.menubar_box)

        # Update disk capacity string
        self.disk_info = get_disk_capacity_info(self.selected_language)

        # Rebuild all subsequent stack screens
        screens = [
            ("screen_user", self._build_screen_user),
            ("screen_options", self._build_screen_options),
            ("screen_welcome", self._build_screen_wizard),
            ("screen_disk", self._build_screen_disk),
            ("screen_progress", self._build_screen_progress),
            ("screen_reboot", self._build_screen_reboot),
        ]
        cur_vis = self.stack.get_visible_child_name()
        for name, builder in screens:
            old_child = self.stack.get_child_by_name(name)
            if old_child:
                self.stack.remove(old_child)
            self.stack.add_named(builder(), name)
        if cur_vis and self.stack.get_child_by_name(cur_vis):
            self.stack.set_visible_child_name(cur_vis)

    def _on_language_selected(self, lang_code):
        self.selected_language = lang_code
        is_rtl = mac_i18n.is_rtl(lang_code)
        self.set_direction(Gtk.TextDirection.RTL if is_rtl else Gtk.TextDirection.LTR)

        # Update language selection screen labels
        if hasattr(self, "lbl_lang_title") and self.lbl_lang_title:
            self.lbl_lang_title.set_label(self.tr("select_language", "Select Language"))
        if hasattr(self, "lbl_lang_sub") and self.lbl_lang_sub:
            self.lbl_lang_sub.set_label(self.tr("select_language_sub", "Select the main language for the system interface."))
        if hasattr(self, "lbl_lang_continue") and self.lbl_lang_continue:
            self.lbl_lang_continue.set_label(self.tr("installer_continue_btn", "Continue"))
        if hasattr(self, "lbl_lang_back") and self.lbl_lang_back:
            self.lbl_lang_back.set_label(self.tr("btn_back", "Back"))

        for c, (btn, lbl) in getattr(self, "lang_buttons", {}).items():
            if c == lang_code:
                btn.add_css_class("selected")
            else:
                btn.remove_css_class("selected")

        # Dynamically rebuild all screens in selected language
        self._rebuild_subsequent_screens()

    def _on_language_back(self):
        self.close()

    def _on_language_continue(self):
        try:
            loc_dir = os.path.expanduser("~/.config/mac-styling")
            os.makedirs(loc_dir, exist_ok=True)
            with open(os.path.join(loc_dir, "locale"), "w", encoding="utf-8") as f:
                f.write(f"{self.selected_language}\n")
        except Exception:
            pass
        self.switch_to_screen("screen_user")

