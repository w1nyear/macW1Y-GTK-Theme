    def _open_benchmark_screen(self):
        curr = self.stack.get_visible_child_name()
        if curr not in ("screen_benchmark_intro", "screen_benchmark_progress", "screen_benchmark_result"):
            self._benchmark_prev_screen = curr or "screen_options"
        self.switch_to_screen("screen_benchmark_intro")

    def _on_benchmark_back(self):
        prev = getattr(self, "_benchmark_prev_screen", "screen_options")
        if not prev or prev in ("screen_benchmark_intro", "screen_benchmark_progress", "screen_benchmark_result"):
            prev = "screen_options"
        self.switch_to_screen(prev)

    def _on_confirm_start_benchmark(self):
        self.hide_modal()
        self.switch_to_screen("screen_benchmark_progress")
        self._start_benchmark_execution()

    def _start_benchmark_execution(self):
        self.bench_prog_bar.set_fraction(0.0)
        self.bench_lbl_status.set_text(self.tr("benchmark_starting", "Запуск фонового тестування..."))
        self.bench_lbl_detail.set_text(self.tr("benchmark_measuring", "Вимірювання FPS (до 50 елементів)..."))
        self._benchmark_cancelled = False
        self._benchmark_recommendation = "shader"
        self._benchmark_min_fps = 60.0
        self._benchmark_avg_fps = 60.0

        def run_bench_thread():
            bench_bin = os.path.join(SCRIPT_DIR, "bin", "mac-liquid-benchmark")
            if not os.path.exists(bench_bin) or not os.access(bench_bin, os.X_OK):
                bench_bin = "mac-liquid-benchmark"

            cmd = [bench_bin, "--duration", "10.0"]
            try:
                self._benchmark_process = subprocess.Popen(
                    cmd,
                    stdout=subprocess.PIPE,
                    stderr=subprocess.PIPE,
                    text=True,
                    bufsize=1
                )
            except Exception as e:
                GLib.idle_add(self._show_benchmark_results, 60.0, 60.0, "shader")
                return

            min_fps = 60.0
            avg_fps = 60.0
            recommendation = "shader"

            for line in self._benchmark_process.stdout:
                if self._benchmark_cancelled:
                    break
                line = line.strip()
                if line.startswith("PROGRESS:"):
                    parts = line.split(":")
                    if len(parts) >= 5:
                        try:
                            pct = float(parts[1])
                            n_elems = int(parts[2])
                            fps = float(parts[3])
                            cur_min = float(parts[4])
                            GLib.idle_add(self._update_benchmark_progress, pct, n_elems, fps, cur_min)
                        except Exception:
                            pass
                elif line.startswith("RESULT:"):
                    parts = line.split(":")
                    for p in parts[1:]:
                        if p.startswith("min_fps="):
                            try: min_fps = float(p.split("=")[1])
                            except Exception: pass
                        elif p.startswith("avg_fps="):
                            try: avg_fps = float(p.split("=")[1])
                            except Exception: pass
                        elif p.startswith("recommendation="):
                            recommendation = p.split("=")[1].strip()

            self._benchmark_process.wait()
            if not self._benchmark_cancelled:
                GLib.idle_add(self._show_benchmark_results, min_fps, avg_fps, recommendation)

        t = threading.Thread(target=run_bench_thread, daemon=True)
        t.start()

    def _update_benchmark_progress(self, pct, n_elems, fps, min_fps):
        if not hasattr(self, "bench_prog_bar"):
            return False
        frac = max(0.0, min(1.0, pct / 100.0))
        self.bench_prog_bar.set_fraction(frac)
        sec = int(round(frac * 10.0))
        elem_str = self.tr("elements_short", "ел.")
        self.bench_lbl_status.set_text(f"Секунда {sec} з 10 ({n_elems} {elem_str})")
        self.bench_lbl_detail.set_text(f"Поточна швидкість: {fps:.1f} FPS (мін. {min_fps:.1f} FPS)")
        return False

    def _abort_benchmark(self):
        self._benchmark_cancelled = True
        if hasattr(self, "_benchmark_process") and self._benchmark_process:
            try:
                self._benchmark_process.terminate()
            except Exception:
                pass
        self._on_benchmark_back()

    def _show_benchmark_results(self, min_fps, avg_fps, recommendation):
        self._benchmark_min_fps = min_fps
        self._benchmark_avg_fps = avg_fps
        self._benchmark_recommendation = recommendation

        min_lbl = self.tr("benchmark_min_fps", "Мінімальний FPS")
        avg_lbl = self.tr("benchmark_avg_fps", "Середній FPS")
        self.bench_res_fps.set_text(f"{min_lbl}: {min_fps:.1f} • {avg_lbl}: {avg_fps:.1f}")
        if recommendation == "shader":
            self.bench_res_rec.set_text(self.tr("benchmark_rec_shader", "Рекомендовано: Ефект Liquid Glass (шейдер скла)"))
            self.bench_res_desc.set_text(
                f"Ваша система набрала {min_fps:.1f} FPS (середній: {avg_fps:.1f} FPS при 50 елементах, поріг: 60.0 FPS) та успішно витримала стрес-тест. "
                "Продуктивність графічного процесора достатня для повноцінних фізичних відблисків та рефракції Liquid Glass."
            )
        else:
            self.bench_res_rec.set_text(self.tr("benchmark_rec_blur", "Рекомендовано: Легке розмиття (Blur mode)"))
            self.bench_res_desc.set_text(
                f"Під час стрес-тестування зафіксовано {min_fps:.1f} FPS (середній: {avg_fps:.1f} FPS при 50 елементах, поріг: 60.0 FPS). "
                "Рекомендовано режим розмиття для плавної роботи без перегріву та затримок."
            )

        self.switch_to_screen("screen_benchmark_result")
        return False

    def _apply_benchmark_choice(self):
        is_blur = (getattr(self, "_benchmark_recommendation", "shader") == "blur")
        if hasattr(self, "chk_lowspec") and self.chk_lowspec:
            self.chk_lowspec.set_active(is_blur)

        prev = getattr(self, "_benchmark_prev_screen", "screen_options")
        if not prev or prev in ("screen_benchmark_intro", "screen_benchmark_progress", "screen_benchmark_result"):
            prev = "screen_options"
        self.switch_to_screen(prev)

    # --------------------------------------------------------------------------
    # Worker Subprocess Execution & Live Progress
    # --------------------------------------------------------------------------
    def _start_worker_execution(self):
        self.worker_cancelled = False
        self.worker_done = False
        self.current_fraction = 0.02
        self.target_fraction = 0.02
        self.last_progress_time = time.time()
        self._start_progress_animation()

        if "--demo" in sys.argv or "--preview" in sys.argv:
            self._start_demo_progress()
            return

        def run_thread():
            custom_script = os.environ.get("MAC_INSTALLER_SCRIPT")
            if not custom_script or not os.path.exists(custom_script):
                custom_script = os.path.join(SCRIPT_DIR, "install.sh")

            install_script = custom_script
            uninstall_script = os.path.join(SCRIPT_DIR, "libexec", "macw1y-uninstall")
            is_mock = "--preview" in sys.argv or "--mock-installer" in sys.argv or "-let_me_try_bradar" in sys.argv or "--let_me_try_bradar" in sys.argv or os.environ.get("MAC_MOCK_INSTALLER") == "1"
            mock_arg = ["-let_me_try_bradar"] if is_mock else []

            if self.selected_action == "uninstall":
                if is_mock:
                    cmd = ["bash", install_script, "--gui-worker"] + mock_arg + ["--uninstall"]
                else:
                    cmd = ["sudo", "-S", "bash", uninstall_script, "--yes"]
            elif self.selected_action == "clean_update":
                if is_mock:
                    cmd = ["bash", install_script, "--gui-worker"] + mock_arg + ["--clean-update"]
                else:
                    cmd = ["sudo", "-S", "bash", install_script, "--gui-worker", "--clean-update"]
            else:
                if is_mock:
                    cmd = ["bash", install_script, "--gui-worker"] + mock_arg + ["--install"]
                else:
                    cmd = ["sudo", "-S", "bash", install_script, "--gui-worker", "--install"]

            if getattr(self, "chk_lowspec", None) and self.chk_lowspec.get_active():
                cmd.append("--low-spec")

            try:
                self.worker_process = subprocess.Popen(
                    cmd,
                    stdin=subprocess.PIPE,
                    stdout=subprocess.PIPE,
                    stderr=subprocess.STDOUT,
                    text=True,
                    bufsize=1
                )

                if self.cached_password and self.worker_process.stdin:
                    self.worker_process.stdin.write(self.cached_password + "\n")
                    self.worker_process.stdin.flush()

                for line in self.worker_process.stdout:
                    if self.worker_cancelled:
                        break
                    line_s = line.strip()
                    if not line_s:
                        continue

                    if line_s.startswith("PROGRESS:"):
                        parts = line_s.split(":", 2)
                        if len(parts) >= 3:
                            try:
                                pct = float(parts[1]) / 100.0
                                msg = parts[2]
                                GLib.idle_add(self._update_progress, pct, msg)
                            except Exception:
                                pass
                    elif "Stage " in line_s or "Stage" in line_s:
                        GLib.idle_add(self._parse_stage_line, line_s)

                self.worker_process.wait()
                rc = self.worker_process.returncode

                def on_done():
                    if not self.worker_cancelled:
                        if rc == 0:
                            self.target_fraction = 1.0
                            self.worker_done = True
                            self._update_progress(1.0, "finalizing")
                        else:
                            if hasattr(self, "_prog_tick_id") and self._prog_tick_id:
                                try:
                                    self.remove_tick_callback(self._prog_tick_id)
                                except Exception:
                                    pass
                                self._prog_tick_id = 0
                            self._show_simple_alert("Помилка інсталяції", f"Процес завершився з кодом {rc}. Перевірте системні журнали.")

                GLib.idle_add(on_done)

            except Exception as e:
                def on_err():
                    self._show_simple_alert("Помилка", str(e))
                GLib.idle_add(on_err)

        self.worker_thread = threading.Thread(target=run_thread, daemon=True)
        self.worker_thread.start()

    def _start_progress_animation(self):
        if not hasattr(self, "_prog_tick_id") or self._prog_tick_id == 0:
            self._prog_tick_id = self.add_tick_callback(self._on_progress_tick)

    def _on_progress_tick(self, widget, frame_clock):
        now = time.time()
        diff = self.target_fraction - self.current_fraction
        if diff > 0.0005:
            step = max(0.0008, diff * 0.08)
            self.current_fraction = min(self.target_fraction, self.current_fraction + step)
        elif self.target_fraction < 0.985 and (now - self.last_progress_time) > 0.6:
            ceiling = min(0.985, self.target_fraction + 0.035)
            if self.current_fraction < ceiling:
                self.current_fraction += 0.00016

        self.prog_bar.set_fraction(self.current_fraction)
        self._update_time_label(self.current_fraction)

        if getattr(self, "worker_done", False) and self.current_fraction >= 0.998:
            self.prog_bar.set_fraction(1.0)
            if hasattr(self, "_prog_tick_id") and self._prog_tick_id:
                try:
                    self.remove_tick_callback(self._prog_tick_id)
                except Exception:
                    pass
                self._prog_tick_id = 0
            GLib.timeout_add(350, lambda: self.switch_to_screen("screen_reboot"))
            return False
        return True

    def _update_time_label(self, frac):
        if frac < 0.25:
            rem = self.tr("installer_time_2m", "About 2 minutes remaining…")
        elif frac < 0.60:
            rem = self.tr("installer_time_1m", "About 1 minute remaining…")
        elif frac < 0.88:
            rem = self.tr("installer_time_less_1m", "Less than a minute remaining…")
        else:
            rem = self.tr("installer_time_almost", "Almost finished…")
        self.lbl_prog_time.set_text(rem)

    def _update_progress(self, pct, msg):
        stage_names = {
            "stage1": self.tr("installer_stage1", "Installing system dependencies…"),
            "stage2": self.tr("installer_stage2", "Installing default fonts…"),
            "stage3": self.tr("installer_stage3", "Installing macW1Y themes (GTK3, GTK4, Shell)…"),
            "stage4": self.tr("installer_stage4", "Installing macW1Y icons and panels…"),
            "stage5": self.tr("installer_stage5", "Installing macW1Y sound theme…"),
            "stage6": self.tr("installer_stage6", "Setting Golden Gate wallpaper…"),
            "stage7": self.tr("installer_stage7", "Configuring GNOME Shell extensions…"),
            "stage8": self.tr("installer_stage8", "Integrating settings menu…"),
            "stage9": self.tr("installer_stage9", "Configuring touchpad gestures…"),
            "stage10": self.tr("installer_stage10", "Configuring hardware acceleration…"),
            "stage11": self.tr("installer_stage11", "Configuring GDM lockscreen…"),
            "stage12": self.tr("installer_stage12", "Installing Plymouth boot splash…"),
            "stage13": self.tr("installer_stage13", "Configuring GRUB bootloader…"),
            "finalizing": self.tr("installer_stage_final", "Finalizing system setup…"),
            "done": self.tr("installer_stage_final", "Finalizing system setup…"),
        }
        display_msg = stage_names.get(msg, msg)
        self.target_fraction = max(self.target_fraction, pct)
        self.last_progress_time = time.time()
        self.lbl_prog_status.set_text(display_msg)
        self._start_progress_animation()

    def _parse_stage_line(self, line):
        stage_map = {
            "Stage 1/": (0.10, "stage1"),
            "Stage 2/": (0.20, "stage2"),
            "Stage 3/": (0.35, "stage3"),
            "Stage 4/": (0.45, "stage4"),
            "Stage 5/": (0.55, "stage5"),
            "Stage 6/": (0.65, "stage6"),
            "Stage 7/": (0.75, "stage7"),
            "Stage 8/": (0.82, "stage8"),
            "Stage 9/": (0.88, "stage9"),
            "Stage 10/": (0.92, "stage10"),
            "Stage 11/": (0.95, "stage11"),
            "Stage 12/": (0.97, "stage12"),
            "Stage 13/": (0.98, "stage13"),
            "Finalizing": (0.99, "finalizing"),
        }
        for k, (pct, stage_key) in stage_map.items():
            if k in line:
                self._update_progress(pct, stage_key)
                break

    def _start_demo_progress(self):
        self.worker_cancelled = False
        self.worker_done = False
        self.current_fraction = 0.02
        self.target_fraction = 0.02
        self.last_progress_time = time.time()
        self._start_progress_animation()

        steps = [
            (0.08, "stage1"),
            (0.18, "stage2"),
            (0.32, "stage3"),
            (0.46, "stage4"),
            (0.58, "stage5"),
            (0.68, "stage6"),
            (0.78, "stage7"),
            (0.86, "stage8"),
            (0.92, "stage9"),
            (0.96, "stage12"),
            (1.00, "finalizing")
        ]
        def run_demo():
            for pct, stage in steps:
                if self.worker_cancelled:
                    break
                GLib.idle_add(self._update_progress, pct, stage)
                time.sleep(0.9)
            if not self.worker_cancelled:
                self.worker_done = True
                self.target_fraction = 1.0
        threading.Thread(target=run_demo, daemon=True).start()

    def _show_simple_alert(self, title, text):
        sheet = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        sheet.add_css_class("mac-modal-sheet")
        sheet.add_css_class("mac-alert-sheet")

        lbl_t = Gtk.Label(label=title)
        lbl_t.add_css_class("mac-modal-title")
        lbl_t.set_halign(Gtk.Align.START)
        lbl_t.set_xalign(0.0)
        lbl_t.set_wrap(True)
        lbl_t.set_max_width_chars(28)
        sheet.append(lbl_t)

        lbl_s = Gtk.Label(label=text)
        lbl_s.add_css_class("mac-modal-desc")
        lbl_s.set_halign(Gtk.Align.START)
        lbl_s.set_xalign(0.0)
        lbl_s.set_wrap(True)
        lbl_s.set_max_width_chars(32)
        lbl_s.set_margin_top(2)
        sheet.append(lbl_s)

        btn_row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        btn_row.set_halign(Gtk.Align.FILL)
        btn_row.set_hexpand(True)
        btn_row.set_margin_top(10)

        btn_ok = Gtk.Button(label="OK")
        btn_ok.add_css_class("mac-modal-btn-primary")
        btn_ok.set_hexpand(True)
        btn_ok.set_halign(Gtk.Align.FILL)
        btn_ok.connect("clicked", lambda b: self.hide_modal())
        btn_row.append(btn_ok)
        sheet.append(btn_row)

        self.show_modal(sheet)
        GLib.idle_add(btn_ok.grab_focus)

# ------------------------------------------------------------------------------
# Application Entry Point
# ------------------------------------------------------------------------------
class MacRecoveryApp(Gtk.Application):
    def __init__(self, action_override=None, preview_screen=None, preview_modal=None, cached_password=None, initial_lang=None):
        super().__init__(
            application_id="org.mactheme.installer.gui",
            flags=Gio.ApplicationFlags.NON_UNIQUE
        )
        self.action_override = action_override
        self.preview_screen = preview_screen
        self.preview_modal = preview_modal
        self.cached_password = cached_password
        self.initial_lang = initial_lang

    def do_activate(self):
        accent_hex = get_system_accent_color()
        effective_css = RECOVERY_CSS.replace("@mac_accent_color", accent_hex)
        css_provider = Gtk.CssProvider()
        css_provider.load_from_data(effective_css.encode("utf-8") if isinstance(effective_css, str) else effective_css)
        Gtk.StyleContext.add_provider_for_display(
            Gdk.Display.get_default(),
            css_provider,
            Gtk.STYLE_PROVIDER_PRIORITY_USER
        )

        settings = Gtk.Settings.get_default()
        if settings and hasattr(settings.props, "gtk_entry_select_on_focus"):
            try:
                settings.set_property("gtk-entry-select-on-focus", False)
            except Exception:
                pass

        if not any(arg in sys.argv for arg in ("--no-kiosk", "--preview", "--fullscreen-preview", "--benchmark", "-benchmark")):
            setup_installer_session()
            kiosk_guard.enter()

        act_about = Gio.SimpleAction.new("about", None)
        act_about.connect("activate", lambda a, p: self.win._show_simple_alert("Про macW1Y", f"macW1Y Release (v{get_package_version()})\nmacW1Y Transformation Modpack for {get_system_os_info()}"))
        self.add_action(act_about)

        act_reboot = Gio.SimpleAction.new("reboot", None)
        act_reboot.connect("activate", lambda a, p: self.win._on_system_reboot())
        self.add_action(act_reboot)

        act_poweroff = Gio.SimpleAction.new("poweroff", None)
        act_poweroff.connect("activate", lambda a, p: subprocess.run(["systemctl", "poweroff"], check=False))
        self.add_action(act_poweroff)

        act_term = Gio.SimpleAction.new("terminal", None)
        act_term.connect("activate", lambda a, p: launch_terminal())
        self.add_action(act_term)

        act_bench = Gio.SimpleAction.new("benchmark", None)
        act_bench.connect("activate", lambda a, p: self.win._open_benchmark_screen())
        self.add_action(act_bench)

        act_disk = Gio.SimpleAction.new("disk_utility", None)
        act_disk.connect("activate", lambda a, p: launch_disk_utility())
        self.add_action(act_disk)

        def _show_sysinfo():
            pkg_v = get_package_version()
            inst_v = get_installed_version()
            inst_str = f"v{inst_v}" if inst_v else "Не встановлено"
            self.win._show_simple_alert(
                "Інформація про систему",
                f"ОС: {get_system_os_info()}\nВерсія інсталятора macW1Y: v{pkg_v}\nПоточна встановлена версія: {inst_str}\nДиск: {get_disk_capacity_info()}"
            )

        act_sysinfo = Gio.SimpleAction.new("sysinfo", None)
        act_sysinfo.connect("activate", lambda a, p: _show_sysinfo())
        self.add_action(act_sysinfo)

        act_close = Gio.SimpleAction.new("close", None)
        act_close.connect("activate", lambda a, p: self.win._show_modal_cancel_confirm())
        self.add_action(act_close)

        act_undo = Gio.SimpleAction.new("undo", None)
        act_undo.connect("activate", lambda a, p: None)
        self.add_action(act_undo)

        act_redo = Gio.SimpleAction.new("redo", None)
        act_redo.connect("activate", lambda a, p: None)
        self.add_action(act_redo)

        act_min = Gio.SimpleAction.new("minimize", None)
        act_min.connect("activate", lambda a, p: None)
        self.add_action(act_min)

        act_noop = Gio.SimpleAction.new("noop", None)
        act_noop.connect("activate", lambda a, p: None)
        self.add_action(act_noop)

        self.win = MacRecoveryInstallerWindow(
            self,
            action_override=self.action_override,
            preview_screen=self.preview_screen,
            preview_modal=self.preview_modal,
            cached_password=self.cached_password,
            initial_lang=self.initial_lang
        )
        self.win.present()

def main():
    action_override = None
    preview_screen = None
    preview_modal = None
    cached_password = None
    initial_lang = None

    for i, arg in enumerate(sys.argv[1:], 1):
        if arg.startswith("--screen="):
            preview_screen = arg.split("=")[1]
        elif arg == "--screen" and i < len(sys.argv) - 1:
            preview_screen = sys.argv[i + 1]
        elif arg.startswith("--action="):
            action_override = arg.split("=")[1]
        elif arg == "--action" and i < len(sys.argv) - 1:
            action_override = sys.argv[i + 1]
        elif arg.startswith("--modal="):
            preview_modal = arg.split("=")[1]
        elif arg == "--modal" and i < len(sys.argv) - 1:
            preview_modal = sys.argv[i + 1]
        elif arg.startswith("--password="):
            cached_password = arg.split("=")[1]
        elif arg.startswith("--lang="):
            initial_lang = arg.split("=")[1]
        elif arg in ("--benchmark", "-benchmark"):
            preview_screen = "screen_benchmark_intro"

    def sig_handler(sig, frame):
        kiosk_guard.leave()
        sys.exit(0)

    signal.signal(signal.SIGINT, sig_handler)
    signal.signal(signal.SIGTERM, sig_handler)

    app = MacRecoveryApp(
        action_override=action_override,
        preview_screen=preview_screen,
        preview_modal=preview_modal,
        cached_password=cached_password,
        initial_lang=initial_lang
    )
    return app.run([])

if __name__ == "__main__":
    sys.exit(main())
