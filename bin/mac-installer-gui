        spacer.set_hexpand(True)
        btn_row.append(spacer)

        btn_apply = Gtk.Button(label=self.tr("benchmark_btn_apply", "Застосувати та повернутися"))
        btn_apply.add_css_class("mac-btn-pill-primary")
        btn_apply.set_halign(Gtk.Align.END)
        btn_apply.connect("clicked", lambda b: self._apply_benchmark_choice())
        btn_row.append(btn_apply)

