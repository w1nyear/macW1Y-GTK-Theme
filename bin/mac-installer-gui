def get_sorted_languages(selected_locale="uk"):
    base = (selected_locale or "uk").split(".")[0].replace("-", "_").lower().split("_")[0]
    sys_lang = None
    for l in SUPPORTED_LANGUAGES:
        if l["code"] == selected_locale or l["code"] == base:
            sys_lang = l
            break
    if not sys_lang:
        sys_lang = SUPPORTED_LANGUAGES[0]
    others = [l for l in SUPPORTED_LANGUAGES if l["code"] != sys_lang["code"]]
    others.sort(key=lambda x: x["native"])
    return [sys_lang] + others

def get_target_username():
    sudo_user = os.environ.get("SUDO_USER")
    if sudo_user:
        return sudo_user
    return os.environ.get("USER", "vitaliy")

def get_user_display_name(username):
    try:
        import pwd
        pw = pwd.getpwnam(username)
        gecos = pw.pw_gecos.split(',')[0].strip()
        if gecos:
            return gecos
    except Exception:
        pass
    return username.capitalize()

def get_system_accent_color():
    try:
        res = subprocess.check_output(
            ["gsettings", "get", "org.gnome.desktop.interface", "accent-color"],
            text=True, stderr=subprocess.DEVNULL
        ).strip().strip("'")
        accent_map = {
            'blue': '#007aff',
            'teal': '#30b0c7',
            'green': '#34c759',
            'yellow': '#ffcc00',
            'orange': '#ff6a00',
            'red': '#ff3b30',
            'pink': '#ff2d55',
            'purple': '#af52de',
            'slate': '#8e8e93',
            'brown': '#a27447',
        }
        return accent_map.get(res, '#ff6a00')
    except Exception:
        return '#ff6a00'

def setup_installer_session():
    disable_exts = [
        "ubuntu-dock@ubuntu.com",
        "tiling-assistant@ubuntu.com",
        "ding@rastersoft.com",
        "dash-to-dock@micxgx.gmail.com",
        "stage-manager@gnome-stage-manager",
        "snapd-prompting@canonical.com",
        "web-search-provider@ubuntu.com",
    ]
    enable_exts = [
        "user-theme@gnome-shell-extensions.gcampax.github.com",
        "eval-helper@mactheme",
        "blur-my-shell@aunetx",
        "dash2dock-motion@unmade.space",
        "appmenu@ChathurangaBW.github.io",
        "kiwi@kemma",
        "desktop-widgets@r3nhick",
        "macos-touchpad-gestures@mactheme",
        "compiz-alike-magic-lamp-effect@hermes83.github.com",
        "cupertino-dock-lite@rinzler69-wastaken.github.com",
        "custom-command-toggle@storageb.github.com",
        "liquid-glass@thinkingcoding1231.gmail.com",
        "quick-settings-scroll@diskmth.fr",
        "Rounded_Corners@lennart-k",
        "volume-percentage-quick-settings@imdarktom",
        "wack-lockscreen-clock@rinzler69-wastaken.github.com",
        "wifi-hotspot-quick-settings@aryan10.github.io",
    ]
    for ext in disable_exts:
        subprocess.run(["gnome-extensions", "disable", ext], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=False)
    for ext in enable_exts:
        subprocess.run(["gnome-extensions", "enable", ext], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=False)

    subprocess.run(["gsettings", "set", "org.gnome.shell.extensions.user-theme", "name", "macW1Y-Dark"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=False)
    subprocess.run(["gsettings", "set", "org.gnome.desktop.interface", "gtk-theme", "macW1Y-Dark"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=False)
    subprocess.run(["gsettings", "set", "org.gnome.desktop.interface", "icon-theme", "MacTahoe-Dark"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=False)
    subprocess.run(["gsettings", "set", "org.gnome.desktop.interface", "font-name", "Inter 10"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=False)

def get_user_avatar_path(username):
    candidates = [
        os.path.join(ASSETS_DIR, "user_avatar.png"),
        os.path.expanduser(f"~{username}/.face"),
        os.path.expanduser(f"~{username}/.face.icon"),
        f"/var/lib/AccountsService/icons/{username}",
        os.path.join(SCRIPT_DIR, "icons", "default-avatar.png"),
    ]
    for c in candidates:
        if os.path.exists(c) and os.path.getsize(c) > 0:
            return c
    return os.path.join(SCRIPT_DIR, "icons", "default-avatar.png")

def get_disk_capacity_info():
    try:
        total, used, free = shutil.disk_usage("/")
        total_gb = int(total / (1024**3))
        avail_gb = int(free / (1024**3))
        return f"{total_gb} ГБ всього, {avail_gb} ГБ доступно"
    except Exception:
        return "128 ГБ всього, 64 ГБ доступно"

def get_battery_info():
    try:
        cap_files = glob.glob("/sys/class/power_supply/BAT*/capacity")
        if cap_files:
            with open(cap_files[0], "r", encoding="utf-8") as f:
                cap = f.read().strip()
                if cap:
                    return f"{cap}%"
    except Exception:
        pass
    return "100%"

def get_modpack_version():
    candidates = [
        VERSION_FILE,
        os.path.expanduser("~/.config/mac-styling/version"),
        "/etc/macW1Y/version"
    ]
    for c in candidates:
        if os.path.exists(c):
            try:
                with open(c, "r", encoding="utf-8") as f:
                    v = f.read().strip()
                    if v:
                        return v
            except Exception:
                pass
    return "0.7"

# ------------------------------------------------------------------------------
# GNOME Shell & Kiosk Coordination
# ------------------------------------------------------------------------------
class KioskGuard:
    def __init__(self):
        self.saved_overlay = None
        self.saved_switch_apps = None
        self.saved_switch_windows = None
        self.active = False

    def eval_shell(self, js_code):
        cmd = ["gdbus", "call", "--session", "--dest", "org.gnome.Shell",
               "--object-path", "/org/gnome/Shell/Extensions/EvalHelper",
               "--method", "org.gnome.Shell.Extensions.EvalHelper.Eval", js_code]
        try:
            res = subprocess.run(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, check=False)
            return res.returncode == 0
        except Exception:
            return False

    def enter(self):
        if self.active:
            return
        self.active = True
        try:
            res = subprocess.run(["gsettings", "get", "org.gnome.mutter", "overlay-key"],
                                 stdout=subprocess.PIPE, text=True, check=False)
            self.saved_overlay = res.stdout.strip()
            res2 = subprocess.run(["gsettings", "get", "org.gnome.desktop.wm.keybindings", "switch-applications"],
                                  stdout=subprocess.PIPE, text=True, check=False)
            self.saved_switch_apps = res2.stdout.strip()

            subprocess.run(["gsettings", "set", "org.gnome.mutter", "overlay-key", "''"], check=False)
            subprocess.run(["gsettings", "set", "org.gnome.desktop.wm.keybindings", "switch-applications", "[]"], check=False)
        except Exception:
            pass

        js = """(() => {
            if (typeof Main !== 'undefined' && Main.panel) {
                Main.panel.hide();
            }
            if (typeof Main !== 'undefined' && Main.overview) {
                Main.overview.hide();
            }
            try {
                let wins = global.display.get_tab_list(0, null);
                for (let w of wins) {
                    if (w.get_window_type() === 0) {
                        w.minimize();
                    }
                }
            } catch (_) {}
            return true;
        })()"""
        self.eval_shell(js)

    def leave(self):
        if not self.active:
            return
        self.active = False
        try:
            if self.saved_overlay and self.saved_overlay != "''":
                subprocess.run(["gsettings", "set", "org.gnome.mutter", "overlay-key", self.saved_overlay], check=False)
            else:
                subprocess.run(["gsettings", "set", "org.gnome.mutter", "overlay-key", "'Super'"], check=False)

            if self.saved_switch_apps and self.saved_switch_apps != "[]":
                subprocess.run(["gsettings", "set", "org.gnome.desktop.wm.keybindings", "switch-applications", self.saved_switch_apps], check=False)
            else:
                subprocess.run(["gsettings", "set", "org.gnome.desktop.wm.keybindings", "switch-applications", "['<Super>Tab', '<Alt>Tab']"], check=False)
        except Exception:
            pass

        js = """(() => {
            if (typeof Main !== 'undefined' && Main.panel) {
                Main.panel.show();
            }
            return true;
        })()"""
        self.eval_shell(js)

kiosk_guard = KioskGuard()
atexit.register(kiosk_guard.leave)

