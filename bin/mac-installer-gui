    def _on_forgot_password(self, btn):
        self._show_simple_alert(
            "Відновлення пароля",
            "Для скидання або зміни пароля облікового запису скористайтеся меню відновлення GRUB або зверніться до системного адміністратора."
        )

    # --------------------------------------------------------------------------
    # Screen 2: Password Modal Sheet (Photo 2)
    # --------------------------------------------------------------------------
    def _show_modal_password(self):
        sheet = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        sheet.add_css_class("mac-modal-sheet")
        sheet.add_css_class("mac-alert-sheet")

        lbl_prompt = Gtk.Label(label=f"Введіть пароль для «{self.display_name}», щоб продовжити:")
        lbl_prompt.add_css_class("mac-modal-title")
        lbl_prompt.set_halign(Gtk.Align.START)
        lbl_prompt.set_xalign(0.0)
        lbl_prompt.set_wrap(True)
        sheet.append(lbl_prompt)

        row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        row.set_margin_top(2)
        lbl_pass = Gtk.Label(label="Пароль:")
        lbl_pass.add_css_class("mac-field-label")
        lbl_pass.set_halign(Gtk.Align.START)
        lbl_pass.set_valign(Gtk.Align.CENTER)
        row.append(lbl_pass)

        entry_pass = Gtk.Entry()
        entry_pass.add_css_class("mac-entry")
        entry_pass.set_visibility(False)
        entry_pass.set_invisible_char("•")
        entry_pass.set_input_purpose(Gtk.InputPurpose.FREE_FORM)
        entry_pass.set_hexpand(True)

        if self.cached_password:
            entry_pass.set_text(self.cached_password)

        entry_pass.connect("notify::has-focus", lambda e, p: GLib.idle_add(lambda: (e.set_position(-1), e.select_region(-1, -1))))
        row.append(entry_pass)
        sheet.append(row)

        lbl_error = Gtk.Label()
        lbl_error.add_css_class("mac-modal-desc")
        lbl_error.set_halign(Gtk.Align.START)
        lbl_error.set_xalign(0.0)
        lbl_error.set_markup("<span color='#ff453a'>Невірний пароль, спробуйте ще раз.</span>")
        lbl_error.set_visible(False)
        sheet.append(lbl_error)

        btn_row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        btn_row.set_homogeneous(True)
        btn_row.set_hexpand(True)
        btn_row.set_halign(Gtk.Align.FILL)
        btn_row.set_margin_top(8)

        btn_cancel = Gtk.Button(label="Скасувати")
        btn_cancel.add_css_class("mac-modal-btn-secondary")
        btn_cancel.set_hexpand(True)
        btn_cancel.set_halign(Gtk.Align.FILL)
        btn_cancel.connect("clicked", lambda b: self.hide_modal())
        btn_row.append(btn_cancel)

        btn_cont = Gtk.Button(label="Продовжити")
        btn_cont.add_css_class("mac-modal-btn-primary")
        btn_cont.set_hexpand(True)
        btn_cont.set_halign(Gtk.Align.FILL)

        def on_submit():
            pwd = entry_pass.get_text()
            if not pwd:
                lbl_error.set_markup("<span color='#ff453a'>Будь ласка, введіть пароль.</span>")
                lbl_error.set_visible(True)
                return

            btn_cont.set_sensitive(False)
            btn_cont.set_label("Перевірка...")

            def check_thread():
                try:
                    p = subprocess.run(["sudo", "-S", "-v"],
                                       input=(pwd + "\n").encode(),
                                       stdout=subprocess.DEVNULL,
                                       stderr=subprocess.DEVNULL,
                                       check=False)
                    ok = (p.returncode == 0)
                except Exception:
                    ok = False

                def finish():
                    btn_cont.set_sensitive(True)
                    btn_cont.set_label("Продовжити")
                    if ok or "--preview" in sys.argv:
                        self.cached_password = pwd
                        self.hide_modal()
                        self.switch_to_screen("screen_options")
                    else:
                        lbl_error.set_markup("<span color='#ff453a'>Невірний пароль. Спробуйте ще раз.</span>")
                        lbl_error.set_visible(True)
                        entry_pass.grab_focus()
                        entry_pass.set_position(-1)
                        entry_pass.select_region(-1, -1)

                GLib.idle_add(finish)

            threading.Thread(target=check_thread, daemon=True).start()

        btn_cont.connect("clicked", lambda b: on_submit())
        entry_pass.connect("activate", lambda e: on_submit())
        btn_row.append(btn_cont)
        sheet.append(btn_row)

        self.show_modal(sheet)
        GLib.idle_add(entry_pass.grab_focus)

    # --------------------------------------------------------------------------
    # Screen 3: Recovery Options Grid (Photo 3 - 4 Cards)
    # --------------------------------------------------------------------------
    def _build_screen_options(self):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        box.set_vexpand(False)

        cards_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        cards_box.set_vexpand(False)
        box.append(cards_box)

        self.option_widgets = {}

        options_data = [
            ("clean_update",
             os.path.join(ASSETS_DIR, "time_machine.svg"),
             "(Чисте) оновлення модпаку",
             "Оновити всі компоненти macW1Y або виконати чисте перевстановлення зі збереженням налаштувань."),
            ("install",
             os.path.join(ASSETS_DIR, "install_macw1y.svg"),
             "Інсталяція macW1Y",
             "Встановити або оновити macW1Y на цей комп'ютер."),
            ("repo",
             os.path.join(ASSETS_DIR, "safari_globe.svg"),
             "GitHub репозиторій macW1Y",
             "Відвідати офіційну сторінку репозиторію macW1Y для отримання детальної інформації."),
            ("uninstall",
             os.path.join(ASSETS_DIR, "disk_utility.svg"),
             "Видалити macW1Y",
             "Повне видалення macW1Y та повернення до стандартного GNOME.")
        ]

        def select_opt(action_id):
            self.selected_action = action_id
            for act, widget in self.option_widgets.items():
                if act == action_id:
                    widget.add_css_class("selected")
                else:
                    widget.remove_css_class("selected")

        for act_id, icon_p, title, desc in options_data:
            row_btn = Gtk.Button()
            row_btn.add_css_class("mac-option-row")
            if act_id == self.selected_action:
                row_btn.add_css_class("selected")

            r_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
            img = Gtk.Image.new_from_file(icon_p)
            img.set_pixel_size(36)
            r_box.append(img)

            t_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=1)
            lbl_t = Gtk.Label(label=title)
            lbl_t.add_css_class("mac-option-title")
            lbl_t.set_halign(Gtk.Align.START)
            t_box.append(lbl_t)

            lbl_d = Gtk.Label(label=desc)
            lbl_d.add_css_class("mac-option-desc")
            lbl_d.set_halign(Gtk.Align.START)
            lbl_d.set_wrap(True)
            lbl_d.set_max_width_chars(46)
            t_box.append(lbl_d)

            r_box.append(t_box)
            row_btn.set_child(r_box)

            row_btn.connect("clicked", lambda b, aid=act_id: select_opt(aid))
            cards_box.append(row_btn)
            self.option_widgets[act_id] = row_btn

        btn_row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=0)
        btn_row.set_halign(Gtk.Align.END)
        btn_row.set_margin_top(10)
        btn_row.set_margin_bottom(0)

        btn_cont = Gtk.Button(label="Продовжити")
        btn_cont.add_css_class("mac-btn-options-continue")
        btn_cont.connect("clicked", self._on_options_continue)
        btn_row.append(btn_cont)
        box.append(btn_row)

        return box

    def _on_options_continue(self, btn):
        if self.selected_action in ["clean_update", "install"]:
            self.switch_to_screen("screen_welcome")
        elif self.selected_action == "repo":
            subprocess.Popen(["xdg-open", "https://github.com/w1nyear/macW1Y-GTK-Theme"])
        elif self.selected_action == "uninstall":
            self._show_modal_uninstall_confirm()

    def _show_modal_uninstall_confirm(self):
        sheet = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        sheet.add_css_class("mac-modal-sheet")
        sheet.add_css_class("mac-alert-sheet")

        lbl_t = Gtk.Label(label="Ви дійсно хочете видалити macW1Y?")
        lbl_t.add_css_class("mac-modal-title")
        lbl_t.set_halign(Gtk.Align.START)
        lbl_t.set_xalign(0.0)
        lbl_t.set_wrap(True)
        sheet.append(lbl_t)

        lbl_sub = Gtk.Label(label="Всі теми оформлення, розширення, іконки та оптимізації macW1Y будуть видалені. Стандартний робочий стіл Ubuntu буде відновлено.")
        lbl_sub.add_css_class("mac-modal-desc")
        lbl_sub.set_halign(Gtk.Align.START)
        lbl_sub.set_xalign(0.0)
        lbl_sub.set_wrap(True)
        lbl_sub.set_margin_top(2)
        sheet.append(lbl_sub)

        btn_row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        btn_row.set_homogeneous(True)
        btn_row.set_hexpand(True)
        btn_row.set_halign(Gtk.Align.FILL)
        btn_row.set_margin_top(12)

        btn_cancel = Gtk.Button(label="Скасувати")
        btn_cancel.add_css_class("mac-modal-btn-secondary")
        btn_cancel.set_hexpand(True)
        btn_cancel.set_halign(Gtk.Align.FILL)
        btn_cancel.connect("clicked", lambda b: self.hide_modal())
        btn_row.append(btn_cancel)

        btn_del = Gtk.Button(label="Видалити")
        btn_del.add_css_class("mac-modal-btn-primary")
        btn_del.set_hexpand(True)
        btn_del.set_halign(Gtk.Align.FILL)
        btn_del.connect("clicked", self._on_confirm_uninstall)
        btn_row.append(btn_del)
        sheet.append(btn_row)

        self.show_modal(sheet)
        GLib.idle_add(btn_cancel.grab_focus)

    def _on_confirm_uninstall(self, btn):
        self.hide_modal()
        self.selected_action = "uninstall"
        self.switch_to_screen("screen_progress")
        self._start_worker_execution()

