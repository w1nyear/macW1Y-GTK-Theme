    def _on_system_reboot(self):
        kiosk_guard.leave()
        try:
            subprocess.run(["systemctl", "reboot"], check=False)
        except Exception:
            subprocess.run(["reboot"], check=False)

    # --------------------------------------------------------------------------
    # Worker Subprocess Execution & Live Progress
    # --------------------------------------------------------------------------
    def _start_worker_execution(self):
        self.worker_cancelled = False

        if "--demo" in sys.argv or "--preview" in sys.argv:
            self._start_demo_progress()
            return

        def run_thread():
            install_script = os.path.join(SCRIPT_DIR, "install.sh")
            uninstall_script = os.path.join(SCRIPT_DIR, "uninstall.sh")

            if self.selected_action == "uninstall":
                cmd = ["sudo", "-S", "bash", uninstall_script, "--yes"]
            elif self.selected_action == "clean_update":
                cmd = ["sudo", "-S", "bash", install_script, "--gui-worker", "--clean-update"]
            else:
                cmd = ["sudo", "-S", "bash", install_script, "--gui-worker", "--install"]

            try:
                self.worker_process = subprocess.Popen(
                    cmd,
                    stdin=subprocess.PIPE,
                    stdout=subprocess.PIPE,
                    stderr=subprocess.STDOUT,
                    text=True,
                    bufsize=1
                )

                if self.cached_password and self.worker_process.stdin:
                    self.worker_process.stdin.write(self.cached_password + "\n")
                    self.worker_process.stdin.flush()

                for line in self.worker_process.stdout:
                    if self.worker_cancelled:
                        break
                    line_s = line.strip()
                    if not line_s:
                        continue

                    if line_s.startswith("PROGRESS:"):
                        parts = line_s.split(":", 2)
                        if len(parts) >= 3:
                            try:
                                pct = float(parts[1]) / 100.0
                                msg = parts[2]
                                GLib.idle_add(self._update_progress, pct, msg)
                            except Exception:
                                pass
                    elif "Stage " in line_s or "Stage" in line_s:
                        GLib.idle_add(self._parse_stage_line, line_s)

                self.worker_process.wait()
                rc = self.worker_process.returncode

                def on_done():
                    if not self.worker_cancelled:
                        if rc == 0:
                            self.switch_to_screen("screen_reboot")
                        else:
                            self._show_simple_alert("Помилка інсталяції", f"Процес завершився з кодом {rc}. Перевірте системні журнали.")

                GLib.idle_add(on_done)

            except Exception as e:
                def on_err():
                    self._show_simple_alert("Помилка", str(e))
                GLib.idle_add(on_err)

        self.worker_thread = threading.Thread(target=run_thread, daemon=True)
        self.worker_thread.start()

    def _update_progress(self, pct, msg):
        stage_names = {
            "stage1": "Встановлення системних залежностей...",
            "stage2": "Встановлення шрифтів Inter...",
            "stage3": "Встановлення тем macW1Y (GTK3, GTK4, Shell)...",
            "stage4": "Встановлення MacTahoe іконок та панелей...",
            "stage5": "Встановлення звукової теми macOS...",
            "stage6": "Встановлення шпалер Golden Gate...",
            "stage7": "Налаштування розширень GNOME Shell...",
            "stage8": "Інтеграція в меню Налаштування (Settings)...",
            "stage9": "Налаштування жестів та тачпада...",
            "stage10": "Конфігурація апаратного прискорення...",
            "stage11": "Налаштування екрана блокування GDM...",
            "stage12": "Встановлення Plymouth boot splash...",
            "stage13": "Налаштування завантажувача GRUB...",
            "finalizing": "Завершення налаштування системи...",
        }
        display_msg = stage_names.get(msg, msg)
        self.prog_bar.set_fraction(pct)
        self.lbl_prog_status.set_text(display_msg)
        if pct < 0.2:
            rem = "Залишилось приблизно 2 хв."
        elif pct < 0.5:
            rem = "Залишилось приблизно 1 хв."
        elif pct < 0.8:
            rem = "Залишилось менше хвилини..."
        else:
            rem = "Майже завершено..."
        self.lbl_prog_time.set_text(rem)

    def _parse_stage_line(self, line):
        stage_map = {
            "Stage 1/": (0.10, "Встановлення системних залежностей..."),
            "Stage 2/": (0.20, "Встановлення шрифтів Inter..."),
            "Stage 3/": (0.35, "Встановлення тем macW1Y (GTK3, GTK4, Shell)..."),
            "Stage 4/": (0.45, "Встановлення MacTahoe іконок та панелей..."),
            "Stage 5/": (0.55, "Встановлення звукової теми macOS..."),
            "Stage 6/": (0.65, "Встановлення шпалер Golden Gate..."),
            "Stage 7/": (0.75, "Налаштування розширень GNOME Shell..."),
            "Stage 8/": (0.82, "Інтеграція в меню Налаштування (Settings)..."),
            "Stage 9/": (0.88, "Налаштування жестів та тачпада..."),
            "Stage 10/": (0.92, "Конфігурація апаратного прискорення..."),
            "Stage 11/": (0.95, "Налаштування екрана блокування GDM..."),
            "Stage 12/": (0.97, "Встановлення Plymouth boot splash..."),
            "Stage 13/": (0.98, "Налаштування завантажувача GRUB..."),
            "Finalizing": (0.99, "Завершення налаштування системи..."),
        }
        for k, (pct, desc) in stage_map.items():
            if k in line:
                self._update_progress(pct, desc)
                break

    def _start_demo_progress(self):
        steps = [
            (0.05, "Перевірка системи та цільового диска..."),
            (0.15, "Встановлення системних залежностей..."),
            (0.30, "Встановлення шрифтів Inter..."),
            (0.45, "Встановлення тем оформлення MacTahoe..."),
            (0.60, "Налаштування розширень GNOME Shell..."),
            (0.75, "Оновлення конфігурацій Dock та OSD..."),
            (0.90, "Оновлення системних кешів..."),
            (1.00, "Встановлення завершено!")
        ]
        def run_demo():
            for pct, msg in steps:
                if self.worker_cancelled:
                    break
                GLib.idle_add(self._update_progress, pct, msg)
                time.sleep(1.0)
            if not self.worker_cancelled:
                GLib.idle_add(lambda: self.switch_to_screen("screen_reboot"))
        threading.Thread(target=run_demo, daemon=True).start()

    def _show_simple_alert(self, title, text):
        sheet = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14)
        sheet.add_css_class("mac-modal-sheet")
        sheet.add_css_class("mac-alert-sheet")
        sheet.set_halign(Gtk.Align.CENTER)

        lbl_t = Gtk.Label(label=title)
        lbl_t.add_css_class("mac-title-medium")
        lbl_t.set_justify(Gtk.Justification.CENTER)
        sheet.append(lbl_t)

        lbl_s = Gtk.Label(label=text)
        lbl_s.add_css_class("mac-subtitle")
        lbl_s.set_justify(Gtk.Justification.CENTER)
        lbl_s.set_wrap(True)
        lbl_s.set_max_width_chars(38)
        sheet.append(lbl_s)

        btn_col = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        btn_col.set_hexpand(True)
        btn_col.set_margin_top(10)

        btn_ok = Gtk.Button(label="OK")
        btn_ok.add_css_class("mac-btn-primary")
        btn_ok.set_hexpand(True)
        btn_ok.connect("clicked", lambda b: self.hide_modal())
        btn_col.append(btn_ok)
        sheet.append(btn_col)

        self.show_modal(sheet)

# ------------------------------------------------------------------------------
# Application Entry Point
# ------------------------------------------------------------------------------
class MacRecoveryApp(Gtk.Application):
    def __init__(self, action_override=None, preview_screen=None, preview_modal=None):
        super().__init__(
            application_id="org.mactheme.installer.gui",
            flags=Gio.ApplicationFlags.FLAGS_NONE
        )
        self.action_override = action_override
        self.preview_screen = preview_screen
        self.preview_modal = preview_modal

    def do_activate(self):
        css_provider = Gtk.CssProvider()
        css_provider.load_from_data(RECOVERY_CSS)
        Gtk.StyleContext.add_provider_for_display(
            Gdk.Display.get_default(),
            css_provider,
            Gtk.STYLE_PROVIDER_PRIORITY_USER
        )

        if not ("--no-kiosk" in sys.argv or "--preview" in sys.argv):
            setup_installer_session()
            kiosk_guard.enter()

        act_about = Gio.SimpleAction.new("about", None)
        act_about.connect("activate", lambda a, p: self.win._show_simple_alert("Про macW1Y", f"macW1Y Release (v{get_modpack_version()})\nmacOS Transformation Modpack for Ubuntu"))
        self.add_action(act_about)

        act_reboot = Gio.SimpleAction.new("reboot", None)
        act_reboot.connect("activate", lambda a, p: self.win._on_system_reboot())
        self.add_action(act_reboot)

        act_poweroff = Gio.SimpleAction.new("poweroff", None)
        act_poweroff.connect("activate", lambda a, p: subprocess.run(["systemctl", "poweroff"], check=False))
        self.add_action(act_poweroff)

        act_term = Gio.SimpleAction.new("terminal", None)
        act_term.connect("activate", lambda a, p: subprocess.Popen(["gnome-terminal"]))
        self.add_action(act_term)

        act_sysinfo = Gio.SimpleAction.new("sysinfo", None)
        act_sysinfo.connect("activate", lambda a, p: self.win._show_simple_alert("Інформація про систему", f"ОС: Ubuntu 24.04 LTS\nВерсія macW1Y: v{get_modpack_version()}\nДиск: {get_disk_capacity_info()}"))
        self.add_action(act_sysinfo)

        act_close = Gio.SimpleAction.new("close", None)
        act_close.connect("activate", lambda a, p: self.win._show_modal_cancel_confirm())
        self.add_action(act_close)

        act_undo = Gio.SimpleAction.new("undo", None)
        act_undo.connect("activate", lambda a, p: None)
        self.add_action(act_undo)

        act_redo = Gio.SimpleAction.new("redo", None)
        act_redo.connect("activate", lambda a, p: None)
        self.add_action(act_redo)

        act_min = Gio.SimpleAction.new("minimize", None)
        act_min.connect("activate", lambda a, p: None)
        self.add_action(act_min)

        act_noop = Gio.SimpleAction.new("noop", None)
        act_noop.connect("activate", lambda a, p: None)
        self.add_action(act_noop)

        self.win = MacRecoveryInstallerWindow(
            self,
            action_override=self.action_override,
            preview_screen=self.preview_screen,
            preview_modal=self.preview_modal
        )
        self.win.present()

def main():
    action_override = None
    preview_screen = None
    preview_modal = None

    for arg in sys.argv[1:]:
        if arg.startswith("--screen="):
            preview_screen = arg.split("=")[1]
        elif arg.startswith("--action="):
            action_override = arg.split("=")[1]
        elif arg.startswith("--modal="):
            preview_modal = arg.split("=")[1]

    def sig_handler(sig, frame):
        kiosk_guard.leave()
        sys.exit(0)

    signal.signal(signal.SIGINT, sig_handler)
    signal.signal(signal.SIGTERM, sig_handler)

    app = MacRecoveryApp(
        action_override=action_override,
        preview_screen=preview_screen,
        preview_modal=preview_modal
    )
    return app.run([])

if __name__ == "__main__":
    sys.exit(main())
