        bench_svg = os.path.join(ASSETS_DIR, "benchmark.svg")
        if not os.path.exists(bench_svg):
            bench_svg = os.path.join(SCRIPT_DIR, "assets", "recovery", "benchmark.svg")
        img_icon = Gtk.Image.new_from_file(bench_svg)
        img_icon.set_pixel_size(96)
        img_icon.set_halign(Gtk.Align.CENTER)
        content.append(img_icon)

        lbl_t = Gtk.Label(label=self.tr("benchmark_prog_title", "Випробування швидкодії Liquid Glass..."))
        lbl_t.add_css_class("mac-title-large")
        content.append(lbl_t)

        prog_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        prog_box.set_halign(Gtk.Align.CENTER)
        prog_box.set_size_request(380, -1)
        prog_box.set_margin_top(8)

        self.bench_prog_bar = Gtk.ProgressBar()
        self.bench_prog_bar.add_css_class("mac-progress")
        self.bench_prog_bar.set_fraction(0.0)
        prog_box.append(self.bench_prog_bar)

        self.bench_lbl_status = Gtk.Label(label=self.tr("benchmark_starting", "Запуск фонового тестування..."))
        self.bench_lbl_status.add_css_class("mac-subtitle")
        prog_box.append(self.bench_lbl_status)

        self.bench_lbl_detail = Gtk.Label(label=self.tr("benchmark_measuring", "Вимірювання FPS (до 50 елементів)..."))
        self.bench_lbl_detail.add_css_class("mac-subtitle")
        prog_box.append(self.bench_lbl_detail)

        content.append(prog_box)
        box.append(content)

        btn_row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=0)
        btn_row.set_halign(Gtk.Align.CENTER)
        btn_row.set_valign(Gtk.Align.END)
        btn_row.set_margin_bottom(6)

        btn_abort = Gtk.Button(label=self.tr("installer_cancel_btn", "Скасувати"))
        btn_abort.add_css_class("mac-btn-secondary")
        btn_abort.connect("clicked", lambda b: self._abort_benchmark())
        btn_row.append(btn_abort)

        box.append(btn_row)
        return box

