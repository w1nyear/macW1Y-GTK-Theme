#!/bin/bash
find_mac_lib() {
    for d in /usr/local/lib "$HOME/.local/lib" /usr/lib/*-linux-gnu /usr/lib64 /usr/lib; do
        if [ -f "$d/$1" ]; then
            echo "$d/$1"
            return 0
        fi
    done
    return 1
}

TERM_LIB=$(find_mac_lib libmac_terminal.so)
POPOVER_LIB=$(find_mac_lib libmacpopover.so)
PRELOAD_LIBS=""
[ -n "$TERM_LIB" ] && PRELOAD_LIBS="$TERM_LIB"
if [ -n "$POPOVER_LIB" ]; then
    [ -n "$PRELOAD_LIBS" ] && PRELOAD_LIBS="$PRELOAD_LIBS:$POPOVER_LIB" || PRELOAD_LIBS="$POPOVER_LIB"
fi
[ -n "$PRELOAD_LIBS" ] && export LD_PRELOAD="$PRELOAD_LIBS${LD_PRELOAD:+:$LD_PRELOAD}"

# Always open new terminal as a new window, never as a tab
NEW_ARGS=()
HAS_ACTION=0

for arg in "$@"; do
    case "$arg" in
        --tab|--tab-with-profile*)
            NEW_ARGS+=("--new-window")
            HAS_ACTION=1
            ;;
        --new-window|-s|--standalone|--preferences|-h|--help|--help-all|--help-gapplication)
            NEW_ARGS+=("$arg")
            HAS_ACTION=1
            ;;
        *)
            NEW_ARGS+=("$arg")
            ;;
    esac
done

if [ "$HAS_ACTION" -eq 0 ]; then
    NEW_ARGS=("--new-window" "${NEW_ARGS[@]}")
fi

# Пакетний виконуваний файл має пріоритет перед старою резервною копією.
for candidate in /usr/bin/ptyxis /usr/bin/ptyxis.orig; do
    [ -x "$candidate" ] || continue
    [ "$(readlink -f "$candidate")" != "$(readlink -f "$0")" ] || continue
    if grep -q 'find_mac_lib()' "$candidate"; then
        continue
    fi
    exec "$candidate" "${NEW_ARGS[@]}"
done
printf '%s\n' 'macW1Y: original ptyxis executable not found.' >&2
exit 127
