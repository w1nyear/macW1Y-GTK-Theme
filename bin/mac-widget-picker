#!/usr/bin/env -S gjs -m
import Gtk from 'gi://Gtk?version=4.0';
import Gio from 'gi://Gio';
import GLib from 'gi://GLib';
import Adw from 'gi://Adw?version=1';
import Gettext from 'gettext';
let userExt = `${GLib.get_user_data_dir()}/gnome-shell/extensions/desktop-widgets@r3nhick`;
let sysExt = '/usr/share/gnome-shell/extensions/desktop-widgets@r3nhick';
let extPath = GLib.file_test(userExt, GLib.FileTest.IS_DIR) ? userExt : sysExt;
const { WidgetPickerDialog } = await import(`file://${extPath}/prefs/widgetPickerDialog.js`);

let userLocale = 'en';
const locFile = `${GLib.get_home_dir()}/.config/mac-styling/locale`;
if (GLib.file_test(locFile, GLib.FileTest.EXISTS)) {
    const [ok, bytes] = GLib.file_get_contents(locFile);
    if (ok) {
        const s = new TextDecoder().decode(bytes).trim();
        if (s) {
            userLocale = s;
            GLib.setenv('LANGUAGE', s, true);
        }
    }
}

Adw.init();
const settings = new Gio.Settings({ schema_id: 'org.gnome.shell.extensions.desktop-widgets-r3nhick' });
settings.set_boolean('edit-mode', true);

const DEFAULT_SIZES = {
    clock: 'small',
    digitalclock: 'small',
    binaryclock: 'small',
    calendar: 'medium',
    weather: 'small',
    battery: 'small',
    screentime: 'medium',
    system: 'medium',
    music: 'medium',
    pomodoro: 'small',
    todo: 'medium',
    notes: 'medium',
    photos: 'medium',
    lava: 'small',
    applauncher: 'small',
    folder: 'small',
    github: 'medium',
    stopwatch: 'small',
    timer: 'small',
};

function addWidget(type) {
    const serialized = settings.get_string('layout-json');
    let parsed = null;
    try {
        parsed = JSON.parse(serialized);
    } catch (_) {
        parsed = null;
    }
    const widgets = parsed && Array.isArray(parsed.widgets) ? [...parsed.widgets] : [];
    const size = DEFAULT_SIZES[type] ?? 'small';
    const id = type + '-' + Date.now();
    widgets.push({
        id,
        type,
        size,
        x: 24,
        y: 80,
        data: {},
    });
    settings.set_string('layout-json', JSON.stringify({ widgets }));
}

const app = new Adw.Application({
    application_id: 'org.gnome.desktopwidgets.picker' + Math.floor(Math.random() * 100000),
    flags: Gio.ApplicationFlags.FLAGS_NONE,
});

app.connect('activate', () => {
    try {
        const localeDir = extPath + '/locale';
        Gettext.bindtextdomain('desktop-widgets@r3nhick', localeDir);
        Gettext.textdomain('desktop-widgets@r3nhick');
        const _ = (s) => Gettext.dgettext('desktop-widgets@r3nhick', s);
        const dialog = new WidgetPickerDialog(null, extPath, _);
        dialog.set_application(app);
        dialog.connect('widget-selected', (_d, widgetType) => {
            addWidget(widgetType);
        });
        dialog.present();
        console.log("Dialog presented successfully!");
    } catch (e) {
        console.error("WidgetPickerDialog error:", e.stack || e);
    }
});

app.run([]);
