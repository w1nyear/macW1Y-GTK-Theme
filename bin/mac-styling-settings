#!/usr/bin/env python3
import sys
import os
import re
import subprocess
import json
import gi

gi.require_version('Gtk', '4.0')
gi.require_version('Adw', '1')
from gi.repository import Gtk, Adw, Gio, GLib

CSS_PATH = os.path.expanduser("~/.themes/macW1Y-Dark/gnome-shell/gnome-shell.css")
CSS_TAHOE = os.path.expanduser("~/.themes/MacTahoe-Dark/gnome-shell/gnome-shell.css")
LIQUID_SCHEMA = "org.gnome.shell.extensions.liquid-glass@thinkingcoding1231.gmail.com"
BMS_SCHEMA_BASE = "org.gnome.shell.extensions.blur-my-shell"

def run_cmd(cmd):
    try:
        return subprocess.check_output(cmd, shell=True, text=True).strip()
    except Exception:
        return ""

class MacStylingApp(Adw.Application):
    def __init__(self):
        super().__init__(application_id="org.gnome.Settings.MacStyling",
                         flags=Gio.ApplicationFlags.FLAGS_NONE)

    def do_activate(self):
        win = self.props.active_window
        if not win:
            win = MacStylingWindow(application=self)
        win.present()

class MacStylingWindow(Adw.ApplicationWindow):
    def __init__(self, *args, **kwargs):
        super().__init__(*args, **kwargs)
        self.set_title("Mac стилізація")
        self.set_default_size(700, 720)
        self.save_timer = None
        self._initializing = True

        self.load_values()

        toolbar_view = Adw.ToolbarView()
        header = Adw.HeaderBar()
        toolbar_view.add_top_bar(header)

        pref_page = Adw.PreferencesPage()
        pref_page.set_title("Mac стилізація")

        # 1. Menubar Group
        menubar_group = Adw.PreferencesGroup()
        menubar_group.set_title("Меню-бар")
        menubar_group.set_description("Налаштування затемнення та розмиття верхньої панелі")
        pref_page.add(menubar_group)

        self.menubar_tint_scale = self._create_slider_row(
            menubar_group, "Затемнення градієнтне", "Інтенсивність градієнтного затемнення меню-бару зверху",
            0, 100, self.menubar_tint
        )
        self.menubar_blur_scale = self._create_slider_row(
            menubar_group, "Розмиття", "Сила розмиття фону верхньої панелі",
            0, 100, self.menubar_blur
        )

        # 2. Liquid Glass Group
        liquid_group = Adw.PreferencesGroup()
        liquid_group.set_title("Liquid Glass")
        liquid_group.set_description("Параметри шейдера Liquid Glass для всіх елементів")
        pref_page.add(liquid_group)

        self.liquid_blur_scale = self._create_slider_row(
            liquid_group, "Розмиття", "Сила розмиття шейдера для всіх елементів з Liquid Glass",
            0, 100, self.liquid_blur
        )
        self.liquid_tint_scale = self._create_slider_row(
            liquid_group, "Затемнення", "Накладене затемнення разом із шейдером Liquid Glass",
            0, 100, self.liquid_tint
        )

        # 3. Blur Group
        blur_group = Adw.PreferencesGroup()
        blur_group.set_title("Blur")
        blur_group.set_description("Глобальні параметри фонового розмиття та затемнення")
        pref_page.add(blur_group)

        self.blur_sigma_scale = self._create_slider_row(
            blur_group, "Розмиття", "Сила розмиття фону у всіх елементах без винятків",
            0, 100, self.blur_sigma
        )
        self.blur_tint_scale = self._create_slider_row(
            blur_group, "Затемнення", "Рівень затемнення для всіх елементів з розмиттям",
            0, 100, self.blur_tint
        )

        # 4. Bootloader Group
        boot_group = Adw.PreferencesGroup()
        boot_group.set_title("Завантажувач (Bootloader)")
        boot_group.set_description("Параметри завантаження macOS Plymouth та логування ядра")
        pref_page.add(boot_group)

        self.verbose_switch = Adw.SwitchRow()
        self.verbose_switch.set_title("Режим verbose")
        self.verbose_switch.set_subtitle("Текстовий лог завантаження термінала позаду логотипу Apple")
        self.verbose_switch.set_active(self.verbose_mode)
        self.verbose_switch.connect("notify::active", self.on_verbose_toggled)
        boot_group.add(self.verbose_switch)

        self.grub_switch = Adw.SwitchRow()
        self.grub_switch.set_title("Меню GRUB")
        self.grub_switch.set_subtitle("Графічне меню вибору системи у стилі macOS під час старту")
        self.grub_switch.set_active(self.grub_mode)
        self.grub_switch.connect("notify::active", self.on_grub_toggled)
        boot_group.add(self.grub_switch)

        toolbar_view.set_content(pref_page)
        self.set_content(toolbar_view)
        self._initializing = False

    def _create_slider_row(self, group, title, subtitle, min_val, max_val, cur_val):
        row = Adw.ActionRow()
        row.set_title(title)
        if subtitle:
            row.set_subtitle(subtitle)
        scale = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, min_val, max_val, 1)
        scale.set_value(cur_val)
        scale.set_size_request(200, -1)
        scale.set_draw_value(True)
        scale.connect("value-changed", self.on_setting_changed)
        row.add_suffix(scale)
        group.add(row)
        return scale

    def load_values(self):
        self.menubar_tint = 35
        self.menubar_blur = 10
        self.liquid_blur = 20
        self.liquid_tint = 12
        self.blur_sigma = 30
        self.blur_tint = 36

        styling_conf = os.path.expanduser("~/.config/mac-styling/styling.json")
        if os.path.exists(styling_conf):
            try:
                with open(styling_conf, "r") as f:
                    data = json.load(f)
                self.menubar_tint = data.get("menubar_tint", int(data.get("panel_tint", 0.35) * 100))
                self.menubar_blur = data.get("menubar_blur", data.get("panel_sigma", 10))
                self.liquid_blur = data.get("liquid_blur", 20)
                self.liquid_tint = data.get("liquid_tint", 12)
                self.blur_sigma = data.get("blur_sigma", data.get("dock_sigma", 30))
                self.blur_tint = data.get("blur_tint", int(data.get("dock_tint", 0.36) * 100))
            except Exception as e:
                print("Error reading styling.json:", e)

        self.verbose_mode = False
        try:
            with open("/etc/default/grub", "r") as f:
                c = f.read()
                if "systemd.show_status=1" in c or os.path.exists("/usr/share/plymouth/themes/apple-mac/verbose_on.png"):
                    self.verbose_mode = True
        except Exception:
            pass

        self.grub_mode = False
        try:
            with open("/etc/default/grub", "r") as f:
                c = f.read()
                if re.search(r"^GRUB_TIMEOUT_STYLE=menu", c, re.M) or re.search(r"^GRUB_TIMEOUT=[1-9]", c, re.M):
                    self.grub_mode = True
        except Exception:
            pass

    def on_verbose_toggled(self, *args):
        if self._initializing:
            return
        is_active = self.verbose_switch.get_active()
        cmd = f"sudo /usr/local/bin/mac-boot-config set-verbose {'enable' if is_active else 'disable'}"
        subprocess.Popen(cmd, shell=True)

    def on_grub_toggled(self, *args):
        if self._initializing:
            return
        is_active = self.grub_switch.get_active()
        cmd = f"sudo /usr/local/bin/mac-boot-config set-grub {'enable' if is_active else 'disable'}"
        subprocess.Popen(cmd, shell=True)

    def on_setting_changed(self, *args):
        if self._initializing:
            return
        self.menubar_tint = int(self.menubar_tint_scale.get_value())
        self.menubar_blur = int(self.menubar_blur_scale.get_value())
        self.liquid_blur = int(self.liquid_blur_scale.get_value())
        self.liquid_tint = int(self.liquid_tint_scale.get_value())
        self.blur_sigma = int(self.blur_sigma_scale.get_value())
        self.blur_tint = int(self.blur_tint_scale.get_value())

        self.apply_realtime()

        if self.save_timer:
            GLib.source_remove(self.save_timer)
        self.save_timer = GLib.timeout_add(400, self.save_css)

    def apply_realtime(self):
        # 1. Menubar blur
        subprocess.Popen(f"/home/vitaliy/MACTHEMEFILES/bin/update-bms-menubar-blur {self.menubar_blur}", shell=True)
        run_cmd(f"gsettings set {BMS_SCHEMA_BASE}.panel sigma {self.menubar_blur}")
        run_cmd(f"gsettings set {BMS_SCHEMA_BASE}.panel blur {'true' if self.menubar_blur > 0 else 'false'}")

        # 2. Liquid Glass (all elements without exception)
        rad = max(1, int(round(self.liquid_blur * 30.0 / 100.0))) if self.liquid_blur > 0 else 0
        tint = self.liquid_tint / 100.0
        for k in ["dock-blur-radius", "quick-settings-blur-radius", "panel-menu-blur-radius",
                  "menu-blur-radius", "desktop-menu-blur-radius", "notification-blur-radius",
                  "application-blur-radius", "osd-blur-radius"]:
            run_cmd(f"gsettings set {LIQUID_SCHEMA} {k} {rad}")

        for k in ["dock-tint-strength", "quick-settings-tint-strength", "quick-settings-toggle-tint-strength",
                  "panel-menu-tint-strength", "menu-tint-strength", "desktop-menu-tint-strength",
                  "notification-tint-strength", "application-tint-strength", "osd-tint-strength"]:
            run_cmd(f"gsettings set {LIQUID_SCHEMA} {k} {tint:.2f}")

        # 3. Blur (all elements without exception)
        bms_schemas = [
            "org.gnome.shell.extensions.blur-my-shell",
            "org.gnome.shell.extensions.blur-my-shell.applications",
            "org.gnome.shell.extensions.blur-my-shell.dash-to-dock",
            "org.gnome.shell.extensions.blur-my-shell.overview",
            "org.gnome.shell.extensions.blur-my-shell.lockscreen",
            "org.gnome.shell.extensions.blur-my-shell.appfolder",
            "org.gnome.shell.extensions.blur-my-shell.screenshot",
            "org.gnome.shell.extensions.blur-my-shell.popup",
            "org.gnome.shell.extensions.blur-my-shell.window-list",
        ]
        brightness = max(0.2, min(1.0, 1.0 - (self.blur_tint / 100.0) * 0.5))
        for s in bms_schemas:
            run_cmd(f"gsettings set {s} sigma {self.blur_sigma}")
            run_cmd(f"gsettings set {s} brightness {brightness:.2f}")

        # Save JSON
        try:
            conf_dir = os.path.expanduser("~/.config/mac-styling")
            os.makedirs(conf_dir, exist_ok=True)
            with open(os.path.join(conf_dir, "styling.json"), "w") as f:
                json.dump({
                    "menubar_tint": self.menubar_tint,
                    "menubar_blur": self.menubar_blur,
                    "liquid_blur": self.liquid_blur,
                    "liquid_tint": self.liquid_tint,
                    "blur_sigma": self.blur_sigma,
                    "blur_tint": self.blur_tint,
                    "dock_blur": self.blur_sigma > 0,
                    "dock_sigma": self.blur_sigma,
                    "dock_tint": round(self.blur_tint / 100.0, 2),
                    "dock_radius": 28,
                    "panel_blur": self.menubar_blur > 0,
                    "panel_sigma": self.menubar_blur,
                    "panel_tint": round(self.menubar_tint / 100.0, 2),
                    "qs_sigma": self.blur_sigma,
                    "notif_blur": self.blur_sigma > 0,
                    "notif_sigma": self.blur_sigma,
                    "notif_tint": round(self.blur_tint / 100.0, 2),
                    "notif_radius": 18
                }, f, indent=2)
        except Exception as e:
            print("Error writing styling.json:", e)

    def save_css(self):
        self.save_timer = None
        subprocess.Popen(
            f"/home/vitaliy/MACTHEMEFILES/bin/update-mac-styling-css {self.menubar_tint} {self.blur_tint}",
            shell=True
        )
        return GLib.SOURCE_REMOVE

def main():
    app = MacStylingApp()
    return app.run(sys.argv)

if __name__ == "__main__":
    sys.exit(main())
