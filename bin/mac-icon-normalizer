SYS_ICONS_DIR = "/usr/share/icons"

MACTAHOE_DIR = os.path.join(USER_ICONS_DIR, "macW1Y")
MACTAHOE_DARK_DIR = os.path.join(USER_ICONS_DIR, "macW1Y-dark")

SYS_MACTAHOE_DIR = os.path.join(SYS_ICONS_DIR, "macW1Y")
SYS_MACTAHOE_DARK_DIR = os.path.join(SYS_ICONS_DIR, "macW1Y-dark")

LOCAL_APPS_DIR = os.path.join(HOME, ".local/share/applications")
SYS_APPS_DIR = "/usr/share/applications"

