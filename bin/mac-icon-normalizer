# Marker comment to identify auto-generated squircle SVGs
NORMALIZED_MARKER = "<!-- macW1Y-normalized-squircle -->"

# Applications whose icons should NEVER be wrapped in a generated squircle tile
# (e.g. apps that already ship an authentic macW1Y squircle tile or official branding)
EXCLUDED_ICONS = {
    "chatgpt",
}

def is_already_squircle(im):
    """
    Checks if an icon already conforms to the macW1Y squircle design
    (solid square-like tile with authentic corner radius and drop shadow)
    to prevent adding redundant double backgrounds.
    """
    arr = np.array(im)
    if arr.ndim != 3 or arr.shape[2] != 4:
        return False
    alpha = arr[:, :, 3]
    bbox = im.getbbox()
    if not bbox:
        return False
    bx0, by0, bx1, by1 = bbox
    bw, bh = bx1 - bx0, by1 - by0
    if bw < 32 or bh < 32:
        return False
    # Aspect ratio close to 1:1
    if abs(bw - bh) / float(max(bw, bh)) > 0.08:
        return False
    
    # Outer corners of bbox should be transparent (rounded corners)
    c_tl = alpha[by0, bx0]
    c_tr = alpha[by0, bx1 - 1]
    c_bl = alpha[by1 - 1, bx0]
    c_br = alpha[by1 - 1, bx1 - 1]
    if max(c_tl, c_tr, c_bl, c_br) > 50:
        return False
        
    # Solid core ratio in bbox
    core_solid = np.count_nonzero(alpha[by0:by1, bx0:bx1] > 200) / float(bw * bh)
    if core_solid < 0.70:
        return False

    # Center is solid
    cy, cx = by0 + bh // 2, bx0 + bw // 2
    if alpha[cy, cx] < 200:
        return False
        
    # Points at 15% inset along the edges (top, bottom, left, right) inside the squircle should be solid
    pt_top = alpha[by0 + max(1, int(bh * 0.15)), cx]
    pt_bot = alpha[by1 - max(1, int(bh * 0.15)), cx]
    pt_left = alpha[cy, bx0 + max(1, int(bw * 0.15))]
    pt_right = alpha[cy, bx1 - max(1, int(bw * 0.15))]
    if min(pt_top, pt_bot, pt_left, pt_right) < 200:
        return False

    return True

def resolve_icon_path(icon_name):
    """Resolves an icon name or path to a real image file on disk."""
    if not icon_name:
        return None
    if os.path.isabs(icon_name) and os.path.exists(icon_name):
        return icon_name

    search_dirs = [
        os.path.join(HOME, ".local/share/icons/hicolor/scalable/apps"),
        os.path.join(HOME, ".local/share/icons/hicolor/256x256/apps"),
        os.path.join(HOME, ".local/share/icons/hicolor/128x128/apps"),
        os.path.join(HOME, ".local/share/icons/hicolor/48x48/apps"),
        "/usr/share/icons/hicolor/scalable/apps",
        "/usr/share/icons/hicolor/256x256/apps",
        "/usr/share/icons/hicolor/128x128/apps",
        "/usr/share/icons/hicolor/48x48/apps",
        "/usr/share/pixmaps",
        os.path.join(HOME, ".local/share/Steam/steam/games"),
        os.path.join(HOME, ".steam/steam/games"),
    ]
    for d in search_dirs:
        for ext in [".svg", ".png", ".xpm", ".ico"]:
            p = os.path.join(d, f"{icon_name}{ext}")
            if os.path.exists(p):
                return p

    try:
        import gi
        gi.require_version("Gtk", "3.0")
        from gi.repository import Gtk
        theme = Gtk.IconTheme.get_default()
        info = theme.lookup_icon(icon_name, 256, 0)
        if info:
            fn = info.get_filename()
            if fn and os.path.exists(fn):
                return fn
    except Exception:
        pass

    return None

def is_native_macw1y_icon(icon_name):
    """Checks if the icon is an official handcrafted macW1Y icon (not autogenerated)."""
    if not icon_name:
        return False
    if icon_name in EXCLUDED_ICONS:
        return True
    svg_path = os.path.join(MACTAHOE_DIR, "apps/scalable", f"{icon_name}.svg")
    if os.path.exists(svg_path):
        try:
            with open(svg_path, "r", errors="ignore") as f:
                content = f.read(500)
                if NORMALIZED_MARKER in content:
                    return False
            return True
        except Exception:
            return True
    return False

def render_image_to_pil(src_path, target_size=512):
    """Loads an image (SVG, PNG, XPM, etc.) into a PIL RGBA Image."""
    if not src_path or not os.path.exists(src_path):
        return None

    ext = os.path.splitext(src_path)[1].lower()
    if ext == ".svg":
        try:
            import gi
            gi.require_version("GdkPixbuf", "2.0")
            from gi.repository import GdkPixbuf
            pb = GdkPixbuf.Pixbuf.new_from_file_at_scale(src_path, target_size, target_size, True)
            if pb:
                buf = pb.save_to_bufferv("png", [], [])
                return Image.open(io.BytesIO(buf[1])).convert("RGBA")
        except Exception:
            pass

    try:
        return Image.open(src_path).convert("RGBA")
    except Exception:
        return None

def analyze_icon_geometry(im):
    """
    Analyzes whether an icon has an opaque full-bleed background (needs corner rounding)
    or is a transparent glyph/cutout (needs an opaque background squircle tile).
    """
    arr = np.array(im)
    alpha = arr[:, :, 3]
    h, w = alpha.shape
    bbox = im.getbbox()
    if not bbox:
        return False

    bx0, by0, bx1, by1 = bbox
    bw = bx1 - bx0
    bh = by1 - by0

    top_pt = alpha[by0 + max(1, int(bh * 0.1)), bx0 + bw // 2]
    bot_pt = alpha[by1 - max(1, int(bh * 0.1)), bx0 + bw // 2]
    left_pt = alpha[by0 + bh // 2, bx0 + max(1, int(bw * 0.1))]
    right_pt = alpha[by0 + bh // 2, bx1 - max(1, int(bw * 0.1))]

    c1 = alpha[by0 + max(1, int(bh * 0.1)), bx0 + max(1, int(bw * 0.1))]
    c2 = alpha[by0 + max(1, int(bh * 0.1)), bx1 - max(1, int(bw * 0.1))]
    c3 = alpha[by1 - max(1, int(bh * 0.1)), bx0 + max(1, int(bw * 0.1))]
    c4 = alpha[by1 - max(1, int(bh * 0.1)), bx1 - max(1, int(bw * 0.1))]

    # Full-bleed square/rect if all 4 edges and corners within the content area are solid opaque
    is_full_bleed = (top_pt > 200 and bot_pt > 200 and left_pt > 200 and right_pt > 200) and \
                    (c1 > 200 and c2 > 200 and c3 > 200 and c4 > 200)
    return is_full_bleed

def generate_squircle_svg(src_im, is_dark=False):
    """
    Generates a standardized macW1Y squircle SVG adhering to the exact macW1Y geometry:
    Canvas: 64x64, Tile: 56.002x56.002, rx: 13.002, ry: 13.002.
    """
    is_full_bleed = analyze_icon_geometry(src_im)

    if is_dark:
        bg_stop0 = "#28282a"
        bg_stop1 = "#1c1c1e"
        stroke_color = "#ffffff"
        stroke_opacity = "0.12"
    else:
        bg_stop0 = "#ffffff"
        bg_stop1 = "#f4f4f6"
        stroke_color = "#000000"
        stroke_opacity = "0.08"

    if is_full_bleed:
        # Full-bleed: fit image into 56x56 and clip with squircle
        buf = io.BytesIO()
        src_im.save(buf, format="PNG")
        b64_data = base64.b64encode(buf.getvalue()).decode("ascii")

        content = f"""<clipPath id="tile-clip"><rect width="56.002" height="56.002" x="4" y="3.969" rx="13.002" ry="13.002"/></clipPath>
<rect width="56.002" height="56.002" x="4" y="3.969" rx="13.002" ry="13.002" fill="url(#bg)" stroke="{stroke_color}" stroke-width="0.5" stroke-opacity="{stroke_opacity}"/>
<image xlink:href="data:image/png;base64,{b64_data}" width="56.002" height="56.002" x="4" y="3.969" preserveAspectRatio="xMidYMid slice" clip-path="url(#tile-clip)"/>"""
    else:
        # Transparent cutout: crop bounding box, center glyph inside tile with proper padding (~68%)
        bbox = src_im.getbbox()
        cropped = src_im.crop(bbox) if bbox else src_im

        # If dark mode and glyph is monochrome black, invert to white for legibility
        if is_dark:
            g_arr = np.array(cropped)
            g_alpha = g_arr[:, :, 3]
            if np.count_nonzero(g_alpha > 50) > 0:
                vis_rgb = g_arr[g_alpha > 50][:, :3]
                avg_lum = np.mean(0.299 * vis_rgb[:, 0] + 0.587 * vis_rgb[:, 1] + 0.114 * vis_rgb[:, 2])
                max_sat = np.max(np.abs(vis_rgb[:, 0] - vis_rgb[:, 1]))
                if avg_lum < 40 and max_sat < 20:
                    r_ch, g_ch, b_ch, a_ch = cropped.split()
                    inv_rgb = ImageOps.invert(Image.merge("RGB", (r_ch, g_ch, b_ch)))
                    cropped = Image.merge("RGBA", (*inv_rgb.split(), a_ch))

        cw, ch = cropped.size
        target_size = 38.0  # safe interior: 38/56 ~ 68%
        aspect = cw / float(max(1, ch))
        if aspect >= 1.0:
            gw = target_size
            gh = target_size / aspect
        else:
            gh = target_size
            gw = target_size * aspect

        gx = 4.0 + (56.002 - gw) / 2.0
        gy = 3.969 + (56.002 - gh) / 2.0

        buf = io.BytesIO()
        cropped.save(buf, format="PNG")
        b64_data = base64.b64encode(buf.getvalue()).decode("ascii")

        content = f"""<rect width="56.002" height="56.002" x="4" y="3.969" rx="13.002" ry="13.002" fill="url(#bg)" stroke="{stroke_color}" stroke-width="0.5" stroke-opacity="{stroke_opacity}"/>
<image xlink:href="data:image/png;base64,{b64_data}" width="{gw:.2f}" height="{gh:.2f}" x="{gx:.2f}" y="{gy:.2f}" preserveAspectRatio="xMidYMid meet"/>"""

    svg = f"""<svg xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" width="64" height="64" viewBox="0 0 64 64">
{NORMALIZED_MARKER}
<defs>
  <linearGradient id="bg" x1="0%" y1="0%" x2="0%" y2="100%">
    <stop offset="0%" stop-color="{bg_stop0}"/>
    <stop offset="100%" stop-color="{bg_stop1}"/>
  </linearGradient>
</defs>
<image xlink:href="data:image/png;base64,{SHADOW_B64}" width="60.882" height="62.001" x="1.559" y="2" preserveAspectRatio="none"/>
{content}
</svg>"""
    return svg

def generate_squircle_png(src_im, is_dark=False, size=256):
    """Generates a high-resolution pre-rendered PNG version of the squircle icon."""
    scale = 2
    canvas_w = size * scale
    canvas_h = size * scale
    tile_w = int(size * 0.875 * scale)
    tile_h = int(size * 0.875 * scale)
    ox = (canvas_w - tile_w) // 2
    oy = (canvas_h - tile_h) // 2
    radius = int(tile_w * 0.23217)

    # 1. Drop Shadow
    shadow_img = Image.new("RGBA", (canvas_w, canvas_h), (0, 0, 0, 0))
    s_draw = ImageDraw.Draw(shadow_img)
    s_oy = oy + 10 * scale
    s_draw.rounded_rectangle([ox, s_oy, ox + tile_w, s_oy + tile_h], radius=radius, fill=(0, 0, 0, 80))
    shadow_img = shadow_img.filter(ImageFilter.GaussianBlur(14 * scale))

    key_shadow = Image.new("RGBA", (canvas_w, canvas_h), (0, 0, 0, 0))
    k_draw = ImageDraw.Draw(key_shadow)
    k_oy = oy + 4 * scale
    k_draw.rounded_rectangle([ox, k_oy, ox + tile_w, k_oy + tile_h], radius=radius, fill=(0, 0, 0, 50))
    key_shadow = key_shadow.filter(ImageFilter.GaussianBlur(6 * scale))

    base = Image.alpha_composite(shadow_img, key_shadow)

    # 2. Tile fill
    mask_img = Image.new("L", (tile_w, tile_h), 0)
    m_draw = ImageDraw.Draw(mask_img)
    m_draw.rounded_rectangle([0, 0, tile_w, tile_h], radius=radius, fill=255)

    if is_dark:
        top_c, bot_c = (40, 40, 42, 255), (28, 28, 30, 255)
        stroke_c = (255, 255, 255, 30)
    else:
        top_c, bot_c = (255, 255, 255, 255), (244, 244, 246, 255)
        stroke_c = (0, 0, 0, 22)

    grad = Image.new("RGBA", (tile_w, tile_h))
    for y in range(tile_h):
        t = y / float(tile_h)
        r = int(top_c[0] * (1 - t) + bot_c[0] * t)
        g = int(top_c[1] * (1 - t) + bot_c[1] * t)
        b = int(top_c[2] * (1 - t) + bot_c[2] * t)
        for x in range(tile_w):
            grad.putpixel((x, y), (r, g, b, 255))

    tile_layer = Image.new("RGBA", (canvas_w, canvas_h), (0, 0, 0, 0))
    tile_layer.paste(grad, (ox, oy), mask=mask_img)

    t_draw = ImageDraw.Draw(tile_layer)
    t_draw.rounded_rectangle([ox, oy, ox + tile_w, oy + tile_h], radius=radius, outline=stroke_c, width=1 * scale)

    base = Image.alpha_composite(base, tile_layer)

    # 3. Content
    is_full_bleed = analyze_icon_geometry(src_im)
    if is_full_bleed:
        scaled = ImageOps.fit(src_im, (tile_w, tile_h), Image.Resampling.LANCZOS)
        content_layer = Image.new("RGBA", (canvas_w, canvas_h), (0, 0, 0, 0))
        content_layer.paste(scaled, (ox, oy), mask=mask_img)
        base = Image.alpha_composite(base, content_layer)
    else:
        bbox = src_im.getbbox()
        cropped = src_im.crop(bbox) if bbox else src_im

        if is_dark:
            g_arr = np.array(cropped)
            g_alpha = g_arr[:, :, 3]
            if np.count_nonzero(g_alpha > 50) > 0:
                vis_rgb = g_arr[g_alpha > 50][:, :3]
                avg_lum = np.mean(0.299 * vis_rgb[:, 0] + 0.587 * vis_rgb[:, 1] + 0.114 * vis_rgb[:, 2])
                max_sat = np.max(np.abs(vis_rgb[:, 0] - vis_rgb[:, 1]))
                if avg_lum < 40 and max_sat < 20:
                    r_ch, g_ch, b_ch, a_ch = cropped.split()
                    inv_rgb = ImageOps.invert(Image.merge("RGB", (r_ch, g_ch, b_ch)))
                    cropped = Image.merge("RGBA", (*inv_rgb.split(), a_ch))

        target_max = int(tile_w * 0.68)
        cw, ch = cropped.size
        scale_f = min(target_max / float(cw), target_max / float(ch))
        nw = max(1, int(cw * scale_f))
        nh = max(1, int(ch * scale_f))
        scaled_glyph = cropped.resize((nw, nh), Image.Resampling.LANCZOS)

        gx = (canvas_w - nw) // 2
        gy = (canvas_h - nh) // 2
        content_layer = Image.new("RGBA", (canvas_w, canvas_h), (0, 0, 0, 0))
        content_layer.paste(scaled_glyph, (gx, gy), mask=scaled_glyph)
        base = Image.alpha_composite(base, content_layer)

    return base.resize((size, size), Image.Resampling.LANCZOS)

def install_normalized_icon(icon_name, src_im):
    """
    Saves the generated light and dark icons into macW1Y and macW1Y-dark themes.
    """
    svg_light = generate_squircle_svg(src_im, is_dark=False)
    svg_dark = generate_squircle_svg(src_im, is_dark=True)

    png_light = generate_squircle_png(src_im, is_dark=False, size=256)
    png_dark = generate_squircle_png(src_im, is_dark=True, size=256)

    dirs = [
        (MACTAHOE_DIR, svg_light, png_light),
        (MACTAHOE_DARK_DIR, svg_dark, png_dark),
    ]

    for base_d, svg_content, png_obj in dirs:
        scalable_dir = os.path.join(base_d, "apps/scalable")
        p256_dir = os.path.join(base_d, "apps/256")
        try:
            os.makedirs(scalable_dir, exist_ok=True)
            os.makedirs(p256_dir, exist_ok=True)

            svg_out = os.path.join(scalable_dir, f"{icon_name}.svg")
            with open(svg_out, "w", encoding="utf-8") as f:
                f.write(svg_content)

            png_out = os.path.join(p256_dir, f"{icon_name}.png")
            png_obj.save(png_out, format="PNG")
        except Exception:
            pass

    # Synchronize to system directories if possible
    try:
        for theme_name, svg_content, png_obj in [("macW1Y", svg_light, png_light), ("macW1Y-dark", svg_dark, png_dark)]:
            sys_scalable = f"/usr/share/icons/{theme_name}/apps/scalable"
            if os.path.exists(sys_scalable):
                tmp_svg = f"/tmp/{theme_name}_{icon_name}.svg"
                with open(tmp_svg, "w", encoding="utf-8") as f:
                    f.write(svg_content)
                subprocess.run(["sudo", "cp", tmp_svg, os.path.join(sys_scalable, f"{icon_name}.svg")],
                               stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                try:
                    os.remove(tmp_svg)
                except Exception:
                    pass
    except Exception:
        pass

def update_icon_caches():
    """Refreshes GTK icon caches for all modified themes."""
    cache_dirs = [
        MACTAHOE_DIR,
        MACTAHOE_DARK_DIR,
        os.path.join(USER_ICONS_DIR, "hicolor"),
    ]
    for d in cache_dirs:
        if os.path.exists(d):
            try:
                subprocess.run(["gtk-update-icon-cache", "-q", "-f", d],
                               stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            except Exception:
                pass

    try:
        subprocess.run(["sudo", "gtk-update-icon-cache", "-q", "-f", "/usr/share/icons/macW1Y"],
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        subprocess.run(["sudo", "gtk-update-icon-cache", "-q", "-f", "/usr/share/icons/macW1Y-dark"],
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except Exception:
        pass

def process_desktop_file(df_path):
    """Inspects a single .desktop file and normalizes its icon if non-squircle or missing."""
    if not os.path.exists(df_path):
        return None

    icon_val = None
    no_display = False
    try:
        with open(df_path, "r", errors="ignore") as f:
            for line in f:
                if line.startswith("Icon="):
                    icon_val = line.strip().split("=", 1)[1].strip()
                elif line.startswith("NoDisplay=true"):
                    no_display = True
    except Exception:
        return None

    if no_display or not icon_val:
        return None

    base_name = os.path.splitext(os.path.basename(df_path))[0]

    is_abs_path = os.path.isabs(icon_val)
    if is_abs_path and os.path.exists(icon_val):
        target_icon_name = base_name.lower().replace(" ", "-")
        src_path = icon_val
    else:
        target_icon_name = icon_val
        if is_native_macw1y_icon(target_icon_name):
            return None
        src_path = resolve_icon_path(target_icon_name)

    if target_icon_name in EXCLUDED_ICONS:
        return None

    if not src_path or not os.path.exists(src_path):
        return None

    pil_im = render_image_to_pil(src_path)
    if not pil_im:
        return None

    if is_already_squircle(pil_im):
        return None

    install_normalized_icon(target_icon_name, pil_im)

    if is_abs_path:
        local_df = os.path.join(LOCAL_APPS_DIR, os.path.basename(df_path))
        try:
            os.makedirs(LOCAL_APPS_DIR, exist_ok=True)
            if not os.path.exists(local_df):
                shutil.copy2(df_path, local_df)
            with open(local_df, "r", errors="ignore") as f:
                lines = f.readlines()
            new_lines = []
            for l in lines:
                if l.startswith("Icon="):
                    new_lines.append(f"Icon={target_icon_name}\n")
                else:
                    new_lines.append(l)
            with open(local_df, "w", encoding="utf-8") as f:
                f.writelines(new_lines)
        except Exception:
            pass

    return target_icon_name

def normalize_all_icons(verbose=False):
    """Scans all installed applications and normalizes all non-squircle icons."""
    processed = []
    seen_icons = set()

    all_dfs = set(glob.glob(os.path.join(LOCAL_APPS_DIR, "*.desktop")) +
                  glob.glob(os.path.join(SYS_APPS_DIR, "*.desktop")))

    for df in sorted(all_dfs):
        res = process_desktop_file(df)
        if res and res not in seen_icons:
            seen_icons.add(res)
            processed.append((os.path.basename(df), res))
            if verbose:
                print(f"  ✓ Normalized {os.path.basename(df)} -> {res}")

    if processed:
        update_icon_caches()

    return processed

if __name__ == "__main__":
    verbose = "-v" in sys.argv or "--verbose" in sys.argv
    args = [a for a in sys.argv[1:] if not a.startswith("-")]

    if len(args) == 1 and args[0].endswith(".desktop"):
        df_target = args[0]
        res = process_desktop_file(df_target)
        if res:
            update_icon_caches()
            print(f"✓ Normalized {df_target} -> {res}")
        else:
            print(f"No normalization needed for {df_target}")
    elif len(args) >= 2:
        icon_name = args[0]
        src_path = args[1]
        im = render_image_to_pil(src_path)
        if im:
            install_normalized_icon(icon_name, im)
            update_icon_caches()
            print(f"✓ Normalized custom icon {icon_name} from {src_path}")
        else:
            print(f"Failed to load image from {src_path}")
    else:
        print("===================================================================")
        print("      macW1Y macW1Y Icon Normalizer & Squircle Engine         ")
        print("===================================================================")
        items = normalize_all_icons(verbose=True)
        print(f"\n🎉 Successfully processed and normalized {len(items)} application icon(s).")
        print("Icon caches refreshed for macW1Y (Light) and macW1Y-dark (Dark).")
