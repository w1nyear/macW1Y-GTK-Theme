# -*- coding: utf-8 -*-
"""
macW1Y macW1Y Icon Normalizer & Squircle Generator
Scans all installed applications (.desktop files), identifies icons with transparent
cutouts or incorrect/sharp rectangular corners, and generates standardized macW1Y
squircle icons (light and dark themes) with authentic macW1Y corner radii, padding,
and subtle drop shadows.
"""

import os
import sys
import glob
import base64
import io
import shutil
import subprocess
import numpy as np
from PIL import Image, ImageOps, ImageDraw, ImageFilter

