APPIMAGES_DIR = os.path.join(HOME, ".local/share/appimages")
INSTALLED_APPS_DIR = os.path.join(HOME, ".local/share/installed-apps")
WINE_APPS_DIR = os.path.join(HOME, ".local/share/wine-apps")
WINE_INSTALLERS_CACHE = os.path.join(HOME, ".cache/wine-installers")
ICONS_DIR = os.path.join(HOME, ".local/share/icons/hicolor/scalable/apps")

for d in [APPS_DIR, APPIMAGES_DIR, INSTALLED_APPS_DIR, WINE_APPS_DIR, WINE_INSTALLERS_CACHE, ICONS_DIR, LOCAL_APPS_DIR, TRASH_DIR, TRASH_INFO_DIR]:
    os.makedirs(d, exist_ok=True)

APP_STORE_ICON = os.path.join(HOME, ".local/share/icons/MacTahoe/apps/scalable/snap-store.svg")
if not os.path.exists(APP_STORE_ICON):
    APP_STORE_ICON = os.path.join(HOME, ".local/share/icons/MacTahoe/apps/scalable/software-center.svg")
if not os.path.exists(APP_STORE_ICON):
    APP_STORE_ICON = "snap-store"

_trash_lock = threading.Lock()
_processing_trash = set()
_recently_trashed = {}


def is_safe_to_delete(folder):
    if not folder or not os.path.isabs(folder):
        return False
    norm = os.path.realpath(folder)

    forbidden = [
        os.path.realpath(HOME),
        os.path.realpath(APPS_DIR),
        os.path.realpath(LOCAL_APPS_DIR),
        os.path.realpath(os.path.join(HOME, ".local")),
        os.path.realpath(os.path.join(HOME, ".local", "share")),
        os.path.realpath(os.path.join(HOME, ".config")),
        os.path.realpath(os.path.join(HOME, "Desktop")),
        os.path.realpath(os.path.join(HOME, "Downloads")),
        os.path.realpath("/"),
        os.path.realpath("/usr"),
        os.path.realpath("/bin"),
        os.path.realpath("/etc"),
        os.path.realpath("/home"),
        os.path.realpath("/var"),
        os.path.realpath(os.path.join(HOME, ".wine")),
        os.path.realpath(os.path.join(HOME, ".wine", "drive_c")),
        os.path.realpath(os.path.join(HOME, ".wine", "drive_c", "windows")),
        os.path.realpath(os.path.join(HOME, ".wine", "drive_c", "users")),
    ]
    if norm in forbidden:
        return False
    for f in forbidden:
        if f.startswith(norm):
            return False

    if norm.startswith(os.path.realpath(INSTALLED_APPS_DIR) + os.sep):
        return True
    if norm.startswith(os.path.realpath(WINE_APPS_DIR) + os.sep):
        return True

    wine_c = os.path.realpath(os.path.join(HOME, ".wine", "drive_c"))
    if norm.startswith(wine_c + os.sep):
        rel = os.path.relpath(norm, wine_c)
        parts = rel.split(os.sep)
        if parts[0].lower() in ["windows", "dosdevices"]:
            return False
        if parts[0].lower() == "users" and len(parts) < 3:
            return False
        return len(parts) >= 2

    return False


def install_icon_file(src_icon_path, icon_name):
    """
    Installs an icon file into user icon theme directories and updates icon caches.
    Copies to:
      ~/.local/share/icons/hicolor/256x256/apps/{icon_name}.{ext}
      ~/.local/share/icons/hicolor/scalable/apps/{icon_name}.{ext}
      ~/.local/share/icons/MacTahoe-dark/apps/scalable/{icon_name}.{ext}
      ~/.local/share/icons/MacTahoe/apps/scalable/{icon_name}.{ext}
    """
    if not src_icon_path or not os.path.exists(src_icon_path):
        return None
    ext = os.path.splitext(src_icon_path)[1].lower()
    if ext not in [".png", ".svg", ".xpm"]:
        ext = ".png"

    dest_paths = [
        os.path.join(HOME, ".local/share/icons/hicolor/256x256/apps", f"{icon_name}{ext}"),
        os.path.join(HOME, ".local/share/icons/hicolor/scalable/apps", f"{icon_name}{ext}"),
        os.path.join(HOME, ".local/share/icons/MacTahoe-dark/apps/scalable", f"{icon_name}{ext}"),
        os.path.join(HOME, ".local/share/icons/MacTahoe/apps/scalable", f"{icon_name}{ext}"),
    ]
    primary_path = dest_paths[0]
    for dp in dest_paths:
        try:
            os.makedirs(os.path.dirname(dp), exist_ok=True)
            shutil.copy2(src_icon_path, dp)
        except Exception:
            pass

    # Ensure index.theme exists in ~/.local/share/icons/hicolor/
    hicolor_index = os.path.join(HOME, ".local/share/icons/hicolor/index.theme")
    if not os.path.exists(hicolor_index) and os.path.exists("/usr/share/icons/hicolor/index.theme"):
        try:
            shutil.copy2("/usr/share/icons/hicolor/index.theme", hicolor_index)
        except Exception:
            pass

    return primary_path

def update_icon_caches():
    """Updates icon caches for hicolor and MacTahoe themes."""
    for tdir in [
        os.path.join(HOME, ".local/share/icons/hicolor"),
        os.path.join(HOME, ".local/share/icons/MacTahoe-dark"),
        os.path.join(HOME, ".local/share/icons/MacTahoe")
    ]:
        if os.path.exists(tdir):
            try:
                subprocess.run(["gtk-update-icon-cache", "-q", "-f", tdir],
                               stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            except Exception:
                pass

def icon_exists_in_theme(icon_name):
    if not icon_name:
        return False
    if os.path.isabs(icon_name) and os.path.exists(icon_name):
        return True
    for d in [
        os.path.join(HOME, ".local/share/icons/MacTahoe/apps/scalable"),
        os.path.join(HOME, ".local/share/icons/MacTahoe-dark/apps/scalable"),
        os.path.join(HOME, ".local/share/icons/MacTahoe/apps/48"),
        os.path.join(HOME, ".local/share/icons/MacTahoe-dark/apps/48"),
        os.path.join(HOME, ".local/share/icons/hicolor/256x256/apps"),
        os.path.join(HOME, ".local/share/icons/hicolor/scalable/apps"),
        "/usr/share/icons/hicolor/scalable/apps",
        "/usr/share/icons/hicolor/256x256/apps",
        "/usr/share/icons/hicolor/48x48/apps",
        "/usr/share/pixmaps"
    ]:
        for ext in [".svg", ".png", ".xpm"]:
            if os.path.exists(os.path.join(d, f"{icon_name}{ext}")):
                return True
    return False

def get_pe_metadata(exe_path):
    """
    Extracts VS_VERSION_INFO metadata (ProductName, FileDescription, CompanyName, etc.)
    from Windows PE executables using wrestool.
    """
    if not exe_path or not os.path.exists(exe_path) or not shutil.which("wrestool"):
        return {}
    try:
        res = subprocess.run(["wrestool", "--raw", "-x", "-t16", exe_path],
                             stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
        if res.returncode != 0 or not res.stdout:
            return {}
        data = res.stdout
        meta = {}
        for key in ["ProductName", "FileDescription", "CompanyName", "InternalName", "OriginalFilename"]:
            pattern = (key + "\x00").encode("utf-16le")
            idx = data.find(pattern)
            if idx != -1:
                val_start = idx + len(pattern)
                while val_start < len(data) and data[val_start:val_start+2] == b"\x00\x00":
                    val_start += 2
                val_bytes = bytearray()
                while val_start + 1 < len(data):
                    pair = data[val_start:val_start+2]
                    if pair == b"\x00\x00":
                        break
                    val_bytes.extend(pair)
                    val_start += 2
                val_str = val_bytes.decode("utf-16le", errors="ignore").strip()
                if val_str:
                    meta[key] = val_str
        return meta
    except Exception:
        return {}


def resolve_icon(app_info, desktop_path, home):
    icon = app_info.get_icon() if app_info else None
    icon_str = icon.to_string() if icon else ""

    # If icon was None, try reading Icon= from desktop_path directly
    if not icon_str and os.path.exists(desktop_path):
        try:
            with open(desktop_path, "r", errors="ignore") as f:
                for line in f:
                    if line.startswith("Icon="):
                        icon_str = line.strip().split("=", 1)[1].strip()
                        break
        except Exception:
            pass

    name_hints = []
    base_file = os.path.basename(desktop_path).replace(".desktop", "").lower()
    name_hints.append(base_file)
    if "_" in base_file:
        name_hints.append(base_file.split("_")[0])
    if "-" in base_file:
        name_hints.append(base_file.split("-")[0])
    if app_info and app_info.get_name():
        app_n = app_info.get_name().lower()
        name_hints.append(app_n)
        for w in app_n.split():
            name_hints.append(w)
    if icon_str and not icon_str.startswith("/"):
        name_hints.append(icon_str.lower())
    elif icon_str and icon_str.startswith("/"):
        base_icon = os.path.splitext(os.path.basename(icon_str))[0].lower()
        if base_icon not in ("icon", "default", "default256"):
            name_hints.append(base_icon)

    # Special well-known mappings
    if any("steam" in h for h in name_hints):
        name_hints.insert(0, "steam")

    # 1. Prefer macOS Tahoe themed icon if available
    for hint in name_hints:
        for tdir in [
            os.path.join(home, ".local/share/icons/MacTahoe/apps/scalable"),
            os.path.join(home, ".local/share/icons/MacTahoe-dark/apps/scalable"),
            os.path.join(home, ".local/share/icons/MacTahoe/apps/48"),
            os.path.join(home, ".local/share/icons/MacTahoe-dark/apps/48"),
            "/usr/share/icons/MacTahoe-dark/apps/scalable"
        ]:
            for ext in [".svg", ".png"]:
                cand = os.path.join(tdir, f"{hint}{ext}")
                if os.path.exists(cand):
                    return f"file://{cand}"

    # 2. If icon_str is a direct path to an existing file
    if icon_str.startswith("/"):
        if os.path.exists(icon_str):
            return f"file://{icon_str}"
    if icon_str.startswith("file://"):
        p = icon_str[7:]
        if os.path.exists(p):
            return icon_str

    # 3. Check system and user icon dirs for icon_str or name hints
    search_dirs = [
        os.path.join(home, ".local/share/icons/MacTahoe/apps/scalable"),
        os.path.join(home, ".local/share/icons/MacTahoe-dark/apps/scalable"),
        os.path.join(home, ".local/share/icons/hicolor/scalable/apps"),
        os.path.join(home, ".local/share/icons/hicolor/512x512/apps"),
        os.path.join(home, ".local/share/icons/hicolor/256x256/apps"),
        os.path.join(home, ".local/share/icons/hicolor/128x128/apps"),
        os.path.join(home, ".local/share/icons/hicolor/48x48/apps"),
        "/usr/share/icons/hicolor/scalable/apps",
        "/usr/share/icons/hicolor/512x512/apps",
        "/usr/share/icons/hicolor/256x256/apps",
        "/usr/share/icons/hicolor/128x128/apps",
        "/usr/share/icons/hicolor/48x48/apps",
        "/usr/share/pixmaps"
    ]

    all_keys = ([icon_str] if icon_str and not icon_str.startswith("/") else []) + name_hints
    for k in all_keys:
        for sdir in search_dirs:
            for ext in [".svg", ".png", ".xpm"]:
                cand = os.path.join(sdir, k + ext)
                if os.path.exists(cand):
                    return f"file://{cand}"

    # 4. Gtk.IconTheme lookup
    try:
        import gi
        gi.require_version("Gtk", "3.0")
        from gi.repository import Gtk
        theme = Gtk.IconTheme.get_default()
        for k in all_keys:
            info = theme.lookup_icon(k, 256, 0)
            if info:
                fn = info.get_filename()
                if fn and os.path.exists(fn):
                    return f"file://{fn}"
    except Exception:
        pass

    return None


def sync():
    _lock = acquire_sync_lock()
    try:
        _sync_internal()
    finally:
        if _lock:
            try:
                fcntl.flock(_lock, fcntl.LOCK_UN)
                _lock.close()
            except Exception:
                pass

def _sync_internal():
    home = HOME
    apps_dir = APPS_DIR
    os.makedirs(apps_dir, exist_ok=True)
    
    # Symlink /Applications -> ~/Applications if root or possible
    try:
        if not os.path.exists("/Applications"):
            os.symlink(apps_dir, "/Applications")
    except Exception:
        pass

    search_dirs = [
        "/usr/share/applications",
        "/var/lib/snapd/desktop/applications",
        "/var/lib/flatpak/exports/share/applications",
        os.path.join(home, ".local/share/applications"),
        os.path.join(home, ".local/share/applications/wine/Programs")
    ]
    
    seen_ids = set()
    used_names = set()
    active_links = set()
    seen_targets = {}  # target_key -> (target_filename, dest_path, source_file)
    
    for sdir in search_dirs:
        if not os.path.isdir(sdir):
            continue
        for root, _, files in os.walk(sdir):
            for file in sorted(files):
                if not file.endswith(".desktop"):
                    continue
                f = os.path.join(root, file)
                base = file
                if base in seen_ids:
                    continue
                if base in ('wine.desktop', 'winetricks.desktop') or base.startswith(('winecfg', 'wine-wineboot', 'winefile', 'wineconsole', 'winedbg', 'winepath')):
                    continue
                try:
                    app_info = Gio.DesktopAppInfo.new_from_filename(f)
                    if not app_info or not app_info.should_show():
                        continue
                    seen_ids.add(base)
                    
                    name = app_info.get_name()
                    if not name:
                        name = base.replace(".desktop", "")
                    
                    # Sanitize filename
                    safe_name = "".join(c for c in name if c not in '/\\:*?"<>|').strip()
                    if not safe_name:
                        safe_name = base.replace(".desktop", "")

                    # Compute target key for deduplication
                    cmdline = app_info.get_commandline() or ""
                    m_wine = re.search(r'mac-wine-runner\s+"?([^"]+\.exe)"?', cmdline, re.I)
                    if m_wine:
                        target_key = ("wine", os.path.normcase(os.path.realpath(m_wine.group(1)) if os.path.exists(m_wine.group(1)) else m_wine.group(1).lower()))
                    else:
                        c_clean = re.sub(r'%[a-zA-Z]', '', cmdline).strip()
                        c_clean = re.sub(r'^env\s+__NV_PRIME_RENDER_OFFLOAD=1\s+__GLX_VENDOR_LIBRARY_NAME=nvidia\s+', '', c_clean).strip()
                        parts = c_clean.split()
                        target_bin = parts[0] if parts else base
                        target_key = ("bin", os.path.normcase(target_bin))

                    if target_key in seen_targets:
                        prev_target_fn, prev_dest_path, prev_src = seen_targets[target_key]
                        # If this is a duplicate entry for the exact same target
                        # (e.g. wine-capcut.desktop vs CapCut.desktop), skip creating a duplicate!
                        if base.startswith("wine-") and not os.path.basename(prev_src).startswith("wine-"):
                            try:
                                os.remove(f)
                            except Exception:
                                pass
                        continue
                        
                    target_filename = f"{safe_name}.desktop"
                    count = 1
                    while target_filename in used_names:
                        target_filename = f"{safe_name} ({count}).desktop"
                        count += 1
                    used_names.add(target_filename)
                    
                    dest_path = os.path.join(apps_dir, target_filename)
                    active_links.add(dest_path)
                    seen_targets[target_key] = (target_filename, dest_path, f)
                    
                    # Create or update desktop file as regular file
                    if os.path.islink(dest_path):
                        try:
                            os.remove(dest_path)
                        except Exception:
                            pass
                    try:
                        with open(f, "r", errors="ignore") as src_f:
                            lines = src_f.readlines()
                        clean_lines = [l for l in lines if not l.startswith("X-Mac-Real-Path=") and not l.startswith("X-Mac-Wine-App=") and not l.startswith("PrefersNonDefaultGPU=") and not l.startswith("X-KDE-RunOnDiscreteGpu=")]
                        while clean_lines and not clean_lines[-1].strip():
                            clean_lines.pop()

                        # Normalize Icon= for snap apps and known themed apps so GNOME Shell uses MacTahoe theme
                        has_icon_line = any(l.startswith("Icon=") for l in clean_lines)
                        normalized_lines = []
                        base_key = base.replace(".desktop", "").lower()
                        name_low = name.lower()

                        for l in clean_lines:
                            if l.startswith("Icon="):
                                icon_val = l.strip().split("=", 1)[1]
                                mapped_icon = None
                                if "steam" in base_key or "steam" in name_low:
                                    mapped_icon = "steam"
                                elif "telegram" in base_key or "telegram" in name_low:
                                    mapped_icon = "telegram"
                                elif "antigravity" in base_key or "antigravity" in name_low:
                                    mapped_icon = "antigravity"
                                elif "snap-store" in base_key or "app center" in name_low:
                                    mapped_icon = "snap-store"
                                elif "discord" in base_key or "discord" in name_low:
                                    mapped_icon = "discord"
                                elif "firefox" in base_key or "firefox" in name_low:
                                    mapped_icon = "firefox"
                                elif "zoom" in base_key or "zoom" in name_low:
                                    mapped_icon = "Zoom"
                                elif icon_val.startswith("/snap/"):
                                    parts = icon_val.split("/")
                                    if len(parts) > 2 and parts[1] == "snap":
                                        snap_pkg = parts[2]
                                        if icon_exists_in_theme(snap_pkg):
                                            mapped_icon = snap_pkg
                                        elif os.path.exists(icon_val):
                                            install_icon_file(icon_val, snap_pkg)
                                            mapped_icon = snap_pkg
                                        else:
                                            mapped_icon = icon_val
                                elif not icon_exists_in_theme(icon_val) and not os.path.isabs(icon_val):
                                    res_cand = resolve_icon(app_info, f, home)
                                    if res_cand and res_cand.startswith("file://"):
                                        real_path = res_cand[7:]
                                        install_icon_file(real_path, icon_val)

                                if mapped_icon:
                                    normalized_lines.append(f"Icon={mapped_icon}\n")
                                else:
                                    normalized_lines.append(l)
                            else:
                                normalized_lines.append(l)

                        if not has_icon_line:
                            injected_icon = None
                            if "steam" in base_key or "steam" in name_low:
                                injected_icon = "steam"
                            elif icon_exists_in_theme(safe_name.lower()):
                                injected_icon = safe_name.lower()
                            elif icon_exists_in_theme(base_key):
                                injected_icon = base_key
                            if injected_icon:
                                normalized_lines.append(f"Icon={injected_icon}\n")
                            else:
                                res_cand = resolve_icon(app_info, f, home)
                                if res_cand and res_cand.startswith("file://"):
                                    normalized_lines.append(f"Icon={res_cand[7:]}\n")

                        clean_lines = normalized_lines

                        if "damx" in base.lower() and not any(l.startswith("StartupWMClass=") for l in clean_lines):
                            clean_lines.append("StartupWMClass=DivAcerManagerMax\n")
                        if "opencode" in base.lower() and not any(l.startswith("StartupWMClass=") for l in clean_lines):
                            clean_lines.append("StartupWMClass=ai.opencode.desktop\n")
                        cats = app_info.get_categories() or ""
                        cmdline = app_info.get_commandline() or ""
                        is_game = ("Game" in cats) or ("game" in base.lower()) or ("steam" in base.lower()) or ("steam://" in cmdline)
                        is_wine = ("wine" in base.lower()) or ("wine" in cmdline.lower()) or any("X-Mac-Wine-App=true" in l for l in lines)
                        clean_lines.append(f"\nX-Mac-Real-Path={f}\n")
                        if is_wine:
                            clean_lines.append("X-Mac-Wine-App=true\n")
                        
                        targets = get_gpu_targets()
                        apps_gpu = targets.get("apps", 1)
                        games_gpu = targets.get("games", 1)

                        run_on_discrete = False
                        if is_game or is_wine:
                            run_on_discrete = (games_gpu == 1 or apps_gpu == 1)
                        elif apps_gpu == 1 and base not in SYSTEM_DESKTOP_EXCLUDES:
                            run_on_discrete = True

                        if run_on_discrete:
                            clean_lines.append("PrefersNonDefaultGPU=true\nX-KDE-RunOnDiscreteGpu=true\n")
                        with open(dest_path, "w") as df:
                            df.writelines(clean_lines)
                        os.chmod(dest_path, 0o755)

                        # Also update entry in ~/.local/share/applications/ so GNOME Shell and Dock launch on RTX 3050 via switcheroo-control
                        local_dest = os.path.join(LOCAL_APPS_DIR, base)
                        if run_on_discrete and base not in SYSTEM_DESKTOP_EXCLUDES:
                            try:
                                with open(local_dest, "w") as ldf:
                                    ldf.writelines(clean_lines)
                                os.chmod(local_dest, 0o755)
                            except Exception:
                                pass
                    except Exception:
                        pass
                        
                    # Set icon metadata
                    res_icon = resolve_icon(app_info, f, home)
                    if res_icon:
                        subprocess.run(["gio", "set", dest_path, "metadata::custom-icon", res_icon],
                                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                        subprocess.run(["gio", "set", "-t", "unset", dest_path, "metadata::custom-icon-name"],
                                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                    else:
                        icon = app_info.get_icon()
                        if icon:
                            icon_str = icon.to_string()
                            if icon_str:
                                subprocess.run(["gio", "set", dest_path, "metadata::custom-icon-name", icon_str],
                                               stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                except Exception:
                    pass
                
    # Remove stale symlinks or deleted apps
    for f in glob.glob(os.path.join(apps_dir, "*.desktop")):
        if f not in active_links:
            try:
                os.remove(f)
            except Exception:
                pass

    print(f"Synced {len(active_links)} applications to {apps_dir}")

    # Sanitize Desktop shortcuts created by Wine or other installers
    for dtop_name in ["Desktop", "Десктоп", "Стільниця"]:
        dtop_dir = os.path.join(home, dtop_name)
        if not os.path.isdir(dtop_dir):
            continue
        # Remove leftover .lnk files
        for lnk in glob.glob(os.path.join(dtop_dir, "*.lnk")):
            try:
                os.remove(lnk)
            except Exception:
                pass
        # Sanitize .desktop files
        for dt in glob.glob(os.path.join(dtop_dir, "*.desktop")):
            try:
                os.chmod(dt, 0o755)
                subprocess.run(["gio", "set", dt, "metadata::trusted", "true"],
                               stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                with open(dt, "r", errors="ignore") as f:
                    content = f.read()
                lines = content.splitlines()
                new_lines = []
                for line in lines:
                    if line.startswith("Exec="):
                        m = re.search(r'([A-Za-z]:\\[^"\n\r]+|/[^"\n\r]+\.exe)', line)
                        if m:
                            win_target = m.group(1).replace("\\\\", "/").replace("\\", "/")
                            if re.match(r'^[A-Za-z]:', win_target):
                                win_target = os.path.join(home, ".wine/drive_c", win_target[3:])
                            line = f'Exec=/usr/local/bin/mac-wine-runner "{win_target}" %U'
                    new_lines.append(line)
                if not any(l.startswith("PrefersNonDefaultGPU=") for l in new_lines):
                    new_lines.append("PrefersNonDefaultGPU=true")
                    new_lines.append("X-KDE-RunOnDiscreteGpu=true")
                with open(dt, "w") as f:
                    f.write("\n".join(new_lines) + "\n")
            except Exception:
                pass


def extract_app_name(filename):
    if os.path.isfile(filename) and filename.lower().endswith(('.exe', '.msi')):
        pe_meta = get_pe_metadata(filename)
        prod = pe_meta.get("ProductName", "").strip()
        desc = pe_meta.get("FileDescription", "").strip()
        generic_terms = {"setup", "installer", "installation", "update", "updater", "patch", "stub", "bootstrapper", "win32", "win64", "x86", "x64"}
        if prod and prod.lower() not in generic_terms and len(prod) > 1:
            return prod
        if desc and desc.lower() not in generic_terms and len(desc) > 1:
            return desc

    base = os.path.basename(filename)
    for ext in ['.appimage', '.AppImage', '.tar.gz', '.tar.xz', '.tgz', '.tar.bz2', '.tar', '.zip', '.deb', '.exe', '.EXE', '.msi', '.MSI', '.bat', '.cmd']:
        if base.endswith(ext):
            base = base[:-len(ext)]
            break
    clean = re.sub(r'[-_](?:v?[\d\.]+.*|x86_64|amd64|i386|linux|x64|x86|win32|win64|win|setup|installer|install|appimage).*$', '', base, flags=re.I)
    clean = re.sub(r'(?:[-_]?(?:setup|installer|install))+$', '', clean, flags=re.I)
    clean = clean.replace('-', ' ').replace('_', ' ').strip().title()
    return clean or base


def wait_for_file_ready(filepath, timeout=20):
    last_size = -1
    stable_count = 0
    start = time.time()
    while time.time() - start < timeout:
        if not os.path.exists(filepath):
            return False
        try:
            curr_size = os.path.getsize(filepath)
            if curr_size > 0 and curr_size == last_size:
                stable_count += 1
                if stable_count >= 2:
                    return True
            else:
                stable_count = 0
                last_size = curr_size
        except Exception:
            pass
        time.sleep(0.5)
    return os.path.exists(filepath) and os.path.getsize(filepath) > 0


def extract_appimage_metadata(dest_binary, temp_dir):
    try:
        subprocess.run([dest_binary, "--appimage-extract"], cwd=temp_dir,
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=25)
    except Exception:
        pass
        
    squashfs_dir = os.path.join(temp_dir, "squashfs-root")
    if not os.path.isdir(squashfs_dir) and shutil.which("unsquashfs"):
        try:
            subprocess.run(["unsquashfs", "-d", squashfs_dir, dest_binary],
                           cwd=temp_dir, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=25)
        except Exception:
            pass
    if not os.path.isdir(squashfs_dir) and shutil.which("7z"):
        try:
            subprocess.run(["7z", "x", f"-o{squashfs_dir}", dest_binary],
                           cwd=temp_dir, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=25)
        except Exception:
            pass

    embedded_meta = {
        "name": "",
        "comment": "",
        "categories": "",
        "icon": "",
        "wmclass": "",
        "icon_file": ""
    }

    if not os.path.isdir(squashfs_dir):
        return embedded_meta

    desktops = glob.glob(os.path.join(squashfs_dir, "*.desktop")) + \
               glob.glob(os.path.join(squashfs_dir, "usr", "share", "applications", "*.desktop"))
    if not desktops:
        desktops = glob.glob(os.path.join(squashfs_dir, "**", "*.desktop"), recursive=True)

    if desktops:
        try:
            with open(desktops[0], "r", errors="ignore") as df:
                for line in df:
                    line = line.strip()
                    if line.startswith("Name=") and not embedded_meta["name"]:
                        embedded_meta["name"] = line.split("=", 1)[1].strip()
                    elif line.startswith("Comment=") and not embedded_meta["comment"]:
                        embedded_meta["comment"] = line.split("=", 1)[1].strip()
                    elif line.startswith("Categories=") and not embedded_meta["categories"]:
                        embedded_meta["categories"] = line.split("=", 1)[1].strip()
                    elif line.startswith("Icon=") and not embedded_meta["icon"]:
                        embedded_meta["icon"] = line.split("=", 1)[1].strip()
                    elif line.startswith("StartupWMClass=") and not embedded_meta["wmclass"]:
                        embedded_meta["wmclass"] = line.split("=", 1)[1].strip()
        except Exception:
            pass

    icon_candidates = []
    dir_icon = os.path.join(squashfs_dir, ".DirIcon")
    if os.path.exists(dir_icon) and os.path.getsize(dir_icon) > 0:
        icon_candidates.append((500, dir_icon))

    target_icon_name = embedded_meta.get("icon", "").lower()
    for root, _, files in os.walk(squashfs_dir):
        for f in files:
            f_low = f.lower()
            if f_low.endswith((".png", ".svg")):
                fp = os.path.join(root, f)
                try:
                    fsize = os.path.getsize(fp)
                    score = fsize
                    base_no_ext = os.path.splitext(f_low)[0]
                    if target_icon_name and (base_no_ext == target_icon_name):
                        score += 10000000
                    elif "256x256" in root or "512x512" in root or "scalable" in root:
                        score += 5000000
                    icon_candidates.append((score, fp))
                except Exception:
                    pass

    if icon_candidates:
        icon_candidates.sort(key=lambda x: x[0], reverse=True)
        embedded_meta["icon_file"] = icon_candidates[0][1]

    return embedded_meta


def install_appimage(filepath):
    if not wait_for_file_ready(filepath):
        return
    print(f"[Installer] Installing AppImage: {filepath}")
    clean_name = extract_app_name(filepath)
    safe_id = "".join(c for c in clean_name if c.isalnum() or c in "-_").lower()
    dest_binary = os.path.join(APPIMAGES_DIR, os.path.basename(filepath))
    
    try:
        shutil.move(filepath, dest_binary)
        os.chmod(dest_binary, 0o755)
    except Exception as e:
        print(f"[Installer] Move AppImage failed: {e}")
        return

    icon_path = ""
    app_comment = f"{clean_name} Application"
    categories = "Utility;Application;"
    startup_wmclass = ""

    # Attempt to extract icon and desktop metadata from AppImage
    temp_dir = tempfile.mkdtemp(prefix="appimage_ext_")
    try:
        meta = extract_appimage_metadata(dest_binary, temp_dir)
        if meta.get("name"):
            clean_name = meta["name"]
            safe_id = "".join(c for c in clean_name if c.isalnum() or c in "-_").lower() or safe_id
        if meta.get("comment"):
            app_comment = meta["comment"]
        if meta.get("categories"):
            categories = meta["categories"]
        if meta.get("wmclass"):
            startup_wmclass = meta["wmclass"]
        if meta.get("icon_file"):
            install_icon_file(meta["icon_file"], safe_id)
            if meta.get("icon") and meta["icon"] != safe_id:
                install_icon_file(meta["icon_file"], meta["icon"])
                icon_path = meta["icon"]
            else:
                icon_path = safe_id
            update_icon_caches()
    except Exception as e:
        print(f"[Installer] AppImage metadata extraction error: {e}")
    finally:
        shutil.rmtree(temp_dir, ignore_errors=True)

    if not icon_path:
        icon_path = safe_id

    wmclass_line = f"StartupWMClass={startup_wmclass}\n" if startup_wmclass else ""
    desktop_content = f"""[Desktop Entry]
Type=Application
Name={clean_name}
Comment={app_comment}
Exec="{dest_binary}" %U
Icon={icon_path}
Terminal=false
Categories={categories}
X-Mac-AppImage=true
X-Mac-Real-Path={dest_binary}
{wmclass_line}StartupNotify=true
"""
    local_desktop = os.path.join(LOCAL_APPS_DIR, f"appimage-{safe_id}.desktop")
    with open(local_desktop, "w") as df:
        df.write(desktop_content)
    os.chmod(local_desktop, 0o755)

    subprocess.run(["update-desktop-database", LOCAL_APPS_DIR], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    sync()
    subprocess.run(["notify-send", "-a", "macOS", "-i", APP_STORE_ICON,
                    "Програму встановлено", f"Програма \"{clean_name}\" успішно встановлена!"])


def install_archive(filepath):
    if not wait_for_file_ready(filepath):
        return
    print(f"[Installer] Installing Archive: {filepath}")
    clean_name = extract_app_name(filepath)
    safe_id = "".join(c for c in clean_name if c.isalnum() or c in "-_").lower()
    temp_dir = tempfile.mkdtemp(prefix="archive_ext_")

    try:
        if zipfile.is_zipfile(filepath):
            with zipfile.ZipFile(filepath, "r") as z:
                z.extractall(temp_dir)
        elif tarfile.is_tarfile(filepath):
            with tarfile.open(filepath, "r") as t:
                t.extractall(temp_dir)
        else:
            return
    except Exception as e:
        print(f"[Installer] Archive extraction failed: {e}")
        shutil.rmtree(temp_dir, ignore_errors=True)
        return

    # Delete the dropped archive from ~/Applications
    try:
        os.remove(filepath)
    except Exception:
        pass

    # Find root content folder if archive had a single enclosing folder
    root_content = temp_dir
    sub_items = os.listdir(temp_dir)
    if len(sub_items) == 1 and os.path.isdir(os.path.join(temp_dir, sub_items[0])):
        root_content = os.path.join(temp_dir, sub_items[0])

    target_app_dir = os.path.join(INSTALLED_APPS_DIR, safe_id)
    if os.path.exists(target_app_dir):
        shutil.rmtree(target_app_dir, ignore_errors=True)
    shutil.copytree(root_content, target_app_dir)
    shutil.rmtree(temp_dir, ignore_errors=True)

    # Check for installer scripts: setup.sh / install.sh
    installer_script = None
    for cand in ["setup.sh", "install.sh", "install", "setup"]:
        p = os.path.join(target_app_dir, cand)
        if os.path.isfile(p):
            installer_script = p
            break

    if installer_script:
        os.chmod(installer_script, 0o755)
        try:
            subprocess.run(["bash", installer_script], cwd=target_app_dir, timeout=60)
        except Exception as e:
            print(f"[Installer] Running installer script error: {e}")

    # Check for .desktop file or main binary
    main_desktop = None
    desktops = glob.glob(os.path.join(target_app_dir, "**", "*.desktop"), recursive=True)
    if desktops:
        main_desktop = desktops[0]

    # Find main executable
    main_bin = None
    for root, _, files in os.walk(target_app_dir):
        for f in files:
            fp = os.path.join(root, f)
            if os.access(fp, os.X_OK) and not fp.endswith((".sh", ".desktop", ".so", ".txt", ".md", ".json")):
                main_bin = fp
                break
        if main_bin:
            break

    # If no binary found, search for runnable scripts (.sh, .bin, .py)
    if not main_bin:
        for root, _, files in os.walk(target_app_dir):
            for f in files:
                fp = os.path.join(root, f)
                if f not in ("install.sh", "setup.sh", "uninstall.sh") and fp.endswith((".sh", ".py", ".bin")):
                    main_bin = fp
                    os.chmod(main_bin, 0o755)
                    break
            if main_bin:
                break

    icon_path = ""
    icons = glob.glob(os.path.join(target_app_dir, "**", "*.png"), recursive=True) + \
            glob.glob(os.path.join(target_app_dir, "**", "*.svg"), recursive=True)
    if icons:
        icons.sort(key=lambda x: os.path.getsize(x), reverse=True)
        install_icon_file(icons[0], safe_id)
        update_icon_caches()
        icon_path = safe_id

    if main_desktop and os.path.exists(main_desktop):
        # Patch desktop file with full paths
        with open(main_desktop, "r", errors="ignore") as df:
            lines = df.readlines()
        with open(os.path.join(LOCAL_APPS_DIR, f"local-{safe_id}.desktop"), "w") as df:
            for line in lines:
                if line.startswith("Exec="):
                    df.write(f"Exec=\"{main_bin or target_app_dir}\" %U\n")
                elif line.startswith("Icon=") and icon_path:
                    df.write(f"Icon={icon_path}\n")
                else:
                    df.write(line)
            df.write(f"\nX-Mac-Installed-App=true\nX-Mac-App-Dir={target_app_dir}\nStartupNotify=true\n")
    elif main_bin:
        desktop_content = f"""[Desktop Entry]
Type=Application
Name={clean_name}
Exec="{main_bin}" %U
Icon={icon_path or 'application-x-executable'}
Terminal=false
Categories=Utility;Application;
X-Mac-Installed-App=true
X-Mac-App-Dir={target_app_dir}
StartupNotify=true
"""
        local_desktop = os.path.join(LOCAL_APPS_DIR, f"local-{safe_id}.desktop")
        with open(local_desktop, "w") as df:
            df.write(desktop_content)
        os.chmod(local_desktop, 0o755)

    subprocess.run(["update-desktop-database", LOCAL_APPS_DIR], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    sync()
    subprocess.run(["notify-send", "-a", "macOS", "-i", APP_STORE_ICON,
                    "Програму встановлено", f"Програма \"{clean_name}\" успішно розгорнута та додана до списку програм!"])


def install_deb(filepath):
    if not wait_for_file_ready(filepath):
        return
    print(f"[Installer] Installing DEB: {filepath}")
    clean_name = extract_app_name(filepath)
    res = subprocess.run(["pkexec", "apt-get", "install", "-y", filepath])
    try:
        os.remove(filepath)
    except Exception:
        pass
    if res.returncode == 0:
        sync()
        subprocess.run(["notify-send", "-a", "macOS", "-i", APP_STORE_ICON, "Встановлено",
                        f"Пакет \"{clean_name}\" успішно встановлено в систему!"])


def extract_exe_icon(exe_path, app_id):
    if not exe_path or not os.path.exists(exe_path):
        return ""
    if not shutil.which("wrestool") or not shutil.which("icotool"):
        return ""
    temp_dir = tempfile.mkdtemp(prefix="wine_icon_")
    try:
        raw_ico = os.path.join(temp_dir, "app.ico")
        # Extract group icon resource (type 14) or icon (type 3)
        subprocess.run(["wrestool", "-x", "-t14", exe_path, "-o", raw_ico],
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        if not os.path.exists(raw_ico) or os.path.getsize(raw_ico) == 0:
            subprocess.run(["wrestool", "-x", "-t3", exe_path, "-o", raw_ico],
                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        if os.path.exists(raw_ico) and os.path.getsize(raw_ico) > 0:
            subprocess.run(["icotool", "-x", "-o", temp_dir, raw_ico],
                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            pngs = glob.glob(os.path.join(temp_dir, "*.png"))
            if pngs:
                pngs.sort(key=lambda x: os.path.getsize(x), reverse=True)
                install_icon_file(pngs[0], app_id)
                update_icon_caches()
                return app_id
    except Exception as e:
        print(f"[Wine Installer] Icon extraction error: {e}")
    finally:
        shutil.rmtree(temp_dir, ignore_errors=True)
    return ""


def is_windows_installer(filepath):
    ext = os.path.splitext(filepath)[1].lower()
    if ext == ".msi":
        return True
    base = os.path.basename(filepath).lower()
    for kw in ["setup", "install", "installer", "update", "patch"]:
        if kw in base:
            return True
    try:
        with open(filepath, "rb") as f:
            header = f.read(5 * 1024 * 1024)
            if b"Inno Setup" in header or b"Nullsoft" in header or b"NSIS" in header or b"InstallShield" in header or b"WiX" in header:
                return True
    except Exception:
        pass
    return False


def get_file_source_info(filepath):
    """
    Retrieves the original source path and directory for a file dropped into ~/Applications.
    Checks:
    1. Per-file metadata JSON in /run/user/<uid>/mac-app-sources/<basename>.json
    2. Per-file metadata JSON in ~/.cache/mac-app-sources/<basename>.json
    3. GIO xattr metadata (xattr::user.mac_source_path, xattr::user.mac_source_dir)
    4. Heuristic search: check mounted drives and Downloads for matching basename and sibling data
    """
    base_name = os.path.basename(filepath)
    now = time.time()

    # 1. Check runtime dir
    runtime_dir = os.environ.get("XDG_RUNTIME_DIR") or f"/run/user/{os.getuid()}"
    meta_json = os.path.join(runtime_dir, "mac-app-sources", f"{base_name}.json")
    if os.path.isfile(meta_json):
        try:
            with open(meta_json, "r", encoding="utf-8") as f:
                data = json.load(f)
            sp = data.get("source_path")
            sd = data.get("source_dir")
            ts = data.get("timestamp", 0)
            if sp and sd and (now - ts < 7200):
                print(f"[SourceInfo] Found runtime metadata for {base_name}: source_dir={sd}")
                return sp, sd
        except Exception as e:
            print(f"[SourceInfo] Error reading {meta_json}: {e}")

    # 2. Check ~/.cache/mac-app-sources/
    cache_meta_json = os.path.join(HOME, ".cache", "mac-app-sources", f"{base_name}.json")
    if os.path.isfile(cache_meta_json):
        try:
            with open(cache_meta_json, "r", encoding="utf-8") as f:
                data = json.load(f)
            sp = data.get("source_path")
            sd = data.get("source_dir")
            ts = data.get("timestamp", 0)
            if sp and sd and (now - ts < 7200):
                print(f"[SourceInfo] Found cache metadata for {base_name}: source_dir={sd}")
                return sp, sd
        except Exception as e:
            print(f"[SourceInfo] Error reading {cache_meta_json}: {e}")

    # 3. Check GIO xattrs
    try:
        gf = Gio.File.new_for_path(filepath)
        gi_info = gf.query_info("xattr::user.mac_source_path,xattr::user.mac_source_dir", Gio.FileQueryInfoFlags.NONE, None)
        sp = gi_info.get_attribute_string("xattr::user.mac_source_path")
        sd = gi_info.get_attribute_string("xattr::user.mac_source_dir")
        if sp and sd and os.path.isdir(sd):
            print(f"[SourceInfo] Found GIO xattr metadata for {base_name}: source_dir={sd}")
            return sp, sd
    except Exception:
        pass

    # 4. Intelligent heuristic fallback: search mounted volumes and Downloads
    try:
        target_size = os.path.getsize(filepath) if os.path.exists(filepath) else 0
        search_roots = []
        user = os.environ.get("USER") or "vitaliy"
        for media_dir in [f"/run/media/{user}", f"/media/{user}", "/mnt"]:
            if os.path.isdir(media_dir):
                search_roots.append(media_dir)
        search_roots.append(os.path.join(HOME, "Downloads"))
        search_roots.append(os.path.join(HOME, "Завантаження"))

        candidates = []
        for root_dir in search_roots:
            for root, dirs, files in os.walk(root_dir):
                depth = root[len(root_dir):].count(os.sep)
                if depth > 8:
                    dirs.clear()
                    continue
                if base_name in files:
                    cand_path = os.path.join(root, base_name)
                    if ".Trash" in cand_path:
                        continue
                    try:
                        cand_size = os.path.getsize(cand_path)
                        siblings = [item for item in os.listdir(root) if item != base_name]
                        has_sibling_data = any(
                            s.lower() in ("data", "payload", "bin", "lib", "setup", "install") or
                            s.lower().endswith((".cab", ".bin", ".iso", ".dat", ".pak", ".assets", ".xml"))
                            for s in siblings
                        )
                        score = 0
                        if target_size > 0 and cand_size == target_size:
                            score += 10
                        if has_sibling_data:
                            score += 5
                        if len(siblings) > 0:
                            score += 2
                        if score > 0:
                            candidates.append((score, cand_path, root))
                    except Exception:
                        pass

        if candidates:
            candidates.sort(key=lambda x: x[0], reverse=True)
            best_cand = candidates[0]
            print(f"[SourceInfo] Heuristic detected source for {base_name}: {best_cand[1]} (dir: {best_cand[2]})")
            return best_cand[1], best_cand[2]
    except Exception as e:
        print(f"[SourceInfo] Heuristic search error: {e}")

    return None, None


def install_wine_installer(filepath):
    if not wait_for_file_ready(filepath):
        return
    print(f"[Wine Installer] Processing Windows executable: {filepath}")
    pe_meta = get_pe_metadata(filepath)
    clean_name = pe_meta.get("ProductName") or pe_meta.get("FileDescription") or extract_app_name(filepath)
    if clean_name.lower() in ("setup", "installer", "installation", "update", "patch", "stub"):
        clean_name = extract_app_name(filepath)
    safe_id = "".join(c for c in clean_name if c.isalnum() or c in "-_").lower() or "winapp"
    ext = os.path.splitext(filepath)[1].lower()

    source_path, source_dir = get_file_source_info(filepath)
    has_source = bool(source_path and source_dir and os.path.isdir(source_dir))

    wine_runner = "/usr/local/bin/mac-wine-runner"
    if not os.path.exists(wine_runner):
        wine_runner = "wine"

    env = os.environ.copy()
    env["WINEDEBUG"] = "-all"
    env["WINEPREFIX"] = os.path.join(HOME, ".wine")

    if has_source:
        print(f"[Wine Installer] Origin detected: {source_path} in {source_dir}")
        if not os.path.exists(source_path):
            try:
                shutil.copy2(filepath, source_path)
                print(f"[Wine Installer] Restored missing source file at {source_path}")
            except Exception as e:
                print(f"[Wine Installer] Restore failed: {e}")

        target_path = source_path
        target_cwd = source_dir

        try:
            if os.path.exists(filepath):
                os.remove(filepath)
        except Exception:
            pass

        meta_json = os.path.join(os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}"), "mac-app-sources", f"{os.path.basename(filepath)}.json")
        try:
            if os.path.exists(meta_json):
                os.remove(meta_json)
        except Exception:
            pass
    else:
        target_path = filepath
        target_cwd = os.path.dirname(filepath)

    # If it is NOT an installer, treat as portable application
    if not is_windows_installer(target_path):
        print(f"[Wine Installer] Detected portable application: {clean_name}")
        if has_source:
            dest_binary = target_path
            dest_cwd = target_cwd
        else:
            app_target_dir = os.path.join(WINE_APPS_DIR, safe_id)
            os.makedirs(app_target_dir, exist_ok=True)
            dest_binary = os.path.join(app_target_dir, os.path.basename(target_path))
            dest_cwd = app_target_dir
            try:
                shutil.move(target_path, dest_binary)
            except Exception as e:
                print(f"[Wine Installer] Move failed: {e}")
                return

        icon_path = extract_exe_icon(dest_binary, safe_id)
        desktop_content = f"""[Desktop Entry]
Type=Application
Name={clean_name}
Comment={clean_name} Windows Application
Exec=/usr/local/bin/mac-wine-runner "{dest_binary}" %U
Path={dest_cwd}
Icon={icon_path or 'application-x-ms-dos-executable'}
Terminal=false
Categories=Utility;Application;
X-Mac-Wine-App=true
X-Mac-Real-Path={dest_binary}
StartupWMClass={os.path.basename(dest_binary)}
PrefersNonDefaultGPU=true
X-KDE-RunOnDiscreteGpu=true
StartupNotify=true
"""
        local_desktop = os.path.join(LOCAL_APPS_DIR, f"wine-{safe_id}.desktop")
        with open(local_desktop, "w") as df:
            df.write(desktop_content)
        os.chmod(local_desktop, 0o755)

        subprocess.run(["update-desktop-database", LOCAL_APPS_DIR], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        sync()
        subprocess.run(["notify-send", "-a", "macOS", "-i", APP_STORE_ICON,
                        "Програму додано", f"Windows програма \"{clean_name}\" готова до запуску!"])
        return

    # Case: Windows Installer (.exe / .msi)
    if not has_source:
        installer_name = os.path.basename(filepath)
        cached_installer = os.path.join(WINE_INSTALLERS_CACHE, installer_name)
        try:
            shutil.move(filepath, cached_installer)
        except Exception as e:
            print(f"[Wine Installer] Move to cache failed: {e}")
            cached_installer = filepath
        target_path = cached_installer
        target_cwd = WINE_INSTALLERS_CACHE

    subprocess.run(["notify-send", "-a", "macOS", "-i", "system-software-install",
                    "Встановлення програми", f"Встановлення Windows програми \"{clean_name}\"..."])

    before_desktops = set(glob.glob(os.path.join(LOCAL_APPS_DIR, "**", "*.desktop"), recursive=True))

    if ext == ".msi":
        cmd = [wine_runner, "msiexec", "/i", target_path]
        print(f"[Wine Installer] Executing MSI install in {target_cwd}: {' '.join(cmd)}")
        subprocess.run(cmd, env=env, cwd=target_cwd)
    else:
        is_inno = False
        try:
            with open(target_path, "rb") as f:
                header = f.read(5 * 1024 * 1024)
                if b"Inno Setup" in header:
                    is_inno = True
        except Exception:
            pass

        if is_inno and not has_source:
            cmd = [wine_runner, target_path, "/VERYSILENT", "/SUPPRESSMSGBOXES", "/NORESTART", "/SP-"]
            print(f"[Wine Installer] Executing silent Inno install: {' '.join(cmd)}")
            res = subprocess.run(cmd, env=env, cwd=target_cwd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            if res.returncode != 0:
                print(f"[Wine Installer] Silent install returned {res.returncode}, launching standard installer...")
                subprocess.run([wine_runner, target_path], env=env, cwd=target_cwd)
        else:
            print(f"[Wine Installer] Launching standard installer in {target_cwd}: {target_path}")
            subprocess.run([wine_runner, target_path], env=env, cwd=target_cwd)

    time.sleep(2)
    after_desktops = set(glob.glob(os.path.join(LOCAL_APPS_DIR, "**", "*.desktop"), recursive=True))
    new_desktops = [d for d in (after_desktops - before_desktops) if not os.path.basename(d).startswith("wine-")]

    created_desktop = None
    icon_path = ""

    if new_desktops:
        created_desktop = new_desktops[0]
        # Keep created_desktop as the canonical desktop file, do NOT copy to wine-{safe_id}.desktop
    else:
        wine_c = os.path.join(HOME, ".wine", "drive_c")
        recent_exes = []
        if os.path.isdir(wine_c):
            now = time.time()
            for prog_dir in ["Program Files", "Program Files (x86)", "users"]:
                pdir = os.path.join(wine_c, prog_dir)
                if not os.path.isdir(pdir):
                    continue
                for root, _, files in os.walk(pdir):
                    for f in files:
                        f_low = f.lower()
                        ignored = ("unins", "setup", "install", "helper", "service", "crash", "update", "diff", "daemon", "agent", "renderer", "broker", "proxy")
                        if f_low.endswith(".exe") and not any(f_low.startswith(p) for p in ignored):
                            fp = os.path.join(root, f)
                            try:
                                mtime = os.path.getmtime(fp)
                                if now - mtime < 1200:
                                    recent_exes.append((fp, mtime))
                            except Exception:
                                pass
        if recent_exes:
            def exe_priority(item):
                fp, mtime = item
                fn = os.path.basename(fp).lower()
                clean_target = f"{clean_name.lower().replace(' ', '')}.exe"
                is_exact = fn == clean_target
                is_sub = safe_id in fn

                parent_dir = os.path.dirname(fp)
                grandparent_dir = os.path.dirname(parent_dir)
                is_subversion = False
                if os.path.exists(os.path.join(grandparent_dir, os.path.basename(fp))):
                    is_subversion = True

                score = 0
                if is_exact:
                    score = 2
                elif is_sub:
                    score = 1
                if is_subversion:
                    score -= 10
                return (score, mtime)
            recent_exes.sort(key=exe_priority, reverse=True)
            installed_exe = recent_exes[0][0]

            inst_pe = get_pe_metadata(installed_exe)
            if inst_pe.get("ProductName") and inst_pe["ProductName"].lower() not in ("setup", "installer"):
                clean_name = inst_pe["ProductName"]
                safe_id = "".join(c for c in clean_name if c.isalnum() or c in "-_").lower() or safe_id

            icon_path = extract_exe_icon(installed_exe, safe_id)

            created_desktop = os.path.join(LOCAL_APPS_DIR, f"wine-{safe_id}.desktop")
            desktop_content = f"""[Desktop Entry]
Type=Application
Name={clean_name}
Exec=/usr/local/bin/mac-wine-runner "{installed_exe}" %U
Icon={icon_path or 'application-x-ms-dos-executable'}
Terminal=false
Categories=Utility;Application;
X-Mac-Wine-App=true
X-Mac-Real-Path={installed_exe}
StartupWMClass={os.path.basename(installed_exe)}
PrefersNonDefaultGPU=true
X-KDE-RunOnDiscreteGpu=true
StartupNotify=true
"""
            with open(created_desktop, "w") as df:
                df.write(desktop_content)
            os.chmod(created_desktop, 0o755)

    if created_desktop and os.path.exists(created_desktop):
        try:
            with open(created_desktop, "r", errors="ignore") as f:
                lines = f.readlines()
            clean_lines = [l for l in lines if not l.startswith("NoDisplay=")]
            if not any(l.startswith("X-Mac-Wine-App=") for l in clean_lines):
                clean_lines.append("X-Mac-Wine-App=true\n")
            if not any(l.startswith("PrefersNonDefaultGPU=") for l in clean_lines):
                clean_lines.append("PrefersNonDefaultGPU=true\nX-KDE-RunOnDiscreteGpu=true\n")
            if not any(l.startswith("StartupNotify=") for l in clean_lines):
                clean_lines.append("StartupNotify=true\n")
            with open(created_desktop, "w") as f:
                f.writelines(clean_lines)
            if not icon_path:
                for l in clean_lines:
                    if l.startswith("Icon="):
                        icon_path = l.strip().split("=", 1)[1]
                        break
        except Exception:
            pass

    subprocess.run(["update-desktop-database", LOCAL_APPS_DIR], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    sync()
    subprocess.run(["notify-send", "-a", "macOS", "-i", APP_STORE_ICON,
                    "Програму встановлено", f"Windows програма \"{clean_name}\" успішно встановлена!"])


def install_shell_script(filepath):
    if not wait_for_file_ready(filepath):
        return
    print(f"[Shell Installer] Processing shell script: {filepath}")
    clean_name = extract_app_name(filepath)
    safe_id = "".join(c for c in clean_name if c.isalnum() or c in "-_").lower() or "shellapp"

    source_path, source_dir = get_file_source_info(filepath)
    has_source = bool(source_path and source_dir and os.path.isdir(source_dir))

    if has_source:
        print(f"[Shell Installer] Origin detected: {source_path} in {source_dir}")
        if not os.path.exists(source_path):
            try:
                shutil.copy2(filepath, source_path)
            except Exception:
                pass
        target_script = source_path
        target_cwd = source_dir
        try:
            if os.path.exists(filepath):
                os.remove(filepath)
        except Exception:
            pass
        meta_json = os.path.join(os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}"), "mac-app-sources", f"{os.path.basename(filepath)}.json")
        try:
            if os.path.exists(meta_json):
                os.remove(meta_json)
        except Exception:
            pass
    else:
        target_app_dir = os.path.join(INSTALLED_APPS_DIR, safe_id)
        os.makedirs(target_app_dir, exist_ok=True)
        target_script = os.path.join(target_app_dir, os.path.basename(filepath))
        target_cwd = target_app_dir
        try:
            shutil.move(filepath, target_script)
        except Exception:
            target_script = filepath
            target_cwd = os.path.dirname(filepath)

    try:
        os.chmod(target_script, 0o755)
    except Exception:
        pass

    base_lower = os.path.basename(target_script).lower()
    is_installer = any(k in base_lower for k in ["install", "setup"])

    if is_installer:
        subprocess.run(["notify-send", "-a", "macOS", "-i", "system-software-install",
                        "Встановлення програми", f"Запуск установника \"{clean_name}\"..."])
        before_desktops = set(glob.glob(os.path.join(LOCAL_APPS_DIR, "**", "*.desktop"), recursive=True))
        try:
            subprocess.run(["bash", target_script], cwd=target_cwd)
        except Exception as e:
            print(f"[Shell Installer] Error executing {target_script}: {e}")
        time.sleep(1)
        after_desktops = set(glob.glob(os.path.join(LOCAL_APPS_DIR, "**", "*.desktop"), recursive=True))
        if after_desktops - before_desktops:
            sync()
        subprocess.run(["notify-send", "-a", "macOS", "-i", APP_STORE_ICON,
                        "Встановлено", f"Установник \"{clean_name}\" завершив роботу!"])
    else:
        icons = glob.glob(os.path.join(target_cwd, "**", "*.png"), recursive=True) + \
                glob.glob(os.path.join(target_cwd, "**", "*.svg"), recursive=True)
        icon_path = ""
        if icons:
            icons.sort(key=lambda x: os.path.getsize(x), reverse=True)
            ext = os.path.splitext(icons[0])[1]
            target_icon = os.path.join(ICONS_DIR, f"{safe_id}{ext}")
            try:
                shutil.copy2(icons[0], target_icon)
                icon_path = target_icon
            except Exception:
                pass

        desktop_content = f"""[Desktop Entry]
Type=Application
Name={clean_name}
Exec="{target_script}" %U
Path={target_cwd}
Icon={icon_path or 'application-x-executable'}
Terminal=false
Categories=Utility;Application;
X-Mac-Installed-App=true
X-Mac-Real-Path={target_script}
StartupNotify=true
"""
        local_desktop = os.path.join(LOCAL_APPS_DIR, f"local-{safe_id}.desktop")
        with open(local_desktop, "w") as df:
            df.write(desktop_content)
        os.chmod(local_desktop, 0o755)
        subprocess.run(["update-desktop-database", LOCAL_APPS_DIR], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        sync()
        subprocess.run(["notify-send", "-a", "macOS", "-i", APP_STORE_ICON,
                        "Програму додано", f"Скрипт \"{clean_name}\" додано до програм!"])


def install_batch_script(filepath):
    if not wait_for_file_ready(filepath):
        return
    print(f"[Batch Installer] Processing Windows batch file: {filepath}")
    clean_name = extract_app_name(filepath)
    safe_id = "".join(c for c in clean_name if c.isalnum() or c in "-_").lower() or "winbatch"

    source_path, source_dir = get_file_source_info(filepath)
    has_source = bool(source_path and source_dir and os.path.isdir(source_dir))

    wine_runner = "/usr/local/bin/mac-wine-runner"
    if not os.path.exists(wine_runner):
        wine_runner = "wine"

    if has_source:
        print(f"[Batch Installer] Origin detected: {source_path} in {source_dir}")
        if not os.path.exists(source_path):
            try:
                shutil.copy2(filepath, source_path)
            except Exception:
                pass
        target_script = source_path
        target_cwd = source_dir
        try:
            if os.path.exists(filepath):
                os.remove(filepath)
        except Exception:
            pass
        meta_json = os.path.join(os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}"), "mac-app-sources", f"{os.path.basename(filepath)}.json")
        try:
            if os.path.exists(meta_json):
                os.remove(meta_json)
        except Exception:
            pass
    else:
        app_target_dir = os.path.join(WINE_APPS_DIR, safe_id)
        os.makedirs(app_target_dir, exist_ok=True)
        target_script = os.path.join(app_target_dir, os.path.basename(filepath))
        target_cwd = app_target_dir
        try:
            shutil.move(filepath, target_script)
        except Exception:
            target_script = filepath
            target_cwd = os.path.dirname(filepath)

    base_lower = os.path.basename(target_script).lower()
    is_installer = any(k in base_lower for k in ["install", "setup"])

    if is_installer:
        subprocess.run(["notify-send", "-a", "macOS", "-i", "system-software-install",
                        "Встановлення програми", f"Запуск пакета Windows \"{clean_name}\"..."])
        cmd = [wine_runner, "cmd", "/c", target_script]
        try:
            subprocess.run(cmd, cwd=target_cwd)
        except Exception as e:
            print(f"[Batch Installer] Error: {e}")
        sync()
        subprocess.run(["notify-send", "-a", "macOS", "-i", APP_STORE_ICON,
                        "Встановлено", f"Пакет \"{clean_name}\" завершив роботу!"])
    else:
        desktop_content = f"""[Desktop Entry]
Type=Application
Name={clean_name}
Exec=/usr/local/bin/mac-wine-runner cmd /c "{target_script}" %U
Path={target_cwd}
Icon=application-x-ms-dos-executable
Terminal=false
Categories=Utility;Application;
X-Mac-Wine-App=true
X-Mac-Real-Path={target_script}
StartupNotify=true
"""
        local_desktop = os.path.join(LOCAL_APPS_DIR, f"wine-{safe_id}.desktop")
        with open(local_desktop, "w") as df:
            df.write(desktop_content)
        os.chmod(local_desktop, 0o755)
        subprocess.run(["update-desktop-database", LOCAL_APPS_DIR], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        sync()
        subprocess.run(["notify-send", "-a", "macOS", "-i", APP_STORE_ICON,
                        "Програму додано", f"Windows скрипт \"{clean_name}\" готовий до запуску!"])


def install_binary_installer(filepath):
    if not wait_for_file_ready(filepath):
        return
    print(f"[Binary Installer] Processing Linux binary installer: {filepath}")
    clean_name = extract_app_name(filepath)
    safe_id = "".join(c for c in clean_name if c.isalnum() or c in "-_").lower() or "binapp"

    source_path, source_dir = get_file_source_info(filepath)
    has_source = bool(source_path and source_dir and os.path.isdir(source_dir))

    if has_source:
        print(f"[Binary Installer] Origin detected: {source_path} in {source_dir}")
        if not os.path.exists(source_path):
            try:
                shutil.copy2(filepath, source_path)
            except Exception:
                pass
        target_bin = source_path
        target_cwd = source_dir
        try:
            if os.path.exists(filepath):
                os.remove(filepath)
        except Exception:
            pass
        meta_json = os.path.join(os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}"), "mac-app-sources", f"{os.path.basename(filepath)}.json")
        try:
            if os.path.exists(meta_json):
                os.remove(meta_json)
        except Exception:
            pass
    else:
        target_app_dir = os.path.join(INSTALLED_APPS_DIR, safe_id)
        os.makedirs(target_app_dir, exist_ok=True)
        target_bin = os.path.join(target_app_dir, os.path.basename(filepath))
        target_cwd = target_app_dir
        try:
            shutil.move(filepath, target_bin)
        except Exception:
            target_bin = filepath
            target_cwd = os.path.dirname(filepath)

    try:
        os.chmod(target_bin, 0o755)
    except Exception:
        pass

    subprocess.run(["notify-send", "-a", "macOS", "-i", "system-software-install",
                    "Встановлення програми", f"Запуск інсталятора \"{clean_name}\"..."])
    try:
        subprocess.run([target_bin], cwd=target_cwd)
    except Exception as e:
        print(f"[Binary Installer] Error: {e}")
    sync()
    subprocess.run(["notify-send", "-a", "macOS", "-i", APP_STORE_ICON,
                    "Встановлено", f"Інсталятор \"{clean_name}\" завершив роботу!"])


def handle_trash(trashinfo_path):
    time.sleep(0.5)
    if not os.path.exists(trashinfo_path):
        return
    try:
        path_in_trash = None
        with open(trashinfo_path, "r", errors="ignore") as f:
            for line in f:
                if line.startswith("Path="):
                    raw_val = line.strip().split("=", 1)[1]
                    import urllib.parse
                    path_in_trash = urllib.parse.unquote(raw_val)
                    break
        
        if not path_in_trash or not (path_in_trash.startswith(APPS_DIR) or path_in_trash.startswith(LOCAL_APPS_DIR)) or not path_in_trash.endswith(".desktop"):
            return

        base_item = os.path.basename(trashinfo_path).replace(".trashinfo", "")
        import urllib.parse
        unquoted_base = urllib.parse.unquote(base_item)
        trashed_desktop = os.path.join(TRASH_DIR, base_item)
        if not os.path.exists(trashed_desktop):
            trashed_desktop = os.path.join(TRASH_DIR, unquoted_base)
            if not os.path.exists(trashed_desktop):
                return

        now = time.time()
        dedup_key = unquoted_base.lower().replace(".desktop", "")
        with _trash_lock:
            if dedup_key in _recently_trashed and now - _recently_trashed[dedup_key] < 8:
                print(f"[Uninstaller] Ignoring duplicate trash event for {dedup_key}")
                return
            _recently_trashed[dedup_key] = now

        print(f"[Uninstaller] Detected trashed application: {trashed_desktop} (orig: {path_in_trash})")

        # Parse desktop details
        app_name = unquoted_base.replace(".desktop", "")
        real_path = ""
        exec_cmd = ""
        app_dir = ""
        is_appimage = False
        is_installed_app = False
        is_wine_app = False

        with open(trashed_desktop, "r", errors="ignore") as f:
            for line in f:
                line = line.strip()
                if line.startswith("Name="):
                    app_name = line.split("=", 1)[1].strip()
                elif line.startswith("X-Mac-Real-Path="):
                    real_path = line.split("=", 1)[1].strip()
                elif line.startswith("Exec="):
                    exec_cmd = line.split("=", 1)[1].strip()
                elif line.startswith("X-Mac-App-Dir="):
                    app_dir = line.split("=", 1)[1].strip()
                elif line.startswith("X-Mac-AppImage="):
                    is_appimage = line.split("=", 1)[1].strip().lower() == "true"
                elif line.startswith("X-Mac-Installed-App="):
                    is_installed_app = line.split("=", 1)[1].strip().lower() == "true"
                elif line.startswith("X-Mac-Wine-App="):
                    is_wine_app = line.split("=", 1)[1].strip().lower() == "true"

        # Fallbacks based on Exec command path
        if not app_dir and INSTALLED_APPS_DIR in exec_cmd:
            clean_exec = exec_cmd.strip('"\'').split()[0]
            rel = os.path.relpath(clean_exec, INSTALLED_APPS_DIR)
            folder_name = rel.split(os.sep)[0]
            app_dir = os.path.join(INSTALLED_APPS_DIR, folder_name)
            is_installed_app = True

        if not real_path and APPIMAGES_DIR in exec_cmd:
            clean_exec = exec_cmd.strip('"\'').split()[0]
            real_path = clean_exec
            is_appimage = True

        # Case 1: AppImage
        if is_appimage or "/appimages/" in real_path or "/appimages/" in exec_cmd:
            bin_target = real_path if real_path.startswith(APPIMAGES_DIR) else ""
            if not bin_target:
                for cand in glob.glob(os.path.join(APPIMAGES_DIR, "*")):
                    if app_name.lower().replace(" ", "") in os.path.basename(cand).lower().replace(" ", ""):
                        bin_target = cand
                        break
            if bin_target and os.path.exists(bin_target):
                try:
                    os.remove(bin_target)
                except Exception:
                    pass
            # Remove desktop file in ~/.local/share/applications
            for df in glob.glob(os.path.join(LOCAL_APPS_DIR, "*.desktop")):
                try:
                    content = open(df, errors="ignore").read()
                    if bin_target and bin_target in content and "X-Mac-AppImage=true" in content:
                        os.remove(df)
                except Exception:
                    pass
            try:
                os.remove(trashed_desktop)
                os.remove(trashinfo_path)
            except Exception:
                pass
            subprocess.run(["update-desktop-database", LOCAL_APPS_DIR], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            sync()
            subprocess.run(["notify-send", "-a", "macOS", "-i", APP_STORE_ICON, "Видалено", f"Програму \"{app_name}\" успішно деінстальовано!"])
            return

        # Case 2: Archive/Custom installed app
        if is_installed_app or app_dir:
            target_dir = app_dir if (app_dir and os.path.exists(app_dir)) else os.path.join(INSTALLED_APPS_DIR, app_name.lower())
            if is_safe_to_delete(target_dir):
                uninst = os.path.join(target_dir, "uninstall.sh")
                if os.path.exists(uninst):
                    try:
                        subprocess.run(["bash", uninst], cwd=target_dir, timeout=30)
                    except Exception:
                        pass
                shutil.rmtree(target_dir, ignore_errors=True)
            for df in glob.glob(os.path.join(LOCAL_APPS_DIR, "*.desktop")):
                try:
                    content = open(df, errors="ignore").read()
                    if target_dir and target_dir in content and "X-Mac-Installed-App=true" in content:
                        os.remove(df)
                except Exception:
                    pass
            try:
                os.remove(trashed_desktop)
                os.remove(trashinfo_path)
            except Exception:
                pass
            subprocess.run(["update-desktop-database", LOCAL_APPS_DIR], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            sync()
            subprocess.run(["notify-send", "-a", "macOS", "-i", APP_STORE_ICON, "Видалено", f"Програму \"{app_name}\" успішно деінстальовано!"])
            return

        # Case 3: Wine Application
        if is_wine_app or "/.wine/" in real_path or "/.wine/" in exec_cmd or "/wine-apps/" in real_path:
            print(f"[Uninstaller] Detected Wine application: {app_name}")
            if "/wine-apps/" in real_path or "/wine-apps/" in exec_cmd:
                for cand in glob.glob(os.path.join(WINE_APPS_DIR, "*")):
                    if app_name.lower().replace(" ", "") in os.path.basename(cand).lower().replace(" ", ""):
                        if is_safe_to_delete(cand):
                            shutil.rmtree(cand, ignore_errors=True)
            elif app_dir or real_path:
                target_folder = app_dir or (os.path.dirname(real_path) if real_path else "")
                if is_safe_to_delete(target_folder):
                    uninst = None
                    for u in ["unins000.exe", "uninstall.exe", "uninst.exe"]:
                        up = os.path.join(target_folder, u)
                        if os.path.exists(up):
                            uninst = up
                            break
                    if uninst:
                        try:
                            subprocess.run(["wine", uninst, "/VERYSILENT", "/SUPPRESSMSGBOXES", "/NORESTART"], timeout=30)
                        except Exception:
                            pass
                    if is_safe_to_delete(target_folder):
                        shutil.rmtree(target_folder, ignore_errors=True)

            # Safely delete specific matching desktop files in LOCAL_APPS_DIR
            clean_candidates = [
                os.path.join(LOCAL_APPS_DIR, f"{base_item}.desktop"),
                os.path.join(LOCAL_APPS_DIR, f"wine-{base_item}.desktop"),
                os.path.join(LOCAL_APPS_DIR, base_item if base_item.endswith(".desktop") else f"{base_item}.desktop"),
            ]
            for cand_f in clean_candidates:
                if os.path.exists(cand_f):
                    try:
                        os.remove(cand_f)
                    except Exception:
                        pass

            for df in glob.glob(os.path.join(LOCAL_APPS_DIR, "*.desktop")):
                try:
                    content = open(df, errors="ignore").read()
                    if "X-Mac-Wine-App=true" in content:
                        if (real_path and real_path in content) or (target_folder and target_folder in content):
                            os.remove(df)
                except Exception:
                    pass

            try:
                os.remove(trashed_desktop)
                os.remove(trashinfo_path)
            except Exception:
                pass

            subprocess.run(["update-desktop-database", LOCAL_APPS_DIR], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            sync()
            subprocess.run(["notify-send", "-a", "macOS", "-i", APP_STORE_ICON, "Видалено", f"Windows програму \"{app_name}\" успішно деінстальовано!"])
            return

        # Case 4: System package (Snap / Flatpak / DEB)
        if real_path and (real_path.startswith("/snap/") or real_path.startswith("/var/lib/flatpak/") or real_path.startswith("/usr/")):
            subprocess.Popen(["/usr/local/bin/mac-uninstall-app", trashed_desktop])
    except Exception as e:
        print(f"[Uninstaller] Trash handler error: {e}")


class MacAppDaemon:
    def __init__(self):
        self._sync_timeout_id = 0

    def trigger_sync_debounced(self):
        if self._sync_timeout_id:
            GLib.source_remove(self._sync_timeout_id)
        self._sync_timeout_id = GLib.timeout_add_seconds(1, self._run_sync_cb)

    def _run_sync_cb(self):
        self._sync_timeout_id = 0
        sync()
        return False

    def on_apps_dir_changed(self, monitor, file, other_file, event_type):
        if event_type not in (Gio.FileMonitorEvent.CREATED, Gio.FileMonitorEvent.CHANGES_DONE_HINT):
            return
        path = file.get_path()
        if not path or not os.path.exists(path):
            return
        base = os.path.basename(path).lower()
        if base.endswith(".appimage"):
            threading.Thread(target=install_appimage, args=(path,), daemon=True).start()
        elif any(base.endswith(ext) for ext in [".zip", ".tar.gz", ".tar.xz", ".tgz", ".tar.bz2", ".tar"]):
            threading.Thread(target=install_archive, args=(path,), daemon=True).start()
        elif base.endswith(".deb"):
            threading.Thread(target=install_deb, args=(path,), daemon=True).start()
        elif base.endswith(".exe") or base.endswith(".msi"):
            threading.Thread(target=install_wine_installer, args=(path,), daemon=True).start()
        elif base.endswith(".sh") or base.endswith(".bash"):
            threading.Thread(target=install_shell_script, args=(path,), daemon=True).start()
        elif base.endswith(".bat") or base.endswith(".cmd"):
            threading.Thread(target=install_batch_script, args=(path,), daemon=True).start()
        elif base.endswith(".run") or base.endswith(".bin"):
            threading.Thread(target=install_binary_installer, args=(path,), daemon=True).start()

    def on_trash_info_changed(self, monitor, file, other_file, event_type):
        if event_type not in (Gio.FileMonitorEvent.CREATED, Gio.FileMonitorEvent.CHANGES_DONE_HINT):
            return
        path = file.get_path()
        if not path or not path.endswith(".trashinfo"):
            return
        now = time.time()
        with _trash_lock:
            if path in _processing_trash or (now - _recently_trashed.get(path, 0) < 5):
                return
            _processing_trash.add(path)
            _recently_trashed[path] = now
        threading.Thread(target=self._run_handle_trash, args=(path,), daemon=True).start()

    def _run_handle_trash(self, path):
        try:
            handle_trash(path)
        finally:
            with _trash_lock:
                _processing_trash.discard(path)

    def on_system_apps_changed(self, monitor, file, other_file, event_type):
        self.trigger_sync_debounced()

    def run(self):
        acquire_daemon_lock()
        print("[MacAppDaemon] Starting macOS Applications Drag-and-Drop Manager...")
        sync()

        # Monitor ~/Applications
        f_apps = Gio.File.new_for_path(APPS_DIR)
        mon_apps = f_apps.monitor_directory(Gio.FileMonitorFlags.NONE, None)
        mon_apps.connect("changed", self.on_apps_dir_changed)

        # Monitor Trash Info
        f_trash = Gio.File.new_for_path(TRASH_INFO_DIR)
        mon_trash = f_trash.monitor_directory(Gio.FileMonitorFlags.NONE, None)
        mon_trash.connect("changed", self.on_trash_info_changed)

        # Monitor desktop directories for system-wide app changes
        for d in [LOCAL_APPS_DIR, "/usr/share/applications", "/var/lib/snapd/desktop/applications", "/var/lib/flatpak/exports/share/applications"]:
            if os.path.isdir(d):
                f_sys = Gio.File.new_for_path(d)
                m = f_sys.monitor_directory(Gio.FileMonitorFlags.NONE, None)
                m.connect("changed", self.on_system_apps_changed)

        loop = GLib.MainLoop()
        loop.run()


if __name__ == "__main__":
    if len(sys.argv) > 1 and sys.argv[1] == "daemon":
        daemon = MacAppDaemon()
        daemon.run()
    else:
        sync()
