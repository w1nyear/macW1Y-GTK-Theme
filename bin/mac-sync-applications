#!/usr/bin/env python3
import os, sys, fcntl, glob, subprocess, time, shutil, zipfile, tarfile, re, threading, tempfile, json, warnings
warnings.filterwarnings("ignore")
import gi
gi.require_version("Gio", "2.0")
from gi.repository import Gio, GLib

SYSTEM_DESKTOP_EXCLUDES = {
    'org.gnome.Settings.desktop',
    'gnome-control-center.desktop',
    'gnome-system-monitor.desktop',
    'org.gnome.Extensions.desktop',
    'session-properties.desktop',
    'org.gnome.Nautilus.desktop',
    'nautilus.desktop'
}

def get_gpu_targets():
    for conf in [os.path.join(os.path.expanduser("~"), ".config/mac-gpu-targets.json"), "/etc/mac-gpu-targets.json"]:
        if os.path.exists(conf):
            try:
                with open(conf, "r") as f:
                    return json.load(f)
            except Exception:
                pass
    return {"system": 0, "apps": 1, "games": 1}


_daemon_lock_fd = None
def acquire_daemon_lock():
    global _daemon_lock_fd
    runtime_dir = os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}")
    lock_file = os.path.join(runtime_dir, "mac-sync-applications-daemon.lock")
    try:
        _daemon_lock_fd = open(lock_file, "w")
        fcntl.flock(_daemon_lock_fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        _daemon_lock_fd.write(f"{os.getpid()}\n")
        _daemon_lock_fd.flush()
        return True
    except (BlockingIOError, IOError):
        print("[MacAppDaemon] Another daemon instance is already active. Exiting cleanly.")
        sys.exit(0)

def acquire_sync_lock():
    runtime_dir = os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}")
    lock_file = os.path.join(runtime_dir, "mac-sync-applications-exec.lock")
    try:
        fd = open(lock_file, "w")
        fcntl.flock(fd, fcntl.LOCK_EX)
        return fd
    except Exception:
        return None

HOME = os.path.expanduser("~")
APPS_DIR = os.path.join(HOME, "Applications")
TRASH_DIR = os.path.join(HOME, ".local/share/Trash/files")
TRASH_INFO_DIR = os.path.join(HOME, ".local/share/Trash/info")
