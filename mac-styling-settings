    def _create_slider_row(self, group, title, subtitle, min_val, max_val, cur_val):
        row = Adw.ActionRow()
        row.set_title(title)
        if subtitle:
            row.set_subtitle(subtitle)
        scale = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, min_val, max_val, 1)
        scale.set_value(cur_val)
        scale.set_size_request(200, -1)
        scale.set_draw_value(True)
        scale.connect("value-changed", self.on_setting_changed)
        row.add_suffix(scale)
        group.add(row)
        return scale

    def _create_tint_controls(self, group, title, current_mode, current_strength):
        mode_row = Adw.ComboRow()
        mode_row.set_title(title)
        mode_row.set_subtitle("Режим: вимкнено, затемнення або засвітлення")
        model = Gtk.StringList.new(["Вимкнено", "Затемнення", "Засвітлення"])
        mode_row.set_model(model)
        idx = 0
        if current_mode == "dark":
            idx = 1
        elif current_mode == "light":
            idx = 2
        mode_row.set_selected(idx)
        mode_row.connect("notify::selected", self.on_setting_changed)
        group.add(mode_row)

        strength_row = Adw.ActionRow()
        strength_row.set_title("Сила тінту")
        strength_row.set_subtitle("Непрозорість шару тінтування (%)")
        scale = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, 0, 100, 1)
        scale.set_value(current_strength)
        scale.set_size_request(200, -1)
        scale.set_draw_value(True)
        scale.connect("value-changed", self.on_setting_changed)
        strength_row.add_suffix(scale)
        group.add(strength_row)

        return mode_row, scale

