        # Show floating toast warning
        self.revealer.set_reveal_child(True)

        self.apply_realtime()

        if self.save_timer:
            GLib.source_remove(self.save_timer)
        self.save_timer = GLib.timeout_add(400, self.save_css)

    def _mode_from_idx(self, idx):
        if idx == 1:
            return "dark"
        elif idx == 2:
            return "light"
        return "disabled"

    def apply_realtime(self):
        # 1. Dock
        d_glass = self.dock_glass_scale.get_value() / 100.0
        d_mode = self._mode_from_idx(self.dock_tint_combo.get_selected())
        d_tint = (self.dock_tint_scale.get_value() / 100.0) if d_mode != "disabled" else 0.0
        d_col = "#ffffff" if d_mode == "light" else "#000000"

        # 2. Menubar
        p_glass = self.menubar_glass_scale.get_value() / 100.0
        p_mode = self._mode_from_idx(self.menubar_tint_combo.get_selected())
        p_tint = (self.menubar_tint_scale.get_value() / 100.0) if p_mode != "disabled" else 0.0
        p_col = "#ffffff" if p_mode == "light" else "#000000"

        # 3. Context Menu
        m_glass = self.menu_glass_scale.get_value() / 100.0
        m_mode = self._mode_from_idx(self.menu_tint_combo.get_selected())
        m_tint = (self.menu_tint_scale.get_value() / 100.0) if m_mode != "disabled" else 0.0
        m_col = "#ffffff" if m_mode == "light" else "#000000"

        # 4. OSD
        o_glass = self.osd_glass_scale.get_value() / 100.0
        o_mode = self._mode_from_idx(self.osd_tint_combo.get_selected())
        o_tint = (self.osd_tint_scale.get_value() / 100.0) if o_mode != "disabled" else 0.0
        o_col = "#ffffff" if o_mode == "light" else "#000000"

        # 5. Notifications
        n_glass = self.notif_glass_scale.get_value() / 100.0
        n_mode = self._mode_from_idx(self.notif_tint_combo.get_selected())
        n_tint = (self.notif_tint_scale.get_value() / 100.0) if n_mode != "disabled" else 0.0
        n_col = "#ffffff" if n_mode == "light" else "#000000"

        # 6. Control Center
        q_glass = self.qs_glass_scale.get_value() / 100.0
        q_mode = self._mode_from_idx(self.qs_tint_combo.get_selected())
        q_tint = (self.qs_tint_scale.get_value() / 100.0) if q_mode != "disabled" else 0.0
        q_col = "#ffffff" if q_mode == "light" else "#000000"

        # Write to liquid-glass in real-time
        set_gsetting(LIQUID_SCHEMA, "dock-blur-radius", max(1, int(d_glass * 30)))
        set_gsetting(LIQUID_SCHEMA, "dock-tint-strength", d_tint)
        set_gsetting(LIQUID_SCHEMA, "dock-tint-color", d_col)

        set_gsetting(LIQUID_SCHEMA, "panel-menu-blur-radius", max(1, int(p_glass * 30)))
        set_gsetting(LIQUID_SCHEMA, "panel-menu-tint-strength", p_tint)
        set_gsetting(LIQUID_SCHEMA, "panel-menu-tint-color", p_col)

        set_gsetting(LIQUID_SCHEMA, "menu-blur-radius", max(1, int(m_glass * 30)))
        set_gsetting(LIQUID_SCHEMA, "menu-tint-strength", m_tint)
        set_gsetting(LIQUID_SCHEMA, "menu-tint-color", m_col)

        set_gsetting(LIQUID_SCHEMA, "osd-blur-radius", max(1, int(o_glass * 30)))
        set_gsetting(LIQUID_SCHEMA, "osd-tint-strength", o_tint)
        set_gsetting(LIQUID_SCHEMA, "osd-tint-color", o_col)

        set_gsetting(LIQUID_SCHEMA, "notification-blur-radius", max(1, int(n_glass * 30)))
        set_gsetting(LIQUID_SCHEMA, "notification-tint-strength", n_tint)
        set_gsetting(LIQUID_SCHEMA, "notification-tint-color", n_col)

        set_gsetting(LIQUID_SCHEMA, "quick-settings-blur-radius", max(1, int(q_glass * 30)))
        set_gsetting(LIQUID_SCHEMA, "quick-settings-tint-strength", q_tint)
        set_gsetting(LIQUID_SCHEMA, "quick-settings-tint-color", q_col)

        # Write to blur-my-shell in real-time
        set_gsetting(f"{BMS_SCHEMA_BASE}.panel", "sigma", max(5, int(p_glass * 35)))
        set_gsetting(f"{BMS_SCHEMA_BASE}.quick-settings", "sigma", max(5, int(q_glass * 30)))
        set_gsetting(f"{BMS_SCHEMA_BASE}.notification", "sigma", max(5, int(n_glass * 35)))

        # Update gradient panel top_blur in real-time
        try:
            top_blur_val = round(p_glass * 10.0, 1)
            run_cmd(f"/home/vitaliy/.local/bin/update-bms-menubar-blur {top_blur_val}")
        except Exception as e:
            print("Error updating menubar blur:", e)

        # Write to styling.json atomically
        try:
            conf_dir = os.path.expanduser("~/.config/mac-styling")
            os.makedirs(conf_dir, exist_ok=True)
            with open(os.path.join(conf_dir, "styling.json"), "w") as f:
                json.dump({
                    "dock_glass_strength": d_glass,
                    "dock_tint_strength": d_tint,
                    "dock_tint_mode": d_mode,
                    "menubar_glass_strength": p_glass,
                    "menubar_tint_strength": p_tint,
                    "menubar_tint_mode": p_mode,
                    "menu_glass_strength": m_glass,
                    "menu_tint_strength": m_tint,
                    "menu_tint_mode": m_mode,
                    "osd_glass_strength": o_glass,
                    "osd_tint_strength": o_tint,
                    "osd_tint_mode": o_mode,
                    "notif_glass_strength": n_glass,
                    "notif_tint_strength": n_tint,
                    "notif_tint_mode": n_mode,
                    "qs_glass_strength": q_glass,
                    "qs_tint_strength": q_tint,
                    "qs_tint_mode": q_mode
                }, f, indent=2)
        except Exception as e:
            print("Error writing styling.json:", e)

    def save_css(self):
        self.save_timer = None
        d_mode = self._mode_from_idx(self.dock_tint_combo.get_selected())
        d_tint = (self.dock_tint_scale.get_value() / 100.0) if d_mode != "disabled" else 0.0
        p_mode = self._mode_from_idx(self.menubar_tint_combo.get_selected())
        p_tint = (self.menubar_tint_scale.get_value() / 100.0) if p_mode != "disabled" else 0.0
        n_mode = self._mode_from_idx(self.notif_tint_combo.get_selected())
        n_tint = (self.notif_tint_scale.get_value() / 100.0) if n_mode != "disabled" else 0.0

        for css_target in [CSS_PATH, CSS_SOLID_PATH]:
            if os.path.exists(css_target):
                try:
                    with open(css_target, 'r') as f:
                        content = f.read()

                    # Dock background tint
                    d_rgb = "255, 255, 255" if d_mode == "light" else "36, 36, 36"
                    content = re.sub(
                        r'(\.mac-notification-banner \{\s*width: 395px !important;\s*min-height: 56px !important;\s*padding: 10px 14px !important;\s*border-radius:\s*[0-9]+px !important;\s*background-color:\s*rgba\()[0-9,\s]+,\s*[0-9.]+(\) !important;)',
                        rf'\g<1>36, 36, 36, {n_tint:.2f}\g<2>',
                        content
                    )
                    content = re.sub(
                        r'(\.message-list \.message \{\s*width: 395px !important;\s*min-height: 56px !important;\s*padding: 10px 14px !important;\s*border-radius:\s*[0-9]+px !important;\s*background-color:\s*rgba\()[0-9,\s]+,\s*[0-9.]+(\) !important;)',
                        rf'\g<1>36, 36, 36, {n_tint:.2f}\g<2>',
                        content
                    )

                    # Menubar gradient darkening tint
                    p_rgb = "255, 255, 255" if p_mode == "light" else "0, 0, 0"
                    eff_p_tint = p_tint if p_mode != "disabled" else 0.0
                    content = re.sub(
                        r'(background-gradient-start:\s*rgba\()[0-9,\s]+,\s*[0-9.]+(\)\s*!important;)',
                        rf'\g<1>{p_rgb}, {eff_p_tint:.2f}\g<2>',
                        content
                    )

                    with open(css_target, 'w') as f:
                        f.write(content)
                except Exception as e:
                    print(f"Error saving CSS {css_target}: {e}")

        # Trigger GNOME Shell user-theme to reload the stylesheet live
        run_cmd("gsettings --schemadir ~/.local/share/gnome-shell/extensions/user-theme@gnome-shell-extensions.gcampax.github.com/schemas set org.gnome.shell.extensions.user-theme name '' && sleep 0.05 && gsettings --schemadir ~/.local/share/gnome-shell/extensions/user-theme@gnome-shell-extensions.gcampax.github.com/schemas set org.gnome.shell.extensions.user-theme name 'MacTahoe-Dark'")

        return GLib.SOURCE_REMOVE

    def on_test_notif_clicked(self, _btn):
        self.apply_realtime()
        self.save_css()
        run_cmd('notify-send "macOS Notification" "Тестове сповіщення з підтримкою широкої картки 395px, тіней та нативного скла!"')

    def on_logout_clicked(self, _btn):
        run_cmd("gnome-session-quit --logout")

def main():
    app = MacStylingApp()
    return app.run(sys.argv)

if __name__ == '__main__':
    sys.exit(main())
