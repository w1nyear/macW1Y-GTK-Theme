def run_cmd(cmd):
    try:
        return subprocess.check_output(cmd, shell=True, text=True).strip()
    except Exception:
        return ""

def get_gsetting(schema, key, val_type="string", default=None):
    try:
        val = run_cmd(f"gsettings get {schema} {key}")
        if not val or "No such key" in val:
            return default
        if val_type == "int":
            return int(val)
        elif val_type == "float":
            return float(val)
        elif val_type == "bool":
            return val.lower() == "true"
        elif val_type == "string":
            return val.strip("'\"")
    except Exception:
        return default
    return default

def set_gsetting(schema, key, val):
    try:
        if isinstance(val, bool):
            s = "true" if val else "false"
        elif isinstance(val, float):
            s = f"{val:.2f}"
        elif isinstance(val, int):
            s = str(val)
        elif isinstance(val, str):
            s = f"'{val}'"
        else:
            s = str(val)
        run_cmd(f"gsettings set {schema} {key} {s}")
    except Exception as e:
        print(f"Error setting gsetting {schema} {key}: {e}")

class MacStylingApp(Adw.Application):
    def __init__(self):
        super().__init__(application_id="org.gnome.Settings.MacStyling",
                         flags=Gio.ApplicationFlags.FLAGS_NONE)

    def do_activate(self):
        win = self.props.active_window
        if not win:
            win = MacStylingWindow(application=self)
        win.present()

