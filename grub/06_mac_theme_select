#! /bin/sh
set -e

# macW1Y Startup Manager: Theme selector & dynamic USB / Thunderbolt device detection

esp_uuid="$(findmnt -no UUID /boot/efi 2>/dev/null || findmnt -no UUID /efi 2>/dev/null || findmnt -no UUID /boot 2>/dev/null || true)"
esp_uuid_lower="$(echo "$esp_uuid" | tr '[:upper:]' '[:lower:]')"
root_uuid="$(findmnt -no UUID / 2>/dev/null || true)"
root_uuid_lower="$(echo "$root_uuid" | tr '[:upper:]' '[:lower:]')"

if [ -f /etc/default/grub ]; then
    . /etc/default/grub
fi

pclogo_val="${GRUB_MAC_PCLOGO:-0}"
timeout_style_val="${GRUB_TIMEOUT_STYLE:-hidden}"
timeout_val="${GRUB_TIMEOUT:-0}"

is_menu_enabled=0
if [ "$timeout_style_val" = "menu" ] || [ "${timeout_val}" != "0" ]; then
    is_menu_enabled=1
fi

cat << EOF
# Ensure all partition and filesystem drivers are loaded for USB, Thunderbolt, NVMe and external SATA
insmod part_gpt
insmod part_msdos
insmod fat
insmod exfat
insmod ntfs
insmod ext2
insmod iso9660
insmod udf
insmod chain
insmod probe
insmod png
insmod gfxterm_background
EOF

if [ "$is_menu_enabled" = "1" ]; then
    # GRUB menu enabled: Scan external USB & Thunderbolt devices and configure theme
    cat << EOF

# macW1Y Startup Manager: Dynamic Device Scan (USB & Thunderbolt)
set mac_has_usb=0
set mac_ext_count=0
set mac_ext1_dev=""
set mac_ext1_path=""
set mac_ext1_name=""
set mac_ext1_class="usb1"
set mac_ext2_dev=""
set mac_ext2_path=""
set mac_ext2_name=""
set mac_ext2_class="usb2"

for dev in (*); do
    if [ "\$dev" != "(\$root)" -a "\$dev" != "proc" -a "\$dev" != "memdisk" ]; then
        probe --fs-uuid "\$dev" --set=dev_uuid
        set is_own_dev=0
        if [ -n "$esp_uuid" -a "\$dev_uuid" = "$esp_uuid" ]; then set is_own_dev=1; fi
        if [ -n "$esp_uuid_lower" -a "\$dev_uuid" = "$esp_uuid_lower" ]; then set is_own_dev=1; fi
        if [ -n "$root_uuid" -a "\$dev_uuid" = "$root_uuid" ]; then set is_own_dev=1; fi
        if [ -n "$root_uuid_lower" -a "\$dev_uuid" = "$root_uuid_lower" ]; then set is_own_dev=1; fi
        if [ "\$dev_uuid" = "\$root_uuid" ]; then set is_own_dev=1; fi
        if [ "\$is_own_dev" = "0" ]; then
            set dev_boot_path=""
            for p in /EFI/BOOT/BOOTX64.EFI /efi/boot/bootx64.efi /EFI/BOOT/bootx64.efi /EFI/BOOT/BOOTX64.efi /EFI/BOOT/grubx64.efi /efi/boot/grubx64.efi /EFI/Microsoft/Boot/bootmgfw.efi /efi/microsoft/boot/bootmgfw.efi /EFI/ubuntu/grubx64.efi /efi/ubuntu/grubx64.efi /EFI/fedora/grubx64.efi /EFI/arch/grubx64.efi /EFI/systemd/systemd-bootx64.efi /bootmgr.efi /ventoy/ventoy.disk; do
                if [ -f "\$dev\$p" ]; then
                    set dev_boot_path="\$p"
                    break
                fi
            done

            if [ -n "\$dev_boot_path" ]; then
                set dev_name=""
                probe --label "\$dev" --set=dev_name
                if [ -z "\$dev_name" ]; then
                    if [ "\$dev_boot_path" = "/EFI/Microsoft/Boot/bootmgfw.efi" -o "\$dev_boot_path" = "/efi/microsoft/boot/bootmgfw.efi" -o "\$dev_boot_path" = "/bootmgr.efi" ]; then
                        set dev_name="Windows"
                    elif [ "\$dev_boot_path" = "/EFI/ubuntu/grubx64.efi" -o "\$dev_boot_path" = "/efi/ubuntu/grubx64.efi" ]; then
                        set dev_name="Ubuntu Live"
                    elif [ "\$dev_boot_path" = "/EFI/fedora/grubx64.efi" ]; then
                        set dev_name="Fedora Live"
                    elif [ "\$dev_boot_path" = "/EFI/arch/grubx64.efi" ]; then
                        set dev_name="Arch Linux"
                    else
                        if [ "\$mac_ext_count" = "0" ]; then
                            set dev_name="VTOYEFI"
                        else
                            set dev_name="MACW1Y"
                        fi
                    fi
                fi

                if [ "\$mac_ext_count" = "0" ]; then
                    set mac_has_usb=1
                    set mac_ext_count=1
                    set mac_ext1_dev="\$dev"
                    set mac_ext1_path="\$dev_boot_path"
                    set mac_ext1_name="\$dev_name"
                    set mac_ext1_class="usb1"
                elif [ "\$mac_ext_count" = "1" ]; then
                    set mac_ext_count=2
                    set mac_ext2_dev="\$dev"
                    set mac_ext2_path="\$dev_boot_path"
                    set mac_ext2_name="\$dev_name"
                    set mac_ext2_class="usb2"
                    break
                fi
            fi
        fi
    fi
done

if [ "\$mac_ext_count" = "2" ]; then
    if [ -f (\$root)/boot/grub/themes/macw1y-boot-usb2/theme.txt ]; then
        set theme=(\$root)/boot/grub/themes/macw1y-boot-usb2/theme.txt
    else
        set theme=(\$root)/boot/grub/themes/apple-mac-usb2/theme.txt
    fi
elif [ "\$mac_ext_count" = "1" ]; then
    if [ -f (\$root)/boot/grub/themes/macw1y-boot-usb/theme.txt ]; then
        set theme=(\$root)/boot/grub/themes/macw1y-boot-usb/theme.txt
    else
        set theme=(\$root)/boot/grub/themes/apple-mac-usb/theme.txt
    fi
else
    if [ -f (\$root)/boot/grub/themes/macw1y-boot/theme.txt ]; then
        set theme=(\$root)/boot/grub/themes/macw1y-boot/theme.txt
    else
        set theme=(\$root)/boot/grub/themes/apple-mac/theme.txt
    fi
fi
export theme
EOF
else
    # GRUB menu disabled (fast direct boot without delay)
    if [ "$pclogo_val" = "0" ]; then
        # PC logo disabled: replace OEM PC logo immediately with centered Apple logo on black
        cat << EOF

# Replace OEM PC logo immediately with macW1Y Apple logo
terminal_output gfxterm
if [ -f (\$root)/boot/grub/themes/apple-mac/apple_center.png ]; then
    background_image -m stretch (\$root)/boot/grub/themes/apple-mac/apple_center.png
elif [ -f (\$root)/boot/grub/themes/macw1y-boot/apple_center.png ]; then
    background_image -m stretch (\$root)/boot/grub/themes/macw1y-boot/apple_center.png
fi
EOF
    else
        # PC logo enabled: preserve OEM PC logo until Plymouth starts, skip any disk scans for instant boot
        cat << EOF

# PC logo enabled: keep UEFI GOP screen intact for immediate transition to Apple logo in Plymouth
EOF
    fi
fi
