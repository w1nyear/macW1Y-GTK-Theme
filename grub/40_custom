#!/bin/sh
exec tail -n +3 $0
# This file provides an easy way to add custom menu entries.  Simply type the
# menu entries you want to add after this comment.  Be careful not to change
# the 'exec tail' line above.

# macOS Startup Manager — Power Controls & Hotkey Helpers
menuentry 'Shut Down' --class shutdown --class halt $menuentry_id_option 'macw1y-shutdown' {
	halt
}
menuentry 'Restart' --class reboot --class restart $menuentry_id_option 'macw1y-restart' {
	reboot
}
menuentry 'Rescan' --class rescan --hotkey=r --hotkey=R --hotkey=tab $menuentry_id_option 'macw1y-rescan' {
	set mac_play_anim=1
	insmod part_gpt
	insmod part_msdos
	insmod fat
	insmod exfat
	insmod ntfs
	insmod ext2
	insmod iso9660
	insmod udf
	insmod chain
	configfile /boot/grub/grub.cfg
}
