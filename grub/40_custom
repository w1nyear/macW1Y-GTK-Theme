#!/bin/sh
exec tail -n +3 $0
# This file provides an easy way to add custom menu entries.  Simply type the
# menu entries you want to add after this comment.  Be careful not to change
# the 'exec tail' line above.

# macW1Y: Shut Down / Restart buttons of the macOS Boot Picker theme.
# The fullscreen icons shutdown.png / reboot.png show the picker with the
# corresponding button selected at the bottom.
menuentry 'Shut Down' --class shutdown --class halt $menuentry_id_option 'macw1y-shutdown' {
	halt
}
menuentry 'Restart' --class reboot --class restart $menuentry_id_option 'macw1y-restart' {
	reboot
}
