[appmenu]
icon-size=22
show-os-icon=false
show-user-switcher=false

[blur-my-shell]
debug=true
hacks-level=2
pipelines={'pipeline_default': {'name': <'Default'>, 'effects': <[<{'type': <'gaussian_blur'>, 'id': <'effect_000000000000'>, 'params': <{'radius': <30>, 'brightness': <0.59999999999999998>}>}>]>}, 'pipeline_default_rounded': {'name': <'Default rounded'>, 'effects': <[<{'type': <'gaussian_blur'>, 'id': <'effect_000000000001'>, 'params': <{'radius': <30>, 'brightness': <0.59999999999999998>}>}>, <{'type': <'corner'>, 'id': <'effect_000000000002'>, 'params': <{'radius': <24>}>}>]>}, 'pipeline_98777dc6-d6d4-4a4d-abcd-1015072b49fc': {'name': <'MenuBar'>, 'effects': <[<{'type': <'gradient_panel'>, 'id': <'effect_00680760882466'>, 'params': <{'top_darkness': <0>, 'bottom_darkness': <0>, 'top_blur': <5>, 'bottom_blur': <0>}>}>]>}}
rounded-blur-found=true
settings-version=2

[blur-my-shell/appfolder]
brightness=1.0
sigma=30
style-dialogs=2

[blur-my-shell/applications]
blacklist=['Plank', 'com.desktop.ding', 'Conky', 'gjs', 'telegram-desktop_telegram-desktop', 'telegram-desktop', 'TelegramDesktop', 'Telegram', 'org.telegram.desktop']
blur=true
blur-on-overview=true
brightness=1.0
corner-when-maximized=false
dynamic-opacity=false
enable-all=true
opacity=255
pipeline='pipeline_default'
sigma=10

[blur-my-shell/coverflow-alt-tab]
pipeline='pipeline_default'

[blur-my-shell/dash-to-dock]
blur=false
brightness=0.59999999999999998
corner-radius=28
override-background=false
pipeline='pipeline_default_rounded'
sigma=10
static-blur=false
style-dash-to-dock=0
unblur-in-overview=true

[blur-my-shell/lockscreen]
pipeline='pipeline_default'

[blur-my-shell/notification]
blur=false
sigma=10

[blur-my-shell/overview]
pipeline='pipeline_default'
style-components=0

[blur-my-shell/panel]
blur=true
brightness=0.59999999999999998
corner-radius=0
force-light-text=false
gradient-panel=true
gradient-panel-mode=0
override-background=true
pipeline='pipeline_default'
sigma=10
static-blur=true
unblur-in-overview=false

[blur-my-shell/popup]
blur=true
brightness=0.52000000000000002
menu-corner-radius=28
notification-corner-radius=24
pipeline='pipeline_default_rounded'
sigma=10

[blur-my-shell/quick-settings]
animation-mode='window'
blur=false
sigma=10

[blur-my-shell/screenshot]
pipeline='pipeline_default'

[blur-my-shell/window-list]
brightness=0.59999999999999998
sigma=30

[dash-to-dock]
background-opacity=0.80000000000000004
click-action='focus-minimize-or-appspread'
custom-theme-shrink=false
dash-max-icon-size=48
dock-position='BOTTOM'
extend-height=false
height-fraction=0.90000000000000002
preferred-monitor=-2
preferred-monitor-by-connector='eDP-1'

[ding]
check-x11wayland=true

[lennart-k/rounded_corners]
corner-radius=16

[liquid-glass]
application-glass-all-windows=false
blur-my-shell-popup-blur=true
desktop-menu-blur-radius=12
desktop-menu-content-opacity=0.68000000000000005
desktop-menu-corner-radius=18.0
detected-extra-menus=['a11y', 'appindicator-:1.119@/StatusNotifierItem', 'appindicator-:1.294@/StatusNotifierItem', 'appindicator-:1.48@/org/ayatana/NotificationItem/livepatch', 'appindicator-:1.48@/org/ayatana/NotificationItem/software_update_available', 'appindicator-:1.48@/org/ayatana/NotificationItem/unattended_upgrade', 'appmenu@ChathurangaBW.github.io-0', 'appmenu@ChathurangaBW.github.io-1', 'appmenu@ChathurangaBW.github.io-2', 'appmenu@ChathurangaBW.github.io-3', 'appmenu@ChathurangaBW.github.io-4', 'appmenu@ChathurangaBW.github.io-5', 'appmenu@ChathurangaBW.github.io-6', 'appmenu@ChathurangaBW.github.io-7', 'dwellClick', 'keyboard', 'macBluetooth', 'macPrivacy', 'macVolume', 'macWifi', 'tiling-assistant@leleat-on-github']
dock-corner-radius=28.0
dock-glass-expand=0
dock-margin-bottom=8
enable-application-glass=false
enable-desktop-menu-glass=true
enable-dock-glass=true
enable-extra-menu-glass=true
enable-menu-animation=false
enable-menu-glass=false
enable-notification-glass=false
enable-osd-glass=true
enable-panel-menu-animation=false
enable-quick-settings-glass=true
glass-chroma-strength=0.34999999999999998
menu-corner-radius=18.0
menu-enable-adaptive-text-color=false
menu-glass-expand=0
menu-scale=1.0
notification-corner-radius=24.0
osd-corner-radius=9999.0
osd-glass-expand=0
osd-y-offset=0
panel-menu-corner-radius=18.0
panel-menu-enable-adaptive-text-color=false
panel-menu-glass-expand=0
panel-menu-scale=1.0
quick-settings-apply-to=1
quick-settings-toggle-corner-radius=24.0

[spotlight]
theme-preference='dark'

[stage-manager]
maximize-migrated=true
sidebar-layout='arc'

[tiling-assistant]
focus-hint-color='rgb(203,67,20)'
last-version-installed=54
overridden-settings={'org.gnome.mutter.edge-tiling': <@mb nothing>, 'org.gnome.mutter.keybindings.toggle-tiled-left': <@mb nothing>, 'org.gnome.mutter.keybindings.toggle-tiled-right': <@mb nothing>}
tiling-popup-all-workspace=true

[user-theme]
name='MacTahoe-Dark'

[wack-lockscreen-clock]
lockscreen-mode='cupertino'
