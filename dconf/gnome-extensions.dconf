[appmenu]
hide-overview-button=true
icon-size=16
menu-icon='apple-logo'
search-shortcut=['<Control>space', '<Primary>space']
show-os-icon=true
show-user-switcher=false

[blur-my-shell]
debug=true
hacks-level=1
pipelines={'pipeline_default': {'name': <'Default'>, 'effects': <[<{'type': <'native_static_gaussian_blur'>, 'id': <'effect_000000000000'>, 'params': <{'unscaled_radius': <30.0>, 'brightness': <0.59999999999999998>}>}>]>}, 'pipeline_default_rounded': {'name': <'Default rounded'>, 'effects': <[<{'type': <'native_static_gaussian_blur'>, 'id': <'effect_000000000001'>, 'params': <{'unscaled_radius': <30.0>, 'brightness': <0.59999999999999998>}>}>, <{'type': <'corner'>, 'id': <'effect_000000000002'>, 'params': <{'radius': <24.0>}>}>]>}, 'pipeline_98777dc6-d6d4-4a4d-abcd-1015072b49fc': {'name': <'MenuBar'>, 'effects': <[<{'type': <'gradient_panel'>, 'id': <'effect_00680760882466'>, 'params': <{'top_darkness': <0>, 'bottom_darkness': <0>, 'top_blur': <5>, 'bottom_blur': <0>}>}>]>}}
rounded-blur-found=true
settings-version=2

[blur-my-shell/appfolder]
blur=false
brightness=1.0
sigma=30
style-dialogs=1

[blur-my-shell/applications]
blacklist=['Plank', 'com.desktop.ding', 'Conky', 'gjs', 'telegram-desktop_telegram-desktop', 'telegram-desktop', 'TelegramDesktop', 'Telegram', 'org.telegram.desktop', 'antigravity', 'Antigravity', 'google-chrome', 'Google-chrome', 'steam', 'Steam', 'net.nokyan.Resources']
blur=true
blur-on-overview=true
brightness=1.0
corner-when-maximized=false
dynamic-opacity=false
enable-all=true
opacity=215
pipeline='pipeline_default'
sigma=10
static-blur=false

[blur-my-shell/coverflow-alt-tab]
pipeline='pipeline_default'

[blur-my-shell/dash-to-dock]
blur=false
brightness=0.59999999999999998
corner-radius=28
override-background=false
pipeline='pipeline_default_rounded'
sigma=10
static-blur=false
style-dash-to-dock=0
unblur-in-overview=true

[blur-my-shell/lockscreen]
blur=false
pipeline='pipeline_default'

[blur-my-shell/notification]
blur=false
sigma=10

[blur-my-shell/overview]
blur=true
pipeline='pipeline_default'
style-components=0

[blur-my-shell/panel]
blur=false
brightness=0.59999999999999998
corner-radius=0
customize=true
force-light-text=false
gradient-panel=true
gradient-panel-mode=0
override-background=true
pipeline='pipeline_98777dc6-d6d4-4a4d-abcd-1015072b49fc'
sigma=10
static-blur=true
unblur-in-overview=false

[blur-my-shell/popup]
blur=false
brightness=0.52000000000000002
corner-radius=24
dialog-corner-radius=24
menu-corner-radius=12
notification-corner-radius=24
pipeline='pipeline_default_rounded'
quick-settings-corner-radius=24
sigma=10

[blur-my-shell/quick-settings]
animation-mode='window'
blur=false
sigma=10

[blur-my-shell/screenshot]
blur=false
pipeline='pipeline_default'

[blur-my-shell/window-list]
blur=false
brightness=0.59999999999999998
sigma=30

[dash-to-dock]
autohide=false
background-opacity=0.80000000000000004
click-action='focus-minimize-or-appspread'
custom-theme-shrink=false
dash-max-icon-size=48
dock-fixed=true
dock-position='BOTTOM'
extend-height=false
height-fraction=0.90000000000000002
intellihide=false
preferred-monitor=-2
preferred-monitor-by-connector='eDP-1'
show-mounts=false
show-mounts-network=false
show-show-apps-button=false

[ding]
check-x11wayland=true

[lennart-k/rounded_corners]
corner-radius=16

[liquid-glass]
application-glass-all-windows=false
blur-my-shell-popup-blur=false
desktop-menu-blur-radius=3
desktop-menu-brightness=1.0
desktop-menu-content-opacity=1.0
desktop-menu-contrast=1.0
desktop-menu-corner-radius=24.0
desktop-menu-saturation=1.0
desktop-menu-tint-color='#000000'
desktop-menu-tint-strength=0.050000000000000003
detected-extra-menus=['a11y', 'appindicator-:1.112@/StatusNotifierItem', 'appindicator-:1.126@/StatusNotifierItem', 'appindicator-:1.53@/org/ayatana/NotificationItem/livepatch', 'appindicator-:1.53@/org/ayatana/NotificationItem/software_update_available', 'appindicator-:1.53@/org/ayatana/NotificationItem/unattended_upgrade', 'appmenu@ChathurangaBW.github.io-0', 'appmenu@ChathurangaBW.github.io-1', 'appmenu@ChathurangaBW.github.io-2', 'appmenu@ChathurangaBW.github.io-3', 'appmenu@ChathurangaBW.github.io-4', 'appmenu@ChathurangaBW.github.io-5', 'appmenu@ChathurangaBW.github.io-6', 'appmenu@ChathurangaBW.github.io-7', 'dwellClick', 'keyboard', 'macBattery', 'macBluetooth', 'macPrivacy', 'macVolume', 'macWifi']
dock-blur-radius=1
dock-corner-radius=28.0
dock-glass-expand=0
dock-margin-bottom=8
dock-tint-color='#ffffff'
dock-tint-strength=0.10000000000000001
enable-application-glass=false
enable-desktop-menu-glass=true
enable-dock-glass=true
enable-extra-menu-glass=true
enable-menu-animation=false
enable-menu-glass=true
enable-notification-glass=true
enable-osd-glass=true
enable-panel-menu-animation=false
enable-quick-settings-animation=false
enable-quick-settings-glass=true
glass-backdrop-highlights=true
glass-chroma-strength=0.34999999999999998
glass-displacement-scale=12.0
glass-light-angle-deg=270.0
glass-rim-intensity=1.1000000000000001
glass-rim-width=2.2999999999999998
glass-sheen-intensity=0.0
glass-specular-intensity=0.0
menu-blur-radius=3
menu-brightness=1.0
menu-contrast=1.0
menu-corner-radius=24.0
menu-enable-adaptive-text-color=false
menu-glass-expand=0
menu-saturation=1.0
