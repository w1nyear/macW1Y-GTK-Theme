menu-tint-color='#000000'
menu-tint-strength=0.050000000000000003
notification-blur-radius=3
notification-brightness=1.0
notification-contrast=1.0
notification-corner-radius=24.0
notification-saturation=1.0
notification-tint-color='#000000'
notification-tint-strength=0.050000000000000003
osd-corner-radius=9999.0
osd-glass-expand=0
