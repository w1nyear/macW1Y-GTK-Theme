[app-folders]
folder-children=['System', 'Utilities', 'YaST', 'Pardus']

[app-folders/folders/Pardus]
categories=['X-Pardus-Apps']
name='X-Pardus-Apps.directory'
translate=true

[app-folders/folders/System]
apps=['nm-connection-editor.desktop', 'org.gnome.baobab.desktop', 'org.gnome.DiskUtility.desktop', 'im-config.desktop', 'org.gnome.Logs.desktop', 'org.gnome.Sysprof.desktop']
name='X-GNOME-Shell-System.directory'
translate=true

[app-folders/folders/Utilities]
apps=['org.gnome.Papers.desktop', 'org.gnome.font-viewer.desktop', 'org.gnome.Loupe.desktop', 'org.gnome.seahorse.Application.desktop']
name='X-GNOME-Shell-Utilities.directory'
translate=true

[app-folders/folders/YaST]
categories=['X-SuSE-YaST']
name='suse-yast.directory'
translate=true

[background]
color-shading-type='solid'
picture-options='zoom'
picture-uri='file:///usr/share/backgrounds/mendhak-Bluebells_Suspended_In_Time.jpg'
picture-uri-dark='file:///usr/share/backgrounds/mendhak-Bluebells_Suspended_In_Time.jpg'
primary-color='#000000000000'
secondary-color='#000000000000'

[input-sources]
mru-sources=[('xkb', 'ua'), ('xkb', 'us')]
sources=[('xkb', 'us'), ('xkb', 'ua')]

[interface]
accent-color='blue'
clock-show-weekday=true
color-scheme='prefer-dark'
document-font-name='SF Pro Text 11'
font-name='SF Pro Text 11'
gtk-theme='MacTahoe-Dark-solid'
icon-theme='MacTahoe-dark'
monospace-font-name='SF Mono 11'
show-battery-percentage=false

[notifications]
application-children=['update-manager', 'org-gnome-ptyxis', 'firefox-firefox', 'antigravity-antigravity', 'telegram-desktop-telegram-desktop', 'zoom-client-zoom-client', 'snapd-desktop-integration-snapd-desktop-integration', 'org-gnome-settings', 'google-chrome', 'com-teamviewer-teamviewer', 'com-mattjakeman-extensionmanager', 'org-gnome-nautilus', 'steam', 'apport-gtk']

[notifications/application/antigravity-antigravity]
application-id='antigravity_antigravity.desktop'

[notifications/application/anydesk]
enable=true

[notifications/application/apport-gtk]
application-id='apport-gtk.desktop'

[notifications/application/com-mattjakeman-extensionmanager]
application-id='com.mattjakeman.ExtensionManager.desktop'

[notifications/application/com-teamviewer-teamviewer]
application-id='com.teamviewer.TeamViewer.desktop'

[notifications/application/firefox-firefox]
application-id='firefox_firefox.desktop'

[notifications/application/google-chrome]
application-id='google-chrome.desktop'

[notifications/application/org-gnome-nautilus]
application-id='org.gnome.Nautilus.desktop'

[notifications/application/org-gnome-ptyxis]
application-id='org.gnome.Ptyxis.desktop'

[notifications/application/org-gnome-settings]
application-id='org.gnome.Settings.desktop'

[notifications/application/snapd-desktop-integration-snapd-desktop-integration]
application-id='snapd-desktop-integration_snapd-desktop-integration.desktop'

[notifications/application/steam]
application-id='steam.desktop'

[notifications/application/telegram-desktop-telegram-desktop]
application-id='telegram-desktop_telegram-desktop.desktop'

[notifications/application/update-manager]
application-id='update-manager.desktop'

[notifications/application/zoom-client-zoom-client]
application-id='zoom-client_zoom-client.desktop'

[peripherals/touchpad]
two-finger-scrolling-enabled=true

[privacy]
report-technical-problems=false

[screensaver]
color-shading-type='solid'
picture-options='zoom'
picture-uri='file:///usr/share/backgrounds/mendhak-Bluebells_Suspended_In_Time.jpg'
primary-color='#000000000000'
secondary-color='#000000000000'

[session]
idle-delay=uint32 0

[wm/preferences]
titlebar-font='SF Pro Text Bold 11'
