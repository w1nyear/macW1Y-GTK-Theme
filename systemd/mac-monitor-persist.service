[Unit]
Description=macW1Y Monitor Preference Persistence (Super+P across reboots)
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 %h/.local/bin/mac-monitor-persist watch
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
