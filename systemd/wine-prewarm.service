[Unit]
Description=Wine Windows Subsystem Prewarm Daemon
Documentation=https://www.winehq.org/
After=graphical-session.target

[Service]
Type=forking
ExecStartPre=/bin/sh -c 'rm -rf /run/user/%U/wine/server-* 2>/dev/null || true'
ExecStart=/usr/local/bin/wineserver -p
ExecStop=/usr/local/bin/wineserver -k
Restart=always
RestartSec=5
LimitNOFILE=524288
LimitNPROC=65536

[Install]
WantedBy=default.target
