[Unit]
Description=macW1Y Verbose Boot Logger for Plymouth
ConditionPathExists=|/usr/share/plymouth/themes/apple-mac/verbose_on.png
ConditionPathExists=|/usr/share/plymouth/themes/macw1y-boot/verbose_on.png
ConditionPathExists=|/etc/plymouth/verbose_on
DefaultDependencies=no
After=plymouth-start.service
Before=plymouth-quit.service
Requires=plymouth-start.service

[Service]
Type=simple
ExecStart=/usr/local/bin/plymouth-verbose-logger
Restart=no
StandardOutput=null
StandardError=null

[Install]
WantedBy=plymouth-start.service sysinit.target
