                            <signal name="value-changed" handler="on_widget_shadow_changed" />
                          </object>
                        </child>
                      </object>
                    </child>
                  </object>
                </child>

                
                <child>
                  <object class="AdwPreferencesGroup">
                    <property name="title">Bootloader</property>
                    <property name="description">macW1Y Plymouth splash boot settings and kernel logging</property>
                    <child>
                      <object class="AdwSwitchRow" id="boot_verbose_switch">
                        <property name="title">Verbose Mode</property>
                        <property name="subtitle">Terminal boot log text displayed behind System logo</property>
                        <signal name="realize" handler="init_boot_verbose" />
                        <signal name="notify::active" handler="on_boot_verbose_changed" />
                      </object>
                    </child>
                    <child>
                      <object class="AdwSwitchRow" id="boot_grub_switch">
                        <property name="title">GRUB Menu</property>
                        <property name="subtitle">macW1Y-style graphical OS selection menu during boot</property>
                        <signal name="realize" handler="init_boot_grub" />
                        <signal name="notify::active" handler="on_boot_grub_changed" />
                      </object>
                    </child>
                  </object>
                </child>

                
                <child>
                  <object class="AdwPreferencesGroup">
                    <property name="title">Integrity &amp; Diagnostics</property>
                    <property name="description">SSOT standard enforcement, GNOME extensions guard, and auto-repair</property>
                    <child>
                      <object class="AdwActionRow" id="diag_status_row">
                        <property name="title">macW1Y Theme Status</property>
                        <property name="subtitle">All components comply with SSOT baseline (OK)</property>
                        <child type="prefix">
                          <object class="GtkImage">
                            <property name="icon-name">emblem-ok-symbolic</property>
                          </object>
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="AdwActionRow">
                        <property name="title">Maintenance Actions</property>
                        <property name="subtitle">Verify current status or restore default styling</property>
                        <child type="suffix">
                          <object class="GtkButton" id="btn_run_diagnostics">
                            <property name="label">Run Diagnostics</property>
                            <property name="valign">center</property>
                            <signal name="clicked" handler="on_run_diagnostics_clicked" />
                          </object>
                        </child>
                        <child type="suffix">
                          <object class="GtkButton" id="btn_restore_theme">
                            <property name="label">Restore Theme</property>
                            <property name="valign">center</property>
                            <style>
                              <class name="suggested-action" />
                            </style>
                            <signal name="clicked" handler="on_restore_theme_clicked" />
                          </object>
                        </child>
                      </object>
                    </child>
                  </object>
                </child>

              </object>
            </property>
          </object>
        </property>
      </object>
</interface>