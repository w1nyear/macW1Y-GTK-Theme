<?xml version='1.0' encoding='utf-8'?>
<interface>
  <requires lib="gtk" version="4.0" />
      <object class="AdwNavigationPage" id="mac_styling_page">
        <property name="title">Mac Styling</property>
        <property name="tag">mac-styling</property>
        <property name="child">
          <object class="AdwToolbarView">
            <property name="extend-content-to-top-edge">False</property>
            <property name="extend-content-to-bottom-edge">True</property>
            <property name="top-bar-style">flat</property>
            <child type="top">
              <object class="AdwHeaderBar">
                <style>
                  <class name="flat" />
                </style>
              </object>
            </child>
            <property name="content">
              <object class="AdwPreferencesPage">

                
                <child>
                  <object class="AdwPreferencesGroup" id="liquid_glass_group">
                    <property name="title">Liquid Glass</property>
                    <property name="description">Liquid Glass shader parameters across all system elements</property>
                    <child>
                      <object class="GtkBox" id="liquid_preview_container">
                        <property name="orientation">1</property>
                        <property name="margin-start">15</property>
                        <property name="margin-end">15</property>
                        <property name="margin-top">4</property>
                        <property name="margin-bottom">12</property>
                        <child>
                          <object class="GtkDrawingArea" id="liquid_glass_preview_area">
                            <property name="height-request">210</property>
                            <property name="hexpand">true</property>
                            <signal name="realize" handler="init_liquid_preview" />
                          </object>
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="AdwComboRow" id="liquid_shape_row">
                        <property name="title">Glass Shape</property>
                        <property name="subtitle">Liquid Glass shader geometry and contour</property>
                        <property name="model">
                          <object class="GtkStringList">
                            <items>
                              <item>Rounded Rectangle</item>
                              <item>Circle</item>
                              <item>Capsule</item>
                            </items>
                          </object>
                        </property>
                        <signal name="realize" handler="init_liquid_shape" />
                        <signal name="notify::selected" handler="on_liquid_shape_changed" />
                      </object>
                    </child>
                    <child>
                      <object class="AdwActionRow" id="liquid_refraction_row">
                        <property name="title">Refraction</property>
                        <child type="suffix">
                          <object class="GtkScale" id="liquid_refraction_scale">
                            <property name="orientation">0</property>
                            <property name="draw-value">true</property>
                            <property name="digits">0</property>
                            <property name="round-digits">0</property>
                            <property name="width-request">200</property>
                            <property name="adjustment">
                              <object class="GtkAdjustment">
                                <property name="lower">0</property>
                                <property name="upper">100</property>
                                <property name="step-increment">1</property>
                                <property name="page-increment">5</property>
                                <property name="value">60</property>
                              </object>
                            </property>
                            <signal name="realize" handler="init_liquid_refraction" />
                            <signal name="value-changed" handler="on_liquid_refraction_changed" />
                          </object>
                        </child>
                      </object>
                    </child>
                      </object>
                    </child>
                    <child>
                      <object class="AdwActionRow" id="liquid_tint_row">
                        <property name="title">Tint</property>
                        <child type="suffix">
                          <object class="GtkScale" id="liquid_tint_scale">
                            <property name="orientation">0</property>
                            <property name="draw-value">true</property>
                            <property name="digits">0</property>
                            <property name="round-digits">0</property>
                            <property name="width-request">200</property>
                            <property name="adjustment">
                              <object class="GtkAdjustment">
                                <property name="lower">0</property>
                                <property name="upper">100</property>
                                <property name="step-increment">1</property>
                                <property name="page-increment">5</property>
                                <property name="value">12</property>
                              </object>
                            </property>
                            <signal name="realize" handler="init_liquid_tint" />
                            <signal name="value-changed" handler="on_liquid_tint_changed" />
                          </object>
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="AdwActionRow" id="liquid_chroma_row">
                        <property name="title">Chromatic Aberration</property>
                        <child type="suffix">
                          <object class="GtkScale" id="liquid_chroma_scale">
                            <property name="orientation">0</property>
                            <property name="draw-value">true</property>
                            <property name="digits">0</property>
                            <property name="round-digits">0</property>
                            <property name="width-request">200</property>
                            <property name="adjustment">
                              <object class="GtkAdjustment">
                                <property name="lower">0</property>
                                <property name="upper">100</property>
                                <property name="step-increment">1</property>
                                <property name="page-increment">5</property>
                                <property name="value">20</property>
                              </object>
                            </property>
                            <signal name="realize" handler="init_liquid_chroma" />
                            <signal name="value-changed" handler="on_liquid_chroma_changed" />
                          </object>
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="AdwActionRow" id="liquid_rim_row">
                        <property name="title">Rim Light</property>
                        <child type="suffix">
                          <object class="GtkScale" id="liquid_rim_scale">
                            <property name="orientation">0</property>
                            <property name="draw-value">true</property>
                            <property name="digits">0</property>
                            <property name="round-digits">0</property>
                            <property name="width-request">200</property>
                            <property name="adjustment">
                              <object class="GtkAdjustment">
                                <property name="lower">0</property>
                                <property name="upper">100</property>
                                <property name="step-increment">1</property>
                                <property name="page-increment">5</property>
                                <property name="value">45</property>
                              </object>
                            </property>
                            <signal name="realize" handler="init_liquid_rim" />
                            <signal name="value-changed" handler="on_liquid_rim_changed" />
                          </object>
                        </child>
                      </object>
                    </child>
                      </object>
                    </child>
                    <child>
                      <object class="AdwActionRow" id="liquid_shadow_row">
                        <property name="title">Glass Shadow</property>
                        <child type="suffix">
                          <object class="GtkScale" id="liquid_shadow_scale">
                            <property name="orientation">0</property>
                            <property name="draw-value">true</property>
                            <property name="digits">0</property>
                            <property name="round-digits">0</property>
                            <property name="width-request">200</property>
                            <property name="adjustment">
                              <object class="GtkAdjustment">
                                <property name="lower">0</property>
                                <property name="upper">100</property>
                                <property name="step-increment">1</property>
                                <property name="page-increment">5</property>
                                <property name="value">35</property>
                              </object>
                            </property>
                            <signal name="realize" handler="init_liquid_shadow" />
                            <signal name="value-changed" handler="on_liquid_shadow_changed" />
                          </object>
                        </child>
                      </object>
                    </child>
                  </object>
                </child>

                
                <child>
                  <object class="AdwPreferencesGroup" id="menubar_group">
                    <property name="title">Menu Bar</property>
                    <property name="description">Menu bar tint and blur configuration</property>
                    <child>
                      <object class="GtkBox" id="menubar_preview_container">
                        <property name="orientation">1</property>
                        <property name="margin-start">15</property>
                        <property name="margin-end">15</property>
                        <property name="margin-top">4</property>
                        <property name="margin-bottom">12</property>
                        <child>
                          <object class="GtkDrawingArea" id="menubar_preview_area">
                            <property name="height-request">140</property>
                            <property name="hexpand">true</property>
                            <signal name="realize" handler="init_menubar_preview" />
                          </object>
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="AdwActionRow" id="menubar_tint_row">
                        <property name="title">Gradient Dimming</property>
                        <child type="suffix">
                          <object class="GtkScale" id="menubar_tint_scale">
                            <property name="orientation">0</property>
                            <property name="draw-value">true</property>
                            <property name="digits">0</property>
                            <property name="round-digits">0</property>
                            <property name="width-request">200</property>
                            <property name="adjustment">
                              <object class="GtkAdjustment">
                                <property name="lower">0</property>
                                <property name="upper">100</property>
                                <property name="step-increment">1</property>
                                <property name="page-increment">5</property>
                                <property name="value">35</property>
                              </object>
                            </property>
                            <signal name="realize" handler="init_menubar_tint" />
                            <signal name="value-changed" handler="on_menubar_tint_changed" />
                          </object>
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="AdwActionRow" id="menubar_blur_row">
                        <property name="title">Blur</property>
                        <child type="suffix">
                          <object class="GtkScale" id="menubar_blur_scale">
                            <property name="orientation">0</property>
                            <property name="draw-value">true</property>
                            <property name="digits">0</property>
                            <property name="round-digits">0</property>
                            <property name="width-request">200</property>
                            <property name="adjustment">
                              <object class="GtkAdjustment">
                                <property name="lower">0</property>
                                <property name="upper">100</property>
                                <property name="step-increment">1</property>
                                <property name="page-increment">5</property>
                                <property name="value">10</property>
                              </object>
                            </property>
                            <signal name="realize" handler="init_menubar_blur" />
                            <signal name="value-changed" handler="on_menubar_blur_changed" />
                          </object>
                        </child>
                      </object>
                    </child>
                  </object>
                </child>

                
                <child>
                  <object class="AdwPreferencesGroup" id="dock_group">
                    <property name="title">Dock</property>
                    <property name="description">Tint, blur, and shadow parameters for the bottom Dock</property>
                    <child>
                      <object class="GtkBox" id="dock_preview_container">
                        <property name="orientation">1</property>
                        <property name="margin-start">15</property>
                        <property name="margin-end">15</property>
                        <property name="margin-top">4</property>
                        <property name="margin-bottom">12</property>
                        <child>
                          <object class="GtkDrawingArea" id="dock_preview_area">
                            <property name="height-request">150</property>
                            <property name="hexpand">true</property>
                            <signal name="realize" handler="init_dock_preview" />
                          </object>
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="AdwActionRow" id="dock_tint_row">
                        <property name="title">Dimming</property>
                        <child type="suffix">
                          <object class="GtkScale" id="dock_tint_scale">
                            <property name="orientation">0</property>
                            <property name="draw-value">true</property>
                            <property name="digits">0</property>
                            <property name="round-digits">0</property>
                            <property name="width-request">200</property>
                            <property name="adjustment">
                              <object class="GtkAdjustment">
                                <property name="lower">0</property>
                                <property name="upper">100</property>
                                <property name="step-increment">1</property>
                                <property name="page-increment">5</property>
                                <property name="value">15</property>
                              </object>
                            </property>
                            <signal name="realize" handler="init_dock_tint" />
                            <signal name="value-changed" handler="on_dock_tint_changed" />
                          </object>
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="AdwActionRow" id="dock_blur_row">
                        <property name="title">Blur</property>
                        <child type="suffix">
                          <object class="GtkScale" id="dock_blur_scale">
                            <property name="orientation">0</property>
                            <property name="draw-value">true</property>
                            <property name="digits">0</property>
                            <property name="round-digits">0</property>
                            <property name="width-request">200</property>
                            <property name="adjustment">
                              <object class="GtkAdjustment">
                                <property name="lower">0</property>
                                <property name="upper">50</property>
                                <property name="step-increment">1</property>
                                <property name="page-increment">5</property>
                                <property name="value">9</property>
                              </object>
                            </property>
                            <signal name="realize" handler="init_dock_blur" />
                            <signal name="value-changed" handler="on_dock_blur_changed" />
                          </object>
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="AdwActionRow" id="dock_shadow_row">
                        <property name="title">Dock Shadow</property>
                        <child type="suffix">
                          <object class="GtkScale" id="dock_shadow_scale">
                            <property name="orientation">0</property>
                            <property name="draw-value">true</property>
                            <property name="digits">0</property>
                            <property name="round-digits">0</property>
                            <property name="width-request">200</property>
                            <property name="adjustment">
                              <object class="GtkAdjustment">
                                <property name="lower">0</property>
                                <property name="upper">100</property>
                                <property name="step-increment">1</property>
                                <property name="page-increment">5</property>
                                <property name="value">30</property>
                              </object>
                            </property>
                            <signal name="realize" handler="init_dock_shadow" />
                            <signal name="value-changed" handler="on_dock_shadow_changed" />
                          </object>
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="AdwActionRow" id="dock_edge_distance_row">
                        <property name="title">Distance from Edge</property>
                        <property name="subtitle">Distance between dock and bottom of screen (px)</property>
                        <child type="suffix">
                          <object class="GtkScale" id="dock_edge_distance_scale">
                            <property name="orientation">0</property>
                            <property name="draw-value">true</property>
                            <property name="digits">0</property>
                            <property name="round-digits">0</property>
                            <property name="width-request">200</property>
                            <property name="adjustment">
                              <object class="GtkAdjustment">
                                <property name="lower">0</property>
                                <property name="upper">24</property>
                                <property name="step-increment">1</property>
                                <property name="page-increment">4</property>
                                <property name="value">0</property>
                              </object>
                            </property>
                            <signal name="realize" handler="init_dock_edge_distance" />
                            <signal name="value-changed" handler="on_dock_edge_distance_changed" />
                          </object>
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="AdwActionRow" id="dock_icon_size_row">
                        <property name="title">Icon Size</property>
                        <property name="subtitle">Application icon size in dock (px)</property>
                        <child type="suffix">
                          <object class="GtkScale" id="dock_icon_size_scale">
                            <property name="orientation">0</property>
                            <property name="draw-value">true</property>
                            <property name="digits">0</property>
                            <property name="round-digits">0</property>
                            <property name="width-request">200</property>
                            <property name="adjustment">
                              <object class="GtkAdjustment">
                                <property name="lower">24</property>
                                <property name="upper">96</property>
                                <property name="step-increment">2</property>
                                <property name="page-increment">8</property>
                                <property name="value">54</property>
                              </object>
                            </property>
                            <signal name="realize" handler="init_dock_icon_size" />
                            <signal name="value-changed" handler="on_dock_icon_size_changed" />
                          </object>
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="AdwActionRow" id="dock_size_row">
                        <property name="title">Dock Size</property>
                        <property name="subtitle">Vertical padding and dock plate size (px)</property>
                        <child type="suffix">
                          <object class="GtkScale" id="dock_size_scale">
                            <property name="orientation">0</property>
                            <property name="draw-value">true</property>
                            <property name="digits">0</property>
                            <property name="round-digits">0</property>
                            <property name="width-request">200</property>
                            <property name="adjustment">
                              <object class="GtkAdjustment">
                                <property name="lower">0</property>
                                <property name="upper">24</property>
                                <property name="step-increment">1</property>
                                <property name="page-increment">4</property>
                                <property name="value">12</property>
                              </object>
                            </property>
                            <signal name="realize" handler="init_dock_size" />
                            <signal name="value-changed" handler="on_dock_size_changed" />
                          </object>
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="AdwActionRow" id="dock_spacing_row">
                        <property name="title">Icon Spacing</property>
                        <property name="subtitle">Distance between adjacent app icons (px)</property>
                        <child type="suffix">
                          <object class="GtkScale" id="dock_spacing_scale">
                            <property name="orientation">0</property>
                            <property name="draw-value">true</property>
                            <property name="digits">0</property>
                            <property name="round-digits">0</property>
                            <property name="width-request">200</property>
                            <property name="adjustment">
                              <object class="GtkAdjustment">
                                <property name="lower">0</property>
                                <property name="upper">24</property>
                                <property name="step-increment">1</property>
                                <property name="page-increment">4</property>
                                <property name="value">0</property>
                              </object>
                            </property>
                            <signal name="realize" handler="init_dock_spacing" />
                            <signal name="value-changed" handler="on_dock_spacing_changed" />
                          </object>
                        </child>
                      </object>
                    </child>
                  </object>
                </child>

                
                <child>
                  <object class="AdwPreferencesGroup" id="labels_group">
                    <property name="title">Dock Labels</property>
                    <property name="description">Blur, tint, and shadow parameters for app labels in the Dock</property>
                    <child>
                      <object class="GtkBox" id="labels_preview_container">
                        <property name="orientation">1</property>
                        <property name="margin-start">15</property>
                        <property name="margin-end">15</property>
                        <property name="margin-top">4</property>
                        <property name="margin-bottom">12</property>
                        <child>
                          <object class="GtkDrawingArea" id="labels_preview_area">
                            <property name="height-request">170</property>
                            <property name="hexpand">true</property>
                            <signal name="realize" handler="init_labels_preview" />
                          </object>
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="AdwActionRow" id="label_blur_row">
                        <property name="title">Blur</property>
                        <child type="suffix">
                          <object class="GtkScale" id="label_blur_scale">
                            <property name="orientation">0</property>
                            <property name="draw-value">true</property>
                            <property name="digits">0</property>
                            <property name="round-digits">0</property>
                            <property name="width-request">200</property>
                            <property name="adjustment">
                              <object class="GtkAdjustment">
                                <property name="lower">0</property>
                                <property name="upper">50</property>
                                <property name="step-increment">1</property>
                                <property name="page-increment">5</property>
                                <property name="value">30</property>
                              </object>
                            </property>
                            <signal name="realize" handler="init_label_blur" />
                            <signal name="value-changed" handler="on_label_blur_changed" />
                          </object>
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="AdwActionRow" id="label_tint_row">
                        <property name="title">Dimming</property>
                        <child type="suffix">
                          <object class="GtkScale" id="label_tint_scale">
                            <property name="orientation">0</property>
                            <property name="draw-value">true</property>
                            <property name="digits">0</property>
                            <property name="round-digits">0</property>
                            <property name="width-request">200</property>
                            <property name="adjustment">
                              <object class="GtkAdjustment">
                                <property name="lower">0</property>
                                <property name="upper">100</property>
                                <property name="step-increment">1</property>
                                <property name="page-increment">5</property>
                                <property name="value">28</property>
                              </object>
                            </property>
                            <signal name="realize" handler="init_label_tint" />
                            <signal name="value-changed" handler="on_label_tint_changed" />
                          </object>
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="AdwActionRow" id="label_shadow_row">
                        <property name="title">Shadow</property>
                        <child type="suffix">
                          <object class="GtkScale" id="label_shadow_scale">
                            <property name="orientation">0</property>
                            <property name="draw-value">true</property>
                            <property name="digits">0</property>
                            <property name="round-digits">0</property>
                            <property name="width-request">200</property>
                            <property name="adjustment">
                              <object class="GtkAdjustment">
                                <property name="lower">0</property>
                                <property name="upper">100</property>
                                <property name="step-increment">1</property>
                                <property name="page-increment">5</property>
                                <property name="value">25</property>
                              </object>
                            </property>
                            <signal name="realize" handler="init_label_shadow" />
                            <signal name="value-changed" handler="on_label_shadow_changed" />
                          </object>
                        </child>
                      </object>
                    </child>
                  </object>
                </child>

                
                <child>
                  <object class="AdwPreferencesGroup" id="alerts_group">
                    <property name="title">Dialog Alerts</property>
                    <property name="description">Tint, blur, and shadow parameters for system alert dialogs</property>
                    <child>
                      <object class="GtkBox" id="alerts_preview_container">
                        <property name="orientation">1</property>
                        <property name="margin-start">15</property>
                        <property name="margin-end">15</property>
                        <property name="margin-top">4</property>
                        <property name="margin-bottom">12</property>
                        <child>
                          <object class="GtkDrawingArea" id="alerts_preview_area">
                            <property name="height-request">175</property>
                            <property name="hexpand">true</property>
                            <signal name="realize" handler="init_alerts_preview" />
                          </object>
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="AdwActionRow" id="alert_tint_row">
                        <property name="title">Dimming</property>
                        <child type="suffix">
                          <object class="GtkScale" id="alert_tint_scale">
                            <property name="orientation">0</property>
                            <property name="draw-value">true</property>
                            <property name="digits">0</property>
                            <property name="round-digits">0</property>
                            <property name="width-request">200</property>
                            <property name="adjustment">
                              <object class="GtkAdjustment">
                                <property name="lower">0</property>
                                <property name="upper">100</property>
                                <property name="step-increment">1</property>
                                <property name="page-increment">5</property>
                                <property name="value">20</property>
                              </object>
                            </property>
                            <signal name="realize" handler="init_alert_tint" />
                            <signal name="value-changed" handler="on_alert_tint_changed" />
                          </object>
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="AdwActionRow" id="alert_blur_row">
                        <property name="title">Blur</property>
                        <child type="suffix">
                          <object class="GtkScale" id="alert_blur_scale">
                            <property name="orientation">0</property>
                            <property name="draw-value">true</property>
                            <property name="digits">0</property>
                            <property name="round-digits">0</property>
                            <property name="width-request">200</property>
                            <property name="adjustment">
                              <object class="GtkAdjustment">
                                <property name="lower">0</property>
                                <property name="upper">50</property>
